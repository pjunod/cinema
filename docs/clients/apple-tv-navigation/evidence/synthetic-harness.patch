+import SwiftUI
+@main struct AuditApp: App {
+ @StateObject var model = AppModel(startServices: false)
+ @StateObject var navigation = RemoteNavigationCoordinator()
+ @StateObject var playback = RemotePlaybackAdapter()
+ let collection = LibraryCollection(id: "category:movie", title: "Movies", kind: "movie", libraries: [Library(id: 1, name: "Movies", kind: "movie")])
+ var body: some Scene { WindowGroup {
+  NavigationStack { LibraryView(collection: collection).remoteScope("library:category:movie") }
+   .environmentObject(model).environmentObject(navigation).environmentObject(playback)
+   .preferredColorScheme(.dark).tint(Palette.accent)
+   .onAppear { navigation.selectedTab = .libraries; navigation.paths[.libraries] = [.collection(collection)]; navigation.synchronizeRoute() }
+ } }
+}
--- a/clients/apple/AuditTests/ModalAuditTests.swift
+++ b/clients/apple/AuditTests/ModalAuditTests.swift
@@ -0,0 +1,20 @@
+import XCTest
+@MainActor final class ModalAuditTests: XCTestCase {
+ func testLibraryModalFocus() {
+  let app = XCUIApplication(); app.launchArguments += ["-plurx.libraryPresentation", "grid"]; app.launch()
+  XCTAssertTrue(app.buttons["View"].waitForExistence(timeout: 30))
+  let remote = XCUIRemote.shared
+  for _ in 0..<8 { if app.buttons["View"].hasFocus { break }; remote.press(.up) }
+  for _ in 0..<4 { if app.buttons["View"].hasFocus { break }; remote.press(.left) }
+  print("AUDIT BEFORE " + app.debugDescription)
+  XCTAssertTrue(app.buttons["View"].hasFocus)
+  remote.press(.select)
+  XCTAssertTrue(app.buttons["Rows"].waitForExistence(timeout: 5))
+  let shot = XCTAttachment(screenshot: app.screenshot()); shot.name = "library-view-modal"; shot.lifetime = .keepAlways; add(shot)
+  print("AUDIT OPEN " + app.debugDescription)
+  for _ in 0..<3 { remote.press(.down) }
+  print("AUDIT AFTER THREE DOWN " + app.debugDescription)
+  let second = XCTAttachment(screenshot: app.screenshot()); second.name = "library-modal-after-three-down"; second.lifetime = .keepAlways; add(second)
+  XCTAssertTrue(app.buttons["Rows"].hasFocus || app.buttons["Grid"].hasFocus || app.buttons["Close"].hasFocus, "Modal must own focus without traversing library")
+ }
+}
