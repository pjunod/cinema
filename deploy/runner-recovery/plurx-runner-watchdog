#!/usr/bin/env python3
"""Recover explicitly managed local runner VMs without undoing maintenance."""

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import socket
import stat
import subprocess
import time
import urllib.parse
import uuid

GIB = 1024**3


def command(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=120)
    if result.returncode:
        raise RuntimeError(f"{args[0]} failed ({result.returncode}): {result.stderr.strip()}")
    return result.stdout


def available_memory():
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024
    raise RuntimeError("MemAvailable missing; refusing a blind VM start")


PAUSED_DIR = Path("/var/lib/plurx-runner-watchdog/paused")
ADMISSION_LOCK = Path("/var/lib/plurx-runner-watchdog/admission.lock")
MAINTENANCE = Path("/var/lib/plurx-runner-watchdog/maintenance.json")
OWNER_CONTRACT = {"version": 2, "operation": "start_vm", "identity_admission": 1,
                  "shared_admission_lock": str(ADMISSION_LOCK), "monotonic_authorization": True}


def canonical_uuid(value):
    try:
        parsed = uuid.UUID(value)
        if str(parsed) != value or not parsed.int:
            raise ValueError()
    except (ValueError, AttributeError, TypeError):
        raise ValueError("expected a canonical nonzero instance UUID") from None
    return value


@contextmanager
def admission_lock():
    """Shared with managed provisioning and maintenance on the physical target.

    Fixed path independent of --state: changing history location cannot create
    a second admission domain. Root-only directory ownership prevents a peer
    from substituting the flock file used by provisioning.
    """
    ADMISSION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    directory = ADMISSION_LOCK.parent.stat()
    if directory.st_uid != os.geteuid() or directory.st_mode & 0o022:
        raise RuntimeError("admission directory must be owned and not group/world writable")
    fd = os.open(str(ADMISSION_LOCK), os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077 or info.st_nlink != 1:
            raise RuntimeError("admission lock must be a private owned regular file")
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def paused_reason(paused_dir, name):
    """Why an operator drained this VM's runner, or None when it is not paused.

    ci-fleet's Drain writes the marker before it stops the runner, so the next
    pass does not restart a unit someone deliberately stopped; Resume removes
    it. The watchdog stays the only thing that starts runner VMs and daemons.
    """
    marker = Path(paused_dir) / name
    if not marker.exists():
        return None
    try:
        detail = json.loads(marker.read_text())
    except (OSError, ValueError):
        return "paused"
    return f"paused by {detail.get('actor') or 'an operator'}" + (f": {detail['reason']}" if detail.get("reason") else "")


def recover(config, state, *, execute=command, memory=available_memory, now=None, host=None, persist=lambda state: None,
            paused_dir=PAUSED_DIR, only=None, expected_instance_uuid=None, expected_instance_generation=None,
            authorization_deadline=None, monotonic=time.monotonic, maintenance=MAINTENANCE):
    now = int(time.time()) if now is None else now
    host = socket.gethostname().split(".")[0] if host is None else host
    guarded = expected_instance_uuid is not None or expected_instance_generation is not None or authorization_deadline is not None
    if guarded:
        if only is None or expected_instance_uuid is None or expected_instance_generation is None or authorization_deadline is None:
            raise ValueError("guarded admission requires one VM, both expected identities and a monotonic deadline")
        canonical_uuid(expected_instance_uuid); canonical_uuid(expected_instance_generation)
        if type(authorization_deadline) not in (int, float) or not 0 < authorization_deadline < float("inf"):
            raise ValueError("invalid monotonic authorization deadline")
    project = config.get("project", "github-runners")
    reserve = config.get("reserve_gib", 4) * GIB
    instances = {i["name"]: i for i in json.loads(execute("incus", "list", "--project", project, "--format", "json"))}
    receipt = {"finished": now, "host": host, "recovered": [], "errors": [], "deferred": []}
    if guarded:
        receipt.update(owner_contract=2, operation="start_vm", outcome="rejected",
                       expected_resource={"name":only,"uuid":expected_instance_uuid,"generation":expected_instance_generation},
                       observed_resource=None)
    def defer(message):
        receipt["deferred"].append(message)
        if guarded:receipt["outcome"] = "deferred"
    attempts = state.setdefault("attempts", {})
    if Path(maintenance).exists():
        defer("host maintenance is active")
        if guarded:receipt["outcome"] = "deferred"
        state["last_run"] = receipt
        return receipt
    admission = None
    # MemAvailable includes pages QEMU has not committed yet. Reserve the
    # unused part of every running local guest, including on later passes.
    def boot_headroom():
        nonlocal admission
        if admission is None:
            unused = 0
            for other in instances.values():
                if other.get("location") != host or other["status"] == "Stopped":
                    continue
                allocation = other["expanded_config"].get("limits.memory", "")
                if not re.fullmatch(r"[1-9][0-9]*GiB", allocation):
                    raise RuntimeError("cannot account for local VM allocation")
                committed = 0
                if other["status"] == "Running":
                    name = other["name"]
                    if not re.fullmatch(r"gha-[a-z0-9-]+", name):
                        raise RuntimeError("invalid local VM identity")
                    usage = json.loads(execute("incus", "query", f"/1.0/instances/{name}/state?project={project}"))["memory"]["usage"]
                    if not isinstance(usage, int) or usage < 0:
                        raise RuntimeError("cannot account for local VM memory usage")
                    committed = usage
                unused += max(0, int(allocation[:-3]) * GIB - committed)
            admission = memory() - unused
        # A later reading may be lower; never enlarge this pass's budget.
        return min(admission, memory())
    managed_runners = config["runners"]
    if only is not None:
        managed_runners = [managed for managed in managed_runners if managed["vm"] == only]
        if not managed_runners:
            receipt["errors"].append(f"{only}: not managed by this host's watchdog")
    for managed in managed_runners:
        name, unit = managed["vm"], managed["unit"]
        if not re.fullmatch(r"gha-[a-z0-9-]+", name) or not re.fullmatch(r"forgejo-runner-gha-[a-z0-9-]+\.service", unit):
            raise ValueError("invalid managed runner identity")
        instance = instances.get(name)
        if guarded:
            try:
                # Exact fresh read under main's shared admission lock. Managed
                # init/config/start/restore authorities use this same target lock.
                instance = json.loads(execute("incus", "query", "/1.0/instances/"+urllib.parse.quote(name,safe="")+
                                              "?project="+urllib.parse.quote(project,safe="")))
                observed = {"name":instance.get("name"),"uuid":instance.get("expanded_config",{}).get("volatile.uuid"),
                            "generation":instance.get("expanded_config",{}).get("volatile.uuid.generation")}
                receipt["observed_resource"] = observed
                if observed != receipt["expected_resource"]:
                    raise ValueError("instance identity differs from guarded plan or is unsupported")
            except (RuntimeError, subprocess.TimeoutExpired, KeyError, ValueError, TypeError, AttributeError):
                receipt["errors"].append(f"{name}: guarded identity unavailable or changed")
                continue
        if not instance or instance.get("location") != host:
            receipt["errors"].append(f"{name}: missing or on another host")
            continue
        if instance["expanded_config"].get("boot.autostart") == "false":
            defer(f"{name}: maintenance")
            continue
        reason = paused_reason(paused_dir, name)
        if reason:
            defer(f"{name}: {reason}")
            continue
        # Inventory drift must not turn an 8 GiB admission check into a boot
        # of a larger VM. Reconcile configuration instead of guessing units.
        allocation = instance["expanded_config"].get("limits.memory")
        if allocation != f"{managed['memory_gib']}GiB":
            receipt["errors"].append(f"{name}: memory allocation differs from recovery budget")
            continue
        try:
            if guarded and instance["status"] == "Running":
                receipt["outcome"] = "already_running"
                continue  # start_vm never becomes an in-service daemon repair
            if instance["status"] == "Stopped":
                history = [t for t in attempts.get(name, []) if now - t < 3600]
                attempts[name] = history
                if history and (now - history[-1] < 600 or len(history) >= 3):
                    defer(f"{name}: restart backoff")
                    continue
                # Boot only when the full configured allocation leaves host headroom.
                if boot_headroom() < (managed["memory_gib"] * GIB + reserve):
                    defer(f"{name}: insufficient host memory")
                    continue
                if Path(maintenance).exists() or paused_reason(paused_dir,name):
                    defer(f"{name}: maintenance intent observed before admission")
                    continue
                if guarded and monotonic() >= authorization_deadline:
                    defer(f"{name}: authorization expired before admission")
                    continue
                admission -= managed["memory_gib"] * GIB
                history.append(now)
                # Retain the attempt before an external command: a timeout or
                # killed watchdog must not reset the OOM retry budget.
                persist(state)
                # Slow fsync can outlast new maintenance intent or authorization.
                if Path(maintenance).exists() or paused_reason(paused_dir,name):
                    defer(f"{name}: maintenance intent observed before start")
                    continue
                if guarded and monotonic() >= authorization_deadline:
                    defer(f"{name}: authorization expired before start")
                    continue
                if guarded:receipt["outcome"] = "unknown"
                execute("incus", "start", "--project", project, name)
                receipt["recovered"].append(f"{name}: VM started")
                if guarded:
                    receipt["outcome"] = "started"
                    continue  # service/pickup verification is a separate observation
            elif instance["status"] != "Running":
                defer(f"{name}: {instance['status']}")
                continue
            prefix = ("incus", "exec", "--project", project, name, "--")
            # Never restart an active or draining runner: it may own a live job.
            status = execute(*prefix, "systemctl", "show", unit, "-p", "ActiveState", "--value").strip()
            if status in {"inactive", "failed"}:
                execute(*prefix, "systemctl", "start", unit)
                receipt["recovered"].append(f"{name}: daemon started")
        except (RuntimeError, subprocess.TimeoutExpired, KeyError, ValueError) as error:
            receipt["errors"].append(f"{name}: {error}")
    state["last_run"] = receipt
    return receipt


def save_state(path, state):
    temporary = path.with_suffix(".tmp")
    with temporary.open("w") as source:
        source.write(json.dumps(state, indent=2) + "\n")
        source.flush(); os.fsync(source.fileno())
    os.replace(temporary, path)
    directory = os.open(str(path.parent), os.O_RDONLY)
    try:os.fsync(directory)
    finally:os.close(directory)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default="/etc/plurx-ci/runner-vms.json")
    parser.add_argument("--state", default="/var/lib/plurx-runner-watchdog/state.json")
    parser.add_argument("--paused-dir", default=str(PAUSED_DIR))
    parser.add_argument("--vm", help="recover only this managed VM (ci-fleet's Start VM and Resume)")
    parser.add_argument("--describe-owner-contract", action="store_true", help="print the guarded admission contract without accessing resources")
    parser.add_argument("--expected-instance-uuid")
    parser.add_argument("--expected-instance-generation")
    parser.add_argument("--authorization-deadline-monotonic", type=float)
    args = parser.parse_args()
    if args.describe_owner_contract:
        print(json.dumps(OWNER_CONTRACT)); return 0
    expected = (args.expected_instance_uuid, args.expected_instance_generation, args.authorization_deadline_monotonic)
    if any(value is not None for value in expected):
        if not args.vm or any(value is None for value in expected):
            parser.error("guarded admission requires --vm, both expected identities and authorization deadline")
        try:canonical_uuid(expected[0]); canonical_uuid(expected[1])
        except ValueError as error:parser.error(str(error))
    path = Path(args.state)
    path.parent.mkdir(parents=True, exist_ok=True)
    # The timer and ci-fleet's Start VM / Resume (`--vm`) can both run a pass:
    # one lock serialises them so neither loses the other's restart history.
    with admission_lock(), path.with_suffix(".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = json.loads(path.read_text()) if path.exists() else {}
        receipt = recover(json.loads(Path(args.config).read_text()), state,
                          persist=lambda value: save_state(path, value), paused_dir=args.paused_dir, only=args.vm,
                          expected_instance_uuid=expected[0], expected_instance_generation=expected[1],
                          authorization_deadline=expected[2])
        save_state(path, state)
    print(json.dumps(receipt), flush=True)
    return int(bool(receipt["errors"]))


if __name__ == "__main__":
    raise SystemExit(main())
