[Unit]
Description=Recover interrupted plurx desktop operations before service startup
Before=plurxd.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/plurx-control/plurx-recovery
RemainAfterExit=yes
User=root
Group=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/plurx /var/lib/plurx-control
ProtectHome=true
