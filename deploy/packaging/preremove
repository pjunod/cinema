#!/bin/sh
# plurxd package pre-removal. dpkg passes `remove` (or `upgrade` on an
# upgrade); rpm passes the number of instances left (0 on an erase). Only a
# real removal stops the service; an upgrade restarts it from post-install.
# The marker in the kept state directory tells a later install that the
# package is arriving again, so it re-enables the service (see post-install).
set -e
joined=0
/usr/lib/plurx-control/plurx-install-helper package-script preremove server -- "$@" || joined=$?
case $joined in 0) ;; 10) exit 0 ;; *) exit "$joined" ;; esac
case "${1:-}" in
  remove|0)
    if [ -d /var/lib/plurx ]; then
      : > /var/lib/plurx/.plurxd-package-removed
    fi
    if [ -d /run/systemd/system ]; then
      systemctl disable --now plurxd.service >/dev/null 2>&1 || true
    fi
    ;;
esac
