# Host-specific compose variables — copy to .env (gitignored) and edit.
#   cp .env.example .env

# Host TCP port for the web app and API. Leave 32400 unless Plex or another
# service still owns it; peer containers always reach plurxd on its unchanged
# internal port 32400.
PLURX_HTTP_PORT=32400

# Host UDP port published for GDM discovery. Plex clients only discover on
# 32414; change this only when something else (a still-running Plex Media
# Server) owns 32414 on this host. plurx then works fine by direct address
# (http://host:<PLURX_HTTP_PORT>) and discovery lights up once you flip this
# back.
PLURX_GDM_PORT=32414

# Physical machine's short hostname for Settings → Cluster. A native plurxd
# reads this from the OS; a container otherwise sees its generated container
# id, so set the same short name you get from `hostname -s` on the Docker host.
PLURX_NODE_HOSTNAME=${HOSTNAME:-}

# Authoritative database and compatibility root. A path on the host,
# deliberately: a named volume lives somewhere Docker chose and
# can be orphaned by a rename or a stack recreate, and plurxd handed an empty
# directory starts up showing the first-run setup screen rather than failing —
# which looks exactly like losing your library. Create it before first run,
# owned by the uid below:
#
#   sudo install -d -o $(id -u) -g $(id -g) /srv/plurx
PLURX_DATA=/srv/plurx
# Optional persistent-cache and disposable-scratch roots are mounted in
# docker-compose.override.yml and configured with their container paths. An
# explicit scratch directory must be empty on first claim; plurx then keeps an
# exact owner-only marker in it before any restart cleanup. It must be owned by
# PUID and not group/world-writable:
# PLURX_CACHE_DIR=/var/cache/plurx
# PLURX_TRANSCODE_DIR=/var/tmp/plurx-transcode
# Keep the local replicated-read pool at 4 until retained 4/8/16 evidence
# proves a different value on the named workload:
# PLURX_CLUSTER_READ_POOL_SIZE=4

# The uid/gid the container runs as, so files under PLURX_DATA belong to you.
# `id -u` and `id -g` if 1000 is not right.
PUID=1000
PGID=1000
