<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tv.plurx.ci-janitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/plurx-ci-janitor</string>
  </array>
  <!-- Hourly, matching the Linux timer. In steady state a pass decides
       "within budget" and deletes nothing. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/var/log/plurx-ci-janitor.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/plurx-ci-janitor.log</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
