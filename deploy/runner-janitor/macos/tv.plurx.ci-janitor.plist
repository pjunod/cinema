<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>tv.plurx.ci-janitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/plurx-ci-janitor</string>
  </array>
  <!-- Five-minute recovery also finds daemons a failed bootstrap left unloaded.
       Healthy caches and busy jobs are untouched. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/var/log/plurx-ci-janitor.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/plurx-ci-janitor.log</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
