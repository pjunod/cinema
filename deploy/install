#!/usr/bin/env bash
# Install plurx as one command, on every platform it runs on.
#
#   make install            # this OS: systemd on Linux, launchd on macOS,
#                           # the native service on Windows
#   make install-docker     # Compose stack, built from this checkout
#   make install-binary     # core plus tray in GUI sessions; fresh server stopped
#   make uninstall          # stop and remove the service; data stays
#
# The Makefile targets call this script; it can also be run directly:
#
#   deploy/install <auto|linux|macos|windows|docker|binary> [options]
#
#   --binary PATH   install this prebuilt plurxd instead of building one
#                   (a release archive's own plurxd, beside this script, is
#                   used without it)
#   --prefix DIR    where the binary goes (default: /usr/local, or the
#                   Homebrew prefix on macOS); the service unit follows it
#   --ffmpeg-archive PATH
#                   macOS: the Jellyfin FFmpeg portable archive, already
#                   downloaded (offline installs); still checksum-verified
#   --source-parser PATH
#                   macOS: a built plurx-source-parser.wasm to install instead
#                   of building one (a release archive's own module, beside
#                   this script, is used without it)
#   --subtitle-engine-package DIR
#                   macOS: verified pinned whisper.cpp bundle; release archives
#                   supply it, and source installs build it automatically
#   --server-only   explicit legacy daemon-only install, without the tray app
#   --uninstall     remove the service and the binary; keep data and config
#   --dry-run       print every command instead of running it
#
# A new/running install proves /readyz and reports the observed version. An
# existing stopped install keeps its running and startup policy. Privileged steps run
# through sudo only when they have to; the build never does.
#
# Stays within bash 3.2, which is what macOS ships.
set -euo pipefail

here=$(cd -P -- "$(dirname -- "$0")" && pwd -P)
root=$(cd -P -- "$here/.." && pwd -P)

# A release archive contains a complete native runtime, app and controller.
# Its shipped native bootstrap verifies the closure and uses fixed per-user
# destinations; it needs no checkout, Python, Homebrew, Rust or downloads.
if [ -f "$here/runtime-closure-v1.json" ] && [ -x "$here/control/plurx-control" ]; then
  "$here/control/plurx-control" bootstrap macos --package "$here" "$@"
  show_tray=1
  for argument in "$@"; do
    case "$argument" in --dry-run|--help|-h|--version|--uninstall) show_tray=0 ;; esac
  done
  if [ "$show_tray" = 1 ] && [ "$(uname -s)" = Darwin ] \
      && launchctl print "gui/$(id -u)" >/dev/null 2>&1; then
    /usr/bin/open "$HOME/Applications/Plurx Server.app"
  fi
  exit 0
fi

mode=auto
binary=
prefix=
ffmpeg_archive=
source_parser=
subtitle_engine_package=
uninstall=0
dry_run=0
server_only=0

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

say() { printf '%s\n' "install: $*"; }
die() { printf '%s\n' "install: $*" >&2; exit 1; }

# `run` executes a command, or prints it under --dry-run. `run_root` does the
# same through sudo when this shell is not root. Quoting is preserved either
# way, so a dry-run line can be pasted back into a shell.
run() {
  if [ "$dry_run" = 1 ]; then
    printf '+'; printf ' %q' "$@"; printf '\n'
  else
    "$@"
  fi
}
run_root() {
  if [ "$(id -u)" = 0 ]; then
    run "$@"
  else
    run sudo "$@"
  fi
}

# Wrap a writing command in sudo only when the destination is not writable by
# this user: Homebrew's bin on Apple Silicon is user-owned, /usr/local/bin is not.
run_for_dir() {
  local dir=$1; shift
  if dir_writable "$dir"; then
    run "$@"
  else
    run_root "$@"
  fi
}

# Judge by the nearest ancestor that exists: `install -d /opt/x/bin` needs
# root when /opt is root-owned even though /opt/x is not there yet.
dir_writable() {
  local dir=$1
  while [ ! -e "$dir" ] && [ "$dir" != / ]; do dir=$(dirname -- "$dir"); done
  [ -w "$dir" ]
}

# True when replacing or removing the file $1 needs root: the file itself is
# not writable, or its directory is not (a replace is a rename into it).
file_needs_root() {
  if [ -e "$1" ] && [ ! -w "$1" ]; then return 0; fi
  ! dir_writable "$(dirname -- "$1")"
}

# `run_for_dir` for a command that replaces or removes the file $1 itself.
run_for_file() {
  local file=$1; shift
  if file_needs_root "$file"; then
    run_root "$@"
  else
    run "$@"
  fi
}

# Hand paths a run as root left behind back to the user running this one.
# macOS sudo keeps HOME, so `sudo make install` writes root-owned files into
# the user's build tree, cargo cache and Library, and every later run as the
# user then fails on them. `--top` claims only the directory itself, for a
# directory that may hold other tools' files (~/Library/LaunchAgents).
# Paths already the user's are left alone; a run as root claims nothing.
claim_for_user() {
  local depth= path uid gid
  [ "${1:-}" = --top ] && { depth="-maxdepth 0"; shift; }
  uid=$(id -u); gid=$(id -g)
  [ "$uid" = 0 ] && return 0
  for path in "$@"; do
    [ -e "$path" ] || continue
    # shellcheck disable=SC2086
    [ -z "$(find "$path" $depth ! -user "$uid" -print 2>/dev/null | head -1)" ] && continue
    if [ -n "$depth" ]; then
      run_root chown "$uid:$gid" "$path"
    else
      run_root chown -R "$uid:$gid" "$path"
    fi
    [ "$dry_run" = 1 ] || say "gave $path back to uid $uid (an earlier run as root left it root-owned)"
  done
}

# Temporary files and directories are removed however the script ends,
# including a declined sudo prompt under `set -e` or an interrupted build.
temp_files=
cleanup_temp_files() {
  local f parent uid
  set +e
  if [ "${subtitle_engine_promoted:-0}" = 1 ] || { [ -n "${subtitle_engine_backup:-}" ] && [ -d "$subtitle_engine_backup" ]; }; then
    parent=$(dirname -- "$subtitle_engine_destination")
    uid=$(id -u)
    run launchctl bootout "gui/$uid/$macos_agent_label" 2>/dev/null
    run_for_dir "$parent" rm -rf "$subtitle_engine_destination"
    if [ -n "$subtitle_engine_backup" ]; then
      run_for_dir "$parent" mv "$subtitle_engine_backup" "$subtitle_engine_destination"
      subtitle_engine_backup=
    fi
    if [ "${macos_was_running:-0}" = 1 ] && [ -f "$HOME/Library/LaunchAgents/$macos_agent_label.plist" ]; then
      run launchctl bootstrap "gui/$uid" "$HOME/Library/LaunchAgents/$macos_agent_label.plist"
      run launchctl kickstart "gui/$uid/$macos_agent_label"
    fi
    say 'subtitle engine update failed; prior engine package restored (model data kept)'
  fi
  if [ -n "${subtitle_engine_stage:-}" ]; then
    run_for_dir "$(dirname -- "$subtitle_engine_stage")" rm -rf "$subtitle_engine_stage"
  fi
  for f in $temp_files; do rm -rf "$f"; done
}
trap cleanup_temp_files EXIT
# `new_temp_file VAR` creates one and stores its path in VAR (not printed,
# because a command substitution's subshell could not record it for cleanup).
new_temp_file() {
  local f
  f=$(mktemp "${TMPDIR:-/tmp}/plurxd-agent.XXXXXX")
  temp_files="$temp_files $f"
  printf -v "$1" '%s' "$f"
}

while [ $# -gt 0 ]; do
  case $1 in
    auto|linux|macos|windows|docker|binary) mode=$1 ;;
    --binary) shift; [ $# -gt 0 ] || die "--binary needs a path"; binary=$1 ;;
    --binary=*) binary=${1#--binary=} ;;
    --prefix) shift; [ $# -gt 0 ] || die "--prefix needs a directory"; prefix=$1 ;;
    --prefix=*) prefix=${1#--prefix=} ;;
    --ffmpeg-archive) shift; [ $# -gt 0 ] || die "--ffmpeg-archive needs a path"; ffmpeg_archive=$1 ;;
    --ffmpeg-archive=*) ffmpeg_archive=${1#--ffmpeg-archive=} ;;
    --source-parser) shift; [ $# -gt 0 ] || die "--source-parser needs a path"; source_parser=$1 ;;
    --source-parser=*) source_parser=${1#--source-parser=} ;;
    --subtitle-engine-package) shift; [ $# -gt 0 ] || die "--subtitle-engine-package needs a path"; subtitle_engine_package=$1 ;;
    --subtitle-engine-package=*) subtitle_engine_package=${1#--subtitle-engine-package=} ;;
    --server-only) server_only=1 ;;
    --uninstall) uninstall=1 ;;
    --dry-run) dry_run=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
  shift
done

detect_platform() {
  case $(uname -s) in
    Linux) echo linux ;;
    Darwin) echo macos ;;
    MINGW*|MSYS*|CYGWIN*) echo windows ;;
    *) die "unsupported platform: $(uname -s)" ;;
  esac
}
[ "$mode" = auto ] && mode=$(detect_platform)

# ---- shared steps ----------------------------------------------------------

# The binary this install ships: --binary as given; else the plurxd a release
# archive carries beside this script (the macOS archive is the script, the
# agent template and that binary); else a release build of this checkout.
# `--locked` matches the Dockerfile and the release workflow, so every install
# path builds the same stamped server.
resolve_binary() {
  if [ -z "$binary" ] && [ -f "$here/plurxd" ]; then
    binary=$here/plurxd
    say "installing the plurxd shipped beside this script"
  fi
  if [ -n "$binary" ]; then
    [ -f "$binary" ] || die "no such file: $binary"
    [ -x "$binary" ] || die "not executable: $binary"
    case $binary in /*) ;; *) binary=$PWD/$binary ;; esac
    return
  fi
  claim_for_user "${CARGO_TARGET_DIR:-$root/target}" "${CARGO_HOME:-$HOME/.cargo}/registry" "${CARGO_HOME:-$HOME/.cargo}/git"
  # Build with the toolchain rust-toolchain.toml pins. A rustup `cargo`
  # honours that file on its own, but a cargo from anywhere else (Homebrew's
  # `rust` formula, a distro package) ignores it and compiles with whatever
  # release it is. And `rustup run` alone is not enough: it starts the pinned
  # cargo without putting that toolchain first on PATH, so cargo still runs
  # the first `rustc` it finds -- Homebrew's, on a Mac that has both. So when
  # rustup is present, build with the pinned toolchain's own bin directory
  # first on PATH and its rustc named outright.
  local toolchain_file channel rustup_bin toolchain_rustc toolchain_bin path_rustc
  toolchain_file=$root/rust-toolchain.toml
  channel=
  if [ -f "$toolchain_file" ]; then
    channel=$(sed -n "s/^[[:space:]]*channel[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" "$toolchain_file" | head -n 1)
  fi
  rustup_bin=$(command -v rustup 2>/dev/null || true)
  if [ -z "$rustup_bin" ] && [ -x "${CARGO_HOME:-$HOME/.cargo}/bin/rustup" ]; then
    rustup_bin=${CARGO_HOME:-$HOME/.cargo}/bin/rustup
  fi
  if [ -n "$rustup_bin" ]; then
    [ -n "$channel" ] || die "rustup is installed but $toolchain_file names no channel, so the pinned toolchain is unknown"
    say "building plurxd (release, --locked, Rust $channel) in $root"
    if [ "$dry_run" = 1 ]; then
      say "would install Rust $channel through $rustup_bin first if it is missing"
      toolchain_bin="<bin directory of: rustup which --toolchain $channel rustc>"
    else
      # Already installed is the common case: no download, no rustup
      # self-update, and an offline reinstall keeps working.
      if ! toolchain_rustc=$(RUSTUP_AUTO_INSTALL=0 "$rustup_bin" which --toolchain "$channel" rustc 2>/dev/null); then
        run "$rustup_bin" toolchain install "$channel" --profile minimal --no-self-update
        toolchain_rustc=$(RUSTUP_AUTO_INSTALL=0 "$rustup_bin" which --toolchain "$channel" rustc) \
          || die "rustup installed Rust $channel but cannot locate its rustc"
      fi
      toolchain_bin=$(dirname -- "$toolchain_rustc")
      # Advisory only: the install is correct either way, but every other
      # cargo or make invocation on this machine still takes PATH's rustc.
      path_rustc=$(command -v rustc 2>/dev/null || true)
      case $path_rustc in
        ''|"$(dirname -- "$rustup_bin")/rustc"|"$toolchain_bin/rustc") ;;
        *) say "note: $path_rustc comes before rustup on PATH, so plain cargo and make builds use it rather than Rust $channel (Homebrew: brew uninstall rust)" ;;
      esac
    fi
    (cd "$root" && run env PATH="$toolchain_bin:$PATH" RUSTC="$toolchain_bin/rustc" cargo build --locked --release -p plurxd)
  else
    command -v cargo >/dev/null 2>&1 \
      || die "cargo is not on PATH; install the Rust toolchain from rust-toolchain.toml, or pass --binary <prebuilt plurxd>"
    say "building plurxd (release, --locked) in $root"
    (cd "$root" && run cargo build --locked --release -p plurxd)
  fi
  binary=${CARGO_TARGET_DIR:-$root/target}/release/plurxd
  [ "$dry_run" = 1 ] || [ -x "$binary" ] || die "build produced no $binary"
}

# ffmpeg/ffprobe are the runtime dependency. A missing one is installed with
# the platform's package manager rather than reported, because a service that
# starts and then cannot play anything is worse than an install that pauses
# for a download.
ensure_ffmpeg() {
  if command -v ffmpeg >/dev/null 2>&1 && command -v ffprobe >/dev/null 2>&1; then
    return
  fi
  say "ffmpeg/ffprobe not found on PATH; installing"
  case $mode in
    macos)
      command -v brew >/dev/null 2>&1 || die "no ffmpeg and no Homebrew; install ffmpeg first (https://brew.sh)"
      run brew install ffmpeg ;;
    *)
      if command -v apt-get >/dev/null 2>&1; then run_root apt-get install -y --no-install-recommends ffmpeg
      elif command -v dnf >/dev/null 2>&1; then run_root dnf install -y ffmpeg
      elif command -v pacman >/dev/null 2>&1; then run_root pacman -S --noconfirm --needed ffmpeg
      elif command -v zypper >/dev/null 2>&1; then run_root zypper install -y ffmpeg
      elif command -v apk >/dev/null 2>&1; then run_root apk add ffmpeg
      else die "no ffmpeg and no known package manager; install ffmpeg and ffprobe, then rerun"
      fi ;;
  esac
  [ "$dry_run" = 1 ] || command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg still not on PATH after install"
}

# Escape a value for the replacement side of a sed `s|…|…|`.
sed_escape() { printf '%s' "$1" | sed -e 's/[&|\\]/\\&/g'; }
# Escape a value for XML text, then for sed (a plist is XML: `&` in a path
# has to arrive as `&amp;` or launchd refuses the whole file).
plist_escape() { sed_escape "$(printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"; }

# GET a URL with whatever this host has: curl, wget, or python3.
http_get() {
  if command -v curl >/dev/null 2>&1; then curl -fsS --max-time 5 "$1"
  elif command -v wget >/dev/null 2>&1; then wget -q -T 5 -t 1 -O - "$1"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys,urllib.request; sys.stdout.write(urllib.request.urlopen(sys.argv[1], timeout=5).read().decode())' "$1"
  else
    die "no curl, wget, or python3 to probe the server with"
  fi
}

# Poll /readyz until the server answers, then print what it says it is. The
# install is not done until this passes; a timeout names the log to read.
ready_timeout=${PLURX_INSTALL_READY_TIMEOUT:-60}
wait_ready() {
  local port=$1 log=$2 tries=0 url
  url="http://127.0.0.1:$port"
  [ "$dry_run" = 1 ] && { say "would wait for $url/readyz"; return; }
  say "waiting for $url/readyz"
  while ! http_get "$url/readyz" >/dev/null 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -ge "$ready_timeout" ]; then
      die "server did not become ready within ${ready_timeout}s; read: $log"
    fi
    sleep 1
  done
  say "ready: $(http_get "$url/api/v1/server" 2>/dev/null || echo "$url answers /readyz")"
  say "open $url"
}

bin_dir() {
  if [ -n "$prefix" ]; then
    printf '%s/bin\n' "${prefix%/}"
  elif [ "$mode" = macos ] && command -v brew >/dev/null 2>&1; then
    printf '%s/bin\n' "$(brew --prefix)"
  else
    printf '%s\n' "${DESTDIR:-}/usr/local/bin"
  fi
}

install_binary_to() {
  local dir=$1
  run_for_dir "$dir" install -d "$dir"
  run_for_dir "$dir" install -m 0755 "$binary" "$dir/plurxd"
  # A browser-downloaded release archive passes its quarantine flag on to the
  # binary it unpacks, and Gatekeeper then refuses to let launchd run it --
  # the same reason the Jellyfin FFmpeg tools are cleared below.
  if [ "$mode" = macos ] && command -v xattr >/dev/null 2>&1; then
    run_for_dir "$dir" xattr -d com.apple.quarantine "$dir/plurxd" 2>/dev/null || true
  fi
  say "installed $dir/plurxd"
}

# ---- linux: systemd ----------------------------------------------------------

# The graphical eligibility probe is read-only and runs before GTK/package
# dependencies. Headless and container installs retain the daemon-only path.
linux_has_local_gui() {
  [ -f "$root/scripts/install-linux-source-runtime" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 "$root/scripts/install-linux-source-runtime" --eligible-session
}

linux_native_source_install() {
  local no_start=${1:-0}
  [ -z "$prefix" ] || die 'Linux tray installs use the native package layout; use --server-only for custom service prefixes'
  set --
  [ -z "$binary" ] || set -- "$@" --binary "$binary"
  [ "$dry_run" != 1 ] || set -- "$@" --dry-run
  [ "$no_start" != 1 ] || set -- "$@" --no-start
  python3 "$root/scripts/install-linux-source-runtime" "$@"
}

linux_install() {
  if [ "$server_only" != 1 ] && linux_has_local_gui; then
    linux_native_source_install
  else
    linux_server_only_install
  fi
}

linux_server_only_install() {
  [ "$dry_run" = 1 ] || command -v systemctl >/dev/null 2>&1 \
    || die "no systemctl on this host; use 'make install-binary' and run plurxd under your own supervisor"
  local dir unit_src unit_dst data was_active=0 was_installed=0
  [ ! -e "${DESTDIR:-}/etc/plurx/installation.json" ] || die "this installation is managed by the native controller; use plurx-control or the package manager instead of a source overwrite"
  dir=$(bin_dir)
  unit_src=$here/plurxd.service
  unit_dst=${DESTDIR:-}/etc/systemd/system/plurxd.service
  data=${DESTDIR:-}/var/lib/plurx
  resolve_binary
  ensure_ffmpeg
  case $dir in
    /home/*|/root/*) die "the unit sets ProtectHome=true, so a prefix under $dir can never start; choose --prefix /opt/plurx or /usr/local" ;;
  esac
  [ ! -f "$unit_dst" ] || was_installed=1
  if command -v systemctl >/dev/null 2>&1 && [ "$(systemctl show --property=LoadState --value plurxd.service 2>/dev/null || true)" = loaded ]; then was_installed=1; fi
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet plurxd 2>/dev/null; then
    was_active=1
    say "plurxd is running; stopping it for the upgrade"
    run_root systemctl stop plurxd
  fi
  if ! getent passwd plurx >/dev/null 2>&1; then
    run_root useradd --system --home /var/lib/plurx --shell /usr/sbin/nologin plurx
  fi
  [ -d "$data" ] || run_root install -d -m 0750 -o plurx -g plurx "$data"
  install_binary_to "$dir"
  # The unit is installed once. An existing one is the operator's — the
  # runbook tells them to uncomment SupplementaryGroups=render and set
  # ProtectHome there — so an upgrade never overwrites it.
  if [ -f "$unit_dst" ]; then
    say "keeping the existing $unit_dst (edit it by hand; the tracked copy is deploy/plurxd.service)"
  else
    run_root install -m 0644 "$unit_src" "$unit_dst"
  fi
  # The tracked unit names /usr/local/bin/plurxd. A different prefix goes in
  # a drop-in, so the base unit stays byte-identical to the tracked one.
  local dropin_dir=$unit_dst.d
  if [ "$dir" != "${DESTDIR:-}/usr/local/bin" ]; then
    local rendered
    rendered=$(mktemp "${TMPDIR:-/tmp}/plurxd-dropin.XXXXXX")
    printf '[Service]\nExecStart=\nExecStart=%s/plurxd run\n' "$dir" > "$rendered"
    run_root install -d "$dropin_dir"
    run_root install -m 0644 "$rendered" "$dropin_dir/10-prefix.conf"
    rm -f "$rendered"
  elif [ -f "$dropin_dir/10-prefix.conf" ]; then
    run_root rm -f "$dropin_dir/10-prefix.conf"
  fi
  run_root systemctl daemon-reload
  if [ "$was_active" = 1 ]; then
    run_root systemctl start plurxd
  elif [ "$was_installed" = 0 ]; then
    run_root systemctl enable --now plurxd
  else
    say "existing service stays stopped; its automatic-start policy is unchanged"
  fi
  if [ "$was_active" = 1 ] || [ "$was_installed" = 0 ]; then
    wait_ready 32400 "journalctl -u plurxd"
  fi
  [ "$dry_run" = 1 ] || systemctl status plurxd --no-pager --lines=0 || true
  say "logs: journalctl -u plurxd -f"
}

linux_uninstall() {
  # Managed source GUI installs use native packages. The legacy prefix remover
  # cannot remove their ownership record or companion safely.
  [ ! -e "${DESTDIR:-}/etc/plurx/installation.json" ] \
    && [ ! -L "${DESTDIR:-}/etc/plurx/installation.json" ] \
    || die 'native Linux package installation detected; remove plurx-desktop and plurxd with apt or dnf; no files or services changed'
  local dir unit_dst installed
  unit_dst=${DESTDIR:-}/etc/systemd/system/plurxd.service
  # The binary is wherever the unit (or its prefix drop-in) says it is, not
  # wherever this run's defaults would have put it.
  installed=$({ cat "$unit_dst.d/10-prefix.conf" "$unit_dst" 2>/dev/null || true; } | sed -n 's|^ExecStart=\(.*\)/plurxd run$|\1|p' | head -1)
  dir=${installed:-$(bin_dir)}
  run_root systemctl disable --now plurxd || true
  run_root rm -rf "$unit_dst.d"
  run_root rm -f "$unit_dst"
  run_root systemctl daemon-reload
  run_for_dir "$dir" rm -f "$dir/plurxd"
  say "removed the service and $dir/plurxd; kept /var/lib/plurx and the plurx user"
}

# ---- macos: launchd ----------------------------------------------------------
#
# A LaunchAgent in the login session, not a boot-time LaunchDaemon, because
# VideoToolbox hardware transcoding needs a GUI session. deploy/README.md
# carries the trade-off (permanent on-disk Dolby Vision conversion must stay
# Off in this mode).

macos_agent_label=com.plurx.plurxd

# The agent lives in the login user's GUI domain (`gui/<uid>`), so this half
# of the installer must run as that user. Under sudo `id -u` is 0 and the
# agent would be bootstrapped into `gui/0`, which launchd refuses ("125:
# Domain does not support specified action"); macOS sudo also keeps HOME, so
# the same run leaves root-owned files in the user's Library that every later
# run then trips over. The steps that do need root ask for it themselves.
macos_refuse_root() {
  [ "$(id -u)" != 0 ] && return 0
  die "run this as your login user, not as root or through sudo: the agent runs in that user's GUI session (launchd gui/<uid>), and the installer asks for sudo itself for the steps that need it"
}

# In a prefix the user owns (Homebrew's, on Apple Silicon), the binary and
# the engine are the user's too; a root run's copies are handed back so an
# upgrade or uninstall does not trip over them. A root-owned prefix such as
# /usr/local is left as it is: its files are written through sudo anyway.
macos_claim_prefix() {
  local dir=$1
  dir_writable "$dir" || return 0
  claim_for_user "$dir/plurxd" "$(dirname -- "$dir")/libexec/plurx"
}

# Put the agent plist $1 in place at $2: mode 0644, owned by the login user,
# through sudo only when the file or its directory is not writable.
macos_place_plist() {
  local src=$1 plist=$2
  if file_needs_root "$plist"; then
    run_root install -m 0644 -o "$(id -u)" -g "$(id -g)" "$src" "$plist"
  else
    run install -m 0644 "$src" "$plist"
  fi
}

# The media engine on macOS is Jellyfin FFmpeg 8.1.3-1, the official portable
# build: it carries the VideoToolbox, tone-mapping, AC-4 and Dolby Vision
# pieces the macOS video path is built and qualified against. Homebrew's
# ffmpeg is a different build and is never used. The release and checksums
# are the ones scripts/build-macos-video-ffmpeg pins (a test holds the two
# copies equal); a new pin is a new versioned directory beside the old one.
jellyfin_ffmpeg_version=8.1.3-1
jellyfin_ffmpeg_sha256_arm64=22445d7299742749ad2eeb9ce87963d50def0357e45b3e6c7b69987c8365dbf6
jellyfin_ffmpeg_sha256_x86_64=cb2b5c154d49a6b6bfe29fa6c16510e85dcbf60b805764121a167b093d4bb6fb
macos_ffmpeg=
macos_ffprobe=

# The release archive carries the complete engine. A checkout builds it from
# pinned source automatically; missing packaging is an install error, never a
# claim that a clean service can generate subtitles. Models stay in server data.
subtitle_engine_stage=
subtitle_engine_backup=
subtitle_engine_destination=
subtitle_engine_promoted=0
macos_prepare_subtitle_engine() {
  local dir=$1 package verifier work
  verifier=$here/verify-subtitle-engine
  package=$subtitle_engine_package
  if [ -z "$package" ] && [ -d "$here/subtitle-engine" ]; then package=$here/subtitle-engine; fi
  if [ "$dry_run" = 1 ]; then
    say "would stage and verify pinned whisper.cpp 1.9.2, then promote $dir/subtitle-engine after stopping the agent"
    return
  fi
  if [ -z "$package" ]; then
    [ -f "$root/scripts/build-subtitle-engine" ] || die 'release is missing its subtitle engine package'
    command -v cmake >/dev/null 2>&1 || die 'building the pinned subtitle engine requires cmake; use a complete release archive'
    work=$(mktemp -d "${TMPDIR:-/tmp}/plurx-subtitle-engine.XXXXXX")
    temp_files="$temp_files $work"
    package=$work/package
    python3 "$root/scripts/build-subtitle-engine" --output "$package" --jobs 2 \
      || die 'could not build the pinned subtitle engine'
  fi
  [ -f "$verifier" ] || die 'release is missing its subtitle engine verifier'
  bash "$verifier" "$package" --static-only || die 'subtitle engine package verification failed; existing installation kept'
  subtitle_engine_destination=$dir/subtitle-engine
  [ ! -L "$subtitle_engine_destination" ] || die 'refusing existing subtitle engine directory symlink'
  run_for_dir "$dir" install -d "$dir"
  subtitle_engine_stage=$(run_for_dir "$dir" mktemp -d "$dir/.subtitle-engine-stage.XXXXXX")
  run_for_dir "$dir" cp -R "$package/." "$subtitle_engine_stage/"
  # Clear browser quarantine only on the verified copy, never on caller input.
  if command -v xattr >/dev/null 2>&1; then
    run_for_dir "$dir" xattr -dr com.apple.quarantine "$subtitle_engine_stage" 2>/dev/null || true
  fi
  bash "$verifier" "$subtitle_engine_stage" || die 'staged subtitle engine failed verification; existing installation kept'
}

macos_promote_subtitle_engine() {
  local dir=$1
  [ "$dry_run" != 1 ] || return 0
  if [ -e "$subtitle_engine_destination" ]; then
    subtitle_engine_backup=$(run_for_dir "$dir" mktemp -d "$dir/.subtitle-engine-backup.XXXXXX")
    run_for_dir "$dir" rmdir "$subtitle_engine_backup"
    run_for_dir "$dir" mv "$subtitle_engine_destination" "$subtitle_engine_backup"
  fi
  # EXIT cleanup restores the complete prior directory if promotion, daemon
  # installation, or readiness fails. No mixed executable/manifest is exposed.
  subtitle_engine_promoted=1
  run_for_dir "$dir" mv "$subtitle_engine_stage" "$subtitle_engine_destination"
  subtitle_engine_stage=
  bash "$here/verify-subtitle-engine" "$subtitle_engine_destination" || die 'promoted subtitle engine failed verification'
  say 'installed pinned subtitle engine; existing models and saved choices kept'
}

macos_finish_subtitle_engine() {
  local retired=$subtitle_engine_backup
  [ "$dry_run" != 1 ] || return 0
  # Readiness commits this transaction. Failure to retire a backup must never
  # roll the working bundle back to an only partly deleted prior directory.
  subtitle_engine_backup=
  subtitle_engine_promoted=0
  [ -z "$retired" ] || run_for_dir "$(dirname -- "$subtitle_engine_destination")" rm -rf "$retired" \
    || say "could not remove prior engine backup: $retired"
}

# The directory the pinned build lives in: beside the binary's prefix, never
# on PATH, so nothing else on the Mac picks it up or replaces it.
macos_ffmpeg_dir() {
  printf '%s/libexec/plurx/jellyfin-ffmpeg-%s\n' "$(dirname -- "$1")" "$jellyfin_ffmpeg_version"
}

# The first line of `$1 -version`, read whole so no pipe can cut it short.
tool_version_line() {
  [ -x "$1" ] || return 0
  "$1" -version 2>/dev/null | sed -n 1p || true
}

# True when $1 is an ffmpeg/ffprobe that reports a Jellyfin build.
is_jellyfin_tool() {
  case $(tool_version_line "$1") in *-Jellyfin*) return 0 ;; esac
  return 1
}

# True when $1 is exactly the pinned release ("ffmpeg version 8.1.3-Jellyfin").
is_pinned_jellyfin_tool() {
  case $(tool_version_line "$1") in *" version ${jellyfin_ffmpeg_version%-*}-Jellyfin"*) return 0 ;; esac
  return 1
}

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else die "no shasum or sha256sum to verify the Jellyfin FFmpeg archive with"
  fi
}

# Install the pinned Jellyfin FFmpeg for this Mac's architecture into
# $(macos_ffmpeg_dir), unless that exact build is already there.
macos_ensure_jellyfin_ffmpeg() {
  local dir=$1 dest arch target expected name url archive work tool actual
  dest=$(macos_ffmpeg_dir "$dir")
  macos_ffmpeg=$dest/ffmpeg
  macos_ffprobe=$dest/ffprobe
  if is_pinned_jellyfin_tool "$macos_ffmpeg" && is_pinned_jellyfin_tool "$macos_ffprobe"; then
    say "Jellyfin FFmpeg $jellyfin_ffmpeg_version already in $dest"
    return
  fi
  arch=$(uname -m)
  case $arch in
    arm64) target=macarm64; expected=$jellyfin_ffmpeg_sha256_arm64 ;;
    x86_64) target=mac64; expected=$jellyfin_ffmpeg_sha256_x86_64 ;;
    *) die "no Jellyfin FFmpeg build for this Mac's architecture: $arch" ;;
  esac
  name=jellyfin-ffmpeg_${jellyfin_ffmpeg_version}_portable_${target}-gpl.tar.xz
  url=https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v$jellyfin_ffmpeg_version/$name
  if [ "$dry_run" = 1 ]; then
    say "would install Jellyfin FFmpeg $jellyfin_ffmpeg_version ($name, sha256 $expected) into $dest"
    return
  fi
  work=$(mktemp -d "${TMPDIR:-/tmp}/plurx-jellyfin-ffmpeg.XXXXXX")
  if [ -n "$ffmpeg_archive" ]; then
    [ -f "$ffmpeg_archive" ] || die "no such file: $ffmpeg_archive"
    archive=$ffmpeg_archive
  else
    say "downloading Jellyfin FFmpeg $jellyfin_ffmpeg_version for $arch"
    archive=$work/$name
    curl -fL --retry 3 --silent --show-error -o "$archive" "$url" \
      || { rm -rf "$work"; die "could not download $url (pass --ffmpeg-archive <file> to install from a copy)"; }
  fi
  actual=$(sha256_of "$archive")
  if [ "$actual" != "$expected" ]; then
    rm -rf "$work"
    die "$archive is not the pinned Jellyfin FFmpeg $jellyfin_ffmpeg_version for $arch (sha256 $actual, expected $expected)"
  fi
  mkdir -p "$work/x"
  tar -xJf "$archive" -C "$work/x" || { rm -rf "$work"; die "could not unpack $archive"; }
  for tool in ffmpeg ffprobe; do
    [ -f "$work/x/$tool" ] || { rm -rf "$work"; die "$archive has no $tool"; }
  done
  run_for_dir "$dest" install -d "$dest"
  for tool in ffmpeg ffprobe; do
    run_for_dir "$dest" install -m 0755 "$work/x/$tool" "$dest/$tool"
    # A browser-downloaded archive passes its quarantine flag on to what it
    # unpacks, and Gatekeeper then refuses to let launchd run the tool.
    if command -v xattr >/dev/null 2>&1; then xattr -d com.apple.quarantine "$dest/$tool" 2>/dev/null || true; fi
  done
  rm -rf "$work"
  is_pinned_jellyfin_tool "$macos_ffmpeg" && is_pinned_jellyfin_tool "$macos_ffprobe" \
    || die "the installed $dest/ffmpeg does not run as Jellyfin FFmpeg $jellyfin_ffmpeg_version"
  say "installed Jellyfin FFmpeg $jellyfin_ffmpeg_version into $dest"
}

# On macOS plurxd reads a source's decoder facts only through the bounded
# WebAssembly build of the pinned FFprobe, which it looks for beside the
# configured ffprobe. Without it no facts can be bound and every transcode is
# refused, so it is part of the media engine and installed with it. It is
# built by scripts/build-macos-source-parser from the same pinned Jellyfin
# source with checksum-verified inputs; a release archive ships one built the
# same way. A module built here is stamped with the builder's parser ABI and
# the builder's own digest, so a checkout whose builder changed in any way
# (ABI, pins, configure flags) rebuilds it and an unchanged one does not.
source_parser_name=plurx-source-parser.wasm
source_parser_builder=$root/scripts/build-macos-source-parser

# The parser ABI this checkout's builder produces; empty outside a checkout.
source_parser_builder_abi() {
  [ -f "$source_parser_builder" ] || return 0
  sed -n 's/^ABI_ID = "\(.*\)"$/\1/p' "$source_parser_builder"
}

# True when $1 starts with the WebAssembly magic.
is_wasm_module() {
  [ -f "$1" ] && [ "$(head -c 4 "$1" | tr -d '\000')" = asm ]
}

macos_ensure_source_parser() {
  local dir=$1 dest module stamp abi built_by= candidate work= recorded
  dest=$(macos_ffmpeg_dir "$dir")
  module=$dest/$source_parser_name
  stamp=$dest/$source_parser_name.abi
  abi=$(source_parser_builder_abi)
  if [ -n "$source_parser" ]; then
    [ -f "$source_parser" ] || die "no such file: $source_parser"
    candidate=$source_parser
  elif [ -f "$here/$source_parser_name" ]; then
    say "installing the $source_parser_name shipped beside this script"
    candidate=$here/$source_parser_name
  elif [ -z "$abi" ]; then
    die "no $source_parser_name to install: run from a checkout or a release archive, or pass --source-parser <file>"
  elif [ "$dry_run" = 1 ]; then
    say "would build $source_parser_name ($abi) with scripts/build-macos-source-parser into $dest, unless this builder's module is already there"
    return
  elif built_by="$abi $(sha256_of "$source_parser_builder")" \
      && is_wasm_module "$module" && [ "$(cat "$stamp" 2>/dev/null || true)" = "$built_by" ]; then
    say "source parser ($abi) already in $dest"
    return
  else
    work=$(mktemp -d "${TMPDIR:-/tmp}/plurx-source-parser.XXXXXX")
    temp_files="$temp_files $work"
    say "building $source_parser_name ($abi) from the pinned Jellyfin source; this takes a few minutes"
    if ! python3 "$source_parser_builder" --output "$work/parser" --jobs 4 >"$work/build.log" 2>&1; then
      tail -20 "$work/build.log" >&2 || true
      die "could not build $source_parser_name (pass --source-parser <file> to install a built one)"
    fi
    candidate=$work/parser/bin/$source_parser_name
  fi
  if [ "$dry_run" = 1 ]; then
    say "would install $candidate into $dest"
    return
  fi
  is_wasm_module "$candidate" || die "$candidate is not a WebAssembly module"
  run_for_dir "$dest" install -d "$dest"
  run_for_dir "$dest" install -m 0444 "$candidate" "$module"
  if command -v xattr >/dev/null 2>&1; then xattr -d com.apple.quarantine "$module" 2>/dev/null || true; fi
  if [ -n "$work" ]; then
    new_temp_file recorded
    printf '%s\n' "$built_by" > "$recorded"
    run_for_dir "$dest" install -m 0644 "$recorded" "$stamp"
  else
    run_for_dir "$dest" rm -f "$stamp"
  fi
  say "installed $source_parser_name into $dest"
}

# One <string> value under <key>NAME</key> in EnvironmentVariables.
plist_env_get() {
  awk -v key="<key>$2</key>" '
    index($0, key) { found = 1; next }
    found && /<string>/ { sub(/.*<string>/, ""); sub(/<\/string>.*/, ""); print; exit }
  ' "$1" | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g'
}

# An existing agent is the operator's and keeps every choice they made. The
# one thing an upgrade corrects is an engine that is not Jellyfin FFmpeg (a
# Homebrew ffmpeg an older installer wrote, a path that no longer exists):
# that is repointed at the pinned build. A Jellyfin build they chose stays.
# Edits are made to a private copy and the copy is put in place once, so the
# same path works whether or not the agent's file or directory needs root.
macos_repoint_engine() {
  local plist=$1 key value current copy changed=0
  if [ "$dry_run" = 1 ]; then
    [ -r "$plist" ] || { say "would read $plist through sudo to check its engine"; return; }
    copy=$plist
  else
    new_temp_file copy
    if [ -r "$plist" ]; then cat "$plist" > "$copy"; else sudo cat "$plist" > "$copy"; fi
  fi
  for key in PLURX_FFMPEG PLURX_FFPROBE; do
    if [ "$key" = PLURX_FFMPEG ]; then value=$macos_ffmpeg; else value=$macos_ffprobe; fi
    current=$(plist_env_get "$copy" "$key")
    [ -n "$current" ] || continue
    if is_jellyfin_tool "$current"; then continue; fi
    if [ "$dry_run" = 1 ]; then
      say "would repoint $key in $plist from $current to $value"
      continue
    fi
    if command -v plutil >/dev/null 2>&1; then
      plutil -replace "EnvironmentVariables.$key" -string "$value" "$copy" \
        || die "could not update $key in $plist"
    else
      local rewritten
      new_temp_file rewritten
      awk -v key="<key>$key</key>" -v value="$(printf '%s' "$value" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')" '
        index($0, key) { found = 1; print; next }
        found && /<string>/ { sub(/<string>.*<\/string>/, "<string>" value "</string>"); found = 0 }
        { print }
      ' "$copy" > "$rewritten" && cat "$rewritten" > "$copy"
    fi
    changed=1
    say "repointed $key from $current (not Jellyfin FFmpeg) to $value"
  done
  if [ "$changed" = 1 ]; then macos_place_plist "$copy" "$plist"; fi
}

macos_render_plist() {
  local dir=$1 out=$2 ffmpeg ffprobe
  ffmpeg=$(plist_escape "$macos_ffmpeg")
  ffprobe=$(plist_escape "$macos_ffprobe")
  local home dir_escaped
  home=$(plist_escape "$HOME"); dir_escaped=$(plist_escape "$dir")
  # The template's XML comments explain the choices to a human reading the
  # repository; the rendered agent is a machine artifact, so they are dropped
  # and the placeholder check below can be absolute.
  awk '/<!--/ { skip = 1 } !skip { print } /-->/ { skip = 0 }' "$here/$macos_agent_label.plist" \
    | sed -e "s|/Users/YOUR_USERNAME|$home|g" \
          -e "s|<string>/usr/local/bin/plurxd</string>|<string>$dir_escaped/plurxd</string>|" \
          -e "s|<string>/usr/local/bin/ffmpeg</string>|<string>$ffmpeg</string>|" \
          -e "s|<string>/usr/local/bin/ffprobe</string>|<string>$ffprobe</string>|" \
    > "$out"
  if grep -q 'YOUR_USERNAME' "$out"; then
    die "plist template still carries a placeholder after rendering: $out"
  fi
}

# A legacy daemon predates the durable controller protocol. Ask it to exit
# cleanly, then prove launchd reports no PID before native migration. Never use
# bootout while it is running: launchd can escalate that operation to SIGKILL.
macos_stop_legacy_for_native() {
  local state code target pid tries=0 plist
  macos_legacy_was_running=0
  macos_native_expect_ready=0
  target="gui/$(id -u)/$macos_agent_label"
  if state=$(launchctl print "$target" 2>/dev/null); then code=0; else code=$?; fi
  [ "$code" = 0 ] || [ "$code" = 113 ] || die 'cannot establish legacy launchd state; existing server kept'
  if [ "$code" = 113 ]; then
    if [ ! -e "$HOME/Library/Application Support/plurx/installation.json" ] \
        && [ ! -e "$HOME/Library/LaunchAgents/$macos_agent_label.plist" ]; then
      macos_native_expect_ready=1
    fi
    return 0
  fi
  pid=$(printf '%s\n' "$state" | sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\)[[:space:]]*$/\1/p')
  [ -n "$pid" ] || return 0
  macos_native_expect_ready=1
  [ ! -e "$HOME/Library/Application Support/plurx/installation.json" ] || return 0
  plist="$HOME/Library/LaunchAgents/$macos_agent_label.plist"
  python3 - "$plist" <<'VERIFY_LEGACY'
import os, pathlib, plistlib, sys
path = pathlib.Path(sys.argv[1])
if path.is_symlink() or not path.is_file() or path.stat().st_uid != os.getuid():
    sys.exit("install: cannot identify an owned legacy LaunchAgent; existing server kept")
with path.open("rb") as stream:
    value = plistlib.load(stream)
arguments = value.get("ProgramArguments", [])
if value.get("Label") != "com.plurx.plurxd" or not arguments or pathlib.Path(arguments[0]).name != "plurxd":
    sys.exit("install: unrelated legacy LaunchAgent; existing server kept")
VERIFY_LEGACY
  say "waiting for legacy plurxd ($pid) to exit cleanly before installing the tray"
  launchctl kill SIGTERM "$target" || die 'legacy daemon did not accept graceful shutdown; no force-stop attempted'
  while :; do
    if state=$(launchctl print "$target" 2>/dev/null); then code=0; else code=$?; fi
    [ "$code" = 0 ] || [ "$code" = 113 ] || die 'cannot prove legacy shutdown; no force-stop attempted'
    if [ "$code" = 113 ] || ! printf '%s\n' "$state" | grep -q '^[[:space:]]*pid = '; then break; fi
    tries=$((tries + 1))
    [ "$tries" -lt 60 ] || die 'legacy daemon did not stop within 60 seconds; no force-stop attempted'
    sleep 1
  done
  macos_legacy_was_running=1
}

macos_native_source_install() {
  local package uid app port fresh_no_start=0
  local request_no_start=${1:-0}
  macos_refuse_root
  [ -z "$prefix" ] || die "macOS tray installs use the fixed per-user runtime and ~/Applications/Plurx Server.app; use --server-only for custom service prefixes"
  command -v python3 >/dev/null 2>&1 || die 'source tray installation requires Python 3, Rust and Swift; use a complete release archive without developer tools'
  package=$root/target/macos-source-runtime-$(date +%Y%m%d%H%M%S)-$$
  set -- --output "$package"
  [ -z "$binary" ] || set -- "$@" --binary "$binary"
  [ -z "$ffmpeg_archive" ] || set -- "$@" --ffmpeg-archive "$ffmpeg_archive"
  [ -z "$source_parser" ] || set -- "$@" --source-parser "$source_parser"
  [ -z "$subtitle_engine_package" ] || set -- "$@" --subtitle-engine-package "$subtitle_engine_package"
  if [ "$dry_run" = 1 ]; then
    run python3 "$root/scripts/build-macos-source-runtime" "$@"
  else
    # Finish every build and integrity check before bootstrap can touch service
    # state. The native controller preserves stopped/running and startup policy.
    python3 "$root/scripts/build-macos-source-runtime" "$@"
  fi
  if [ "$dry_run" != 1 ]; then macos_stop_legacy_for_native; fi
  set -- bootstrap macos-source --package "$package"
  if [ "$request_no_start" = 1 ] \
      && [ ! -e "$HOME/Library/Application Support/plurx/installation.json" ] \
      && [ ! -e "$HOME/Library/LaunchAgents/$macos_agent_label.plist" ] \
      && [ "${macos_legacy_was_running:-0}" != 1 ]; then
    fresh_no_start=1
    set -- "$@" --no-start
  fi
  run "$package/control/plurx-control" "$@"
  if [ "$dry_run" != 1 ] && [ "${macos_legacy_was_running:-0}" = 1 ]; then
    # Bootstrap succeeded. A previously stopped legacy daemon stays stopped;
    # only the daemon which was running before migration is started again.
    run "$package/control/plurx-control" start
  fi
  if [ "$dry_run" != 1 ] && [ "${macos_native_expect_ready:-0}" = 1 ] && [ "$fresh_no_start" != 1 ]; then
    port=$(python3 - "$HOME/Library/Application Support/plurx/installation.json" <<'READ_PORT'
import json, sys, urllib.parse
with open(sys.argv[1]) as stream:
    record = json.load(stream)
origin = urllib.parse.urlsplit(record["browser_origin"])
print(origin.port or 80)
READ_PORT
)
    wait_ready "$port" "$HOME/Library/Logs/plurxd.log"
  fi
  uid=$(id -u)
  app="$HOME/Applications/Plurx Server.app"
  if [ "$dry_run" = 1 ]; then
    say "would open $app when the current login has a GUI session"
  elif launchctl print "gui/$uid" >/dev/null 2>&1; then
    run /usr/bin/open "$app"
  else
    say "installed $app; open it from the GUI login to show the menu bar icon"
  fi
}

macos_server_only_install() {
  local dir agents plist data uid
  dir=$(bin_dir)
  agents=$HOME/Library/LaunchAgents
  plist=$agents/$macos_agent_label.plist
  data="$HOME/Library/Application Support/plurx"
  uid=$(id -u)
  macos_refuse_root
  [ ! -e "$data/installation.json" ] || die "this installation is managed by the native controller; use the tray or plurx-control instead of a source overwrite"
  macos_was_installed=0
  macos_was_running=0
  if [ -f "$plist" ]; then
    macos_was_installed=1
    if launchctl print "gui/$uid/$macos_agent_label" 2>/dev/null | grep -q '^[[:space:]]*pid = [0-9]'; then macos_was_running=1; fi
  fi
  resolve_binary
  macos_claim_prefix "$dir"
  macos_ensure_jellyfin_ffmpeg "$dir"
  macos_ensure_source_parser "$dir"
  macos_prepare_subtitle_engine "$dir"
  # Boot a running agent out before its binary is replaced. A fresh install
  # has nothing to boot out and that is fine.
  run launchctl bootout "gui/$uid/$macos_agent_label" 2>/dev/null || true
  macos_promote_subtitle_engine "$dir"
  install_binary_to "$dir"
  claim_for_user --top "$agents"
  claim_for_user "$plist" "$data" "$HOME/Library/Logs/plurxd.log"
  [ -d "$agents" ] || run_for_dir "$agents" mkdir -p "$agents"
  run mkdir -p "$data" "$HOME/Library/Logs"
  # The plist is rendered once. An existing one is the operator's (the
  # runbook has them plutil -replace tool paths in it), so an upgrade keeps it
  # and only repoints an engine that is not Jellyfin FFmpeg.
  if [ -f "$plist" ]; then
    say "keeping the existing $plist (edit it with plutil; the template is deploy/$macos_agent_label.plist)"
    macos_repoint_engine "$plist"
  elif [ "$dry_run" = 1 ]; then
    say "would render $plist from deploy/$macos_agent_label.plist"
  else
    local rendered
    new_temp_file rendered
    macos_render_plist "$dir" "$rendered"
    if command -v plutil >/dev/null 2>&1; then plutil -lint "$rendered" >/dev/null || die "rendered plist is not valid: $rendered"; fi
    macos_place_plist "$rendered" "$plist"
    say "rendered $plist"
  fi
  if [ "$macos_was_installed" = 0 ]; then
    run launchctl bootstrap "gui/$uid" "$plist"
    run launchctl enable "gui/$uid/$macos_agent_label"
    run launchctl kickstart "gui/$uid/$macos_agent_label"
    wait_ready 32400 "$HOME/Library/Logs/plurxd.log"
  elif [ "$macos_was_running" = 1 ]; then
    run launchctl bootstrap "gui/$uid" "$plist"
    run launchctl kickstart "gui/$uid/$macos_agent_label"
    wait_ready 32400 "$HOME/Library/Logs/plurxd.log"
  else
    say "existing agent stays stopped; its login-start policy is unchanged"
  fi
  macos_finish_subtitle_engine
  [ "$dry_run" = 1 ] || launchctl print "gui/$uid/$macos_agent_label" | grep -E 'state|pid' || true
  say "logs: tail -f ~/Library/Logs/plurxd.log"
}


macos_install() {
  if [ "$server_only" = 1 ]; then
    macos_server_only_install
  else
    macos_native_source_install
  fi
}

macos_uninstall() {
  # A native runtime has different ownership and paths from the legacy prefix
  # install. Refuse before touching either tree until native removal is explicit.
  [ ! -e "$HOME/Library/Application Support/plurx/installation.json" ] \
    && [ ! -L "$HOME/Library/Application Support/plurx/installation.json" ] \
    || die 'native macOS installation detected; legacy uninstall cannot safely remove its app/runtime; no files changed'
  local dir plist uid installed
  plist=$HOME/Library/LaunchAgents/$macos_agent_label.plist
  installed=$({ sed -n 's|.*<string>\(.*\)/plurxd</string>.*|\1|p' "$plist" 2>/dev/null || true; } | head -1 | sed -e 's/&amp;/\&/g' -e 's/&lt;/</g' -e 's/&gt;/>/g')
  dir=${installed:-$(bin_dir)}
  uid=$(id -u)
  macos_refuse_root
  macos_claim_prefix "$dir"
  run launchctl bootout "gui/$uid/$macos_agent_label" 2>/dev/null || true
  run_for_file "$plist" rm -f "$plist"
  run_for_dir "$dir" rm -f "$dir/plurxd"
  run_for_dir "$dir" rm -rf "$dir/subtitle-engine"
  run_for_dir "$dir" rm -rf "$(dirname -- "$dir")/libexec/plurx"
  say "removed the agent, $dir/plurxd and its Jellyfin FFmpeg; kept ~/Library/Application Support/plurx"
}

# ---- windows: the native service, via deploy/install.ps1 ---------------------

windows_install() {
  local ps args
  if command -v pwsh >/dev/null 2>&1; then ps=pwsh
  elif command -v powershell.exe >/dev/null 2>&1; then ps=powershell.exe
  elif command -v powershell >/dev/null 2>&1; then ps=powershell
  else
    die "run deploy\\install.ps1 from an elevated PowerShell on the Windows host (no PowerShell found here)"
  fi
  set -- -NoProfile -ExecutionPolicy Bypass -File "$here/install.ps1"
  [ "$uninstall" = 1 ] && set -- "$@" -Uninstall
  [ "$dry_run" = 1 ] && set -- "$@" -DryRun
  [ -n "$binary" ] && set -- "$@" -Binary "$binary"
  [ -n "$prefix" ] && set -- "$@" -InstallDir "$prefix"
  run "$ps" "$@"
}

# ---- docker: the Compose stack ------------------------------------------------
#
# `make docker-up` is the deploy; this only makes the first run one command by
# creating the two untracked files it reads and the data directory it mounts.

# One value from a Compose .env: last assignment wins, CRLF, surrounding
# quotes and a trailing comment are dropped, as Compose itself reads it.
env_value() {
  sed -n "s/^$2=//p" "$1" | tail -1 | tr -d '\r' \
    | sed -e 's/[[:space:]]#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

# Docker remains headless. An eligible Linux login gets a separate user-owned
# host tray, scoped to this checkout's Compose project by its installer.
docker_install_host_tray() {
  [ "$server_only" != 1 ] || return 0
  [ "$(uname -s)" = Linux ] || return 0
  if [ "$dry_run" = 1 ]; then
    say 'would install the host tray after Compose is ready, only for an eligible Linux graphical login'
    return 0
  fi
  if [ "$(id -u)" = 0 ]; then
    say "the container is ready; run as your graphical login user: python3 $root/scripts/install-compose-tray --checkout $root"
    return 0
  fi
  if linux_has_local_gui; then
    python3 "$root/scripts/install-compose-tray" --checkout "$root"
  else
    say "no eligible local graphical login; to add host controls later run: python3 $root/scripts/install-compose-tray --checkout $root"
  fi
}

docker_install() {
  if [ "$dry_run" = 0 ]; then
    command -v docker >/dev/null 2>&1 || die "docker is not on PATH"
    docker compose version >/dev/null 2>&1 || die "'docker compose' is unavailable; install the Compose plugin"
  fi
  local deploy=$here env=$here/.env override=$here/docker-compose.override.yml data port
  if [ ! -f "$env" ]; then
    say "creating deploy/.env from .env.example (PUID/PGID = $(id -u)/$(id -g))"
    if [ "$dry_run" = 0 ]; then
      sed -e "s|^PUID=.*|PUID=$(id -u)|" -e "s|^PGID=.*|PGID=$(id -g)|" "$deploy/.env.example" > "$env"
    else
      printf '+ sed -e %q -e %q %q > %q\n' "s|^PUID=.*|PUID=$(id -u)|" "s|^PGID=.*|PGID=$(id -g)|" "$deploy/.env.example" "$env"
    fi
  fi
  if [ ! -f "$override" ]; then
    say "creating deploy/docker-compose.override.yml from its example — put your media mounts there; docker-up detects local Linux GPUs"
    run cp "$deploy/docker-compose.override.example.yml" "$override"
  fi
  data=/srv/plurx
  port=32400
  if [ -f "$env" ]; then
    data=$(env_value "$env" PLURX_DATA)
    port=$(env_value "$env" PLURX_HTTP_PORT)
    data=${data:-/srv/plurx}
    port=${port:-32400}
  fi
  if [ ! -d "$data" ]; then
    run_for_dir "$data" install -d -o "$(id -u)" -g "$(id -g)" "$data"
  fi
  (cd "$root" && run make docker-up)
  wait_ready "$port" "cd deploy && docker compose logs plurxd"
  docker_install_host_tray
  say "logs: cd deploy && docker compose logs -f plurxd"
}

docker_uninstall() {
  (cd "$here" && run docker compose down)
  say "stack is down; kept deploy/.env, the override file, and the data directory"
}

# ---- binary: core plus eligible desktop; fresh servers stay stopped ------------

binary_install() {
  local platform
  platform=$(detect_platform)
  if [ "$server_only" != 1 ]; then
    case "$platform" in
      macos)
        if launchctl print "gui/$(id -u)" >/dev/null 2>&1; then
          macos_native_source_install 1
          return
        fi ;;
      linux)
        if linux_has_local_gui; then
          linux_native_source_install 1
          return
        fi ;;
    esac
  fi
  say 'installing core binaries only: the tray applies to a native local GUI session'
  local dir
  dir=$(bin_dir)
  resolve_binary
  ensure_ffmpeg
  install_binary_to "$dir"
  [ "$dry_run" = 1 ] || "$dir/plurxd" --version || true
  say "run it with: plurxd run    (serves http://localhost:32400; config via ./plurx.toml or PLURX_* env)"
}

binary_uninstall() {
  local dir
  dir=$(bin_dir)
  run_for_dir "$dir" rm -f "$dir/plurxd"
  say "removed $dir/plurxd"
}

# ---- dispatch --------------------------------------------------------------------

case $mode:$uninstall in
  linux:0) linux_install ;;     linux:1) linux_uninstall ;;
  macos:0) macos_install ;;     macos:1) macos_uninstall ;;
  windows:*) windows_install ;;
  docker:0) docker_install ;;   docker:1) docker_uninstall ;;
  binary:0) binary_install ;;   binary:1) binary_uninstall ;;
esac
