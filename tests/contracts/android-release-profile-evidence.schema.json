{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paired physical Android release profile measurement",
  "type": "object",
  "required": ["schema", "identity", "iterations_per_mode", "modes", "first_frame_boundary", "inputs", "acceptance", "measured_gain_claimed"],
  "properties": {
    "schema": {"const": "plurx_release_profile_measurement_v1"},
    "iterations_per_mode": {"const": 5},
    "measured_gain_claimed": {"const": false},
    "identity": {
      "type": "object",
      "required": ["source_sha", "apk_sha256", "package", "version_code", "device_alias", "device_model", "sdk"],
      "properties": {
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "apk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package": {"const": "tv.plurx.app"},
        "version_code": {"type": "integer", "minimum": 1},
        "device_alias": {"type": "string", "minLength": 1},
        "device_model": {"type": "string", "minLength": 1},
        "sdk": {"type": "integer", "minimum": 28}
      }
    },
    "modes": {
      "type": "object", "required": ["none", "required"],
      "properties": {"none": {"$ref": "#/$defs/mode"}, "required": {"$ref": "#/$defs/mode"}}
    },
    "first_frame_boundary": {"type": "string", "minLength": 1},
    "acceptance": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "object", "required": ["path", "sha256"], "properties": {
        "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }}
    }
  },
  "$defs": {
    "samples": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}},
    "mode": {
      "type": "object", "required": ["startup_initial_display_ms", "startup_median_ms", "media3_ttff_ms", "media3_ttff_median_ms"],
      "properties": {
        "startup_initial_display_ms": {"$ref": "#/$defs/samples"}, "media3_ttff_ms": {"$ref": "#/$defs/samples"},
        "startup_median_ms": {"type": "number", "minimum": 0}, "media3_ttff_median_ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
