      "then_when_stopped": "stopped",
      "carries": [
        "position_ms"
      ]
    },
    {
      "id": "control_hold",
      "context": "attached",
      "class": "hold"
    },
    {
      "id": "media_waiting",
      "context": "attached",
      "class": "buffering"
    },
    {
      "id": "owner_recovery_step",
      "context": "any",
      "class": "recovering"
    },
    {
      "id": "readiness_deadline_rungs_left",
      "context": "any",
