#!/usr/bin/env python3
"""Entry point for the ci-fleet collector (docs/ci/CI-FLEET.md)."""
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
# Installed: /opt/ci-fleet holds cifleet/ and validation/. Checkout: the repo root holds validation/.
sys.path[:0] = [str(here), str(here.parents[1])]

from cifleet.collector import main  # noqa: E402

raise SystemExit(main())
