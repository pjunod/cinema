  "selection_method": {
    "center_identifiability": "Center is directly observed in that dataset, or its local SVD center projection residual is <= 1e-7.",
    "cross_dataset": "Both per-channel estimates must be finite and within [-0.5,65535.5]; their per-channel absolute difference must be < 0.25 code.",
    "direct": "Direct maximum interpolation weight > 0.99999; coordinates within 1e-5 of an integer are snapped before fitting.",
    "domain": "Only lattice i=1..64 and p,t=-16..16 are exported.",
    "independent_solve": "Each table coordinate must pass original and held-out probe datasets independently; only shared integer coordinates are considered.",
    "pseudoinverse": "For non-direct centers in each dataset, pseudoinverse row norm < 8 and local reconstruction residual < 0.25 native 16-bit code.",
    "quantization": "Average the two unrounded estimates, round nearest ties-to-even, then clip channels to 0..rounded target peak PQ code.",
    "supplement_priority": "Neutral original/held-out pair has priority. Each repeatable supplement pair uses the same two-solve acceptance; it fills only coordinates not already exported. Earlier accepted rows win any overlap."
  },
