# syntax=docker/dockerfile:1

# The toolchain image of the fast Rust gate (main-fast-lane.yml `rust_compile`)
# and the effort Rust compile (effort-ci.yml). Everything those jobs used to
# apt-install and download at the start of every run is baked in here once:
# the Ubuntu 24.04 build packages, the distribution's FFmpeg 6 (the lane's
# pinned FFmpeg major), Node 22.23.4 (Forgejo's checkout action needs it before
# checkout) and Rust 1.97.1 with rustfmt and clippy (rust-toolchain.toml).
#
# The lanes pin the published image by digest. To change anything here, edit
# this file, run `scripts/rust-gate-image publish`, and commit the digest it
# prints with `scripts/rust-gate-image pin <digest>`.
# docs/ci/RUST-GATE-IMAGE.md is the reference. Each job compares the
# PLURX_RUST_GATE_INPUT recorded in the image with the sha256 of this file in
# the checkout, so an edit that was not republished fails the gate at once
# with that instruction instead of silently compiling on stale tools.
FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5

ARG PLURX_RUST_GATE_INPUT
RUN test -n "$PLURX_RUST_GATE_INPUT"

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential ca-certificates clang cmake curl ffmpeg git libssl-dev lld llvm \
        libgtk-4-dev libdbus-1-dev make nasm ninja-build xz-utils pkg-config python3 \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version | sed -n '1p' | grep -Eq '^ffmpeg version (n)?6\.'

# Forgejo's checkout action runs on Node; use the patched upstream build.
RUN set -eu; \
    curl --fail --silent --show-error --location --retry 3 \
        https://nodejs.org/dist/v22.23.4/node-v22.23.4-linux-x64.tar.xz -o /tmp/node.tar.xz; \
    echo "1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce  /tmp/node.tar.xz" \
        | sha256sum --check --strict; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner; \
    rm /tmp/node.tar.xz; \
    node --version | grep -Fx 'v22.23.4'

# rustup and the pinned toolchain live outside CARGO_HOME's cache: the jobs
# point CARGO_HOME at the runner's bounded Cargo cache, and the proxies in
# /usr/local/cargo/bin find this RUSTUP_HOME regardless.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN set -eu; \
    curl --fail --silent --show-error --location --retry 3 \
        https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
        -o /tmp/rustup-init; \
    echo "20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c  /tmp/rustup-init" \
        | sha256sum --check --strict; \
    chmod 0755 /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain 1.97.1 --component rustfmt,clippy; \
    rm /tmp/rustup-init; \
    chmod -R a+rX "$RUSTUP_HOME" "$CARGO_HOME"; \
    rustc --version | grep -F 'rustc 1.97.1 '; \
    cargo clippy --version; \
    rustfmt --version

RUN mkdir -p /etc/plurx && printf '%s\n' "$PLURX_RUST_GATE_INPUT" > /etc/plurx/rust-gate-input
LABEL org.plurx.rust-gate.input=$PLURX_RUST_GATE_INPUT
