+static int vt_images_frame(AVFilterLink *inlink, AVFrame *clock)
+{
+    AVFilterContext *ctx = inlink->dst;
+    AVFilterLink *outlink = ctx->outputs[0];
+    AssContext *ass = ctx->priv;
+    ASS_Image *image;
+    AVFrame *output = NULL;
+    int changed = 0, ret;
+    int64_t time_ms;
+    if (clock->pts == AV_NOPTS_VALUE) {
+        ret = AVERROR(EINVAL);
+        goto done;
+    }
+    time_ms = subtitles_time_ms(clock->pts, inlink->time_base);
+    image = ass_render_frame(ass->renderer, ass->track, time_ms, &changed);
+    if (ass->vt_commands && time_ms < ass->vt_last_time_ms)
+        av_buffer_unref(&ass->vt_commands);
+    ass->vt_last_time_ms = time_ms;
+    if (!ass->vt_commands || changed) {
+        ret = vt_prepare_commands(ass, image, outlink->w, outlink->h);
+        if (ret < 0)
+            goto done;
+    }
+    output = av_frame_clone(clock); /* retain the VT clock without mapping any main pixels */
+    if (!output) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    av_buffer_unref(&output->opaque_ref);
+    output->opaque_ref = av_buffer_ref(ass->vt_commands);
+    if (!output->opaque_ref) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    av_frame_free(&clock);
+    return ff_filter_frame(outlink, output);
+ done:
+    av_frame_free(&output);
+    av_frame_free(&clock);
+    return ret;
+}
