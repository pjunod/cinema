+static int svt_validate(const AVBufferRef *payload, int width, int height)
+{
+    const SVTHeader *header;
+    const SVTCommand *commands;
+    size_t offset;
+    if (!payload || payload->size < sizeof(SVTHeader) || payload->size > SVT_MAX_BYTES)
+        return AVERROR(EINVAL);
+    header = (const SVTHeader *)payload->data;
+    if (header->magic != SVT_MAGIC || header->version != SVT_VERSION ||
+        header->bytes != payload->size || header->width != width || header->height != height ||
+        (header->count && (header->min_x >= header->max_x || header->min_y >= header->max_y ||
+                          header->max_x > width || header->max_y > height)) ||
+        header->count > SVT_MAX_COMMANDS ||
+        header->count > (payload->size - sizeof(SVTHeader)) / sizeof(SVTCommand))
+        return AVERROR(EINVAL);
+    commands = (const SVTCommand *)(header + 1);
+    offset = sizeof(SVTHeader) + header->count * sizeof(SVTCommand);
+    for (unsigned i = 0; i < header->count; i++) {
+        const SVTCommand *c = &commands[i];
+        if (c->x < 0 || c->y < 0 || !c->width || !c->height ||
+            c->x < header->min_x || c->y < header->min_y ||
+            c->x > header->max_x || c->y > header->max_y ||
+            c->width > header->max_x - c->x || c->height > header->max_y - c->y ||
+            c->offset != offset || c->alpha > ((0x10307u * 255u + 3u) >> 8) ||
+            c->color_y > 255 || c->color_u > 255 || c->color_v > 255 ||
+            c->height > (payload->size - offset) / c->width)
+            return AVERROR(EINVAL);
+        offset += (size_t)c->width * c->height;
+    }
+    return offset == payload->size ? 0 : AVERROR(EINVAL);
+}
