+static int svt_prepare_bitmap(OverlayVideoToolboxContext *ctx, const AVFrame *image,
+                              int width, int height) API_AVAILABLE(macos(10.11), ios(9.0))
+{
+    size_t n, bytes, offset;
+    AVBufferRef *payload;
+    AVFrame *previous;
+    if (image->format != AV_PIX_FMT_YUVA420P || image->width != width || image->height != height ||
+        image->alpha_mode == AVALPHA_MODE_PREMULTIPLIED || width <= 0 || height <= 0 ||
+        (width & 1) || (height & 1) || width > (SVT_MAX_BYTES - sizeof(SVTHeader)) / height)
+        return AVERROR(EINVAL);
+    n = (size_t)width * height;
+    if (n > (SVT_MAX_BYTES - sizeof(SVTHeader)) * 2 / 5)
+        return AVERROR(EINVAL);
+    bytes = sizeof(SVTHeader) + n * 5 / 2;
+    for (int plane = 0; plane < 4; plane++) {
+        int pw = (plane == 1 || plane == 2) ? width / 2 : width;
+        if (!image->data[plane] || image->linesize[plane] < pw)
+            return AVERROR(EINVAL);
+    }
+    if (ctx->bitmap_previous && ctx->bitmap_previous->width == width &&
+        ctx->bitmap_previous->height == height &&
+        !memcmp(ctx->bitmap_previous->data, image->data, 4 * sizeof(image->data[0])) &&
+        !memcmp(ctx->bitmap_previous->linesize, image->linesize, 4 * sizeof(image->linesize[0])))
+        return 0; /* retained plane refs prevent producer-side buffer reuse */
+    payload = av_buffer_alloc(bytes);
+    previous = av_frame_clone(image);
+    if (!payload || !previous) {
+        av_buffer_unref(&payload); av_frame_free(&previous);
+        return AVERROR(ENOMEM);
+    }
+    *(SVTHeader *)payload->data = (SVTHeader){ 0x53564231u, SVT_VERSION, bytes, 1, width, height };
+    offset = sizeof(SVTHeader);
+    for (int plane = 0; plane < 4; plane++) {
+        int pw = (plane == 1 || plane == 2) ? width / 2 : width;
+        int ph = (plane == 1 || plane == 2) ? height / 2 : height;
+        for (int y = 0; y < ph; y++) {
+            memcpy(payload->data + offset, image->data[plane] + (size_t)y * image->linesize[plane], pw);
+            offset += pw;
+        }
+    }
+    id<MTLBuffer> gpu = [ctx->mtl_device newBufferWithBytes: payload->data length: bytes options: MTLResourceStorageModeShared];
+    if (!gpu) { av_buffer_unref(&payload); av_frame_free(&previous); return AVERROR(ENOMEM); }
+    av_buffer_unref(&ctx->ass_commands);
+    ff_objc_release(&ctx->ass_buffer);
+    av_frame_free(&ctx->bitmap_previous);
+    ctx->ass_commands = payload;
+    ctx->ass_buffer = gpu;
+    ctx->bitmap_previous = previous;
+    return 0;
+}
