+static uint svt_mask(device const uchar *bytes, device const SVTCommand &command, uint2 position)
+{
+    if (position.x < uint(command.x) || position.y < uint(command.y))
+        return 0;
+    uint2 local = position - uint2(command.x, command.y);
+    if (local.x >= command.width || local.y >= command.height)
+        return 0;
+    return bytes[command.offset + local.y * command.width + local.x];
+}
+
+/* Exact ordered 8-bit FFDraw blend_pixel arithmetic, including per-layer
+ * truncation and clipped 2x2 chroma mask averaging. Main pixels stay on Metal. */
+kernel void blend_shader_ass_overlay(
+    texture2d<float, access::read> source_y [[ texture(0) ]],
+    texture2d<float, access::read> source_uv [[ texture(1) ]],
+    texture2d<float, access::write> dest_y [[ texture(3) ]],
+    texture2d<float, access::write> dest_uv [[ texture(4) ]],
+    device const uchar *bytes [[ buffer(6) ]],
+    uint2 gid [[ thread_position_in_grid ]])
+{
+    if (gid.x >= dest_uv.get_width() || gid.y >= dest_uv.get_height())
+        return;
+    device const SVTHeader &header = *(device const SVTHeader *)bytes;
+    device const SVTCommand *commands = (device const SVTCommand *)(bytes + sizeof(SVTHeader));
+    uint2 origin = gid * 2;
+    if (origin.x + 2 <= header.min_x || origin.y + 2 <= header.min_y ||
+        origin.x >= header.max_x || origin.y >= header.max_y) {
+        for (uint j = 0; j < 4; j++) {
+            uint2 loc = origin + uint2(j & 1, j >> 1);
+            if (loc.x < dest_y.get_width() && loc.y < dest_y.get_height())
+                dest_y.write(source_y.read(loc), loc);
+        }
+        dest_uv.write(source_uv.read(gid), gid);
+        return;
+    }
+    uint2 uv = uint2(round(source_uv.read(gid).rg * 255.0f));
+    uint4 y = uint4(0);
+    for (uint j = 0; j < 4; j++) {
+        uint2 loc = gid * 2 + uint2(j & 1, j >> 1);
+        if (loc.x < dest_y.get_width() && loc.y < dest_y.get_height())
+            y[j] = uint(round(source_y.read(loc).r * 255.0f));
+    }
+    for (uint i = 0; i < header.count; i++) {
+        device const SVTCommand &c = commands[i];
+        if (origin.x + 2 <= uint(c.x) || origin.y + 2 <= uint(c.y) ||
+            origin.x >= uint(c.x) + c.width || origin.y >= uint(c.y) + c.height)
+            continue;
+        uint total = 0;
+        for (uint j = 0; j < 4; j++) {
+            uint2 loc = gid * 2 + uint2(j & 1, j >> 1);
+            uint mask = svt_mask(bytes, c, loc);
+            uint alpha = mask * c.alpha;
+            y[j] = ((0x1010101u - alpha) * y[j] + alpha * c.color_y) >> 24;
+            total += mask;
+        }
+        uint alpha = (total >> 2) * c.alpha;
+        uv = ((0x1010101u - alpha) * uv + alpha * uint2(c.color_u, c.color_v)) >> 24;
+    }
+    for (uint j = 0; j < 4; j++) {
+        uint2 loc = gid * 2 + uint2(j & 1, j >> 1);
+        if (loc.x < dest_y.get_width() && loc.y < dest_y.get_height())
+            dest_y.write(float4(float(y[j]) / 255.0f, 0, 0, 1), loc);
+    }
+    dest_uv.write(float4(float2(uv) / 255.0f, 0, 1), gid);
+}
+
+static uint svt_div255(uint value) { return ((value + 128u) * 257u) >> 16; }
+
+/* PGS remains decoded/scaled as the incumbent YUVA420P secondary input. */
+kernel void blend_shader_bitmap_overlay(
+    texture2d<float, access::read> source_y [[ texture(0) ]],
+    texture2d<float, access::read> source_uv [[ texture(1) ]],
+    texture2d<float, access::write> dest_y [[ texture(3) ]],
+    texture2d<float, access::write> dest_uv [[ texture(4) ]],
+    device const uchar *bytes [[ buffer(6) ]],
+    uint2 gid [[ thread_position_in_grid ]])
+{
+    if (gid.x >= dest_uv.get_width() || gid.y >= dest_uv.get_height())
+        return;
+    device const SVTHeader &h = *(device const SVTHeader *)bytes;
+    const uint n = h.width * h.height, uvn = n / 4;
+    device const uchar *y = bytes + sizeof(SVTHeader);
+    device const uchar *u = y + n, *v = u + uvn, *a = v + uvn;
+    uint total = 0;
+    for (uint j = 0; j < 4; j++) {
+        uint2 loc = gid * 2 + uint2(j & 1, j >> 1);
+        uint pos = loc.y * h.width + loc.x;
+        uint alpha = a[pos];
+        uint main = uint(round(source_y.read(loc).r * 255.0f));
+        uint result = svt_div255(main * (255u - alpha) + uint(y[pos]) * alpha);
+        dest_y.write(float4(float(result) / 255.0f, 0, 0, 1), loc);
+        total += alpha;
+    }
+    // Match incumbent vf_overlay boundary averaging, including its last
+    // chroma row/column fallback rather than a uniform 2x2 average.
+    uint ap = gid.y * 2 * h.width + gid.x * 2;
+    uint alpha_h = gid.x + 1 < h.width / 2 ? (uint(a[ap]) + a[ap + 1]) >> 1 : a[ap];
+    uint alpha_v = gid.y + 1 < h.height / 2 ? (uint(a[ap]) + a[ap + h.width]) >> 1 : a[ap];
+    uint alpha = gid.x + 1 < h.width / 2 && gid.y + 1 < h.height / 2 ? total >> 2 : (alpha_h + alpha_v) >> 1;
+    uint pos = gid.y * (h.width / 2) + gid.x;
+    uint2 main = uint2(round(source_uv.read(gid).rg * 255.0f));
+    uint2 color = uint2(u[pos], v[pos]);
+    uint2 value = main * (255u - alpha) + color * alpha;
+    uint2 result = ((value + 128u) * 257u) >> 16;
+    dest_uv.write(float4(float2(result) / 255.0f, 0, 1), gid);
+}
