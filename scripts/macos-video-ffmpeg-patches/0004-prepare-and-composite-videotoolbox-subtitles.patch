+static int vt_image_bounds(const ASS_Image *image, int width, int height, int bounds[4])
+{
+    int64_t right = (int64_t)image->dst_x + image->w;
+    int64_t bottom = (int64_t)image->dst_y + image->h;
+    bounds[0] = FFMAX(image->dst_x, 0);
+    bounds[1] = FFMAX(image->dst_y, 0);
+    bounds[2] = FFMIN(right, width) - bounds[0];
+    bounds[3] = FFMIN(bottom, height) - bounds[1];
+    return bounds[2] > 0 && bounds[3] > 0 && (image->color & 255) != 255;
+}
+
+static int vt_prepare_commands(AssContext *ass, ASS_Image *images, int width, int height)
+{
+    ASS_Image *image;
+    size_t bytes = sizeof(SVTHeader);
+    unsigned count = 0;
+    unsigned min_x = width, min_y = height, max_x = 0, max_y = 0;
+    AVBufferRef *buffer;
+    SVTHeader *header;
+    SVTCommand *commands;
+    uint8_t *mask;
+    int bounds[4];
+    for (image = images; image; image = image->next) {
+        size_t mask_bytes;
+        if (image->w <= 0 || image->h <= 0 || !vt_image_bounds(image, width, height, bounds))
+            continue;
+        if (!image->bitmap || image->stride < image->w ||
+            bounds[2] > SVT_MAX_BYTES / bounds[3] || ++count > SVT_MAX_COMMANDS)
+            return AVERROR(EINVAL);
+        mask_bytes = (size_t)bounds[2] * bounds[3];
+        if (bytes > SVT_MAX_BYTES - sizeof(SVTCommand) ||
+            mask_bytes > SVT_MAX_BYTES - bytes - sizeof(SVTCommand))
+            return AVERROR(EINVAL);
+        bytes += sizeof(SVTCommand) + mask_bytes;
+        min_x = FFMIN(min_x, bounds[0]); min_y = FFMIN(min_y, bounds[1]);
+        max_x = FFMAX(max_x, bounds[0] + bounds[2]); max_y = FFMAX(max_y, bounds[1] + bounds[3]);
+    }
+    buffer = av_buffer_alloc(bytes);
+    if (!buffer)
+        return AVERROR(ENOMEM);
+    header = (SVTHeader *)buffer->data;
+    *header = (SVTHeader){ SVT_MAGIC, SVT_VERSION, bytes, count, width, height, min_x, min_y, max_x, max_y };
+    commands = (SVTCommand *)(header + 1);
+    mask = (uint8_t *)(commands + count);
+    count = 0;
+    for (image = images; image; image = image->next) {
+        uint8_t rgba[4];
+        FFDrawColor color;
+        SVTCommand *command;
+        if (image->w <= 0 || image->h <= 0 || !vt_image_bounds(image, width, height, bounds))
+            continue;
+        rgba[0] = image->color >> 24;
+        rgba[1] = image->color >> 16;
+        rgba[2] = image->color >> 8;
+        rgba[3] = 255 - (image->color & 255);
+        ff_draw_color(&ass->draw, &color, rgba);
+        command = &commands[count++];
+        *command = (SVTCommand){ bounds[0], bounds[1], bounds[2], bounds[3],
+                                mask - buffer->data,
+                                (0x10307u * color.rgba[3] + 3u) >> 8,
+                                color.comp[0].u8[0], color.comp[1].u8[0], color.comp[1].u8[1] };
+        for (int y = 0; y < bounds[3]; y++) {
+            memcpy(mask, image->bitmap + (size_t)(bounds[1] - image->dst_y + y) * image->stride +
+                         (bounds[0] - image->dst_x), bounds[2]);
+            mask += bounds[2];
+        }
+    }
+    av_buffer_unref(&ass->vt_commands);
+    ass->vt_commands = buffer;
+    return 0;
+}
