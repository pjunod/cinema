--- /dev/null
+++ b/libavfilter/dovi_required.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Optional renderer-boundary contract for base-layer-only Dolby processing.
+ * The decoder attaches resolved mapping/color state to the decoded frame;
+ * raw RPU presence is neither necessary nor sufficient for this contract.
+ */
+#ifndef AVFILTER_DOVI_REQUIRED_H
+#define AVFILTER_DOVI_REQUIRED_H
+#include "libavutil/dovi_meta.h"
+#include "libavutil/error.h"
+#include "libavutil/frame.h"
+
+static inline int ff_dovi_metadata_required(const AVFrameSideData *sd)
+{
+    const AVDOVIMetadata *m;
+    const AVDOVIRpuDataHeader *h;
+    if (!sd || sd->size < sizeof(AVDOVIMetadata))
+        return AVERROR_INVALIDDATA;
+    m = (const AVDOVIMetadata *)sd->data;
+#define CHECK_OFFSET(field, type) \
+    if (m->field < sizeof(*m) || m->field > sd->size || \
+        sizeof(type) > sd->size - m->field) \
+        return AVERROR_INVALIDDATA
+    CHECK_OFFSET(header_offset, AVDOVIRpuDataHeader);
+    CHECK_OFFSET(mapping_offset, AVDOVIDataMapping);
+    CHECK_OFFSET(color_offset, AVDOVIColorMetadata);
+#undef CHECK_OFFSET
+    h = av_dovi_get_header(m);
+    /* Match the CPU renderer's supported reshaping domain. */
+    if (!h->disable_residual_flag || h->vdr_rpu_profile != 0 || h->bl_bit_depth != 10)
+        return AVERROR_INVALIDDATA;
+    return 0;
+}
+#endif
