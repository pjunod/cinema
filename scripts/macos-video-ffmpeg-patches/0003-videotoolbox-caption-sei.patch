+/* SEI payload sizes count RBSP bytes, not the encoded emulation-prevention
+ * bytes. Keep the encoded cursor so insertion preserves the existing NAL. */
+static int read_sei_byte(uint8_t **data, size_t *size, unsigned *zeros)
+{
+    int byte;
+
+    if (!*size)
+        return AVERROR_INVALIDDATA;
+    byte = *(*data)++;
+    (*size)--;
+    if (*zeros == 2) {
+        if (byte == 3) {
+            if (!*size || **data > 3)
+                return AVERROR_INVALIDDATA;
+            byte = *(*data)++;
+            (*size)--;
+            *zeros = 0;
+        } else if (byte <= 2) {
+            return AVERROR_INVALIDDATA;
+        }
+    }
+    *zeros = byte == 0 ? *zeros + 1 : 0;
+    return byte;
+}
