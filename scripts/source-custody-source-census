#!/usr/bin/env python3
"""Record a Linux host census only after the witness's exact kernel ended.

A zero-open snapshot cannot confine an unknown surviving child or recall a
transferred descriptor. The root helper verifies the witness's earlier boot
in this machine's persistent journal before collecting any observations.
It never stops processes or reboots the host. Existing ordinary reader
namespace recovery is separate and unchanged.

    source-custody-source-census --custody <uuid> --source <host path>
    source-custody-source-census --custody <uuid> --source <host path> --publish

Both background job custody and foreground playback owner witnesses are
supported. The daemon verifies the exact token, ended kernel, expired lease
and unchanged unlocked anchor before typed settlement. Source pathname and
inode observations are additional diagnostics, not the owner's identity.
"""
from __future__ import annotations
import argparse, ctypes, json, os, re, stat, subprocess, sys, tempfile, time, uuid
from pathlib import Path

MODEL = "source_open_census_v1"
PROOF_DIR = Path("/run/plurx-physical-stop/source-census-v1")
GAP_SECONDS = 3


class Refused(Exception):
    pass


def require(ok, why):
    if not ok:
        raise Refused(why)


def _unescape(raw: bytes) -> str:
    # mountinfo escapes space, tab, newline and backslash as \ooo octal on bytes.
    return re.sub(rb"\\([0-7]{3})", lambda m: bytes([int(m.group(1), 8)]), raw).decode("utf-8", "surrogateescape")


def mountinfo(pid="self"):
    rows = []
    for line in Path(f"/proc/{pid}/mountinfo").read_bytes().splitlines():
        left, right = line.split(b" - ", 1)
        fields = left.split()
        fstype = right.split()[0].decode()
        rows.append({"dev": fields[2].decode(), "root": _unescape(fields[3]),
                     "point": _unescape(fields[4]), "fstype": fstype})
    return rows


def owning_mount(path: Path):
    best = None
    for row in mountinfo():
        point = row["point"].rstrip("/") or "/"
        if str(path) == point or str(path).startswith(point.rstrip("/") + "/"):
            if best is None or len(point) > len(best["point"]):
                best = row
    require(best is not None, "source has no mount")
    return best


class FileHandle(ctypes.Structure):
    _fields_ = [("handle_bytes", ctypes.c_uint), ("handle_type", ctypes.c_int),
                ("f_handle", ctypes.c_ubyte * 128)]


LIBC = ctypes.CDLL(None, use_errno=True)


def superblock_fds(path: Path):
    """O_PATH handles on the source in every superblock of its filesystem.

    The file handle names the server file itself, so mounts of the same
    filesystem through another export path or server name are found too.
    """
    handle, mount_id = FileHandle(handle_bytes=128), ctypes.c_int()
    require(LIBC.name_to_handle_at(-100, os.fsencode(path), ctypes.byref(handle),
                                   ctypes.byref(mount_id), 0) == 0,
            "source has no exportable file handle: " + os.strerror(ctypes.get_errno()))
    fstype = owning_mount(path)["fstype"]
    fds, seen = [], set()
    home = os.open(path, os.O_PATH | os.O_CLOEXEC)
    fds.append(home)
    seen.add(os.fstat(home).st_dev)
    for pid in sorted(int(p) for p in os.listdir("/proc") if p.isdigit()):
        try:
            rows = mountinfo(pid)
        except OSError:
            continue
        for row in rows:
            major, minor = map(int, row["dev"].split(":"))
            if row["fstype"] != fstype or os.makedev(major, minor) in seen:
                continue
            try:
                mount = os.open(f"/proc/{pid}/root/{row['point'].lstrip('/')}",
                                os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            except OSError:
                continue
            try:
                if os.fstat(mount).st_dev != os.makedev(major, minor):
                    continue
                fd = LIBC.open_by_handle_at(mount, ctypes.byref(handle), os.O_PATH | os.O_CLOEXEC)
                if fd >= 0:
                    st = os.fstat(fd)
                    if st.st_dev in seen:
                        os.close(fd)
                    else:
                        seen.add(st.st_dev)
                        fds.append(fd)
                # ESTALE: the file is not reachable through that superblock.
            finally:
                os.close(mount)
    return fds


def kernel_counts(fds):
    """i_readcount/i_writecount per in-core inode, read through O_PATH handles."""
    filt = " || ".join(f"ctx->fd == {fd}" for fd in fds)
    program = ("iter:task_file /ctx->task->tgid == %d && (%s)/ { printf(\"%%d %%u %%lu %%d %%d\\n\", "
               "ctx->fd, ctx->file->f_inode->i_sb->s_dev, ctx->file->f_inode->i_ino, "
               "ctx->file->f_inode->i_readcount.counter, ctx->file->f_inode->i_writecount.counter); }"
               % (os.getpid(), filt))
    out = subprocess.run(["bpftrace", "-q", "-e", program], capture_output=True, text=True, timeout=60)
    require(out.returncode == 0, "bpftrace census failed: " + out.stderr.strip()[-300:])
    rows = {}
    for line in out.stdout.split("\n"):
        parts = line.split()
        if len(parts) == 5:
            fd, sdev, ino, readers, writers = map(int, parts)
            rows[fd] = (sdev, ino, readers, writers)
    require(sorted(rows) == sorted(fds), "kernel census did not report every superblock")
    result = []
    for fd in fds:
        sdev, ino, readers, writers = rows[fd]
        st = os.fstat(fd)
        # The kernel's s_dev encoding (major << 20 | minor) differs from dev_t.
        require(st.st_ino == ino and os.major(st.st_dev) == sdev >> 20
                and os.minor(st.st_dev) == sdev & 0xFFFFF, "census handle identity changed")
        result.append({"device": st.st_dev, "inode": ino, "readers": readers, "writers": writers})
    return result


def anchor_locks(st):
    key = "%02x:%02x:%d" % (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
    return sum(1 for line in Path("/proc/locks").read_text().splitlines() if key in line.split())


def ancestry():
    pids, pid = set(), os.getpid()
    while pid > 1:
        pids.add(pid)
        pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    return pids


def path_references(name: bytes):
    mine, count = ancestry(), 0
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) in mine:
            continue
        try:
            if name in Path(f"/proc/{entry}/cmdline").read_bytes():
                count += 1
        except OSError:
            continue
    return count


def census(source: Path, anchor: Path):
    st = os.stat(source)
    fds = superblock_fds(source)
    try:
        counted = kernel_counts(fds)
    finally:
        for fd in fds:
            os.close(fd)
    observed = {
        "at_ms": int(time.time() * 1000),
        "superblocks": counted,
        "anchor_locks": anchor_locks(os.stat(anchor)),
        "silly_renames": sum(1 for n in os.listdir(source.parent) if n.startswith(".nfs")),
        "path_references": path_references(source.name.encode()),
    }
    return st, observed


def witness_owner(witnesses: Path, custody: str):
    """The poisoned witness naming `custody` and the owner the proof must carry.

    Returns (family, evidence, owner, lease_expires_ms). A job witness is
    `background-<custody id>`; a playback witness is `foreground-<owner id>`.
    """
    families = [f for f in ("background", "foreground") if (witnesses / f"{f}-{custody}.json").exists()]
    require(len(families) == 1, "no single poisoned witness names this custody")
    family = families[0]
    evidence = json.loads((witnesses / f"{family}-{custody}.json").read_text())
    require(evidence.get("version") == 2 and evidence.get("reader_model") == "daemon_mediated_v1",
            "unsupported witness")
    token = evidence["record"]["token"]
    require(evidence["record"].get("kind") == family, "witness record is another custody family")
    if family == "background":
        require(token["custody_id"] == custody and token["owner"]["kind"] == "job",
                "witness owner is not this custody's job")
        job = token["owner"]["token"]
        lease = job["lease_expires_ms"]
        owner = {"custody_id": custody, "job_id": job["job_id"], "node_id": job["node_id"],
                 "boot_id": job["boot_id"], "claim_id": job["claim_id"], "fence": job["fence"]}
    else:
        playback = token["owner"]
        require(playback["owner_id"] == custody, "witness owner is not this playback owner")
        # The witness keeps the activation-time lease; the daemon checks the
        # Store's renewed lease itself. This is only a necessary condition.
        lease = token["lease_expires_at_ms"]
        owner = {"custody_id": custody, "lifetime_id": playback["lifetime_id"],
                 "session_incarnation": playback["session_incarnation"],
                 "producer_attempt": playback["producer_attempt"],
                 "node_id": playback["node_id"], "boot_id": playback["boot_id"],
                 "fence": token["fence"]}
    return family, evidence, owner, lease


def ended_boot(witness_kernel, current_boot):
    """The witness's kernel boot, shown by this machine's own journal to have
    ended before the current boot began: no process of it survives here. The
    journal is the machine's own, so a cloned data directory on another host
    cannot claim this machine's boots."""
    try:
        require(witness_kernel.startswith("linux:"), "witness kernel is not a Linux boot")
        witness = uuid.UUID(witness_kernel[len("linux:"):]).hex
        current = uuid.UUID(current_boot).hex
        require(witness != current, "zero-open census cannot prove an unknown same-kernel reader stopped")
    except ValueError:
        require(False, "witness or current boot is not a boot UUID")
    try:
        listed = subprocess.run(["journalctl", "--list-boots", "--output=json", "--no-pager"],
                                check=True, capture_output=True, text=True).stdout
        boots = {boot["boot_id"] for boot in json.loads(listed)}
    except (OSError, subprocess.CalledProcessError, ValueError, KeyError, TypeError):
        require(False, "this machine's journal cannot list its boots (persistent journald needed)")
    # Listed and not the current boot: that kernel has ended, whatever the
    # clocks said at the time.
    require(current in boots and witness in boots and witness != current,
            "this machine's journal does not list the witness's boot as an earlier one")
    return {"kernel_instance": witness_kernel}


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--custody", required=True)
    parser.add_argument("--source", required=True, type=Path, help="the source's path on this host")
    parser.add_argument("--data-dir", default="/srv/plurx", type=Path)
    parser.add_argument("--publish", action="store_true")
    args = parser.parse_args()
    require(os.geteuid() == 0, "run as root on the owner host")
    require(str(uuid.UUID(args.custody)) == args.custody, "custody must be a canonical UUID")
    witnesses = args.data_dir / "source-custody-recovery" / "v2"
    family, evidence, owner, lease = witness_owner(witnesses, args.custody)
    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    prior_boot = ended_boot(evidence["kernel_instance"], boot)
    require(lease < time.time() * 1000, "owner lease has not expired")
    anchor = witnesses / f"{family}-{args.custody}.anchor"
    anchor_st = os.stat(anchor, follow_symlinks=False)
    # Poisoning rewrites the anchor, so its ctime differs from the witness;
    # the inode is the identity. The daemon requires this ctime unchanged.
    require(stat.S_ISREG(anchor_st.st_mode) and anchor_st.st_nlink == 1
            and anchor_st.st_dev == evidence["anchor_device"]
            and anchor_st.st_ino == evidence["anchor_inode"], "anchor is not the witness's inode")
    # The old kernel, not a reconstructed pathname, closes every possible
    # reader. A replaced source or stale .source sidecar grants no authority.
    first_st, first = census(args.source, anchor)
    time.sleep(GAP_SECONDS)
    second_st, second = census(args.source, anchor)
    require(os.stat(anchor).st_ctime_ns == anchor_st.st_ctime_ns, "anchor changed during the census")
    for a, b in zip(first["superblocks"], second["superblocks"]):
        require((a["device"], a["inode"]) == (b["device"], b["inode"]), "superblock set changed")
    require(len(first["superblocks"]) == len(second["superblocks"]), "superblock set changed")
    require((first_st.st_ino, first_st.st_size, first_st.st_mtime_ns)
            == (second_st.st_ino, second_st.st_size, second_st.st_mtime_ns), "source changed")
    proof = {
        "version": 1, "model": MODEL, "kernel_instance": f"linux:{boot}",
        "owner": owner,
        "anchor": {"device": anchor_st.st_dev, "inode": anchor_st.st_ino,
                   "ctime": [anchor_st.st_ctime_ns // 10**9, anchor_st.st_ctime_ns % 10**9]},
        "source": {"path": str(args.source), "inode": second_st.st_ino, "size": second_st.st_size,
                   "mtime": int(second_st.st_mtime)},
        "passes": [first, second],
    }
    if prior_boot is not None:
        proof["prior_boot"] = prior_boot
    quiet = all(sb["readers"] == 0 and sb["writers"] == 0 for p in proof["passes"] for sb in p["superblocks"]) \
        and all(p[k] == 0 for p in proof["passes"] for k in ("anchor_locks", "silly_renames", "path_references"))
    print(json.dumps({"quiescent": quiet, "prior_boot": prior_boot, "proof": proof}, indent=1))
    require(quiet, "source is not quiescent; nothing published")
    if args.publish:
        for directory in (PROOF_DIR.parent, PROOF_DIR):
            directory.mkdir(mode=0o755, exist_ok=True)
            st = os.stat(directory, follow_symlinks=False)
            require(stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and st.st_mode & 0o022 == 0,
                    f"{directory} is not root-owned and private to writes")
        handle, temporary = tempfile.mkstemp(dir=PROOF_DIR, prefix=".census-")
        with os.fdopen(handle, "w") as stream:
            json.dump(proof, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, PROOF_DIR / f"{args.custody}.json")
        print(f"published {PROOF_DIR / (args.custody + '.json')}")


if __name__ == "__main__":
    try:
        main()
    except Refused as refusal:
        sys.exit(f"refused: {refusal}")
