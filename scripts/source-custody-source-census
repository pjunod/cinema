#!/usr/bin/env python3
"""Census one dead owner's exact source on its Linux host; never stops anything.

Run as root on the custody's owner host. It reads the worker's poisoned v2
witness, then twice (>= 3 s apart) records the kernel's open counts for the
exact source inode on every NFS/local superblock that reaches it, plus anchor
locks, NFS silly-renames and argv references. Every open file description is
counted, including inherited, mmapped and SCM_RIGHTS in-flight descriptors.
Any nonzero or unstable observation refuses.

    source-custody-source-census --custody <uuid> --source <host path>           # check only
    source-custody-source-census --custody <uuid> --source <host path> --publish

--publish writes /run/plurx-physical-stop/source-census-v1/<uuid>.json for the
daemon, which independently re-verifies owner, lease, anchor and source before
using its ordinary settlement. Remove the proof after the custody is released.
"""
from __future__ import annotations
import argparse, ctypes, json, os, re, stat, subprocess, sys, tempfile, time, uuid
from pathlib import Path

MODEL = "source_open_census_v1"
PROOF_DIR = Path("/run/plurx-physical-stop/source-census-v1")
GAP_SECONDS = 3


class Refused(Exception):
    pass


def require(ok, why):
    if not ok:
        raise Refused(why)


def _unescape(raw: bytes) -> str:
    # mountinfo escapes space, tab, newline and backslash as \ooo octal on bytes.
    return re.sub(rb"\\([0-7]{3})", lambda m: bytes([int(m.group(1), 8)]), raw).decode("utf-8", "surrogateescape")


def mountinfo(pid="self"):
    rows = []
    for line in Path(f"/proc/{pid}/mountinfo").read_bytes().splitlines():
        left, right = line.split(b" - ", 1)
        fields = left.split()
        fstype = right.split()[0].decode()
        rows.append({"dev": fields[2].decode(), "root": _unescape(fields[3]),
                     "point": _unescape(fields[4]), "fstype": fstype})
    return rows


def owning_mount(path: Path):
    best = None
    for row in mountinfo():
        point = row["point"].rstrip("/") or "/"
        if str(path) == point or str(path).startswith(point.rstrip("/") + "/"):
            if best is None or len(point) > len(best["point"]):
                best = row
    require(best is not None, "source has no mount")
    return best


class FileHandle(ctypes.Structure):
    _fields_ = [("handle_bytes", ctypes.c_uint), ("handle_type", ctypes.c_int),
                ("f_handle", ctypes.c_ubyte * 128)]


LIBC = ctypes.CDLL(None, use_errno=True)


def superblock_fds(path: Path):
    """O_PATH handles on the source in every superblock of its filesystem.

    The file handle names the server file itself, so mounts of the same
    filesystem through another export path or server name are found too.
    """
    handle, mount_id = FileHandle(handle_bytes=128), ctypes.c_int()
    require(LIBC.name_to_handle_at(-100, os.fsencode(path), ctypes.byref(handle),
                                   ctypes.byref(mount_id), 0) == 0,
            "source has no exportable file handle: " + os.strerror(ctypes.get_errno()))
    fstype = owning_mount(path)["fstype"]
    fds, seen = [], set()
    home = os.open(path, os.O_PATH | os.O_CLOEXEC)
    fds.append(home)
    seen.add(os.fstat(home).st_dev)
    for pid in sorted(int(p) for p in os.listdir("/proc") if p.isdigit()):
        try:
            rows = mountinfo(pid)
        except OSError:
            continue
        for row in rows:
            major, minor = map(int, row["dev"].split(":"))
            if row["fstype"] != fstype or os.makedev(major, minor) in seen:
                continue
            try:
                mount = os.open(f"/proc/{pid}/root/{row['point'].lstrip('/')}",
                                os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            except OSError:
                continue
            try:
                if os.fstat(mount).st_dev != os.makedev(major, minor):
                    continue
                fd = LIBC.open_by_handle_at(mount, ctypes.byref(handle), os.O_PATH | os.O_CLOEXEC)
                if fd >= 0:
                    st = os.fstat(fd)
                    if st.st_dev in seen:
                        os.close(fd)
                    else:
                        seen.add(st.st_dev)
                        fds.append(fd)
                # ESTALE: the file is not reachable through that superblock.
            finally:
                os.close(mount)
    return fds


def kernel_counts(fds):
    """i_readcount/i_writecount per in-core inode, read through O_PATH handles."""
    filt = " || ".join(f"ctx->fd == {fd}" for fd in fds)
    program = ("iter:task_file /ctx->task->tgid == %d && (%s)/ { printf(\"%%d %%u %%lu %%d %%d\\n\", "
               "ctx->fd, ctx->file->f_inode->i_sb->s_dev, ctx->file->f_inode->i_ino, "
               "ctx->file->f_inode->i_readcount.counter, ctx->file->f_inode->i_writecount.counter); }"
               % (os.getpid(), filt))
    out = subprocess.run(["bpftrace", "-q", "-e", program], capture_output=True, text=True, timeout=60)
    require(out.returncode == 0, "bpftrace census failed: " + out.stderr.strip()[-300:])
    rows = {}
    for line in out.stdout.split("\n"):
        parts = line.split()
        if len(parts) == 5:
            fd, sdev, ino, readers, writers = map(int, parts)
            rows[fd] = (sdev, ino, readers, writers)
    require(sorted(rows) == sorted(fds), "kernel census did not report every superblock")
    result = []
    for fd in fds:
        sdev, ino, readers, writers = rows[fd]
        st = os.fstat(fd)
        # The kernel's s_dev encoding (major << 20 | minor) differs from dev_t.
        require(st.st_ino == ino and os.major(st.st_dev) == sdev >> 20
                and os.minor(st.st_dev) == sdev & 0xFFFFF, "census handle identity changed")
        result.append({"device": st.st_dev, "inode": ino, "readers": readers, "writers": writers})
    return result


def anchor_locks(st):
    key = "%02x:%02x:%d" % (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
    return sum(1 for line in Path("/proc/locks").read_text().splitlines() if key in line.split())


def ancestry():
    pids, pid = set(), os.getpid()
    while pid > 1:
        pids.add(pid)
        pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    return pids


def path_references(name: bytes):
    mine, count = ancestry(), 0
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) in mine:
            continue
        try:
            if name in Path(f"/proc/{entry}/cmdline").read_bytes():
                count += 1
        except OSError:
            continue
    return count


def daemon_pid(explicit):
    """The live daemon: the only `plurxd run` that is PID 1 of its PID namespace."""
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            argv = Path(f"/proc/{entry}/cmdline").read_bytes().split(b"\0")
            if os.path.basename(argv[0]) != b"plurxd" or argv[1:2] != [b"run"]:
                continue
            nspid = next(line.split()[1:] for line in Path(f"/proc/{entry}/status").read_text().splitlines()
                         if line.startswith("NSpid:"))
        except (OSError, StopIteration):
            continue
        if nspid[-1] == "1":
            found.append(int(entry))
    if explicit is not None:
        require(explicit in found, "--daemon-pid is not a `plurxd run` that is PID 1 of its namespace")
        return explicit
    require(len(found) == 1, "found %d `plurxd run` namespace inits; pass --daemon-pid" % len(found))
    return found[0]


# Filesystems whose files are media storage read over the network or FUSE.
NETWORK_FS = {"nfs", "nfs4", "cifs", "smb3", "9p", "ceph", "glusterfs"}
# Executables a surviving reader of the dead owner would be: FFmpeg tools and
# plurx helpers. `plurxd` itself is judged by its argv (another `run` refuses;
# the discovery `advertise` process reads no media).
MEDIA_TOOLS = ("ffmpeg", "ffprobe", "plurx-")


def storage_devices(census_devices, extra_roots):
    """Network/FUSE superblocks in every mount namespace on the host, the
    census's, and any extra library roots the operator names."""
    devices, unreadable = set(census_devices), 0
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            rows = mountinfo(entry)
        except (FileNotFoundError, ProcessLookupError):
            continue
        except OSError:
            unreadable += 1
            continue
        for row in rows:
            if row["fstype"] in NETWORK_FS or row["fstype"].startswith("fuse"):
                major, minor = map(int, row["dev"].split(":"))
                devices.add(os.makedev(major, minor))
    for root in extra_roots:
        devices.add(os.stat(root).st_dev)
    return devices, unreadable


def start_ticks(base):
    return int(Path(f"{base}/stat").read_text().rsplit(")", 1)[1].split()[19])


def teardown(daemon, census_devices, lease_expires_ms, extra_roots=()):
    """The dead owner's process tree, seen from the host.

    Processes in the live daemon's PID namespace must all be younger than the
    owner's death. No other `plurxd run` may exist anywhere on the host.
    Processes outside the namespace must hold nothing on media storage (no
    descriptor, cwd, root, executable or mapping on any network or FUSE
    superblock in any mount namespace, the census's, or a named library root)
    and must not be a media tool (ffmpeg, ffprobe, plurx*), so an idle
    survivor between opens is refused too. A process that exists but cannot
    be read is counted, never skipped.
    """
    require(os.stat("/proc/1/ns/pid").st_ino == os.stat("/proc/self/ns/pid").st_ino,
            "run the helper in the host's PID namespace")
    namespace = os.stat(f"/proc/{daemon}/ns/pid").st_ino
    devices, unreadable = storage_devices(census_devices, extra_roots)
    btime = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
                 if line.startswith("btime "))
    hz = os.sysconf("SC_CLK_TCK")
    preexisting = others = foreign = tools = 0
    holders = []

    def holds(base):
        names = [f"{base}/fd/{fd}" for fd in os.listdir(f"{base}/fd")]
        count = 0
        for name in names + [f"{base}/cwd", f"{base}/root", f"{base}/exe"]:
            try:
                if os.stat(name).st_dev in devices:
                    count += 1
                    holders.append((base, os.readlink(name)))
            except FileNotFoundError:
                continue  # closed, or no executable (kernel thread)
        for line in Path(f"{base}/maps").read_text().splitlines():
            fields = line.split()
            if len(fields) >= 6 and fields[4] != "0":
                major, minor = (int(part, 16) for part in fields[3].split(":"))
                if os.makedev(major, minor) in devices:
                    count += 1
                    holders.append((base, fields[5]))
        return count

    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        base = f"/proc/{entry}"
        try:
            argv = Path(f"{base}/cmdline").read_bytes().split(b"\0")
            if int(entry) != daemon and os.path.basename(argv[0]) == b"plurxd" and argv[1:2] == [b"run"]:
                others += 1
                holders.append((base, "another plurxd run"))
            if os.stat(f"{base}/ns/pid").st_ino == namespace:
                started = btime * 1000 + start_ticks(base) * 1000 // hz
                preexisting += started <= lease_expires_ms
                continue
            exe = os.path.basename(os.readlink(f"{base}/exe")) if os.path.exists(f"{base}/exe") else ""
            if exe.startswith(MEDIA_TOOLS):
                tools += 1
                holders.append((base, "media tool " + exe))
            # A zombie leader's live threads keep the files; read every task.
            tasks = [f"{base}/task/{tid}" for tid in os.listdir(f"{base}/task")]
            foreign += max(holds(task) for task in tasks) if tasks else holds(base)
        except (FileNotFoundError, ProcessLookupError):
            continue  # the process exited between listing and reading
        except OSError:
            unreadable += 1
            holders.append((base, "unreadable"))
    for base, what in sorted(set(holders))[:20]:
        print(f"holder {base}: {what}", file=sys.stderr)
    return {"pid_namespace": namespace, "daemon_is_namespace_init": True,
            "preexisting": preexisting, "other_daemons": others,
            "foreign_storage_holders": foreign, "foreign_media_tools": tools,
            "unreadable": unreadable, "storage_devices": sorted(devices)}


def census(source: Path, anchor: Path, daemon=None, lease_expires_ms=None, roots=()):
    st = os.stat(source)
    fds = superblock_fds(source)
    try:
        counted = kernel_counts(fds)
    finally:
        for fd in fds:
            os.close(fd)
    observed = {
        "at_ms": int(time.time() * 1000),
        "superblocks": counted,
        "anchor_locks": anchor_locks(os.stat(anchor)),
        "silly_renames": sum(1 for n in os.listdir(source.parent) if n.startswith(".nfs")),
        "path_references": path_references(source.name.encode()),
    }
    if daemon is not None:
        observed["owner_teardown"] = teardown(
            daemon, {sb["device"] for sb in counted}, lease_expires_ms, roots)
    return st, observed


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--custody", required=True)
    parser.add_argument("--source", required=True, type=Path, help="the source's path on this host")
    parser.add_argument("--data-dir", default="/srv/plurx", type=Path)
    parser.add_argument("--publish", action="store_true")
    parser.add_argument("--library-root", action="append", default=[], type=Path,
                        help="host path of a library root on local disk (network and FUSE "
                             "storage is always scanned); repeat for each")
    parser.add_argument("--daemon-pid", type=int,
                        help="host PID of the live plurxd (default: the only plurxd namespace init)")
    args = parser.parse_args()
    require(os.geteuid() == 0, "run as root on the owner host")
    require(str(uuid.UUID(args.custody)) == args.custody, "custody must be a canonical UUID")
    witnesses = args.data_dir / "source-custody-recovery" / "v2"
    evidence = json.loads((witnesses / f"background-{args.custody}.json").read_text())
    require(evidence.get("version") == 2 and evidence.get("reader_model") == "daemon_mediated_v1",
            "unsupported witness")
    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    require(evidence["kernel_instance"] == f"linux:{boot}", "witness is from another kernel boot")
    token = evidence["record"]["token"]
    require(token["custody_id"] == args.custody and token["owner"]["kind"] == "job",
            "witness owner is not this custody's job")
    job = token["owner"]["token"]
    require(job["lease_expires_ms"] < time.time() * 1000, "owner lease has not expired")
    anchor = witnesses / f"background-{args.custody}.anchor"
    anchor_st = os.stat(anchor, follow_symlinks=False)
    # Poisoning rewrites the anchor, so its ctime differs from the witness;
    # the inode is the identity. The daemon requires this ctime unchanged.
    require(stat.S_ISREG(anchor_st.st_mode) and anchor_st.st_nlink == 1
            and anchor_st.st_dev == evidence["anchor_device"]
            and anchor_st.st_ino == evidence["anchor_inode"], "anchor is not the witness's inode")
    # The inode the owner actually opened, recorded at enrollment. A replaced
    # path with matching size and mtime is not the source the owner read.
    opened = witnesses / f"background-{args.custody}.source"
    if opened.exists():
        device, inode = map(int, opened.read_text().split())
        current = os.stat(args.source)
        require((current.st_dev, current.st_ino) == (device, inode),
                "source path no longer names the inode the owner opened")
    # Teardown evidence is what the daemon needs when the owner's job row,
    # and with it the exact source binding, is gone.
    daemon = daemon_pid(args.daemon_pid)
    first_st, first = census(args.source, anchor, daemon, job["lease_expires_ms"], args.library_root)
    time.sleep(GAP_SECONDS)
    second_st, second = census(args.source, anchor, daemon, job["lease_expires_ms"], args.library_root)
    require(os.stat(anchor).st_ctime_ns == anchor_st.st_ctime_ns, "anchor changed during the census")
    for a, b in zip(first["superblocks"], second["superblocks"]):
        require((a["device"], a["inode"]) == (b["device"], b["inode"]), "superblock set changed")
    require(len(first["superblocks"]) == len(second["superblocks"]), "superblock set changed")
    require((first_st.st_ino, first_st.st_size, first_st.st_mtime_ns)
            == (second_st.st_ino, second_st.st_size, second_st.st_mtime_ns), "source changed")
    proof = {
        "version": 1, "model": MODEL, "kernel_instance": evidence["kernel_instance"],
        "owner": {"custody_id": args.custody, "job_id": job["job_id"], "node_id": job["node_id"],
                  "boot_id": job["boot_id"], "claim_id": job["claim_id"], "fence": job["fence"]},
        "anchor": {"device": anchor_st.st_dev, "inode": anchor_st.st_ino,
                   "ctime": [anchor_st.st_ctime_ns // 10**9, anchor_st.st_ctime_ns % 10**9]},
        "source": {"path": str(args.source), "inode": second_st.st_ino, "size": second_st.st_size,
                   "mtime": int(second_st.st_mtime)},
        "passes": [first, second],
    }
    quiet = all(sb["readers"] == 0 and sb["writers"] == 0 for p in proof["passes"] for sb in p["superblocks"]) \
        and all(p[k] == 0 for p in proof["passes"] for k in ("anchor_locks", "silly_renames", "path_references"))
    torn_down = all(all(p["owner_teardown"][k] == 0 for k in (
        "preexisting", "other_daemons", "foreign_storage_holders", "foreign_media_tools", "unreadable"))
        for p in proof["passes"])
    print(json.dumps({"quiescent": quiet, "owner_teardown": torn_down, "proof": proof}, indent=1))
    require(quiet, "source is not quiescent; nothing published")
    if args.publish:
        for directory in (PROOF_DIR.parent, PROOF_DIR):
            directory.mkdir(mode=0o755, exist_ok=True)
            st = os.stat(directory, follow_symlinks=False)
            require(stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and st.st_mode & 0o022 == 0,
                    f"{directory} is not root-owned and private to writes")
        handle, temporary = tempfile.mkstemp(dir=PROOF_DIR, prefix=".census-")
        with os.fdopen(handle, "w") as stream:
            json.dump(proof, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, PROOF_DIR / f"{args.custody}.json")
        print(f"published {PROOF_DIR / (args.custody + '.json')}")


if __name__ == "__main__":
    try:
        main()
    except Refused as refusal:
        sys.exit(f"refused: {refusal}")
