#!/usr/bin/env python3
"""Render the private local status page from the canonical diagnostic ledger."""
from pathlib import Path
import html
import re
import argparse
from urllib.parse import urlsplit

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--forge-origin", default="http://forge.lan:3000")
arguments = parser.parse_args()
forge = urlsplit(arguments.forge_origin)
if forge.scheme not in {"http", "https"} or not forge.hostname or forge.username or forge.password or forge.query or forge.fragment or forge.path not in {"", "/"}:
    parser.error("a fixed credential-free Forge origin is required")
forge_origin = html.escape(arguments.forge_origin.rstrip("/"), quote=True)

root = Path(__file__).resolve().parent.parent
ledger = root / "docs/features/REMOTE-DIAGNOSTICS-STATUS.md"
source = ledger.read_text()
blocks = []
table = []


def inline(value):
    value = html.escape(value)
    value = re.sub(r"`([^`]+)`", r"<code>\1</code>", value)
    value = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", value)
    return value


def flush():
    if table:
        rows = ["<tr>" + "".join("<td>" + inline(cell.strip()) + "</td>" for cell in row.strip("|").split("|")) + "</tr>" for row in table if not re.match(r"^[|:\s-]+$", row)]
        blocks.append("<div class='scroll'><table>" + "".join(rows) + "</table></div>")
        table.clear()


for line in source.splitlines():
    if line.startswith("|"):
        table.append(line)
        continue
    flush()
    if line.startswith("# "):
        blocks.append("<h1>" + inline(line[2:]) + "</h1>")
    elif line.startswith("## "):
        blocks.append("<h2>" + inline(line[3:]) + "</h2>")
    elif line:
        blocks.append("<p>" + inline(line) + "</p>")
flush()


def current_field(name):
    prefix = "| " + name + " |"
    return next((line[len(prefix):].strip().rstrip("|").strip()
                 for line in source.splitlines() if line.startswith(prefix)), "")


status = next((line.removeprefix("**Status:**").strip()
               for line in source.splitlines() if line.startswith("**Status:**")), "Status unavailable")
banner = inline(status)
for label, field in [("Owner", "Implementation owner"),
                     ("Source", "Implementation workspace/base"),
                     ("Next action", "Next action")]:
    value = current_field(field)
    if value:
        banner += "<br><strong>" + label + ":</strong> " + inline(value)
page = """<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>Cinema remote diagnostics — build status</title><style>
:root{color-scheme:dark}body{font:16px/1.5 system-ui;background:#12141a;color:#e9eaf1;max-width:1320px;margin:40px auto;padding:0 24px}h1{font-size:30px}h2{margin-top:40px}a{color:#91baff}p{max-width:1000px}table{border-collapse:collapse;width:100%;font-size:14px}td{padding:12px;border:1px solid #353a4b;vertical-align:top}tr:first-child{background:#242a39;font-weight:bold}code{background:#252a36;padding:2px 4px;border-radius:4px}.scroll{overflow:auto}.banner{padding:16px;background:#1d293b;border-left:4px solid #91baff}
</style><body><p class="banner">__CURRENT_STATUS__</p>
<p><a href="docs/features/REMOTE-DIAGNOSTICS-STATUS.md">Canonical ledger</a> · <a href="docs/features/REMOTE-DIAGNOSTICS-IMPLEMENTATION.md">Implementation contract</a> · <a href="http://forge.lan:3000/noirr/plurx/pulls/1037">Active batched PR #1037</a> · <a href="http://forge.lan:3000/noirr/plurx/pulls/1035">Closed B00 draft #1035</a></p>
""".replace("http://forge.lan:3000", forge_origin).replace("__CURRENT_STATUS__", banner) + "\n".join(blocks) + "</body></html>\n"
(root / "diagnostics-status.html").write_text(page)
print(root / "diagnostics-status.html")
