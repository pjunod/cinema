#!/usr/bin/env node
"use strict";

// Writes crates/plurxd/src/web/jsconfig.json from the shell itself.
//
// Why this exists: `scripts/web-types` runs TypeScript's checker (`tsc` in
// checkJs mode) over the web shell's plain script rows as one global-scope
// program (docs/clients/WEB-TYPE-CHECKING-AND-PLAYER-DECOMPOSITION.md §3.2).
// Its `files` list has to be exactly the rows the browser loads, or the
// checker quietly stops looking at a new file — a gate that can pass because
// it never read the code. So the list is not written by hand: it is the
// head rows then the body rows of `index.html`, in served order, read by the
// same `tests/web/shell-source.js` every other web gate uses.
//
// Left out on purpose, and declared in types/globals.d.ts instead: the UMD
// sidecars and the vendored hls.min.js. TypeScript reads a UMD file as a
// CommonJS module and hides the global it assigns.
//
// A `files` list is not a load order — `tests/web/asset-order.test.js` still
// proves the order; this only decides what the checker reads.
//
//   scripts/web-jsconfig           # rewrite jsconfig.json
//   scripts/web-jsconfig --check   # exit 1 if the committed file is stale

const fs = require("node:fs");
const path = require("node:path");
const {shellSource, WEB} = require("../tests/web/shell-source.js");

const OUT = path.join(WEB, "jsconfig.json");

// Body rows that are not ours to type: vendored, minified upstream code.
const NOT_CHECKED = Object.freeze(["hls.min.js"]);

// The checker's settings. `moduleDetection: "legacy"` is what makes a file
// with no import/export a *script* whose top-level declarations are global —
// the runtime truth of this shell. `strict` and `noImplicitAny` stay off: the
// ratchet in `scripts/web-types` (tests/web/tsc-baseline.tsv) is the
// strictness ramp, not a compiler flag that turns 600 findings on at once.
const COMPILER_OPTIONS = Object.freeze({
  allowJs: true,
  checkJs: true,
  noEmit: true,
  target: "es2022",
  lib: ["dom", "dom.iterable", "es2022"],
  moduleDetection: "legacy",
  strict: false,
  noImplicitAny: false,
  skipLibCheck: true,
  types: [],
});

function render() {
  const {rows} = shellSource();
  const files = [
    "types/globals.d.ts",
    ...rows.head,
    ...rows.body.filter((row) => !NOT_CHECKED.includes(row)),
  ];
  const doc = {
    "//": "Generated by scripts/web-jsconfig from index.html's rows. Do not edit; rerun it.",
    compilerOptions: COMPILER_OPTIONS,
    files,
  };
  return JSON.stringify(doc, null, 2) + "\n";
}

function main(argv) {
  const check = argv.includes("--check");
  const want = render();
  if (check) {
    const have = fs.existsSync(OUT) ? fs.readFileSync(OUT, "utf8") : "";
    if (have !== want) {
      console.error(`web-jsconfig: ${path.relative(process.cwd(), OUT)} is stale — `
        + "the shell's rows changed. Run scripts/web-jsconfig and commit the result.");
      return 1;
    }
    console.log(`web-jsconfig: jsconfig.json matches the shell (${JSON.parse(want).files.length} files)`);
    return 0;
  }
  fs.writeFileSync(OUT, want);
  console.log(`web-jsconfig: wrote ${path.relative(process.cwd(), OUT)}`);
  return 0;
}

module.exports = {render, NOT_CHECKED, COMPILER_OPTIONS, OUT};

if (require.main === module) process.exit(main(process.argv.slice(2)));
