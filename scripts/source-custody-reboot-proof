#!/usr/bin/env python3
"""Attest a local-journal-proven host reboot for an exact expired legacy job.

Run only as root on the actual Linux host with independently prepared root-owned
host enrollment. Check-only is the default. This never changes worker witnesses,
opens a database, signals a process, or stops/restarts a service.
"""
from __future__ import annotations
import argparse, contextlib, ctypes, errno, fcntl, hashlib, json, math, os, re, select
import stat, subprocess, sys, time, uuid
from pathlib import Path

ADMIN_UID = 0
PROC_SUPER_MAGIC = 0x9fa0
MAX_INPUT = 256 * 1024
MAX_PROOF = 4096
MAX_JOURNAL_ENTRIES = 4096
LOCAL_FILESYSTEMS = {0xef53, 0x58465342, 0x9123683e, 0x01021994, 0x794c7630}
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
PROOF_DIRECTORY = Path('/run/plurx-physical-stop/reboot-v1')
JOURNAL_ROOT = Path('/var/log/journal')

class Refused(Exception):
    pass

def require(ok,why):
    if not ok:raise Refused(why)


def read_at(fd,name,maximum=65536):
    handle=os.open(name,os.O_RDONLY|os.O_CLOEXEC|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd)
    try:
        require(stat.S_ISREG(os.fstat(handle).st_mode), 'kernel/identity input is not a regular file')
        raw=os.read(handle,maximum+1)
        require(len(raw)<=maximum,'kernel metadata exceeds bound')
        return raw
    finally:os.close(handle)


def directory_at(fd,name):
    return os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_CLOEXEC|os.O_NOFOLLOW,dir_fd=fd)


def fd_stamp(fd):
    s=os.fstat(fd)
    return (s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns)


def host_context(expected,proc):
    require(sys.platform=='linux' and os.geteuid()==0,'actual Linux host root is required')
    libc=ctypes.CDLL(None,use_errno=True);storage=ctypes.create_string_buffer(256)
    require(libc.fstatfs(proc,ctypes.byref(storage))==0,'cannot verify procfs type')
    require(ctypes.c_long.from_buffer(storage).value==PROC_SUPER_MAGIC,'process directory is not procfs')
    mountlines=read_at(proc,'self/mountinfo',1024*1024).decode().splitlines()
    mounts=[]
    for line in mountlines:
        a,b=line.split(' - ',1);left=a.split();right=b.split()
        if left[4]=='/proc':mounts.append((left,right))
    require(len(mounts)==1,'procfs mount selection is ambiguous')
    left,right=mounts[0]
    require(left[3]=='/' and right[0]=='proc','procfs is not a full namespace-root mount')
    options=set(left[5].split(','))|set(right[2].split(','))
    require(not any(v.startswith('hidepid=') and v!='hidepid=0' for v in options),'hidden-PID procfs is unsupported')
    pidns=os.stat('/proc/self/ns/pid').st_ino;userns=os.stat('/proc/self/ns/user').st_ino
    require(pidns==expected['initial_pid_namespace_inode']==os.stat('/proc/1/ns/pid').st_ino,'trusted initial host PID namespace differs')
    require(userns==expected['initial_user_namespace_inode']==os.stat('/proc/1/ns/user').st_ino,'trusted initial host user namespace differs')
    root=os.stat('/');initroot=os.stat('/proc/1/root')
    require([root.st_dev,root.st_ino]==expected['host_root_device_inode']==[initroot.st_dev,initroot.st_ino],'trusted host filesystem root differs')
    etcfd=os.open('/etc',os.O_RDONLY|os.O_DIRECTORY|os.O_CLOEXEC)
    try:machine=read_at(etcfd,'machine-id',128).strip()
    finally:os.close(etcfd)
    require(hashlib.sha256(machine).hexdigest()==expected['machine_id_sha256'],'host machine identity differs')
    boot=read_at(proc,'sys/kernel/random/boot_id',128).decode().strip()
    require(boot==expected['boot_id'],'host kernel boot differs')
    node=expected['node_id'];require(isinstance(node,str) and len(node)==36,'invalid host/node enrollment')
    datafd=os.open(expected['data_dir'],os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
    try:require(read_at(datafd,'node.id',128).decode().strip()==node,'actual persistent node identity differs')
    finally:os.close(datafd)
    fd=os.open('/proc/self/ns/pid',os.O_RDONLY|os.O_CLOEXEC)
    try:
        try:parent=fcntl.ioctl(fd,0xb702)
        except OSError as e:
            require(e.errno==errno.EPERM,'unexpected PID namespace relation failure');relation='EPERM; initial namespace established by trusted enrollment, not this errno'
        else:
            os.close(parent);raise Refused('visible parent PID namespace; not the initial host boundary')
    finally:os.close(fd)
    return {'node_id':node,'machine_id_sha256':expected['machine_id_sha256'],'boot_id':boot,'pid_namespace_inode':pidns,'user_namespace_inode':userns,'root_device_inode':[root.st_dev,root.st_ino],'proc_mount_id':int(left[0]),'namespace_relation_observation':relation}


def strict_json(raw):
    def pairs(items):
        result={}
        for key,value in items:
            require(key not in result,'duplicate JSON field')
            result[key]=value
        return result
    def invalid(value):raise Refused('non-finite JSON value')
    def finite(value):
        number = float(value)
        require(math.isfinite(number), 'non-finite JSON value')
        return number
    return json.loads(raw, object_pairs_hook=pairs, parse_constant=invalid, parse_float=finite)


def exact(value,keys,label):
    require(isinstance(value,dict) and set(value)==set(keys),'unsupported '+label+' shape')


def canonical_uuid(value):
    require(isinstance(value,str),'UUID must be text')
    parsed=uuid.UUID(value)
    require(parsed.int!=0 and str(parsed)==value,'noncanonical UUID')
    return value


def local_filesystem(fd):
    storage=ctypes.create_string_buffer(256);libc=ctypes.CDLL(None,use_errno=True)
    require(libc.fstatfs(fd,ctypes.byref(storage))==0,'cannot inspect filesystem type')
    return ctypes.c_long.from_buffer(storage).value & 0xffffffff in LOCAL_FILESYSTEMS


def admin_directory(fd):
    s=os.fstat(fd)
    require(stat.S_ISDIR(s.st_mode) and s.st_uid==ADMIN_UID and s.st_mode&0o022==0,
            'administrator input directory is writable by a worker')


@contextlib.contextmanager
def walk_directory(path,administrator=False):
    path=Path(path)
    require(path.is_absolute() and '..' not in path.parts,'an absolute nontraversing directory is required')
    fd=os.open('/',DIRECTORY_FLAGS)
    try:
        if administrator:admin_directory(fd)
        for part in path.parts[1:]:
            nextfd=directory_at(fd,part)
            os.close(fd);fd=nextfd
            if administrator:admin_directory(fd)
        yield fd
    finally:os.close(fd)


class PinnedInput:
    def __init__(self,parent,name,administrator=False,private_owner=None):
        self.parent=parent;self.name=name;self.fd=-1
        self.fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC,dir_fd=parent)
        try:
            s=os.fstat(self.fd)
            require(stat.S_ISREG(s.st_mode) and s.st_nlink==1 and 0<s.st_size<=MAX_INPUT,
                    'input is not a bounded single-link regular file')
            if administrator:
                require(s.st_uid==ADMIN_UID and s.st_mode&0o022==0,'input is not protected by host root')
            if private_owner is not None:
                require(s.st_uid==private_owner and stat.S_IMODE(s.st_mode)==0o600,
                        'activation is not private to the data owner')
            self.stamp=fd_stamp(self.fd);self.raw=os.read(self.fd,MAX_INPUT+1)
            require(len(self.raw)==s.st_size,'input changed during its read')
            self.verify()
        except BaseException:
            os.close(self.fd);self.fd=-1;raise
    def verify(self):
        require(fd_stamp(self.fd)==self.stamp,'pinned input changed')
        s=os.stat(self.name,dir_fd=self.parent,follow_symlinks=False)
        require(stat.S_ISREG(s.st_mode) and s.st_nlink==1 and (s.st_dev,s.st_ino)==self.stamp[:2],
                'input pathname was substituted')
    def close(self):
        if self.fd>=0:os.close(self.fd);self.fd=-1


@contextlib.contextmanager
def admin_input(path):
    path=Path(path)
    with walk_directory(path.parent,True) as directory:
        value=PinnedInput(directory,path.name,administrator=True)
        try:yield value
        finally:value.close()




def enrollment_value(raw):
    value = strict_json(raw)
    exact(value, {'version', 'node_id', 'data_dir', 'machine_id_sha256', 'boot_id',
                  'initial_pid_namespace_inode', 'initial_user_namespace_inode',
                  'host_root_device_inode'}, 'host enrollment')
    require(type(value['version']) is int and value['version'] == 1, 'unsupported enrollment version')
    canonical_uuid(value['node_id']); canonical_uuid(value['boot_id'])
    require(isinstance(value['data_dir'], str) and Path(value['data_dir']).is_absolute()
            and '..' not in Path(value['data_dir']).parts, 'invalid enrolled data directory')
    require(isinstance(value['machine_id_sha256'], str)
            and re.fullmatch('[0-9a-f]{64}', value['machine_id_sha256']), 'invalid machine hash')
    for key in ('initial_pid_namespace_inode', 'initial_user_namespace_inode'):
        require(type(value[key]) is int and value[key] > 0, 'invalid initial namespace inode')
    root = value['host_root_device_inode']
    require(isinstance(root, list) and len(root) == 2
            and all(type(n) is int and n > 0 for n in root), 'invalid host root identity')
    return value


def actual_host(expected):
    require(sys.platform == 'linux' and os.getuid() == os.geteuid() == 0,
            'actual Linux host root is required')
    with walk_directory('/proc') as proc:
        context = host_context(expected, proc)
    with walk_directory('/etc') as etc:
        machine = read_at(etc, 'machine-id', 128).decode('ascii').strip()
    require(re.fullmatch('[0-9a-f]{32}', machine), 'invalid actual host machine ID')
    require(hashlib.sha256(machine.encode()).hexdigest() == expected['machine_id_sha256'],
            'host machine identity changed')
    return machine, canonical_uuid(context['boot_id'])


def trusted_data_ancestors(data_dir, data, owner):
    with walk_directory('/') as root:
        fd = os.dup(root)
        try:
            for part in Path(data_dir).parts[1:]:
                nxt = directory_at(fd, part); os.close(fd); fd = nxt
                s = os.fstat(fd)
                require(s.st_uid in {0, owner} and s.st_mode & 0o022 == 0,
                        'data ancestor is writable by an untrusted user')
            require(fd_stamp(fd)[:2] == fd_stamp(data)[:2], 'data directory changed')
        finally:
            os.close(fd)


@contextlib.contextmanager
def private_inputs(data_dir, custody):
    # Every component is opened without symlink traversal. Recovery directories
    # and records stay private to the selected data owner, as the daemon requires.
    with walk_directory(data_dir) as data, contextlib.ExitStack() as stack:
        owner = os.fstat(data).st_uid
        trusted_data_ancestors(data_dir, data, owner)
        base = directory_at(data, 'source-custody-recovery'); stack.callback(os.close, base)
        v1 = directory_at(base, 'v1'); stack.callback(os.close, v1)
        v2 = directory_at(base, 'v2'); stack.callback(os.close, v2)
        for fd in (base, v1, v2):
            s = os.fstat(fd)
            require(s.st_uid == owner and stat.S_IMODE(s.st_mode) == 0o700,
                    'recovery ancestor is not private to the data owner')
        name = 'background-' + custody
        values = []
        for fd, suffix in ((v2, '.json'), (v1, '.json'), (v2, '.armed')):
            item = PinnedInput(fd, name + suffix, private_owner=owner)
            stack.callback(item.close); values.append(item)
        yield values
        for item in values:
            item.verify()


def validate_witnesses(witness_raw, legacy_raw, armed_raw, node, custody, current_boot, at_ms):
    canonical_uuid(node); canonical_uuid(custody); canonical_uuid(current_boot)
    require(type(at_ms) is int and 0 < at_ms <= 2**63 - 1, 'invalid observation timestamp')
    witness = strict_json(witness_raw); legacy = strict_json(legacy_raw)
    required = {'version', 'reader_model', 'kernel_instance', 'activation_id', 'node_id',
                'anchor_nonce', 'anchor_device', 'anchor_inode', 'record'}
    require(isinstance(witness, dict) and required <= set(witness)
            and set(witness) <= required | {'anchor_ctime', 'daemon_namespace'}, 'unsupported v2 witness shape')
    require(type(witness['version']) is int and witness['version'] == 2
            and witness['reader_model'] == 'daemon_mediated_v1' and witness['node_id'] == node,
            'wrong witness version, reader model or node')
    activation = canonical_uuid(witness['activation_id']); canonical_uuid(witness['anchor_nonce'])
    require(armed_raw == activation.encode(), 'missing or incorrect armed activation marker')
    for key in ('anchor_device', 'anchor_inode'):
        require(type(witness[key]) is int and 0 < witness[key] <= 2**64 - 1, 'invalid anchor identity')
    ctime = witness.get('anchor_ctime')
    require(ctime is None or (isinstance(ctime, list) and len(ctime) == 2
            and all(type(n) is int for n in ctime) and 0 <= ctime[0] <= 2**63 - 1
            and 0 <= ctime[1] < 10**9), 'invalid anchor ctime')
    namespace = witness.get('daemon_namespace')
    if namespace is not None:
        exact(namespace, {'pid_namespace', 'init'}, 'daemon namespace')
        require(type(namespace['pid_namespace']) is int and 0 < namespace['pid_namespace'] <= 2**64 - 1
                and type(namespace['init']) is bool, 'invalid daemon namespace')
    kernel = witness['kernel_instance']
    require(isinstance(kernel, str) and kernel.startswith('linux:'), 'not a Linux witness')
    previous = canonical_uuid(kernel[6:])
    require(previous != current_boot, 'witness belongs to the current kernel boot')
    exact(legacy, {'version', 'machine_id', 'boot_id', 'node_id', 'records'}, 'legacy witness')
    require(type(legacy['version']) is int and legacy['version'] == 1
            and legacy['node_id'] == node and legacy['machine_id'] == legacy['boot_id'] == '',
            'legacy witness must have the enrolled node and empty v1 identity')
    require(isinstance(legacy['records'], list) and len(legacy['records']) == 1
            and json.dumps(legacy['records'][0], sort_keys=True, separators=(',', ':'))
                == json.dumps(witness['record'], sort_keys=True, separators=(',', ':')),
            'v1 and v2 must name exactly the same record')
    record = witness['record']; exact(record, {'kind', 'token'}, 'record')
    require(record['kind'] == 'background', 'only background records are supported')
    token = record['token']; exact(token, {'custody_id', 'owner'}, 'custody token')
    require(token['custody_id'] == custody, 'wrong custody token')
    owner = token['owner']; exact(owner, {'kind', 'token'}, 'background owner')
    require(owner['kind'] == 'job', 'only job owners are supported')
    job = owner['token']
    exact(job, {'job_id', 'node_id', 'boot_id', 'claim_id', 'fence', 'revision', 'lease_expires_ms'}, 'job token')
    for key in ('job_id', 'node_id', 'boot_id', 'claim_id'):
        canonical_uuid(job[key])
    require(job['node_id'] == node, 'job owner belongs to a different node')
    for key in ('fence', 'revision', 'lease_expires_ms'):
        require(type(job[key]) is int and 0 < job[key] <= 2**63 - 1, 'invalid job token integer')
    require(job['lease_expires_ms'] <= at_ms, 'original job lease is still live')
    return activation, previous


def journal_entry(raw, machine, previous, at_ms):
    lines = raw.splitlines()
    require(len(lines) == 1 and len(raw) <= MAX_PROOF, 'missing or ambiguous prior boot journal entry')
    entry = strict_json(lines[0])
    required = {'_BOOT_ID', '_MACHINE_ID', '__REALTIME_TIMESTAMP'}
    require(isinstance(entry, dict) and required <= set(entry)
            and set(entry) <= required | {'__CURSOR', '__MONOTONIC_TIMESTAMP', '__SEQNUM', '__SEQNUM_ID'},
            'unsupported prior boot journal entry shape')
    for key in set(entry) - required:
        require(isinstance(entry[key], str) and 0 < len(entry[key]) <= 1024, 'invalid journal metadata')
    require(entry['_BOOT_ID'] == uuid.UUID(previous).hex and entry['_MACHINE_ID'] == machine,
            'journal entry belongs to a different host or boot')
    stamp = entry['__REALTIME_TIMESTAMP']
    require(isinstance(stamp, str) and re.fullmatch('[0-9]{1,20}', stamp), 'invalid journal timestamp')
    milliseconds = int(stamp) // 1000
    require(0 < milliseconds <= at_ms, 'prior boot journal timestamp is not sane')
    return milliseconds


def bounded_journalctl(directory, machine, previous):
    # No user-controlled binary, options, filters or journal path. The open
    # directory is passed by fd so renaming an ancestor cannot redirect the read.
    command = ['/usr/bin/journalctl', '--directory=/proc/self/fd/' + str(directory),
               '--no-pager', '--quiet', '-n', '1', '-o', 'json',
               '--output-fields=_BOOT_ID,_MACHINE_ID,__REALTIME_TIMESTAMP',
               '_BOOT_ID=' + uuid.UUID(previous).hex, '_MACHINE_ID=' + machine]
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               pass_fds=(directory,), env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'})
    try:
        deadline = time.monotonic() + 10
        output = bytearray()
        while True:
            remaining = deadline - time.monotonic()
            require(remaining > 0, 'journal query timed out')
            ready, _, _ = select.select([process.stdout], [], [], remaining)
            require(bool(ready), 'journal query timed out')
            chunk = os.read(process.stdout.fileno(), MAX_PROOF + 1 - len(output))
            if not chunk:
                break
            output.extend(chunk)
            require(len(output) <= MAX_PROOF, 'journal query exceeds output bound')
        require(process.wait(timeout=max(0.001, deadline - time.monotonic())) == 0,
                'journal query failed')
        return bytes(output)
    finally:
        if process.poll() is None:
            process.kill(); process.wait()
        process.stdout.close()


def journal_ancestor(fd, allow_group_write=False):
    s = os.fstat(fd)
    forbidden = 0o002 if allow_group_write else 0o022
    require(stat.S_ISDIR(s.st_mode) and s.st_uid == ADMIN_UID and s.st_mode & forbidden == 0,
            'journal traversal ancestor is untrusted')


@contextlib.contextmanager
def journal_directory(machine):
    # A standard root:syslog 0775 /var/log is only a traversal ancestor.
    # Pin every component without symlinks; root ownership remains mandatory.
    # The journal root and machine child retain strict administrator protection,
    # so a renamed parent cannot redirect the pinned journalctl directory fd.
    path = JOURNAL_ROOT.parent
    require(path.is_absolute() and '..' not in path.parts, 'invalid fixed journal layout')
    fd = os.open('/', DIRECTORY_FLAGS)
    try:
        journal_ancestor(fd)
        current = Path('/')
        for part in path.parts[1:]:
            current = current / part
            nxt = directory_at(fd, part); os.close(fd); fd = nxt
            journal_ancestor(fd, allow_group_write=current == path)
        with contextlib.ExitStack() as stack:
            root = directory_at(fd, JOURNAL_ROOT.name); stack.callback(os.close, root)
            admin_directory(root)
            require(local_filesystem(root), 'persistent journal root is not local')
            directory = directory_at(root, machine); stack.callback(os.close, directory)
            admin_directory(directory)
            require(local_filesystem(directory), 'persistent journal is not local')
            yield directory
    finally:
        os.close(fd)


def prior_boot_entry(machine, previous, at_ms):
    require(re.fullmatch('[0-9a-f]{32}', machine), 'invalid machine journal directory')
    canonical_uuid(previous)
    with journal_directory(machine) as directory:
        inventory = []
        with os.scandir(directory) as entries:
            for entry in entries:
                require(len(inventory) < MAX_JOURNAL_ENTRIES, 'journal directory exceeds inventory bound')
                s = entry.stat(follow_symlinks=False)
                require(stat.S_ISREG(s.st_mode) and s.st_uid == ADMIN_UID and s.st_nlink == 1
                        and s.st_mode & 0o022 == 0, 'journal contains an untrusted file')
                inventory.append((entry.name, s.st_dev, s.st_ino, s.st_mode, s.st_uid))
        require(bool(inventory), 'persistent host journal is empty')
        raw = bounded_journalctl(directory, machine, previous)
        for name, device, inode, mode, owner in inventory:
            s = os.stat(name, dir_fd=directory, follow_symlinks=False)
            require((s.st_dev, s.st_ino, s.st_mode, s.st_uid) == (device, inode, mode, owner)
                    and s.st_nlink == 1, 'journal identity changed during query')
        return journal_entry(raw, machine, previous, at_ms)


def publish_at(directory, custody, raw):
    canonical_uuid(custody)
    admin_directory(directory)
    require(local_filesystem(directory), 'proof must live on a local filesystem')
    require(0 < len(raw) <= MAX_PROOF, 'proof exceeds consumer bound')
    name = custody + '.json'
    try:
        existing = PinnedInput(directory, name, administrator=True)
    except FileNotFoundError:
        existing = None
    if existing is not None:
        try:
            require(existing.raw == raw, 'a different proof exists; nothing overwritten')
            require(stat.S_IMODE(os.fstat(existing.fd).st_mode) == 0o644, 'incorrect proof permissions')
            existing.verify()
        finally:
            existing.close()
        os.fsync(directory); return
    temporary = '.' + str(uuid.uuid4()) + '.tmp'
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o644, dir_fd=directory)
    try:
        with os.fdopen(fd, 'wb') as stream:
            os.fchmod(stream.fileno(), 0o644)
            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
        os.link(temporary, name, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
        os.unlink(temporary, dir_fd=directory); os.fsync(directory)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def publish_fixed(custody, raw):
    with walk_directory(PROOF_DIRECTORY.parent.parent, True) as run, contextlib.ExitStack() as stack:
        require(local_filesystem(run), 'proof parent is not local')
        directory = run
        for name in ('plurx-physical-stop', 'reboot-v1'):
            try:
                os.mkdir(name, 0o755, dir_fd=directory); os.fsync(directory)
            except FileExistsError:
                pass
            directory = directory_at(directory, name); stack.callback(os.close, directory)
            admin_directory(directory)
            require(stat.S_IMODE(os.fstat(directory).st_mode) == 0o755, 'incorrect proof directory permissions')
        publish_at(directory, custody, raw)


def verify(enrollment_path, custody, publish=False):
    require(sys.platform == 'linux' and os.getuid() == os.geteuid() == 0,
            'actual Linux host root is required')
    canonical_uuid(custody)
    with admin_input(enrollment_path) as enrollment:
        expected = enrollment_value(enrollment.raw)
        machine, current = actual_host(expected)
        with private_inputs(expected['data_dir'], custody) as (witness, legacy, armed):
            at_ms = time.time_ns() // 1_000_000
            activation, previous = validate_witnesses(witness.raw, legacy.raw, armed.raw,
                expected['node_id'], custody, current, at_ms)
            entry_ms = prior_boot_entry(machine, previous, at_ms)
            require(actual_host(expected) == (machine, current), 'actual host changed')
            enrollment.verify(); witness.verify(); legacy.verify(); armed.verify()
            proof = {'version': 1, 'model': 'host_journal_reboot_v1', 'node_id': expected['node_id'],
                     'custody_id': custody, 'activation_id': activation, 'machine_id': machine,
                     'previous_boot_id': previous, 'current_boot_id': current,
                     'witness_sha256': hashlib.sha256(witness.raw).hexdigest(),
                     'legacy_sha256': hashlib.sha256(legacy.raw).hexdigest(), 'at_ms': at_ms,
                     'previous_boot_entry_ms': entry_ms}
            raw = (json.dumps(proof, sort_keys=True, separators=(',', ':')) + '\n').encode()
            require(len(raw) <= MAX_PROOF, 'proof exceeds consumer bound')
            if publish:
                publish_fixed(custody, raw)
            return proof


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host-enrollment', type=Path, required=True,
                        help='Independently prepared root-owned actual-host enrollment JSON')
    parser.add_argument('--custody', required=True, help='Canonical background custody UUID')
    parser.add_argument('--publish', action='store_true', help='Publish proof in fixed /run namespace')
    args = parser.parse_args(argv)
    try:
        print(json.dumps(verify(args.host_enrollment, args.custody, args.publish),
                         sort_keys=True, separators=(',', ':')))
        return 0
    except (Refused, OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError, RecursionError) as error:
        print('source-custody-reboot-proof: refused: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
