#!/usr/bin/env python3
"""Explicitly publish and pin Cinema's independently built media runtime."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import urllib.error
import urllib.parse
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
PIN = re.compile(
    r"(?m)^(FROM \$\{PLURX_MEDIA_RUNTIME_REPOSITORY\}@)"
    r"(sha256:[0-9a-f]{64})( AS runtime-assets)$"
)
DIGEST_ARG = re.compile(r'(?m)^ARG PLURX_MEDIA_RUNTIME_DIGEST="(sha256:[0-9a-f]{64})"$')
# The DV helper build dependencies are a second published image in the same
# repository. Its pin travels with the identity of the files it was built from.
DV_PIN = re.compile(
    r"(?m)^(FROM \$\{PLURX_MEDIA_RUNTIME_REPOSITORY\}@)"
    r"(sha256:[0-9a-f]{64})( AS dv-processing-dependencies)$"
)
DV_INPUTS_ARG = re.compile(r'(?m)^ARG PLURX_DV_DEPENDENCY_INPUTS="(sha256:[0-9a-f]{64})"$')
UNPUBLISHED = "sha256:" + "0" * 64
DV_DEPENDENCY_INPUTS = (
    ("tools/dv_processing", ("build-dependencies.sh", "build-requirements.txt", "fetch_renderer_sources.py", "*.patch")),
    ("tools/dv_quality/backends", ("parsed-rpu/fetch_parser.py", "parsed-rpu/resolved-Cargo.lock")),
)
IMAGE = re.compile(
    r"[A-Za-z0-9][A-Za-z0-9.:-]*/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}"
)
REQUIRED_PLATFORMS = {("linux", "amd64"), ("linux", "arm64")}
PUBLIC_REPOSITORY = "ghcr.io/pjunod/cinema-media-runtime"
MANIFEST_ACCEPT = ", ".join((
    "application/vnd.oci.image.index.v1+json",
    "application/vnd.docker.distribution.manifest.list.v2+json",
    "application/vnd.oci.image.manifest.v1+json",
    "application/vnd.docker.distribution.manifest.v2+json",
))


def run(command: list[str], *, capture: bool = False) -> str:
    result = subprocess.run(command, check=True, text=True,
                            stdout=subprocess.PIPE if capture else None)
    return result.stdout if capture else ""


def verify_public_image(digest: str) -> None:
    """Prove the canonical index and both platform manifests work without login.

    A fresh urllib opener never reads Docker's authentication configuration or
    a credential helper. Only GHCR's anonymous pull token is sent to GHCR.
    """
    opener = urllib.request.build_opener()
    token_url = "https://ghcr.io/token?" + urllib.parse.urlencode({
        "service": "ghcr.io", "scope": "repository:pjunod/cinema-media-runtime:pull",
    })
    try:
        with opener.open(token_url, timeout=30) as response:
            grant = json.load(response)
            token = grant.get("token") if isinstance(grant, dict) else None
        if not isinstance(token, str) or not token:
            raise ValueError("canonical public media runtime returned no anonymous pull token")

        def manifest(reference: str) -> dict:
            request = urllib.request.Request(
                "https://ghcr.io/v2/pjunod/cinema-media-runtime/manifests/" + reference,
                headers={"Authorization": "Bearer " + token, "Accept": MANIFEST_ACCEPT},
            )
            with opener.open(request, timeout=30) as response:
                payload = response.read()
            if "sha256:" + hashlib.sha256(payload).hexdigest() != reference:
                raise ValueError("canonical public media manifest bytes do not match their digest")
            document = json.loads(payload)
            if not isinstance(document, dict):
                raise ValueError("canonical public media manifest must be a JSON object")
            return document

        index = manifest(digest)
        platforms = {
            (entry.get("platform", {}).get("os"), entry.get("platform", {}).get("architecture")): entry
            for entry in index.get("manifests", [])
        }
        if not REQUIRED_PLATFORMS.issubset(platforms):
            raise ValueError("canonical public media index must contain both linux/amd64 and linux/arm64")
        for platform in sorted(REQUIRED_PLATFORMS):
            child = platforms[platform].get("digest", "")
            if not re.fullmatch(r"sha256:[0-9a-f]{64}", child):
                raise ValueError("canonical public media index contains an invalid platform digest")
            manifest(child)
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as error:
        raise ValueError("canonical public media runtime is not anonymously available at "
                         + PUBLIC_REPOSITORY + "@" + digest) from error


def dv_dependency_inputs(root: Path = ROOT) -> str:
    """Identity of the files that define the published DV build dependencies.

    Byte for byte the list tools/dv_processing/dependency-inputs.sh prints, so
    the value pinned in source equals what the dependency image recorded when
    it was built from the same files.
    """
    lines = []
    for directory, patterns in DV_DEPENDENCY_INPUTS:
        for pattern in patterns:
            matches = sorted((root / directory).glob(pattern), key=lambda path: path.name.encode())
            if not matches:
                raise ValueError(f"DV dependency input {directory}/{pattern} is missing")
            for path in matches:
                name = path.relative_to(root / directory).as_posix()
                lines.append(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {name}\n")
    return "sha256:" + hashlib.sha256("".join(lines).encode()).hexdigest()


def pin_image(image: str, dockerfile: Path, *, insecure: bool = False,
              dv_dependencies: bool = False) -> None:
    """Require a published multi-platform image before changing application source."""
    if not IMAGE.fullmatch(image):
        raise ValueError("image must be REGISTRY/REPOSITORY@sha256:<64 lowercase hex>")
    source = dockerfile.read_text()
    if dv_dependencies:
        if len(DV_PIN.findall(source)) != 1 or len(DV_INPUTS_ARG.findall(source)) != 1:
            raise ValueError("Dockerfile must contain exactly one DV build dependency pin and input identity")
    else:
        if len(PIN.findall(source)) != 1:
            raise ValueError("Dockerfile must contain exactly one immutable media runtime pin")
        defaults = DIGEST_ARG.findall(source)
        if len(defaults) != 1 or defaults[0] != PIN.findall(source)[0][1]:
            raise ValueError("runtime digest identity default must match the committed media base")
    inspect = ["docker", "manifest", "inspect"]
    if insecure:
        inspect.append("--insecure")
    manifest = json.loads(run([*inspect, image], capture=True))
    platforms = {
        (entry.get("platform", {}).get("os"), entry.get("platform", {}).get("architecture"))
        for entry in manifest.get("manifests", [])
    }
    if not REQUIRED_PLATFORMS.issubset(platforms):
        raise ValueError("media image index must contain both linux/amd64 and linux/arm64")
    digest = image.rsplit("@", 1)[1]
    verify_public_image(digest)
    if dv_dependencies:
        # The image must have been built from this tree's dependency inputs;
        # the application build compares the recorded list with the image's.
        updated = DV_PIN.sub(lambda match: match[1] + digest + match[3], source)
        updated = DV_INPUTS_ARG.sub(
            f'ARG PLURX_DV_DEPENDENCY_INPUTS="{dv_dependency_inputs(dockerfile.resolve().parent)}"', updated)
    else:
        updated = PIN.sub(lambda match: match[1] + digest + match[3], source)
        updated = DIGEST_ARG.sub(f'ARG PLURX_MEDIA_RUNTIME_DIGEST="{digest}"', updated)
    # Keep the mirror repository configurable while making the selected bytes immutable.
    temporary: str | None = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=dockerfile.parent,
                                         prefix=".media-runtime-pin-", delete=False) as output:
            temporary = output.name
            output.write(updated)
        os.chmod(temporary, dockerfile.stat().st_mode & 0o777)
        os.replace(temporary, dockerfile)
        temporary = None
    finally:
        if temporary:
            Path(temporary).unlink(missing_ok=True)
    print(f"Pinned {'DV build dependencies' if dv_dependencies else 'media runtime'}: {digest}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    show = commands.add_parser("show", help="print the committed immutable image reference")
    show.add_argument("--dockerfile", type=Path, default=ROOT / "Dockerfile")
    show.add_argument("--repository", default=os.environ.get("PLURX_MEDIA_RUNTIME_REPOSITORY", "ghcr.io/pjunod/cinema-media-runtime"))
    pin = commands.add_parser("pin", help="verify a published multi-platform index and update its digest")
    pin.add_argument("image")
    pin.add_argument("--insecure", action="store_true", help="allow the configured private HTTP registry")
    pin.add_argument("--dockerfile", type=Path, default=ROOT / "Dockerfile")
    pin_dv = commands.add_parser(
        "pin-dv-dependencies",
        help="verify a published DV build dependency index and update its digest and input identity")
    pin_dv.add_argument("image")
    pin_dv.add_argument("--insecure", action="store_true", help="allow the configured private HTTP registry")
    pin_dv.add_argument("--dockerfile", type=Path, default=ROOT / "Dockerfile")
    build = commands.add_parser("build", help="explicitly build and push media dependencies")
    build.add_argument("--image", required=True)
    build.add_argument("--metadata", type=Path, required=True)
    build.add_argument("--platforms", default="linux/amd64,linux/arm64")
    build.add_argument("--target", choices=("media-runtime", "runtime-assets-dolby-amd64", "dv-processing-dependencies"),
                       default="media-runtime")
    build.add_argument("--package", type=Path)
    args = parser.parse_args()
    try:
        if args.command == "show":
            source = args.dockerfile.read_text()
            matches = PIN.findall(source)
            if len(matches) != 1:
                raise ValueError("Dockerfile must contain exactly one immutable media runtime pin")
            if not IMAGE.fullmatch(args.repository + "@sha256:" + "0" * 64):
                raise ValueError("repository must be REGISTRY/REPOSITORY without a tag or digest")
            reference = matches[0][0].removeprefix("FROM ") + matches[0][1]
            print(reference.replace("${PLURX_MEDIA_RUNTIME_REPOSITORY}", args.repository))
        elif args.command == "pin":
            pin_image(args.image, args.dockerfile, insecure=args.insecure)
        elif args.command == "pin-dv-dependencies":
            pin_image(args.image, args.dockerfile, insecure=args.insecure, dv_dependencies=True)
        else:
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.:-]*/[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9_.-]+", args.image):
                raise ValueError("build image must be a tagged REGISTRY/REPOSITORY reference")
            if not set(args.platforms.split(",")).issubset({"linux/amd64", "linux/arm64"}):
                raise ValueError("supported platforms are linux/amd64 and linux/arm64")
            extra: list[str] = []
            if args.target == "runtime-assets-dolby-amd64":
                if args.platforms != "linux/amd64" or not args.package or not args.package.is_dir():
                    raise ValueError("audited Dolby target requires --platforms linux/amd64 and --package DIRECTORY")
                extra = ["--build-context", f"linux-dolby-package={args.package.resolve()}"]
            elif args.package:
                raise ValueError("--package requires the audited Dolby target")
            revision = run(["git", "-C", str(ROOT), "rev-parse", "HEAD"], capture=True).strip()
            if run(["git", "-C", str(ROOT), "status", "--porcelain", "--untracked-files=no"], capture=True):
                raise ValueError("commit tracked changes before publishing an image labelled with its source revision")
            args.metadata.parent.mkdir(parents=True, exist_ok=True)
            run(["docker", "buildx", "build", "--file", str(ROOT / "Dockerfile.media-runtime"),
                 "--target", args.target, "--platform", args.platforms, "--push",
                 "--tag", args.image, "--metadata-file", str(args.metadata.resolve()),
                 "--label", f"org.opencontainers.image.revision={revision}",
                 "--provenance=false", "--sbom=false", *extra, str(ROOT)])
    except (ValueError, OSError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        parser.exit(1, f"media-runtime: {error}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
