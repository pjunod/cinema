#!/usr/bin/env python3
"""Keep platform key decoding inside the three player input adapters."""

from __future__ import annotations

from pathlib import Path
import re
import sys


ROOT = Path(__file__).resolve().parents[1]
TOKENS = (
    ("KEYCODE_", re.compile(r"KEYCODE_")),
    ("onMoveCommand", re.compile(r"onMoveCommand")),
    ("onExitCommand", re.compile(r"onExitCommand")),
    ("onPlayPauseCommand", re.compile(r"onPlayPauseCommand")),
    ('addEventListener("keydown"', re.compile(r'addEventListener\("keydown"')),
    ("e.key", re.compile(r"(?<![A-Za-z0-9_])e\.key\b")),
)

WHOLE_FILE_ALLOWLIST = {
    Path("clients/android/app/src/main/java/tv/plurx/app/player/PlayerKeyAdapter.kt"):
        "Android player key codes are decoded into contract inputs here.",
    Path("clients/android/app/src/main/java/tv/plurx/app/ui/AuthScreens.kt"):
        "The sign-in form uses Select/Enter to begin editing; it is not a player.",
    Path("clients/apple/Sources/PlayerRemoteAdapter.swift"):
        "Apple remote commands are decoded into contract inputs here.",
    Path("crates/plurxd/src/web/reader.js"):
        "The EPUB frame owns document navigation while the reader is open.",
    Path("crates/plurxd/src/web/offline-reader.js"):
        "The native offline EPUB shell owns its local document navigation.",
}

# index.html contains several independent applications. These bounded regions
# are non-player keyboard adapters with reasons beside their anchors. The
# player itself gets one region only; adding a second handler makes the fence
# fail even if it happens to agree with the reducer today.
INDEX_REGIONS = (
    (
        "// Capture Escape before layout-specific sheet handlers",
        "// ---- global activity indicator",
        "The connection QR dialog owns Escape while it is modal.",
    ),
    (
        "// Keyboard while the player is open: 'i' toggles stats",
        "// player-input-adapter:begin",
        "The photo lightbox owns Escape and previous/next while it is open.",
    ),
    (
        "// player-input-adapter:begin",
        "// player-input-adapter:end",
        "The web player adapter maps browser keys to contract inputs.",
    ),
    (
        "function catalogWireOnce(){",
        "// ---- phone: the library sheet and the search tab",
        "Catalog poster keys provide link/button activation outside playback.",
    ),
    (
        "function theaterWireOnce(){",
        "// ---- registration",
        "Theater poster keys provide link/button activation outside playback.",
    ),
    (
        "function showReaderSearch(){",
        "function toggleReaderPanel(mode){",
        "The EPUB search field submits on Enter outside playback.",
    ),
)


def client_files() -> list[Path]:
    files: list[Path] = []
    for suffix in ("*.kt", "*.swift"):
        for path in (ROOT / "clients").rglob(suffix):
            relative = path.relative_to(ROOT)
            if any(part in {"build", ".build", "DerivedData", ".gradle"} for part in relative.parts):
                continue
            files.append(relative)
    files.extend(
        [
            Path("crates/plurxd/src/web/index.html"),
            Path("crates/plurxd/src/web/reader.js"),
            Path("crates/plurxd/src/web/offline-reader.js"),
        ]
    )
    return sorted(set(files))


def index_allowed_lines(lines: list[str]) -> set[int]:
    allowed: set[int] = set()
    for start_text, end_text, _reason in INDEX_REGIONS:
        starts = [index for index, line in enumerate(lines) if start_text in line]
        ends = [index for index, line in enumerate(lines) if end_text in line and index >= starts[0]] if starts else []
        if len(starts) != 1 or not ends:
            raise ValueError(f"index.html lost keyboard allowlist anchors: {start_text!r} … {end_text!r}")
        allowed.update(range(starts[0] + 1, ends[0] + 2))
    return allowed


def scan() -> list[str]:
    failures: list[str] = []
    for relative in client_files():
        path = ROOT / relative
        if not path.exists():
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        allowed = set(range(1, len(lines) + 1)) if relative in WHOLE_FILE_ALLOWLIST else set()
        if relative == Path("crates/plurxd/src/web/index.html"):
            try:
                allowed = index_allowed_lines(lines)
            except ValueError as error:
                failures.append(f"{relative}:1: {error}")
                continue
        for number, line in enumerate(lines, start=1):
            if number in allowed:
                continue
            for token, pattern in TOKENS:
                if pattern.search(line):
                    failures.append(f"{relative}:{number}: {token} is outside an allowed adapter")

    resource_files = {
        Path("clients/android/app/build.gradle.kts"):
            ("player-input-contract.json", "playback-info-fields.json"),
        Path("clients/apple/project.yml"):
            ("player-input-contract.json", "playback-info-fields.json"),
    }
    for relative, names in resource_files.items():
        source = (ROOT / relative).read_text(encoding="utf-8")
        for name in names:
            if name not in source:
                failures.append(f"{relative}:1: test resources no longer reference {name}")

    android_build = ROOT / "clients/android/app/build.gradle.kts"
    android_source = android_build.read_text(encoding="utf-8")
    resource_directories = re.findall(
        r'getByName\("test"\)\.resources\.directories\.add\("([^"]+)"\)',
        android_source,
    )
    for name in ("player-input-contract.json", "playback-info-fields.json"):
        wired = any((android_build.parent / directory / name).resolve().is_file()
                    for directory in resource_directories)
        if not wired:
            failures.append(
                f"clients/android/app/build.gradle.kts:1: test resources do not wire {name}"
            )
    return failures


def main() -> int:
    failures = scan()
    if failures:
        print("player input fence failed:", file=sys.stderr)
        for failure in failures:
            print(f"  {failure}", file=sys.stderr)
        return 1
    print("PASS player key handling is fenced to the platform adapters")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
