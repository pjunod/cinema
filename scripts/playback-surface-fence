#!/usr/bin/env python3
"""Keep every playback surface write inside the presenter's render.

The overlay was an imperative message channel: 35 `setLoading` call sites on
the web, four published failure fields on Apple, an `onError` string callback
on Android. The contract (docs/clients/PLAYBACK-SURFACE-CONTRACT.md) makes it a
projection of a pure reducer instead, and this fence is what keeps it one —
it fails on WRITES to a surface outside the presenter's render. It says
nothing about READS: ladders, readiness code and diagnostics keep every
`errorCode`, `status` and `details` reference they have.

Until M1/M2/M3 land, each client still writes its surface the old way. Those
sites are budgeted per file with a reason, so no NEW one can be added while the
migration is in flight, and the budget goes to zero as each milestone lands.
"""

from __future__ import annotations

from pathlib import Path
import re
import sys


ROOT = Path(__file__).resolve().parents[1]

# One pattern set per file kind. Spellings, not just the idiom that happened to
# be in the tree: an assignment, a `+=`, and a class toggle are all writes.
# A line that DEFINES the render entry point is not a call site. Checked before
# the write patterns so the budget below counts the calls it says it counts.
# A line that is ONLY the render's entry-point declaration is not a call site.
# Anchored, because `if (x) function setLoading(){}` is not a thing but
# `paint(); function setLoading(` on one folded logical line very much is: a
# loose search here excused every write that happened to share a line with the
# declaration, which is a hole the shape of the whole render.
NOT_A_WRITE = (
    re.compile(r"^\s*(?:async\s+)?function\s+setLoading\s*\([^)]*\)\s*\{?\s*$"),
)

# One pattern set per file kind. Spellings, not just the idiom that happened to
# be in the tree: an assignment, a `+=`, a `toggle()`, a key path, an alias and
# a call split across two lines are all writes. The scanner joins continuation
# lines before matching (see `logical_lines`), so `setLoading\n  (true, …)` and
# `playFailure\n    = message` are not hiding places.
PATTERNS = {
    "web": (
        ("setLoading", re.compile(r"\bsetLoading\s*(?:\?\.)?\s*\(")),
        ("setLoading reflected", re.compile(r"\bsetLoading\s*\.\s*(?:call|apply|bind)\s*\(")),
        ("setLoading by name", re.compile(r"[\"']setLoading[\"']")),
        ("setLoading alias", re.compile(r"=\s*setLoading\s*(?:[;,)\]}]|$)")),
        ("failed class toggle", re.compile(r"classList\s*\.\s*(?:add|remove|toggle|replace)\s*\([^)]*(?i:failed)")),
        ("overlay class toggle", re.compile(r"\bploading\b[^\n]*classList\s*\.\s*(?:add|remove|toggle|replace)\s*\(")),
        ("computed class write", re.compile(r"classList\s*\[")),
        ("computed class argument", re.compile(r"classList\s*\.\s*(?:add|remove|toggle|replace)\s*\([^)]*\+")),
        ("overlay className write", re.compile(r"\.className\s*(?:=|\+=)(?!=)[^\n]*(?i:failed|ploading)")),
        ("stallPrompt write", re.compile(r"\b[A-Za-z_$][\w$]*\.stallPrompt\s*(?:=|\+=)(?!=)")),
        ("stallPrompt in a literal", re.compile(r"[{,]\s*stallPrompt\s*:")),
        ("overlay element write", re.compile(r"\bpload(?:ing|Text|Sub|Act)\b[^\n]*?\.(?:textContent|innerText|innerHTML|className)\s*=(?!=)")),
        ("overlay element replace", re.compile(r"\bpload(?:ing|Text|Sub|Act)\b[^\n]*?\.(?:insertAdjacentHTML|append|prepend|replaceChildren|replaceWith)\s*\(")),
        ("overlay attribute write", re.compile(r"\bpload(?:ing|Text|Sub|Act)\b[^\n]*?setAttribute\(\s*[\"']class[\"']")),
        ("overlay bulk write", re.compile(r"Object\.assign\([^)]*\b(?:ploading|ploadText|ploadSub|ploadAct|stallPrompt)\b")),
        # M1 added the two surfaces that are not the full screen. They are the
        # presenter's output too, so they are fenced the same way.
        ("notice element write", re.compile(r"\b(?:psurface|psurfText|psurfSub|psurfAct|pindicator|pindText)\b[^\n]*?\.(?:textContent|innerText|innerHTML|className)\s*=(?!=)")),
        ("notice element replace", re.compile(r"\b(?:psurface|psurfText|psurfSub|psurfAct|pindicator|pindText)\b[^\n]*?\.(?:insertAdjacentHTML|append|prepend|replaceChildren|replaceWith)\s*\(")),
        ("notice attribute write", re.compile(r"\b(?:psurface|psurfText|psurfSub|psurfAct|pindicator|pindText)\b[^\n]*?setAttribute\(\s*[\"']class[\"']")),
        ("notice class toggle", re.compile(r"\b(?:psurface|pindicator)\b[^\n]*classList\s*\.\s*(?:add|remove|toggle|replace)\s*\(")),
        ("notice bulk write", re.compile(r"Object\.assign\([^)]*\b(?:psurface|psurfText|psurfSub|psurfAct|pindicator|pindText)\b")),
        # The door, not the spellings. A computed member write —
        # `el["class"+"Name"]="failed"` or `el["inner"+"HTML"]=msg` — matches no
        # property pattern above and never will, because the property name does
        # not appear in the source at all. What DOES have to appear is the
        # lookup that got hold of the element, and every one of those already
        # lives inside the render region.
        ("surface element lookup", re.compile(
            r"(?:getElementById|querySelector(?:All)?)\s*\(\s*[\"'`]#?"
            r"(?:ploading|ploadText|ploadSub|ploadAct|psurface|psurfText|psurfSub|psurfAct|pindicator|pindText)\b")),
    ),
    "swift": (
        # The four pre-contract fields. M2 deleted them, so these now guard
        # names that must never come back rather than names that exist.
        ("failure field write", re.compile(r"(?<!var )(?<!let )(?<![=!<>])\b(?:failed|playbackError|playbackFailureTitle|playbackNotice)\s*(?:=|\+=)(?!=)")),
        ("failure field mutation", re.compile(r"\b(?:failed|playbackError|playbackFailureTitle|playbackNotice)\s*\.\s*(?:toggle|negate)\s*\(")),
        ("failure field key path", re.compile(r"keyPath:\s*\\\.(?:failed|playbackError|playbackFailureTitle|playbackNotice)\b")),
        ("failure field by name", re.compile(r"forKey:\s*[\"'](?:failed|playbackError|playbackFailureTitle|playbackNotice)[\"']")),
        ("failure field tuple write", re.compile(r"\(\s*(?:self\.)?(?:failed|playbackError|playbackFailureTitle|playbackNotice)\s*,[^)]*\)\s*=(?!=)")),
        # And the field that replaced them. A fence that only guards deleted
        # names guards nothing: every spelling below got a surface write past
        # the first M2 fence in review. `var` and `let` are excused because a
        # declaration and a local binding are not writes — `let surface =
        # controller.surface.surface` is how the view READS it, and reads are
        # never scanned.
        ("surface write", re.compile(r"(?<!var )(?<!let )(?<![=!<>])\bsurface\s*(?:=|\+=)(?!=)")),
        ("surface reducer call", re.compile(r"\bsurface\s*\.\s*apply\s*\(")),
        ("surface key path", re.compile(r"keyPath:\s*\\\.surface(?:History)?\b")),
        ("surface by name", re.compile(r"forKey:\s*[\"']surface(?:History)?[\"']")),
        ("published storage write", re.compile(r"\b_surface(?:History)?\s*(?:=|\+=)(?!=)")),
        ("surface ledger write", re.compile(r"(?<!var )(?<!let )(?<![=!<>])\bsurfaceHistory\s*(?:=(?!=)|\+=|\.\s*record\s*\()")),
    ),
    # M3 deleted `onError`, `playFailure` and `playbackNotice`, so those three
    # patterns now guard nothing that exists. What replaced them is what has to
    # be guarded: the StateFlow the presenter publishes through, the surface
    # types themselves, the owner's stop, and the shape of the imperative
    # channel that was removed — a nullable String the screen holds and paints.
    "kotlin": (
        ("onError call", re.compile(r"\bonError\s*(?:\(|\.invoke\s*\()")),
        ("onError alias", re.compile(r"=\s*onError\s*(?:[;,)\]}]|$)")),
        ("failure field write", re.compile(r"(?<!var )(?<!val )(?<![=!<>])\b(?:playFailure|playbackNotice)\s*(?:=|\+=)(?!=)")),
        # The publish itself. Only the one assignment inside the anchors is
        # allowed, and the region is `required=True` so deleting the anchors
        # fails rather than opening the file.
        ("surface flow write", re.compile(
            r"\b_surface\s*\.\s*(?:value\s*(?:=|\+=)(?!=)|tryEmit\s*\(|emit\s*\(|update\s*[({])")),
        # A surface built anywhere but the presenter. The render reads
        # `PlaybackSurface`; it never constructs one.
        ("surface constructed", re.compile(
            r"\bPlaybackSurface\s*\.\s*(?:Blocking|Banner|Indicator)\s*\(")),
        # A fault built by hand instead of raised. `preplayerStoppedFault` is
        # the presenter's own factory for the one playback that never got one.
        ("fault constructed", re.compile(r"\bPlaybackFault\s*\(")),
        # The generic raise. Every site in `Controller` goes through a named
        # method on `PlaybackSurfaceOwner`, so a new site has to add itself
        # where a test can name it.
        #
        # The receiver is optional on purpose. It was required, and that made
        # the pattern blind inside `PlaybackSurfaceOwner.kt` itself, where a
        # bare `raiseBlocking(...)` with no stop in front of it is exactly the
        # defect the file exists to prevent. That file is scanned as
        # `kotlin_owner` below — this pattern set is for everything else, where
        # a bare one would be a second door into the same room.
        ("generic surface raise", re.compile(
            r"(?:\bsurfaceOwner\s*\.\s*)?\b(?:raiseNotice|raiseBlocking|stopAndRaise)\s*\(|"
            r"\bsurfaceOwner\s*\.\s*raise\s*\(")),
        # The imperative channel, in the shape it would come back in: a
        # nullable message the screen holds and paints for itself.
        ("screen-held failure string", re.compile(
            r"\bmutableStateOf\s*<\s*String\s*\?\s*>\s*\(\s*null\s*\)")),
    ),
}

# `PlaybackSurfaceOwner.kt` is the one file that is SUPPOSED to call the generic
# raises: they are its own private helpers. It gets every other Kotlin pattern
# and, in place of the generic-raise one, a bespoke check that the invariant its
# own doc comment states is actually true of every blocking site
# (`owner_stop_failures`).
PATTERNS["kotlin_owner"] = tuple(
    (token, pattern) for token, pattern in PATTERNS["kotlin"] if token != "generic surface raise"
)

# Whole files that ARE a presenter (see PRESENTER_FILES) are exempt from the
# write patterns, because writing the surface is all they do. That exemption
# used to be unconditional, which left contract v2's actual thesis — "the
# presenter has no side effects" (§3.0) — unfenced: a free function calling
# `player.pause()` inside the presenter passed. These are the inverted rule.
PRESENTER_FORBIDDEN = (
    # The five verbs §3.0 and implementation §6 name, plus the two ways a
    # presenter could move a player without naming them.
    ("player call", re.compile(
        r"\.\s*(?:pause|play|seek|seekTo|seekToDefaultPosition|prepare|startLoad|stopLoad"
        r"|reopen|replaceCurrentItem|setMediaItem)\s*\(")),
    # A timer of its own. `Timer(` alone is not it — the Android presenter has a
    # `Timer` enum CASE — so these are creation spellings only.
    ("timer creation", re.compile(
        r"Timer\s*\.\s*scheduledTimer|DispatchQueue\s*\.[\w.]+\s*\.\s*asyncAfter"
        r"|\bTask\s*[{(]|Task\s*\.\s*sleep|\bsetTimeout\s*\(|\bsetInterval\s*\("
        r"|\blaunch\s*[{(]|\bdelay\s*\(|CoroutineScope\s*\(|kotlin\.concurrent\.timer")),
    # Reporting to the control plane.
    ("control-plane call", re.compile(
        r"\bplaybackControl\b|\bnotifyPlaybackControl\s*\(|\breportControlEvidence\s*\("
        r"|\bcontrolReporter\b")),
)

# The finite player's shipped surfaces, and nothing else. Scope is deliberate:
# the offline players, the readers, Live TV and Library Channels' own Swift
# screen are outside the finite player (contract §7) and are not scanned here.
WEB_PLAYER = Path("crates/plurxd/src/web/player")


def web_player_rows() -> dict[Path, str]:
    """Every row of the split shell's `player/` folder.

    Globbed, never listed. The web surface writes used to be in `index.html`
    and this fence named that one file; after the split it went *silently
    vacuous* — a rogue `document.getElementById("psurface").innerHTML=` dropped
    into any player row printed PASS, while the same line in the un-split shell
    failed. A fence that names its files by hand is a fence that stops working
    the day someone adds a file.
    """
    return {
        path.relative_to(ROOT): "web"
        for path in sorted((ROOT / WEB_PLAYER).glob("*.js"))
    }


SCANNED = {
    **web_player_rows(),
    Path("crates/plurxd/src/web/playback-policy.js"): "web",
    Path("clients/apple/Sources/PlayerController.swift"): "swift",
    Path("clients/apple/Sources/PlayerView.swift"): "swift",
    Path("clients/apple/Sources/PlayerSurface.swift"): "swift",
    Path("clients/android/app/src/main/java/tv/plurx/app/player/Controller.kt"): "kotlin",
    Path("clients/android/app/src/main/java/tv/plurx/app/player/PlayerScreen.kt"): "kotlin",
    # The recovery owner's surface arm: it stops the player and then raises,
    # which is the one thing the presenter itself may never do. Scanned rather
    # than allow-listed, so it can never grow a pre-contract write either.
    Path("clients/android/app/src/main/java/tv/plurx/app/player/PlaybackSurfaceOwner.kt"): "kotlin_owner",
}

# Named so a later reader can see the exclusion was a decision, not an
# oversight. If one of these ever grows a finite-player surface it belongs in
# SCANNED, and this list is where the argument gets made.
NEVER_SCANNED = {
    Path("clients/apple/Sources/LibraryChannels.swift"): "Library Channels' own Swift screen is not the finite player.",
    Path("clients/android/app/src/main/java/tv/plurx/app/player/OfflinePlayerScreen.kt"): "The offline player has its own lifecycle and no server session.",
    Path("clients/apple/Sources/OfflineDownloadManager.swift"): "Downloads report progress, not a playback surface.",
    Path("crates/plurxd/src/web/reader.js"): "The EPUB reader is not the player.",
    Path("crates/plurxd/src/web/offline-reader.js"): "The native offline EPUB shell is not the player.",
    Path("crates/plurxd/src/web/live-tv.js"): "Live TV has its own surface; the contract's scope is the finite player.",
}

# Whole files that ARE the presenter. They land with M1/M2/M3; a missing one is
# not a failure while its milestone is still ahead, but a present one is
# allowed to write the surface because writing it is all it does.
PRESENTER_FILES = {
    Path("clients/apple/Sources/PlaybackSurfaceModel.swift"):
        "The Apple presenter. It is the only place a fault becomes a surface.",
    Path("clients/android/app/src/main/java/tv/plurx/app/player/PlaybackSurface.kt"):
        "The Android presenter. It is the only place a fault becomes a surface.",
}

# Bounded regions inside a scanned file that ARE the render. Anchors are
# comments beside the code so a move keeps the reason with it.
REGIONS = {
    Path("crates/plurxd/src/web/player/surface.js"): (
        (
            "// playback-surface-render:begin",
            "// playback-surface-render:end",
            "The web presenter's render function: the only caller of setLoading and the only writer of the failed class.",
            # Required. It was optional while the anchors sat in a 24,000-line
            # file; in a 315-line row of its own, a missing anchor is a deleted
            # anchor, and an optional anchor exempts the file.
            True,
        ),
    ),
    Path("clients/apple/Sources/PlayerController.swift"): (
        (
            "// playback-surface-publish:begin",
            "// playback-surface-publish:end",
            "The Apple presenter's publication: the only code that writes `surface`, "
            "resets it, or records a fault in the ledger ring.",
            # Required, now that M2 has landed. Leaving it optional made
            # deleting the two anchors a silent way to exempt the whole file.
            True,
        ),
    ),
    Path("clients/android/app/src/main/java/tv/plurx/app/player/Controller.kt"): (
        (
            "// playback-surface-publish:begin",
            "// playback-surface-publish:end",
            "The single assignment that publishes the presenter's surface.",
            # Required: M3 has landed, so deleting the anchors is not a file
            # waiting for its milestone — it is the one write site going
            # unfenced.
            True,
        ),
    ),
}

# The migration budget: how many pre-contract write sites each file may still
# have, and why. A milestone that lands drops its file's entry to zero and then
# removes it, and a file with no entry is held at zero by
# `MIGRATION_BUDGET.get(relative, (0, ""))` below. A NEW write site fails the
# fence either way, which is the point. All three client files have left:
# the web with M1 (every web surface write is inside `player/surface.js`'s
# render anchors),
# `PlayerController.swift` with M2 (every Apple one is inside the publish
# region), and the two Android rows with M3 (`onError`, `playFailure` and
# `playbackNotice` are gone).
MIGRATION_BUDGET = {
    Path("crates/plurxd/src/web/playback-policy.js"): (0, "The policy module never touched the DOM; it stays at zero."),
    Path("clients/apple/Sources/PlayerView.swift"): (0, "The Apple view reads the model; it never wrote one."),
    Path("clients/apple/Sources/PlayerSurface.swift"): (0, "The Apple surface reads the model; it never wrote one."),
}


def region_allowed_lines(path: Path, lines: list[str]) -> set[int]:
    allowed: set[int] = set()
    for begin, end, _reason, required in REGIONS.get(path, ()):  # noqa: B007
        starts = [index for index, line in enumerate(lines) if begin in line]
        if not starts:
            if required:
                raise ValueError(f"lost its {begin!r} anchor")
            continue
        if len(starts) != 1:
            raise ValueError(f"has {len(starts)} copies of the {begin!r} anchor; the render is one region")
        ends = [index for index, line in enumerate(lines) if end in line and index > starts[0]]
        if not ends:
            raise ValueError(f"has {begin!r} with no {end!r} after it")
        allowed.update(range(starts[0] + 2, ends[0] + 1))
    return allowed


def logical_lines(text: str) -> list[tuple[int, str]]:
    """(first line number, joined text) for every line, with continuations folded in.

    A write split over two lines is still a write: `setLoading\n  (true, …)`,
    `playFailure\n    = message`, `player\n  .classList.add("failed")`. At most
    three following lines are folded so a long chained expression cannot make
    the whole file one line.
    """
    raw = text.splitlines()
    out: list[tuple[int, str]] = []
    for index, line in enumerate(raw):
        joined = line
        cursor = index + 1
        folded = 0
        while cursor < len(raw) and folded < 3:
            nxt = raw[cursor].strip()
            if not nxt:
                cursor += 1
                continue
            if nxt[0] not in "(.=+[?":
                break
            joined = f"{joined} {nxt}"
            cursor += 1
            folded += 1
        out.append((index + 1, joined))
    return out


def scan_text(kind: str, text: str, allowed: set[int] | None = None) -> list[tuple[int, str]]:
    """Every write site in `text`, as (1-based line, token). Reads are not hits."""
    allowed = allowed or set()
    hits: list[tuple[int, str]] = []
    for number, line in logical_lines(text):
        if number in allowed:
            continue
        if any(pattern.search(line) for pattern in NOT_A_WRITE):
            continue
        for token, pattern in PATTERNS[kind]:
            if pattern.search(line):
                # One hit per line: a line is a write site, and the budgets
                # below count sites, not spellings.
                hits.append((number, token))
                break
    return hits


def owner_stop_failures(text: str) -> list[tuple[int, str]]:
    """Every `raiseBlocking(` whose enclosing function does not stop the player.

    `PlaybackSurfaceOwner.kt`'s own doc comment says it outright: "each blocking
    one does its own stop before it raises". A regex over spellings cannot say
    that; this can. For each call, walk back to the `fun ` that encloses it and
    require `player.playbackRequested = false` between the two — which is what
    the owner's stop IS on this client.
    """
    lines = text.splitlines()
    failures: list[tuple[int, str]] = []
    for index, line in enumerate(lines):
        if not re.search(r"(?<!fun )\braiseBlocking\s*\(", line):
            continue
        start = None
        for back in range(index, -1, -1):
            if re.match(r"\s*(?:private |internal |public )?fun\s", lines[back]):
                start = back
                break
        if start is None:
            failures.append((index + 1, "raiseBlocking outside any function"))
            continue
        body = "\n".join(lines[start:index])
        if not re.search(r"player\.playbackRequested\s*=\s*false", body):
            failures.append((index + 1, "raiseBlocking with no `player.playbackRequested = false` before it"))
    return failures


def presenter_failures(kind_text: str) -> list[tuple[int, str]]:
    """A presenter that moves the player is not a presenter (contract §3.0)."""
    hits: list[tuple[int, str]] = []
    for number, line in logical_lines(kind_text):
        stripped = line.lstrip()
        # A doc comment naming the thing it refuses to do is not the thing.
        if stripped.startswith("//") or stripped.startswith("*") or stripped.startswith("/*"):
            continue
        for token, pattern in PRESENTER_FORBIDDEN:
            if pattern.search(line):
                hits.append((number, token))
                break
    return hits


def scan() -> list[str]:
    failures: list[str] = []
    # Fail closed: a renamed or deleted scanned file used to make a fence PASS,
    # which is the one answer it must never give by accident.
    for relative in SCANNED:
        if not (ROOT / relative).is_file():
            failures.append(f"{relative}:1: a scanned player file is missing; the fence scanned nothing for it")
    for relative in NEVER_SCANNED:
        if relative in SCANNED:
            failures.append(f"{relative}:1: a file is both scanned and explicitly out of scope")
    for relative in MIGRATION_BUDGET:
        if relative not in SCANNED:
            failures.append(f"{relative}:1: budgeted file is not scanned")
    # Fail closed on the glob too: an empty player/ folder would scan nothing
    # and print PASS.
    if not web_player_rows():
        failures.append(f"{WEB_PLAYER}:1: no web player rows found; the fence scanned none of the web")
    for relative in REGIONS:
        if relative not in SCANNED:
            failures.append(f"{relative}:1: a file with render anchors is not scanned")

    for relative, kind in sorted(SCANNED.items()):
        path = ROOT / relative
        if not path.is_file():
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        try:
            allowed = region_allowed_lines(relative, lines)
        except ValueError as error:
            failures.append(f"{relative}:1: {error}")
            continue
        hits = scan_text(kind, "\n".join(lines), allowed)
        budget, reason = MIGRATION_BUDGET.get(relative, (0, ""))
        if len(hits) > budget:
            failures.append(
                f"{relative}:{hits[budget][0]}: {len(hits)} surface writes outside the presenter's render, "
                f"budget is {budget}. {reason or 'Every surface write belongs in the render.'}"
            )
            for number, token in hits[budget: budget + 5]:
                failures.append(f"{relative}:{number}: {token}")

    owner = Path("clients/android/app/src/main/java/tv/plurx/app/player/PlaybackSurfaceOwner.kt")
    if (ROOT / owner).is_file():
        for number, token in owner_stop_failures((ROOT / owner).read_text(encoding="utf-8")):
            failures.append(f"{owner}:{number}: {token}")

    for relative, reason in PRESENTER_FILES.items():
        path = ROOT / relative
        if not path.is_file():
            continue
        if relative in SCANNED:
            failures.append(f"{relative}:1: the presenter cannot also be scanned ({reason})")
        for number, token in presenter_failures(path.read_text(encoding="utf-8")):
            failures.append(f"{relative}:{number}: the presenter has a side effect ({token}); {reason}")
    return failures


def main() -> int:
    failures = scan()
    if failures:
        print("playback surface fence failed:", file=sys.stderr)
        for failure in failures:
            print(f"  {failure}", file=sys.stderr)
        return 1
    print("PASS every playback surface write is inside the presenter's render or its migration budget")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
