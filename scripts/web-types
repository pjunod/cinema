#!/usr/bin/env python3
"""Type-check the web shell with TypeScript's checker, against a ratchet.

Why this exists: the web app is sixty-odd plain scripts sharing one global
scope, and nothing checked the *shape* of what they pass each other — a
misspelled `PLAYER` field, a call to a function that exists nowhere, a
property read off the wrong element type all load, parse, and fail on a
viewer's screen. `tsc` in checkJs mode reads the JavaScript as it is, with
the JSDoc types written into it, and reports those
(docs/clients/WEB-TYPE-CHECKING-AND-PLAYER-DECOMPOSITION.md §3.1-§3.3).

The shell did not start clean, so the gate is a ratchet: every diagnostic is
counted under the key `path<TAB>TScode` (line and column dropped — they move
on every edit) and compared with `tests/web/tsc-baseline.tsv`. A key whose
count rose, or a key the baseline does not have, fails. A count that fell
passes and says the baseline can shrink.

    scripts/web-types                                # the gate (make web-check)
    scripts/web-types --update                       # lower the baseline to what is left
    scripts/web-types --accept-increase "<reason>"   # raise it, with the reason on record

`--update` only ever lowers counts. Raising one takes `--accept-increase`,
which writes `# accepted <date>: <reason>` into the baseline so the diff that
raises it says why.

`tsc` is a dev-only tool pinned in `tools/web-types/package-lock.json`; this
script runs `npm ci` there when the installed copy is missing or is not the
locked version. Nothing under `tools/` is served or shipped.
"""

from __future__ import annotations

import argparse
import collections
import datetime
import json
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOOLS = ROOT / "tools/web-types"
CONFIG = ROOT / "crates/plurxd/src/web/jsconfig.json"
BASELINE = ROOT / "tests/web/tsc-baseline.tsv"

# `path(line,col): error TS1234: message` — what `tsc --pretty false` prints.
DIAGNOSTIC = re.compile(
    r"^(?P<path>[^\s(][^(]*)\((?P<line>\d+),(?P<col>\d+)\): error (?P<code>TS\d+): (?P<message>.*)$"
)

HEADER = [
    "# tsc diagnostics the web shell carried when this gate began, per file and",
    "# code. scripts/web-types fails if a count rises or a key appears; lower it",
    "# with `scripts/web-types --update`. Columns: path, code, count.",
]

Key = tuple  # (path, code)


def locked_version() -> str:
    lock = json.loads((TOOLS / "package-lock.json").read_text(encoding="utf-8"))
    return lock["packages"]["node_modules/typescript"]["version"]


def installed_version() -> str | None:
    manifest = TOOLS / "node_modules/typescript/package.json"
    if not manifest.is_file():
        return None
    return json.loads(manifest.read_text(encoding="utf-8")).get("version")


def ensure_tsc() -> Path | None:
    """The locked tsc, installing it with `npm ci` first when it is not there."""
    want = locked_version()
    if installed_version() != want:
        npm = shutil.which("npm")
        if npm is None:
            print("web-types: FAIL — npm is not on PATH, so the pinned TypeScript "
                  f"{want} cannot be installed into tools/web-types", file=sys.stderr)
            return None
        print(f"web-types: installing typescript {want} (npm ci --prefix tools/web-types)")
        proc = subprocess.run(
            [npm, "ci", "--prefix", str(TOOLS), "--no-audit", "--no-fund", "--loglevel=error"],
            capture_output=True, text=True, check=False,
        )
        if proc.returncode != 0 or installed_version() != want:
            print("web-types: FAIL — npm ci did not install the locked typescript", file=sys.stderr)
            print((proc.stderr or proc.stdout).rstrip(), file=sys.stderr)
            return None
    return TOOLS / "node_modules/typescript/bin/tsc"


def run_tsc(tsc: Path) -> tuple[int, str]:
    proc = subprocess.run(
        ["node", str(tsc), "-p", str(CONFIG.relative_to(ROOT)), "--pretty", "false"],
        cwd=ROOT, capture_output=True, text=True, check=False,
    )
    return proc.returncode, proc.stdout + proc.stderr


def parse(output: str) -> tuple[list[dict], list[str]]:
    """Diagnostics, and any error line that names no file (a broken config)."""
    diagnostics: list[dict] = []
    stray: list[str] = []
    for line in output.splitlines():
        if not line.strip():
            continue
        match = DIAGNOSTIC.match(line)
        if match:
            diagnostics.append(match.groupdict())
        elif line[:1].isspace() and diagnostics:
            # tsc indents the rest of a multi-line message.
            diagnostics[-1]["message"] += "\n" + line
        else:
            stray.append(line)
    return diagnostics, stray


def count(diagnostics: list[dict]) -> collections.Counter:
    return collections.Counter((d["path"], d["code"]) for d in diagnostics)


def read_baseline(path: Path) -> tuple[collections.Counter, list[str]]:
    counts: collections.Counter = collections.Counter()
    accepted: list[str] = []
    if not path.is_file():
        return counts, accepted
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        if line.startswith("#"):
            if line.startswith("# accepted "):
                accepted.append(line)
            continue
        file, code, n = line.split("\t")
        counts[(file, code)] = int(n)
    return counts, accepted


def write_baseline(path: Path, counts: collections.Counter, accepted: list[str]) -> None:
    rows = [f"{file}\t{code}\t{n}" for (file, code), n in sorted(counts.items()) if n > 0]
    path.write_text("\n".join(HEADER + accepted + rows) + "\n", encoding="utf-8")


def compare(baseline: collections.Counter, current: collections.Counter):
    """(keys that rose or appeared, keys that fell) as {key: (was, now)}."""
    keys = set(baseline) | set(current)
    rose = {k: (baseline[k], current[k]) for k in keys if current[k] > baseline[k]}
    fell = {k: (baseline[k], current[k]) for k in keys if current[k] < baseline[k]}
    return rose, fell


def lowered(baseline: collections.Counter, current: collections.Counter) -> collections.Counter:
    """The baseline with every count brought down to what is left, never up."""
    return collections.Counter({k: min(n, current[k]) for k, n in baseline.items() if current[k] > 0})


def report_rose(rose: dict, diagnostics: list[dict]) -> None:
    for key in sorted(rose):
        was, now = rose[key]
        file, code = key
        print(f"web-types: FAIL — {file} {code}: {now} now, baseline allows {was}", file=sys.stderr)
        for d in diagnostics:
            if (d["path"], d["code"]) == key:
                first = d["message"].splitlines()[0]
                print(f"  {d['path']}:{d['line']}:{d['col']} {code} {first}", file=sys.stderr)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--update", action="store_true", help="lower the baseline to what is left")
    mode.add_argument("--accept-increase", metavar="REASON", help="raise the baseline, recording why")
    parser.add_argument("--baseline", type=Path, default=BASELINE, help=argparse.SUPPRESS)
    parser.add_argument("--tsc-output", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    started = time.monotonic()
    if args.tsc_output is not None:
        # Tests feed a recorded tsc run to exercise the ratchet on its own.
        output = args.tsc_output.read_text(encoding="utf-8")
    else:
        # A stale file list is a checker that stopped reading a file.
        stale = subprocess.run(["node", str(ROOT / "scripts/web-jsconfig"), "--check"],
                               cwd=ROOT, capture_output=True, text=True, check=False)
        if stale.returncode != 0:
            print((stale.stderr or stale.stdout).rstrip(), file=sys.stderr)
            return 1
        tsc = ensure_tsc()
        if tsc is None:
            return 2
        code, output = run_tsc(tsc)
        if code not in (0, 1, 2):
            print(f"web-types: FAIL — tsc exited {code}", file=sys.stderr)
            print(output.rstrip(), file=sys.stderr)
            return 1

    diagnostics, stray = parse(output)
    if stray:
        print("web-types: FAIL — tsc reported something that is not a file diagnostic "
              "(a broken jsconfig.json or globals.d.ts?):", file=sys.stderr)
        for line in stray:
            print(f"  {line}", file=sys.stderr)
        return 1

    current = count(diagnostics)
    baseline, accepted = read_baseline(args.baseline)
    rose, fell = compare(baseline, current)
    total, allowed = sum(current.values()), sum(baseline.values())
    elapsed = time.monotonic() - started
    rel = args.baseline.relative_to(ROOT) if args.baseline.is_relative_to(ROOT) else args.baseline

    if args.accept_increase is not None:
        reason = args.accept_increase.strip()
        if not reason:
            print("web-types: --accept-increase needs a reason", file=sys.stderr)
            return 2
        if not rose:
            print("web-types: nothing rose; use --update to lower the baseline", file=sys.stderr)
            return 1
        stamp = datetime.datetime.now(datetime.timezone.utc).date().isoformat()
        write_baseline(args.baseline, current,
                       accepted + [f"# accepted {stamp}: {' '.join(reason.split())}"])
        print(f"web-types: wrote {rel} — {total} diagnostics in {len(current)} keys "
              f"(was {allowed}); accepted: {reason}")
        return 0

    if rose:
        report_rose(rose, diagnostics)
        print(f"web-types: {len(rose)} key(s) rose above {rel}. Fix the new diagnostics; "
              "if one is truly intended, run scripts/web-types --accept-increase \"<why>\".",
              file=sys.stderr)
        return 1

    if args.update:
        lower = lowered(baseline, current)
        if lower == baseline:
            print(f"web-types: nothing shrank — {rel} not written ({total} diagnostics)")
            return 0
        write_baseline(args.baseline, lower, accepted)
        print(f"web-types: lowered {rel} from {allowed} to {sum(lower.values())} diagnostics")
        return 0

    if fell:
        shrink = sum(was - now for was, now in fell.values())
        print(f"web-types: OK, shrank — {total} diagnostics, baseline allows {allowed}; "
              f"the baseline can shrink by {shrink} — run scripts/web-types --update "
              f"({elapsed:.1f}s)")
    else:
        print(f"web-types: OK, unchanged — {total} diagnostics in {len(current)} keys "
              f"match {rel} ({elapsed:.1f}s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
