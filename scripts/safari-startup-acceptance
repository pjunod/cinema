#!/usr/bin/env python3
"""Replay the Gran Turismo first-playlist contract in native WebKit on macOS.

Requires an explicitly supplied, task-owned HLS media directory produced by
plurx's copy cutter from the original DV5/EC3 source. No media is committed.
The Rust regression compares the candidate fixture with actual publication
bytes. This probe establishes native first-frame behavior, not daemon/fleet
qualification. All binaries, module caches, events and receipts stay in the
required --evidence-dir. Nothing is installed and no user browser is controlled.
"""
import argparse
import hashlib
import http.server
import json
import pathlib
import platform
import re
import subprocess
import threading
import time
import urllib.parse

ROOT = pathlib.Path(__file__).resolve().parents[1]
CASE = ROOT / 'tests/playback/fixtures/gran-turismo-safari-startup.json'
PAGE = b'''<!doctype html><video id="v" playsinline preload="auto"></video><script>
const v=document.getElementById('v'),start=performance.now();
const report=(event,extra={})=>window.webkit.messageHandlers.report.postMessage({
 event,elapsed_ms:performance.now()-start,ready_state:v.readyState,
 position_s:v.currentTime,...extra});
for(const event of ['loadedmetadata','loadeddata','canplay','playing','waiting','error'])
 v.addEventListener(event,()=>report(event,{error:v.error?.message||null}));
v.addEventListener('loadedmetadata',()=>{v.currentTime=0;});
if(typeof v.requestVideoFrameCallback==='function')
 v.requestVideoFrameCallback((now,frame)=>report('first_frame',{
   presented_frames:frame.presentedFrames,media_time_s:frame.mediaTime}));
else report('unsupported_frame_observer');
v.src='master.m3u8';v.play().catch(error=>report('play_rejected',{error:String(error)}));
setTimeout(()=>report('complete'),__OBSERVE_MS__);
</script>'''


def digest(path):
    value = hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--media-dir', type=pathlib.Path, required=True)
    parser.add_argument('--evidence-dir', type=pathlib.Path, required=True)
    args = parser.parse_args()
    if platform.system() != 'Darwin':
        parser.error('native WebKit qualification requires macOS')
    media, evidence = args.media_dir.resolve(), args.evidence_dir.resolve()
    if not str(evidence).startswith('/Volumes/Untitled/agent/'):
        parser.error('evidence must be under /Volumes/Untitled/agent')
    evidence.mkdir(parents=True, exist_ok=True)
    case = json.loads(CASE.read_text())
    writer = (media / 'index.m3u8').read_text()
    durations = [float(value) for value in re.findall(r'^#EXTINF:([0-9.]+)', writer, re.M)]
    expected = case['segment_durations_ms'][:case['candidate_first_segment_count']]
    if len(durations) < len(expected) or any(abs(a * 1000 - b) > 1 for a, b in zip(durations, expected)):
        parser.error('media must contain the recorded variable-duration Gran Turismo prefix')
    init = (media / 'init.mp4').read_bytes()
    if b'dvh1' not in init or b'ec-3' not in init:
        parser.error('media must retain original Dolby Vision / EC3; AVC/AAC is not this case')
    names = ['init.mp4'] + [f'seg{i:05}.m4s' for i in range(len(expected))]
    media_hashes = {name: digest(media / name) for name in names}
    (evidence / 'candidate-first.m3u8').write_text(case['candidate_first_playlist'])
    (evidence / 'failed-first.m3u8').write_text(case['failed_first_playlist'])
    swift = ROOT / 'tests/playback/safari-startup-probe.swift'
    binary = evidence / 'safari-startup-probe'
    subprocess.run(['xcrun', 'swiftc', '-module-cache-path', str(evidence / 'module-cache'),
                    str(swift), '-o', str(binary)], check=True)
    # The native positive is held past the fixed target's first reload. The
    # exact first snapshot remains readable throughout, isolating admission
    # from producer speed, deletion, retries and fresh playlist generation.
    cases = [('failed-short', 8, case['failed_first_playlist'], False, 'off'),
             ('failed-short-cold-subtitle', 8, case['failed_first_playlist'], False, 'cold'),
             ('candidate-native', 24, case['candidate_first_playlist'], True, 'off'),
             ('candidate-cold-subtitle', 8, case['candidate_first_playlist'], True, 'cold'),
             ('candidate-warm-subtitle', 8, case['candidate_first_playlist'], True, 'warm'),
             ('completed-short', 8, case['failed_first_playlist'] + '#EXT-X-ENDLIST\n', True, 'off')]
    runs = []
    current = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *_args):
            pass

        def do_GET(self):
            name = urllib.parse.urlsplit(self.path).path.rsplit('/', 1)[-1]
            if name == 'page.html':
                body = PAGE.replace(b'__OBSERVE_MS__', str(current['seconds'] * 1000).encode())
                mime = 'text/html'
            elif name == 'master.m3u8':
                subtitle = current['subtitle'] != 'off'
                group = ('#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID="subs",NAME="English Forced",'
                         'LANGUAGE="en",DEFAULT=YES,AUTOSELECT=YES,FORCED=YES,URI="subs.m3u8"\n') if subtitle else ''
                body = ('#EXTM3U\n#EXT-X-VERSION:7\n' + group +
                        '#EXT-X-STREAM-INF:BANDWIDTH=25530329,RESOLUTION=3840x2020,'
                        'FRAME-RATE=23.976,VIDEO-RANGE=PQ,CODECS="dvh1.05.06,ec-3"' +
                        (',SUBTITLES="subs"' if subtitle else '') + '\nvideo.m3u8\n').encode()
                mime = 'application/vnd.apple.mpegurl'
            elif name == 'video.m3u8':
                body = current['playlist'].encode()
                mime = 'application/vnd.apple.mpegurl'
            elif name == 'subs.m3u8':
                lines = current['playlist'].splitlines()
                body = ('\n'.join(line.replace('.m4s', '.vtt') for line in lines
                                  if not line.startswith(('#EXT-X-MAP:', '#EXT-X-START:'))) + '\n').encode()
                mime = 'application/vnd.apple.mpegurl'
            elif re.fullmatch(r'seg[0-9]{5}\.vtt', name):
                ordinal = int(name[3:8])
                if ordinal >= len(expected):
                    self.send_error(404)
                    return
                if current['subtitle'] == 'cold' and ordinal == 1:
                    time.sleep(0.85)  # The incident's in-flight window publication.
                mapping = '' if current['subtitle'] == 'cold' and ordinal == 0 else (
                    'X-TIMESTAMP-MAP=MPEGTS:%d,LOCAL:00:00:00.000\n' % (sum(expected[:ordinal]) * 90))
                body = ('WEBVTT\n' + mapping + '\n').encode()
                mime = 'text/vtt'
            elif name in names:
                body = (media / name).read_bytes()
                mime = 'video/mp4'
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header('Content-Type', mime)
            self.send_header('Content-Length', str(len(body)))
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass  # A finished probe releases its own outstanding reads.

    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        for name, seconds, playlist, should_play, subtitle in cases:
            current.update(seconds=seconds, playlist=playlist, subtitle=subtitle)
            process = subprocess.run([str(binary), f'http://127.0.0.1:{server.server_port}/{name}/page.html',
                                      str(seconds)], capture_output=True, text=True, timeout=seconds + 15)
            events = [json.loads(line) for line in process.stdout.splitlines() if line.startswith('{')]
            frames = [row for row in events if row['event'] == 'first_frame']
            completed = [row for row in events if row['event'] == 'complete']
            played = bool(frames and frames[0]['elapsed_ms'] <= case['first_frame_budget_ms'])
            negative_is_startup_stall = bool(not frames and completed and completed[-1]['ready_state'] == 1
                                            and not any(row['event'] in ['error', 'play_rejected'] for row in events))
            continuity = bool(completed and (not should_play or completed[-1]['position_s'] >= seconds - 3))
            passed = (process.returncode == 0 and continuity and
                      (played if should_play else negative_is_startup_stall))
            runs.append(dict(name=name, passed=passed, should_play=should_play, events=events,
                             stderr=process.stderr, returncode=process.returncode))
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=2)
    receipt = dict(schema='plurx.safari-startup-acceptance.v1',
                   source_head=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
                   worktree_diff_sha256=hashlib.sha256(subprocess.check_output(['git', 'diff', 'HEAD'], cwd=ROOT)).hexdigest(),
                   case_sha256=digest(CASE), media_sha256=media_hashes,
                   native_platform=platform.platform(), probe_sha256=digest(swift),
                   observed_at_unix_ms=round(time.time() * 1000), runs=runs,
                   passed=all(run['passed'] for run in runs),
                   scope='Matched-source cutter output and production-pinned snapshot; not daemon HTTP or fleet acceptance')
    (evidence / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps({'passed': receipt['passed'], 'receipt': str(evidence / 'receipt.json'),
                      'runs': [{'name': row['name'], 'passed': row['passed']} for row in runs]}))
    raise SystemExit(0 if receipt['passed'] else 1)


if __name__ == '__main__':
    main()
