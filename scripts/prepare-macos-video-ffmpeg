#!/usr/bin/env python3
"""Prepare pinned Jellyfin + explicit Dolby patch in a new private directory.

This prepares inspectable source and a private build entry point, not a
qualified executable. The entry point reuses Jellyfin dependency recipes but
skips its global Homebrew installer. No installed package is changed.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import tarfile


def load_package_script():
    path = Path(__file__).with_name("build-macos-video-ffmpeg")
    loader = importlib.machinery.SourceFileLoader("mac_video_package", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def load_dependency_offers():
    path = Path(__file__).with_name("macos-video-dependency-offers.py")
    loader = importlib.machinery.SourceFileLoader("mac_video_dependency_offers", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def prepare(archive, output, jobs, dependency_source=None):
    package = load_package_script()
    if package.digest(archive) != package.SOURCE_SHA256:
        raise ValueError("source archive checksum mismatch")
    if not output.is_absolute() or output.exists():
        raise ValueError("output must be an absolute new private directory")
    repo = Path(__file__).resolve().parent.parent
    if output.is_relative_to(repo) or any(output.is_relative_to(Path(p)) for p in
            ["/Applications", "/Library", "/System", "/usr", "/opt"]):
        raise ValueError("source must remain outside checkout and global paths")
    output.mkdir(parents=True)
    import shutil
    shutil.copyfile(archive, output / "jellyfin-ffmpeg-source.tar.gz")
    source = output / "source"
    source.mkdir()
    with tarfile.open(archive) as tar:
        for member in tar:
            rel = Path(*Path(member.name).parts[1:])
            if rel.is_absolute() or ".." in rel.parts or member.issym() or member.islnk():
                raise ValueError("unsafe source member")
            if member.isfile():
                target = source / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(tar.extractfile(member).read())
                target.chmod(member.mode & 0o777)
    patches = []
    for line in (source / "debian/patches/series").read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            patches.append(source / "debian/patches" / line.split()[0])
    local = sorted(Path(__file__).with_name("macos-video-ffmpeg-patches").glob("*.patch"))
    if not local:
        raise ValueError("no local Dolby contract patch")
    retained = output / "local-patches"
    retained.mkdir()
    for patch in local:
        shutil.copyfile(patch, retained / patch.name)
    for patch in patches + local:
        subprocess.run(["/usr/bin/patch", "-p1", "-E", "--batch", "--forward", "-i", str(patch.resolve())],
                       cwd=source, check=True, stdout=subprocess.DEVNULL)
    # Upstream setup installs/uninstalls global tools: replace only that stage.
    # Dependency recipes still install statically into this private prefix.
    setup = source / "builder/images/macos/00-dep.sh"
    setup.write_text("#!/bin/bash\nffbuild_macbase() { :; }\n")
    builder = source / "builder/buildmac.sh"
    text = builder.read_text().replace('export FFBUILD_PREFIX="/opt/ffbuild/prefix"',
            'export FFBUILD_PREFIX="${PLURX_BUILD_ROOT:?}/prefix"')
    start = text.index('if [[ -f "debian/patches/series" ]]')
    end = text.index("\n./configure", start)
    text = text[:start] + text[end:]
    text = text.replace("--prefix=/ffbuild/prefix", '--prefix="$FFBUILD_PREFIX"')
    builder.write_text(text)
    # GNU libtool is an autotools dependency, but this recipe requires Apple's
    # archive combiner. A PATH-selected GNU tool leaves a Main-only archive.
    x265 = source / "builder/scripts.d/50-x265.sh"
    x265.write_text(x265.read_text().replace(
        "libtool -static -o libx265.a", "/usr/bin/libtool -static -o libx265.a"))
    tools = output / "bin"
    tools.mkdir()
    for name, script in [("git-mini-clone", "git-mini-clone.sh"),
                         ("retry-tool", "retry-tool.sh"), ("check-wget", "check-wget.sh")]:
        p = tools / name
        p.write_bytes((source / "builder/images/base" / script).read_bytes())
        p.chmod(0o755)
    (tools / "nproc").write_text(f"#!/bin/sh\nprintf '%s\\n' '{jobs}'\n")
    (tools / "nproc").chmod(0o755)
    dependency_facts = None
    if dependency_source is not None:
        offers = load_dependency_offers()
        dependency_facts = offers.stage_offers(dependency_source, output / "dependency-source-inputs")
        retained_helpers = output / "extraction-helpers"
        retained_helpers.mkdir()
        for name in ("macos-video-dependency-offers.py", "macos-video-dependency-sources.json"):
            shutil.copyfile(Path(__file__).with_name(name), retained_helpers / name)
        # Keep the standard pinned recipes; replace only their fetch/extraction
        # operations with verified source offers. No synthetic .git is created.
        import re
        for recipe in sorted((source / "builder/scripts.d").rglob("*.sh")):
            text = recipe.read_text()
            text = re.sub(r'git-mini-clone "\$SCRIPT_REPO" "\$SCRIPT_COMMIT" ([\w-]+)',
                          r'archive-source \1 "$SCRIPT_COMMIT" \1', text)
            for role in ("x265", "svtav1"):
                text = text.replace('git clone "$SCRIPT_REPO" ' + role + '\n    cd ' + role + '\n    git checkout "$SCRIPT_COMMIT"',
                                    'archive-source ' + role + ' "$SCRIPT_COMMIT" ' + role + '\n    cd ' + role)
            text = text.replace('retry-tool sh -c "rm -rf lame && svn checkout \'${SCRIPT_REPO}@${SCRIPT_REV}\' lame"',
                                'archive-source lame "$SCRIPT_REV" lame')
            text = text.replace('git submodule update --init --recursive', ': # verified retained submodules extracted with source')
            recipe.write_text(text)
        # The exact file name is pinned in the source, but keep discovery robust
        # to its numeric prefix without changing the selected source identity.
        for recipe in (source / "builder/images/macos").glob("*.sh"):
            text = recipe.read_text().replace('git clone https://github.com/glennrp/libpng.git\n  cd libpng\n  git checkout v1.6.58',
                                            'archive-source libpng v1.6.58 libpng\n  cd libpng')
            for name in ("gettext.tar.gz", "broti.tar.gz"):
                text = re.sub(r'^  wget .* -O ' + re.escape(name) + r'$',
                              '  archive-upstream ' + name, text, flags=re.MULTILINE)
            recipe.write_text(text)
        bindings = {}
        for recipe in sorted((source / "builder").rglob("*.sh")):
            text = recipe.read_text()
            relative = str(recipe.relative_to(source))
            roles = re.findall(r"archive-source ([\w-]+) ", text)
            roles += re.findall(r"archive-upstream ([\w.-]+)", text)
            if not roles:
                continue
            text = text.replace("archive-source ", "archive-source --recipe " + relative + " ")
            text = text.replace("archive-upstream ", "archive-upstream --recipe " + relative + " ")
            recipe.write_text(text)
            bindings[relative] = {"sha256": package.digest(recipe), "roles": sorted(set(roles))}
        (output / "dependency-recipe-bindings.json").write_text(json.dumps(bindings, indent=2, sort_keys=True) + "\n")
        dependency_facts["recipe_bindings_sha256"] = package.digest(output / "dependency-recipe-bindings.json")
        dependency_facts["helper_sha256"] = package.digest(retained_helpers / "macos-video-dependency-offers.py")
        dependency_facts["policy_sha256"] = package.digest(retained_helpers / "macos-video-dependency-sources.json")
        fetch = tools / "archive-source"
        fetch.write_text('#!/bin/sh\nexec python3 "${PLURX_BUILD_ROOT:?}/extraction-helpers/macos-video-dependency-offers.py" --root "$PLURX_BUILD_ROOT" "$@"\n')
        fetch.chmod(0o755)
        upstream = tools / "archive-upstream"
        upstream.write_text('#!/bin/sh\nexec python3 "${PLURX_BUILD_ROOT:?}/extraction-helpers/macos-video-dependency-offers.py" --root "$PLURX_BUILD_ROOT" --upstream "$@"\n')
        upstream.chmod(0o755)
    retained_helpers = output / "extraction-helpers"
    retained_helpers.mkdir(exist_ok=True)
    for name in ("build-macos-video-ffmpeg", "macos-video-dependency-sources.json"):
        shutil.copyfile(Path(__file__).with_name(name), retained_helpers / name)
    entry = output / "build.sh"
    entry.write_text('#!/bin/bash\nset -euo pipefail\nPLURX_BUILD_ROOT="$(cd "$(dirname "$0")" && pwd)"\nexport PLURX_BUILD_ROOT\nexport PATH="$PLURX_BUILD_ROOT/bin:$PATH"\nexport ACLOCAL_PATH="$PLURX_BUILD_ROOT/prefix/share/aclocal${ACLOCAL_PATH:+:$ACLOCAL_PATH}"\nfor tool in wget git cmake meson ninja pkg-config autoconf automake libtoolize glibtoolize nasm timeout shuf makeinfo; do\n    command -v "$tool" >/dev/null || { echo "Missing build tool: $tool" >&2; exit 1; }\ndone\nxcrun -sdk macosx metal -v\n/bin/bash "$PLURX_BUILD_ROOT/source/builder/buildmac.sh"\npython3 "$PLURX_BUILD_ROOT/extraction-helpers/build-macos-video-ffmpeg" --font-tools-build "$PLURX_BUILD_ROOT" --jobs "$(nproc)"\n')
    entry.chmod(0o755)
    facts = {"schema_version": 1, "source_commit": package.COMMIT,
             "source_sha256": package.SOURCE_SHA256,
             "local_patches": {p.name: package.digest(p) for p in local},
             "contract": {"renderer": "require_dovi=1", "decoder": "hwaccel_flags=+require_hardware",
                          "parse_errors": "err_detect=explode", "decode_metadata": "strict_dovi=1", "tool_failure": "xerror",
                          "color": "P5 IPT-PQ-C2; no generic default color",
                          "bwdif": "Metal shader parameter buffer index 0"},
             "qualification": "source-prepared-only", "jobs": jobs,
             "font_tools_builder_sha256": package.digest(retained_helpers / "build-macos-video-ffmpeg")}
    if dependency_facts is not None:
        facts["dependency_source_inputs"] = dependency_facts
    (output / "prepared-source.json").write_text(json.dumps(facts, indent=2, sort_keys=True) + "\n")
    return facts


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-archive", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--jobs", type=int, default=2)
    parser.add_argument("--dependency-source", type=Path, help="Verified pinned dependency source-offer directory; no Git metadata reconstruction")
    args = parser.parse_args()
    if not 1 <= args.jobs <= 8:
        parser.error("jobs must be between 1 and 8")
    print(json.dumps(prepare(args.source_archive, args.output, args.jobs, args.dependency_source), sort_keys=True))


if __name__ == "__main__":
    main()
