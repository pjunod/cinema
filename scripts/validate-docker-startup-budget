#!/usr/bin/env python3
"""Refuse a Compose deploy whose readiness grace is shorter than startup."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from decimal import Decimal, InvalidOperation
import json
import os
from pathlib import Path, PurePosixPath
import posixpath
import re
import shlex
import subprocess
import sys
import tomllib
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
DEPLOY = ROOT / "deploy"
CHUNK_ENV = "PLURX_CLUSTER_SNAPSHOT_CHUNK_TIMEOUT_SECS"
TRANSFER_ENV = "PLURX_CLUSTER_SNAPSHOT_TRANSFER_TIMEOUT_SECS"
INSTALL_ENV = "PLURX_CLUSTER_INSTALL_SNAPSHOT_TIMEOUT_SECS"
CONFIG_ENV = "PLURX_CONFIG"
HEALTH_ENV = "PLURX_HEALTH_START_PERIOD"
COMPOSE_FILE = DEPLOY / "docker-compose.yml"
TRACKED_DEFAULT = re.compile(
    r'(?m)^[ \t]*start_period:[ \t]*"\$\{' + HEALTH_ENV + r':-([^}]+)\}"[ \t]*$'
)
PHASE_NAMES = (
    "HIQLITE_HEALTH_TIMEOUT",
    "MEMBERSHIP_ADMISSION_TIMEOUT",
    "SNAPSHOT_CATCHUP_GRACE",
)
DEFAULT_CONFIG_PATHS = ("plurx.toml", "/etc/plurx/plurx.toml")
DURATION_PART = re.compile(r"(\d+(?:\.\d+)?)(ns|us|µs|μs|ms|s|m|h)")
DURATION_SECONDS = {
    "ns": Decimal("0.000000001"),
    "us": Decimal("0.000001"),
    "µs": Decimal("0.000001"),
    "μs": Decimal("0.000001"),
    "ms": Decimal("0.001"),
    "s": Decimal(1),
    "m": Decimal(60),
    "h": Decimal(3_600),
}


class BudgetError(ValueError):
    """A deployment input cannot prove a safe startup budget."""


@dataclass(frozen=True)
class SourceLimits:
    default_chunk_seconds: int
    minimum_chunk_seconds: int
    maximum_chunk_seconds: int
    default_transfer_seconds: int
    minimum_transfer_seconds: int
    maximum_transfer_seconds: int
    default_install_seconds: int
    minimum_install_seconds: int
    maximum_install_seconds: int
    phase_seconds: tuple[tuple[str, int], ...]

    @property
    def startup_allowance_seconds(self) -> int:
        return sum(seconds for _, seconds in self.phase_seconds)


@dataclass(frozen=True)
class Budget:
    health_seconds: Decimal
    chunk_seconds: int
    transfer_seconds: int
    install_seconds: int
    startup_allowance_seconds: int
    chunk_source: str
    transfer_source: str
    install_source: str

    @property
    def required_seconds(self) -> int:
        return (
            self.transfer_seconds
            + self.install_seconds
            + self.startup_allowance_seconds
        )


def source_integer(source: str, name: str) -> int:
    match = re.search(rf"(?m)^pub const {re.escape(name)}: u64 = ([\d_]+);$", source)
    if match is None:
        raise BudgetError(f"could not read Rust constant {name}")
    return int(match.group(1).replace("_", ""))


def source_duration(source: str, name: str) -> int:
    match = re.search(
        rf"(?m)^const {re.escape(name)}: Duration = Duration::from_secs\((\d+)\);$",
        source,
    )
    if match is None:
        raise BudgetError(f"could not read Rust startup phase {name}")
    return int(match.group(1))


def load_source_limits(root: Path = ROOT) -> SourceLimits:
    config = (root / "crates/plurx-core/src/config.rs").read_text(encoding="utf-8")
    migration = (root / "crates/plurx-core/src/cluster/migration.rs").read_text(
        encoding="utf-8"
    )
    return SourceLimits(
        default_chunk_seconds=source_integer(
            config, "DEFAULT_SNAPSHOT_CHUNK_TIMEOUT_SECS"
        ),
        minimum_chunk_seconds=source_integer(
            config, "MIN_SNAPSHOT_CHUNK_TIMEOUT_SECS"
        ),
        maximum_chunk_seconds=source_integer(
            config, "MAX_SNAPSHOT_CHUNK_TIMEOUT_SECS"
        ),
        default_transfer_seconds=source_integer(
            config, "DEFAULT_SNAPSHOT_TRANSFER_TIMEOUT_SECS"
        ),
        minimum_transfer_seconds=source_integer(
            config, "MIN_SNAPSHOT_TRANSFER_TIMEOUT_SECS"
        ),
        maximum_transfer_seconds=source_integer(
            config, "MAX_SNAPSHOT_TRANSFER_TIMEOUT_SECS"
        ),
        default_install_seconds=source_integer(
            config, "DEFAULT_INSTALL_SNAPSHOT_TIMEOUT_SECS"
        ),
        minimum_install_seconds=source_integer(
            config, "MIN_INSTALL_SNAPSHOT_TIMEOUT_SECS"
        ),
        maximum_install_seconds=source_integer(
            config, "MAX_INSTALL_SNAPSHOT_TIMEOUT_SECS"
        ),
        phase_seconds=tuple(
            (name, source_duration(migration, name)) for name in PHASE_NAMES
        ),
    )


def parse_duration(value: object, label: str) -> Decimal:
    if not isinstance(value, str) or not value:
        raise BudgetError(f"{label} must be a non-empty Docker duration")
    offset = 0
    seconds = Decimal(0)
    while offset < len(value):
        part = DURATION_PART.match(value, offset)
        if part is None:
            raise BudgetError(f"{label}={value!r} is not a Docker duration")
        try:
            seconds += Decimal(part.group(1)) * DURATION_SECONDS[part.group(2)]
        except InvalidOperation as error:
            raise BudgetError(f"{label}={value!r} is not a Docker duration") from error
        offset = part.end()
    if seconds <= 0:
        raise BudgetError(f"{label} must be greater than zero")
    return seconds


def service_environment(service: dict[str, Any]) -> dict[str, str]:
    environment = service.get("environment", {})
    if isinstance(environment, dict):
        return {
            str(name): "" if value is None else str(value)
            for name, value in environment.items()
        }
    if isinstance(environment, list):
        resolved: dict[str, str] = {}
        for entry in environment:
            name, separator, value = str(entry).partition("=")
            resolved[name] = value if separator else os.environ.get(name, "")
        return resolved
    raise BudgetError("resolved plurxd environment is neither an object nor a list")


def service_config_argument(service: dict[str, Any]) -> str | None:
    arguments: list[str] = []
    for field in ("entrypoint", "command"):
        value = service.get(field)
        if isinstance(value, list):
            arguments.extend(str(argument) for argument in value)
        elif isinstance(value, str):
            try:
                arguments.extend(shlex.split(value))
            except ValueError as error:
                raise BudgetError(
                    f"resolved plurxd {field} cannot be parsed: {error}"
                ) from error
        elif value is not None:
            raise BudgetError(
                f"resolved plurxd {field} is neither a string nor a list"
            )

    for index, argument in enumerate(arguments):
        if argument.startswith("--config="):
            value = argument.partition("=")[2]
            if not value:
                raise BudgetError("resolved plurxd --config argument is empty")
            return value
        if argument == "--config":
            if index + 1 >= len(arguments) or not arguments[index + 1]:
                raise BudgetError("resolved plurxd --config argument has no path")
            return arguments[index + 1]
    return None


def container_path(value: str, working_directory: str) -> PurePosixPath:
    if not value.startswith("/"):
        value = posixpath.join(working_directory, value)
    return PurePosixPath(posixpath.normpath(value))


def mapped_config_file(
    document: dict[str, Any],
    service: dict[str, Any],
    wanted: PurePosixPath,
) -> tuple[Path | None, bool]:
    """Return a readable host path and whether an opaque mount covers it."""

    for config in service.get("configs", []) or []:
        if not isinstance(config, dict):
            continue
        source_name = config.get("source")
        if source_name is None:
            continue
        target = config.get("target") or f"/{source_name}"
        if container_path(str(target), "/") != wanted:
            continue
        source = (document.get("configs", {}) or {}).get(str(source_name), {})
        source_file = source.get("file") if isinstance(source, dict) else None
        if source_file:
            return Path(str(source_file)), False
        return None, True

    candidates: list[tuple[int, Path | None]] = []
    for volume in service.get("volumes", []) or []:
        if not isinstance(volume, dict) or "target" not in volume:
            continue
        target = container_path(str(volume["target"]), "/")
        try:
            relative = wanted.relative_to(target)
        except ValueError:
            continue
        depth = len(target.parts)
        if volume.get("type") != "bind" or not volume.get("source"):
            candidates.append((depth, None))
            continue
        source = Path(str(volume["source"]))
        candidate = source if not relative.parts else source.joinpath(*relative.parts)
        candidates.append((depth, candidate))

    if candidates:
        deepest = max(depth for depth, _ in candidates)
        paths = [path for depth, path in candidates if depth == deepest]
        if any(path is None for path in paths):
            return None, True
        return paths[0], False
    return None, False


def parse_snapshot_value(
    value: object,
    *,
    label: str,
    minimum: int,
    maximum: int,
    source: str,
) -> int:
    if isinstance(value, bool):
        raise BudgetError(f"{label} from {source} must be an integer")
    if isinstance(value, int):
        parsed = value
    elif isinstance(value, str) and re.fullmatch(r"[0-9]+", value):
        parsed = int(value)
    else:
        raise BudgetError(f"{label} from {source} must be an integer")
    if not minimum <= parsed <= maximum:
        raise BudgetError(
            f"{label} from {source} must be between {minimum}s and {maximum}s"
        )
    return parsed


def timeouts_from_toml(
    path: Path, limits: SourceLimits
) -> tuple[tuple[int, str], tuple[int, str], tuple[int, str]]:
    try:
        with path.open("rb") as handle:
            document = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise BudgetError(f"cannot read production config {path}: {error}") from error
    cluster = document.get("cluster", {})
    if not isinstance(cluster, dict):
        raise BudgetError(f"production config {path} has a non-table [cluster]")
    default_source = f"{path} (built-in default)"
    chunk = (
        (
            parse_snapshot_value(
                cluster["snapshot_chunk_timeout_secs"],
                label="snapshot chunk timeout",
                minimum=limits.minimum_chunk_seconds,
                maximum=limits.maximum_chunk_seconds,
                source=str(path),
            ),
            str(path),
        )
        if "snapshot_chunk_timeout_secs" in cluster
        else (limits.default_chunk_seconds, default_source)
    )
    transfer = (
        (
            parse_snapshot_value(
                cluster["snapshot_transfer_timeout_secs"],
                label="snapshot transfer timeout",
                minimum=limits.minimum_transfer_seconds,
                maximum=limits.maximum_transfer_seconds,
                source=str(path),
            ),
            str(path),
        )
        if "snapshot_transfer_timeout_secs" in cluster
        else (limits.default_transfer_seconds, default_source)
    )
    install = (
        (
            parse_snapshot_value(
                cluster["install_snapshot_timeout_secs"],
                label="snapshot install timeout",
                minimum=limits.minimum_install_seconds,
                maximum=limits.maximum_install_seconds,
                source=str(path),
            ),
            str(path),
        )
        if "install_snapshot_timeout_secs" in cluster
        else (limits.default_install_seconds, default_source)
    )
    return chunk, transfer, install


def effective_snapshot_timeouts(
    document: dict[str, Any], service: dict[str, Any], limits: SourceLimits
) -> tuple[tuple[int, str], tuple[int, str], tuple[int, str]]:
    environment = service_environment(service)
    chunk_override = environment.get(CHUNK_ENV, "")
    transfer_override = environment.get(TRANSFER_ENV, "")
    install_override = environment.get(INSTALL_ENV, "")
    chunk = (
        (
            parse_snapshot_value(
                chunk_override,
                label="snapshot chunk timeout",
                minimum=limits.minimum_chunk_seconds,
                maximum=limits.maximum_chunk_seconds,
                source=CHUNK_ENV,
            ),
            CHUNK_ENV,
        )
        if chunk_override
        else None
    )
    transfer = (
        (
            parse_snapshot_value(
                transfer_override,
                label="snapshot transfer timeout",
                minimum=limits.minimum_transfer_seconds,
                maximum=limits.maximum_transfer_seconds,
                source=TRANSFER_ENV,
            ),
            TRANSFER_ENV,
        )
        if transfer_override
        else None
    )
    install = (
        (
            parse_snapshot_value(
                install_override,
                label="snapshot install timeout",
                minimum=limits.minimum_install_seconds,
                maximum=limits.maximum_install_seconds,
                source=INSTALL_ENV,
            ),
            INSTALL_ENV,
        )
        if install_override
        else None
    )
    if chunk is not None and transfer is not None and install is not None:
        return chunk, transfer, install

    working_directory = str(service.get("working_dir") or "/")
    cli_config = service_config_argument(service)
    explicit = cli_config or environment.get(CONFIG_ENV, "")
    explicit_source = "--config" if cli_config else CONFIG_ENV
    names = (explicit,) if explicit else DEFAULT_CONFIG_PATHS
    opaque_paths: list[str] = []
    for name in names:
        wanted = container_path(name, working_directory)
        mapped, opaque = mapped_config_file(document, service, wanted)
        if mapped is not None:
            if mapped.is_file():
                toml_chunk, toml_transfer, toml_install = timeouts_from_toml(
                    mapped, limits
                )
                return (
                    chunk or toml_chunk,
                    transfer or toml_transfer,
                    install or toml_install,
                )
            if explicit:
                raise BudgetError(
                    f"{explicit_source}={name!r} maps to missing host file {mapped}"
                )
            continue
        if opaque:
            opaque_paths.append(str(wanted))
        elif explicit:
            raise BudgetError(
                f"{explicit_source}={name!r} is not backed by a Compose bind or file config; "
                f"set {CHUNK_ENV}, {TRANSFER_ENV}, and {INSTALL_ENV} explicitly "
                "so the preflight can prove the budget"
            )

    if opaque_paths:
        paths = ", ".join(opaque_paths)
        source = f"opaque config mount at {paths} (maximum assumed)"
        return (
            chunk or (limits.maximum_chunk_seconds, source),
            transfer or (limits.maximum_transfer_seconds, source),
            install or (limits.maximum_install_seconds, source),
        )
    return (
        chunk or (limits.default_chunk_seconds, "built-in default"),
        transfer or (limits.default_transfer_seconds, "built-in default"),
        install or (limits.default_install_seconds, "built-in default"),
    )


def validate_snapshot_combination(
    chunk_seconds: int,
    chunk_source: str,
    transfer_seconds: int,
    transfer_source: str,
) -> None:
    if chunk_seconds > transfer_seconds:
        raise BudgetError(
            f"snapshot chunk timeout {chunk_seconds}s from {chunk_source} exceeds "
            f"snapshot transfer timeout {transfer_seconds}s from {transfer_source}"
        )


def plurxd_service(document: dict[str, Any]) -> dict[str, Any]:
    services = document.get("services", {})
    service = services.get("plurxd") if isinstance(services, dict) else None
    if not isinstance(service, dict):
        raise BudgetError("resolved Compose config has no plurxd service")
    return service


def resolved_health_seconds(service: dict[str, Any]) -> Decimal:
    healthcheck = service.get("healthcheck")
    if not isinstance(healthcheck, dict) or healthcheck.get("disable") is True:
        raise BudgetError("resolved plurxd service has no enabled healthcheck")
    return parse_duration(
        healthcheck.get("start_period"), "plurxd health start period"
    )


def tracked_default_health_seconds(path: Path = COMPOSE_FILE) -> Decimal:
    """Return the health grace this repository ships when nobody sets one."""

    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise BudgetError(f"cannot read {path}: {error}") from error
    match = TRACKED_DEFAULT.search(text)
    if match is None:
        raise BudgetError(
            f"{path} no longer interpolates {HEALTH_ENV} with a tracked default"
        )
    return parse_duration(match.group(1), f"tracked {path.name} start period")


def start_period_for_deployment(
    document: dict[str, Any],
    limits: SourceLimits | None = None,
    compose_file: Path = COMPOSE_FILE,
) -> tuple[str, str]:
    """Return the health grace a rollout should use, and how it was chosen.

    The grace and the snapshot deadline are one budget set in two places, and
    the deadline commonly lives in a bind-mounted production TOML this
    repository never sees. Asking an operator to mirror it into `deploy/.env`
    by hand meant the first report of a mismatch was a refused deploy. So a
    grace nobody chose is derived here from the same deadline and phases the
    refusal is computed from, and cannot drift.

    Whether anybody chose is answered by Compose, not by reading `.env` and
    hoping to agree with it: a resolved grace that is anything other than this
    repository's own interpolation default came from a shell variable, an env
    file, or a literal pinned in an override, at Compose's own precedence. Such
    a value is returned untouched even when it is too short — `validate_document`
    then refuses it by name, because a short grace is how a build that can never
    become ready gets reported instead of waited out.
    """

    limits = limits or load_source_limits()
    service = plurxd_service(document)
    resolved = resolved_health_seconds(service)
    (
        (chunk_seconds, chunk_source),
        (transfer_seconds, transfer_source),
        (install_seconds, install_source),
    ) = effective_snapshot_timeouts(document, service, limits)
    validate_snapshot_combination(
        chunk_seconds, chunk_source, transfer_seconds, transfer_source
    )
    required = (
        transfer_seconds + install_seconds + limits.startup_allowance_seconds
    )
    rendered = f"{display_seconds(resolved)}s"
    if resolved >= required:
        return rendered, f"{rendered} resolved by Compose, which covers the budget"
    if resolved != tracked_default_health_seconds(compose_file):
        return (
            rendered,
            f"{rendered} chosen by this deployment and shorter than the "
            f"{required}s it needs; left as written for the preflight to refuse",
        )
    return (
        f"{required}s",
        f"{required}s derived from snapshot transfer timeout {transfer_seconds}s "
        f"({transfer_source}), install timeout {install_seconds}s "
        f"({install_source}), plus the named startup phases "
        f"{limits.startup_allowance_seconds}s",
    )


def validate_document(
    document: dict[str, Any], limits: SourceLimits | None = None
) -> Budget:
    limits = limits or load_source_limits()
    service = plurxd_service(document)
    health_seconds = resolved_health_seconds(service)
    (
        (chunk_seconds, chunk_source),
        (transfer_seconds, transfer_source),
        (install_seconds, install_source),
    ) = effective_snapshot_timeouts(document, service, limits)
    validate_snapshot_combination(
        chunk_seconds, chunk_source, transfer_seconds, transfer_source
    )
    budget = Budget(
        health_seconds=health_seconds,
        chunk_seconds=chunk_seconds,
        transfer_seconds=transfer_seconds,
        install_seconds=install_seconds,
        startup_allowance_seconds=limits.startup_allowance_seconds,
        chunk_source=chunk_source,
        transfer_source=transfer_source,
        install_source=install_source,
    )
    if budget.health_seconds < budget.required_seconds:
        raise BudgetError(
            f"plurxd health start period is {budget.health_seconds}s, but snapshot transfer "
            f"timeout {budget.transfer_seconds}s from {budget.transfer_source}, install timeout "
            f"{budget.install_seconds}s from {budget.install_source}, plus the named startup "
            f"phases {budget.startup_allowance_seconds}s requires at least "
            f"{budget.required_seconds}s"
        )
    return budget


def resolved_compose_document() -> dict[str, Any]:
    command = ["docker", "compose", "config", "--format", "json"]
    try:
        result = subprocess.run(
            command,
            cwd=DEPLOY,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as error:
        raise BudgetError(f"cannot run {' '.join(command)}: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise BudgetError(f"docker compose config failed: {detail}")
    try:
        document = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise BudgetError("docker compose config did not return JSON") from error
    if not isinstance(document, dict):
        raise BudgetError("docker compose config returned a non-object document")
    return document


def display_seconds(seconds: Decimal) -> str:
    rendered = format(seconds, "f")
    if "." in rendered:
        rendered = rendered.rstrip("0").rstrip(".")
    return rendered


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="validate Docker readiness grace before a Compose deployment"
    )
    parser.add_argument(
        "--compose-json",
        type=Path,
        help="validate an already-resolved Compose JSON document (test/debug only)",
    )
    parser.add_argument(
        "--emit-start-period",
        action="store_true",
        help=(
            "print the health start period a rollout should run with, deriving "
            "one when the operator has not chosen a value"
        ),
    )
    args = parser.parse_args(argv)
    try:
        if args.compose_json is None:
            document = resolved_compose_document()
        else:
            document = json.loads(args.compose_json.read_text(encoding="utf-8"))
            if not isinstance(document, dict):
                raise BudgetError("resolved Compose JSON must be an object")
        if args.emit_start_period:
            value, explanation = start_period_for_deployment(document)
            print(f"docker startup budget start period: {explanation}", file=sys.stderr)
            print(value)
            return 0
        budget = validate_document(document)
    except (BudgetError, OSError, json.JSONDecodeError) as error:
        print(
            f"docker startup budget preflight failed; nothing was changed: {error}",
            file=sys.stderr,
        )
        return 2

    print(
        "docker startup budget ok: "
        f"health={display_seconds(budget.health_seconds)}s, "
        f"snapshot-chunk={budget.chunk_seconds}s ({budget.chunk_source}), "
        f"snapshot-transfer={budget.transfer_seconds}s ({budget.transfer_source}), "
        f"snapshot-install={budget.install_seconds}s ({budget.install_source}), "
        f"startup-phases={budget.startup_allowance_seconds}s, "
        f"required={budget.required_seconds}s"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
