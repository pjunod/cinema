#!/usr/bin/env python3
"""Refuse a Compose deploy whose readiness grace is shorter than startup."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from decimal import Decimal, InvalidOperation
import json
import os
from pathlib import Path, PurePosixPath
import posixpath
import re
import shlex
import subprocess
import sys
import tomllib
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
DEPLOY = ROOT / "deploy"
SNAPSHOT_ENV = "PLURX_CLUSTER_INSTALL_SNAPSHOT_TIMEOUT_SECS"
CONFIG_ENV = "PLURX_CONFIG"
PHASE_NAMES = (
    "HIQLITE_HEALTH_TIMEOUT",
    "MEMBERSHIP_ADMISSION_TIMEOUT",
    "SNAPSHOT_CATCHUP_GRACE",
)
DEFAULT_CONFIG_PATHS = ("plurx.toml", "/etc/plurx/plurx.toml")
DURATION_PART = re.compile(r"(\d+(?:\.\d+)?)(ns|us|µs|μs|ms|s|m|h)")
DURATION_SECONDS = {
    "ns": Decimal("0.000000001"),
    "us": Decimal("0.000001"),
    "µs": Decimal("0.000001"),
    "μs": Decimal("0.000001"),
    "ms": Decimal("0.001"),
    "s": Decimal(1),
    "m": Decimal(60),
    "h": Decimal(3_600),
}


class BudgetError(ValueError):
    """A deployment input cannot prove a safe startup budget."""


@dataclass(frozen=True)
class SourceLimits:
    default_snapshot_seconds: int
    minimum_snapshot_seconds: int
    maximum_snapshot_seconds: int
    phase_seconds: tuple[tuple[str, int], ...]

    @property
    def startup_allowance_seconds(self) -> int:
        return sum(seconds for _, seconds in self.phase_seconds)


@dataclass(frozen=True)
class Budget:
    health_seconds: Decimal
    snapshot_seconds: int
    startup_allowance_seconds: int
    snapshot_source: str

    @property
    def required_seconds(self) -> int:
        return self.snapshot_seconds + self.startup_allowance_seconds


def source_integer(source: str, name: str) -> int:
    match = re.search(rf"(?m)^pub const {re.escape(name)}: u64 = ([\d_]+);$", source)
    if match is None:
        raise BudgetError(f"could not read Rust constant {name}")
    return int(match.group(1).replace("_", ""))


def source_duration(source: str, name: str) -> int:
    match = re.search(
        rf"(?m)^const {re.escape(name)}: Duration = Duration::from_secs\((\d+)\);$",
        source,
    )
    if match is None:
        raise BudgetError(f"could not read Rust startup phase {name}")
    return int(match.group(1))


def load_source_limits(root: Path = ROOT) -> SourceLimits:
    config = (root / "crates/plurx-core/src/config.rs").read_text(encoding="utf-8")
    migration = (root / "crates/plurx-core/src/cluster/migration.rs").read_text(
        encoding="utf-8"
    )
    return SourceLimits(
        default_snapshot_seconds=source_integer(
            config, "DEFAULT_INSTALL_SNAPSHOT_TIMEOUT_SECS"
        ),
        minimum_snapshot_seconds=source_integer(
            config, "MIN_INSTALL_SNAPSHOT_TIMEOUT_SECS"
        ),
        maximum_snapshot_seconds=source_integer(
            config, "MAX_INSTALL_SNAPSHOT_TIMEOUT_SECS"
        ),
        phase_seconds=tuple(
            (name, source_duration(migration, name)) for name in PHASE_NAMES
        ),
    )


def parse_duration(value: object, label: str) -> Decimal:
    if not isinstance(value, str) or not value:
        raise BudgetError(f"{label} must be a non-empty Docker duration")
    offset = 0
    seconds = Decimal(0)
    while offset < len(value):
        part = DURATION_PART.match(value, offset)
        if part is None:
            raise BudgetError(f"{label}={value!r} is not a Docker duration")
        try:
            seconds += Decimal(part.group(1)) * DURATION_SECONDS[part.group(2)]
        except InvalidOperation as error:
            raise BudgetError(f"{label}={value!r} is not a Docker duration") from error
        offset = part.end()
    if seconds <= 0:
        raise BudgetError(f"{label} must be greater than zero")
    return seconds


def service_environment(service: dict[str, Any]) -> dict[str, str]:
    environment = service.get("environment", {})
    if isinstance(environment, dict):
        return {
            str(name): "" if value is None else str(value)
            for name, value in environment.items()
        }
    if isinstance(environment, list):
        resolved: dict[str, str] = {}
        for entry in environment:
            name, separator, value = str(entry).partition("=")
            resolved[name] = value if separator else os.environ.get(name, "")
        return resolved
    raise BudgetError("resolved plurxd environment is neither an object nor a list")


def service_config_argument(service: dict[str, Any]) -> str | None:
    arguments: list[str] = []
    for field in ("entrypoint", "command"):
        value = service.get(field)
        if isinstance(value, list):
            arguments.extend(str(argument) for argument in value)
        elif isinstance(value, str):
            try:
                arguments.extend(shlex.split(value))
            except ValueError as error:
                raise BudgetError(
                    f"resolved plurxd {field} cannot be parsed: {error}"
                ) from error
        elif value is not None:
            raise BudgetError(
                f"resolved plurxd {field} is neither a string nor a list"
            )

    for index, argument in enumerate(arguments):
        if argument.startswith("--config="):
            value = argument.partition("=")[2]
            if not value:
                raise BudgetError("resolved plurxd --config argument is empty")
            return value
        if argument == "--config":
            if index + 1 >= len(arguments) or not arguments[index + 1]:
                raise BudgetError("resolved plurxd --config argument has no path")
            return arguments[index + 1]
    return None


def container_path(value: str, working_directory: str) -> PurePosixPath:
    if not value.startswith("/"):
        value = posixpath.join(working_directory, value)
    return PurePosixPath(posixpath.normpath(value))


def mapped_config_file(
    document: dict[str, Any],
    service: dict[str, Any],
    wanted: PurePosixPath,
) -> tuple[Path | None, bool]:
    """Return a readable host path and whether an opaque mount covers it."""

    for config in service.get("configs", []) or []:
        if not isinstance(config, dict):
            continue
        source_name = config.get("source")
        if source_name is None:
            continue
        target = config.get("target") or f"/{source_name}"
        if container_path(str(target), "/") != wanted:
            continue
        source = (document.get("configs", {}) or {}).get(str(source_name), {})
        source_file = source.get("file") if isinstance(source, dict) else None
        if source_file:
            return Path(str(source_file)), False
        return None, True

    candidates: list[tuple[int, Path | None]] = []
    for volume in service.get("volumes", []) or []:
        if not isinstance(volume, dict) or "target" not in volume:
            continue
        target = container_path(str(volume["target"]), "/")
        try:
            relative = wanted.relative_to(target)
        except ValueError:
            continue
        depth = len(target.parts)
        if volume.get("type") != "bind" or not volume.get("source"):
            candidates.append((depth, None))
            continue
        source = Path(str(volume["source"]))
        candidate = source if not relative.parts else source.joinpath(*relative.parts)
        candidates.append((depth, candidate))

    if candidates:
        deepest = max(depth for depth, _ in candidates)
        paths = [path for depth, path in candidates if depth == deepest]
        if any(path is None for path in paths):
            return None, True
        return paths[0], False
    return None, False


def parse_snapshot_value(value: object, limits: SourceLimits, source: str) -> int:
    if isinstance(value, bool):
        raise BudgetError(f"snapshot timeout from {source} must be an integer")
    if isinstance(value, int):
        parsed = value
    elif isinstance(value, str) and re.fullmatch(r"[0-9]+", value):
        parsed = int(value)
    else:
        raise BudgetError(f"snapshot timeout from {source} must be an integer")
    if not limits.minimum_snapshot_seconds <= parsed <= limits.maximum_snapshot_seconds:
        raise BudgetError(
            f"snapshot timeout from {source} must be between "
            f"{limits.minimum_snapshot_seconds}s and {limits.maximum_snapshot_seconds}s"
        )
    return parsed


def timeout_from_toml(path: Path, limits: SourceLimits) -> tuple[int, str]:
    try:
        with path.open("rb") as handle:
            document = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise BudgetError(f"cannot read production config {path}: {error}") from error
    cluster = document.get("cluster", {})
    if not isinstance(cluster, dict):
        raise BudgetError(f"production config {path} has a non-table [cluster]")
    if "install_snapshot_timeout_secs" not in cluster:
        return limits.default_snapshot_seconds, f"{path} (built-in default)"
    return (
        parse_snapshot_value(
            cluster["install_snapshot_timeout_secs"], limits, str(path)
        ),
        str(path),
    )


def effective_snapshot_timeout(
    document: dict[str, Any], service: dict[str, Any], limits: SourceLimits
) -> tuple[int, str]:
    environment = service_environment(service)
    override = environment.get(SNAPSHOT_ENV, "")
    if override:
        return parse_snapshot_value(override, limits, SNAPSHOT_ENV), SNAPSHOT_ENV

    working_directory = str(service.get("working_dir") or "/")
    cli_config = service_config_argument(service)
    explicit = cli_config or environment.get(CONFIG_ENV, "")
    explicit_source = "--config" if cli_config else CONFIG_ENV
    names = (explicit,) if explicit else DEFAULT_CONFIG_PATHS
    opaque_paths: list[str] = []
    for name in names:
        wanted = container_path(name, working_directory)
        mapped, opaque = mapped_config_file(document, service, wanted)
        if mapped is not None:
            if mapped.is_file():
                return timeout_from_toml(mapped, limits)
            if explicit:
                raise BudgetError(
                    f"{explicit_source}={name!r} maps to missing host file {mapped}"
                )
            continue
        if opaque:
            opaque_paths.append(str(wanted))
        elif explicit:
            raise BudgetError(
                f"{explicit_source}={name!r} is not backed by a Compose bind or file config; "
                f"set {SNAPSHOT_ENV} explicitly so the preflight can prove the budget"
            )

    if opaque_paths:
        paths = ", ".join(opaque_paths)
        return (
            limits.maximum_snapshot_seconds,
            f"opaque config mount at {paths} (maximum assumed)",
        )
    return limits.default_snapshot_seconds, "built-in default"


def validate_document(
    document: dict[str, Any], limits: SourceLimits | None = None
) -> Budget:
    limits = limits or load_source_limits()
    services = document.get("services", {})
    service = services.get("plurxd") if isinstance(services, dict) else None
    if not isinstance(service, dict):
        raise BudgetError("resolved Compose config has no plurxd service")
    healthcheck = service.get("healthcheck")
    if not isinstance(healthcheck, dict) or healthcheck.get("disable") is True:
        raise BudgetError("resolved plurxd service has no enabled healthcheck")
    health_seconds = parse_duration(
        healthcheck.get("start_period"), "plurxd health start period"
    )
    snapshot_seconds, snapshot_source = effective_snapshot_timeout(
        document, service, limits
    )
    budget = Budget(
        health_seconds=health_seconds,
        snapshot_seconds=snapshot_seconds,
        startup_allowance_seconds=limits.startup_allowance_seconds,
        snapshot_source=snapshot_source,
    )
    if budget.health_seconds < budget.required_seconds:
        raise BudgetError(
            f"plurxd health start period is {budget.health_seconds}s, but snapshot timeout "
            f"{budget.snapshot_seconds}s from {budget.snapshot_source} plus the named startup "
            f"phases {budget.startup_allowance_seconds}s requires at least "
            f"{budget.required_seconds}s"
        )
    return budget


def resolved_compose_document() -> dict[str, Any]:
    command = ["docker", "compose", "config", "--format", "json"]
    try:
        result = subprocess.run(
            command,
            cwd=DEPLOY,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as error:
        raise BudgetError(f"cannot run {' '.join(command)}: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise BudgetError(f"docker compose config failed: {detail}")
    try:
        document = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise BudgetError("docker compose config did not return JSON") from error
    if not isinstance(document, dict):
        raise BudgetError("docker compose config returned a non-object document")
    return document


def display_seconds(seconds: Decimal) -> str:
    rendered = format(seconds, "f")
    if "." in rendered:
        rendered = rendered.rstrip("0").rstrip(".")
    return rendered


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="validate Docker readiness grace before a Compose deployment"
    )
    parser.add_argument(
        "--compose-json",
        type=Path,
        help="validate an already-resolved Compose JSON document (test/debug only)",
    )
    args = parser.parse_args(argv)
    try:
        if args.compose_json is None:
            document = resolved_compose_document()
        else:
            document = json.loads(args.compose_json.read_text(encoding="utf-8"))
            if not isinstance(document, dict):
                raise BudgetError("resolved Compose JSON must be an object")
        budget = validate_document(document)
    except (BudgetError, OSError, json.JSONDecodeError) as error:
        print(
            f"docker startup budget preflight failed; nothing was changed: {error}",
            file=sys.stderr,
        )
        return 2

    print(
        "docker startup budget ok: "
        f"health={display_seconds(budget.health_seconds)}s, "
        f"snapshot={budget.snapshot_seconds}s ({budget.snapshot_source}), "
        f"startup-phases={budget.startup_allowance_seconds}s, "
        f"required={budget.required_seconds}s"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
