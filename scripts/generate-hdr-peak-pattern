#!/usr/bin/env python3
"""Generate the synthetic Settings HDR comparison clip; no external media.

Run from the repository root. Writes only target/hdr-peak-pattern/, then prints
an embeddable data URI. Requires ffmpeg with libx265 and ffprobe. PQ is ST 2084;
10-bit limited range luma is round(64 + 876 * PQ(nits / 10000)), chroma 512.
Each column's two halves are 90% and 100% of the labeled luminance.
"""
import argparse
import base64
import hashlib
import json
from pathlib import Path
import struct
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--update", action="store_true", help="replace the embedded Settings clip")
args = parser.parse_args()

STEPS = (100, 200, 400, 600, 1000, 1600, 2000, 4000)
WIDTH, HEIGHT = 1024, 256
OUT = Path("target/hdr-peak-pattern")
OUT.mkdir(parents=True, exist_ok=True)

def code(nits):
    linear = (nits / 10000) ** (2610 / 16384)
    pq = ((3424 / 4096 + (2413 / 128) * linear) /
          (1 + (2392 / 128) * linear)) ** (2523 / 32)
    return round(64 + 876 * pq)

row = b"".join(struct.pack("<H", code(step * fraction)) * (WIDTH // 16)
               for step in STEPS for fraction in (0.9, 1))
frame = row * HEIGHT + struct.pack("<H", 512) * (WIDTH * HEIGHT // 2)
raw = OUT / "wedge.yuv"
raw.write_bytes(frame * 2)
clip = OUT / "wedge.mp4"
command = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
    "-f", "rawvideo", "-pixel_format", "yuv420p10le", "-video_size", "1024x256",
    # The synthetic raw frames already contain this exact signal. Declare it
    # on the input too so frame properties reach the encoder and MP4 muxer.
    "-color_range", "tv", "-color_primaries", "bt2020",
    "-color_trc", "smpte2084", "-colorspace", "bt2020nc",
    "-framerate", "1", "-i", str(raw), "-an", "-c:v", "libx265", "-preset", "medium",
    "-x265-params", "lossless=1:pools=none:frame-threads=1:wpp=0:log-level=error:repeat-headers=1:colorprim=9:transfer=16:colormatrix=9:range=limited:hdr10=1:master-display=G(8500,39850)B(6550,2300)R(35400,14600)WP(15635,16450)L(40000000,50):max-cll=4000,0",
    "-tag:v", "hvc1", "-color_range", "tv", "-color_primaries", "bt2020",
    "-color_trc", "smpte2084", "-colorspace", "bt2020nc", "-movflags", "+faststart+write_colr",
    "-fflags", "+bitexact", "-flags:v", "+bitexact", str(clip)]
subprocess.run(command, check=True)
# Stream/VUI tags alone do not prove MP4 color signalling. Force write_colr
# above even with bitexact muxing, and refuse to embed an untagged container.
clip_bytes = clip.read_bytes()
colr = clip_bytes.find(b"colrnclx")
if (colr < 4 or clip_bytes[colr - 4:colr] != struct.pack(">I", 19)
        or clip_bytes[colr + 8:colr + 15] != struct.pack(">HHHB", 9, 16, 9, 0)):
    raise SystemExit("Expected MP4 nclx BT.2020/ST2084/BT.2020nc limited-range metadata")
probe = subprocess.check_output(["ffprobe", "-v", "error", "-show_streams",
    "-show_frames", "-read_intervals", "%+#1", "-of", "json", str(clip)])
(OUT / "probe.json").write_bytes(probe)
summary = {"steps_nits": STEPS, "pairs_10bit": [[code(v * .9), code(v)] for v in STEPS],
    "raw_sha256": hashlib.sha256(frame * 2).hexdigest(),
    "mp4_sha256": hashlib.sha256(clip_bytes).hexdigest(),
    "container_color": {"box": "nclx", "color_primaries": 9,
        "transfer_characteristics": 16, "matrix_coefficients": 9, "full_range": False},
    "ffmpeg_version": subprocess.check_output(["ffmpeg", "-version"], text=True).splitlines()[0],
    "ffmpeg_argv": command}
(OUT / "provenance.json").write_text(json.dumps(summary, indent=2) + "\n")
uri = "data:video/mp4;base64," + base64.b64encode(clip_bytes).decode()
if args.update:
    import re
    page = Path("crates/plurxd/src/web/pages/settings-playback.js")
    source, count = re.subn(r'const HDR_PEAK_PATTERN_URI="[^"]*";',
                           'const HDR_PEAK_PATTERN_URI="' + uri + '";', page.read_text())
    if count != 1:
        raise SystemExit("Expected exactly one embedded HDR peak clip")
    page.write_text(source)
else:
    print(uri)
