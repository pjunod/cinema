#!/usr/bin/env python3
"""Exercise the shipped Apple readiness decision against real macOS AVPlayer.

Every subtitle segment is initially empty. Only after AVPlayer has buffered
those responses does the fixture publish real captions. Its first control
observation is ready; no warming observation is fabricated. Success requires
late cues, unchanged player-item identity, and continuing video time.
Uses only synthetic local media; no server credentials or physical devices.
"""

import argparse
import http.server
import json
import pathlib
import subprocess
import tempfile
import threading
import time

ROOT = pathlib.Path(__file__).resolve().parents[1]
PLAYER = r"""import Foundation
import AVFoundation
final class Captions: NSObject, AVPlayerItemLegibleOutputPushDelegate {
    func legibleOutput(_ output: AVPlayerItemLegibleOutput, didOutputAttributedStrings strings: [NSAttributedString], nativeSampleBuffers: [Any], forItemTime itemTime: CMTime) {
        for value in strings { print("CUE \(itemTime.seconds) \(value.string)") }
    }
}
let url = URL(string: CommandLine.arguments[1])!
let item = AVPlayerItem(url: url)
let player = AVPlayer(playerItem: item)
let captions = Captions()
let readiness = SubtitleReadinessRetryState()
let output = AVPlayerItemLegibleOutput()
output.setDelegate(captions, queue: .main)
item.add(output)
player.appliesMediaSelectionCriteriaAutomatically = false
Task { @MainActor in
    do {
        if let group = try await item.asset.loadMediaSelectionGroup(for: .legible) {
            print("OPTIONS \(group.options.count)")
            item.select(group.options.first, in: group)
            player.play()
            try await Task.sleep(nanoseconds: 6_000_000_000)
            _ = try await URLSession.shared.data(from: url.deletingLastPathComponent().appendingPathComponent("ready"))
            if readiness.record("ready") {
                item.select(nil, in: group)
                item.select(group.options.first, in: group)
                print("RESELECT \(player.currentTime().seconds)")
            }
        }
    } catch { print("ERROR \(error)") }
}
DispatchQueue.main.asyncAfter(deadline: .now() + 22) {
    print("END sameItem=\(player.currentItem === item) status=\(item.status.rawValue) time=\(player.currentTime().seconds) error=\(String(describing:item.error))")
    exit(0)
}
RunLoop.main.run()
"""


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-root", type=pathlib.Path, default=ROOT)
    parser.add_argument(
        "--serve",
        action="store_true",
        help="serve the synthetic fixture for an isolated Android instrumentation run",
    )
    args = parser.parse_args()
    source = (
        args.source_root / "clients/apple/Sources/PlaybackControlReporter.swift"
    ).read_text()
    begin = source.index("enum SubtitleReadinessDecision {")
    end = source.index("\nstruct ControlResponse:", begin)
    decision = source[begin:end]
    with tempfile.TemporaryDirectory(prefix="plurx-subtitle-native-") as raw:
        root = pathlib.Path(raw)
        (root / "player.swift").write_text(PLAYER + "\n" + decision)
        subprocess.run(
            [
                "xcrun",
                "swiftc",
                "-module-cache-path",
                str(root / "modules"),
                str(root / "player.swift"),
                "-o",
                str(root / "player"),
            ],
            check=True,
        )
        subprocess.run(
            [
                "ffmpeg",
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-f",
                "lavfi",
                "-i",
                "color=c=black:s=320x180:r=25:d=30",
                "-f",
                "lavfi",
                "-i",
                "sine=frequency=440:sample_rate=48000:duration=30",
                "-c:v",
                "libx264",
                "-pix_fmt",
                "yuv420p",
                "-g",
                "150",
                "-keyint_min",
                "150",
                "-sc_threshold",
                "0",
                "-c:a",
                "aac",
                "-b:a",
                "64k",
                "-shortest",
                "-f",
                "hls",
                "-hls_time",
                "6",
                "-hls_playlist_type",
                "vod",
                "-hls_segment_type",
                "fmp4",
                "-hls_fmp4_init_filename",
                "init.mp4",
                "-hls_segment_filename",
                str(root / "seg%d.m4s"),
                str(root / "video.m3u8"),
            ],
            check=True,
        )
        return exercise(root, serve=args.serve)


def exercise(root, serve=False):
    master = """#EXTM3U
    #EXT-X-VERSION:7
    #EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID="subs",NAME="English",LANGUAGE="en",AUTOSELECT=YES,DEFAULT=YES,URI="subs.m3u8"
    #EXT-X-STREAM-INF:BANDWIDTH=500000,CODECS="avc1.64000c,mp4a.40.2",CLOSED-CAPTIONS=NONE,SUBTITLES="subs"
    video.m3u8
    """
    master = "\n".join(line.strip() for line in master.splitlines()) + "\n"
    playlist = (
        "#EXTM3U\n#EXT-X-VERSION:3\n#EXT-X-TARGETDURATION:6\n#EXT-X-MEDIA-SEQUENCE:0\n#EXT-X-PLAYLIST-TYPE:VOD\n"
        + "".join(f"#EXTINF:6,\nsub{i}.vtt\n" for i in range(5))
        + "#EXT-X-ENDLIST\n"
    )
    started = time.monotonic()
    ready = threading.Event()
    requests = []

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *args):
            pass

        def do_GET(self):
            path = self.path.lstrip("/")
            mime = "application/vnd.apple.mpegurl"
            if path == "ready":
                ready.set()
                body = b"{}"
            elif path == "master.m3u8":
                body = master.encode()
            elif path == "subs.m3u8":
                body = playlist.encode()
            elif path.startswith("sub") and path.endswith(".vtt"):
                n = int(path[3:-4])
                empty = not ready.is_set()

                body = (
                    b"WEBVTT\n\n"
                    if empty
                    else (
                        f"WEBVTT\nX-TIMESTAMP-MAP=MPEGTS:{n * 540000},LOCAL:00:00:00.000\n\n"
                        + "".join(
                            f"00:00:0{i}.100 --> 00:00:0{i}.900\ncue-{n * 6 + i}\n\n"
                            for i in range(6)
                        )
                    ).encode()
                )
                mime = "text/vtt"
                requests.append(
                    {
                        "segment": n,
                        "empty": empty,
                        "at": round(time.monotonic() - started, 2),
                    }
                )
            else:
                f = root / path
                if not f.is_file():
                    self.send_error(404)
                    return
                body = f.read_bytes()
                mime = (
                    "application/vnd.apple.mpegurl"
                    if path.endswith("m3u8")
                    else "video/mp4"
                )
            self.send_response(200)
            self.send_header("Content-Type", mime)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    if serve:
        print(f"http://127.0.0.1:{server.server_port}", flush=True)
        try:
            threading.Event().wait()
        except KeyboardInterrupt:
            server.shutdown()
            server.server_close()
            return 0
    try:
        result = subprocess.run(
            [
                str(root / "player"),
                f"http://127.0.0.1:{server.server_port}/master.m3u8",
            ],
            capture_output=True,
            text=True,
            timeout=35,
        )
    finally:
        server.shutdown()
        server.server_close()
    print(result.stdout)
    print(json.dumps(requests))
    empty = any(request["empty"] for request in requests)
    refetched = any(not request["empty"] for request in requests)
    passed = (
        result.returncode == 0
        and empty
        and refetched
        and "cue-18" in result.stdout
        and "error=nil" in result.stdout
        and "sameItem=true" in result.stdout
    )
    print(
        "PASS" if passed else "FAIL",
        "native first-ready recovery with continuous late captions",
    )
    if result.stderr:
        print(result.stderr)
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
