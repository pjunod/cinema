#!/usr/bin/env python3
"""Bounded design replay; protocol arithmetic, never physical-client proof."""
import argparse
import json
import math
from pathlib import Path

DURATIONS_MS = (10427, 12804, 7758, 8675, 11303, 7591)
LEAD_MS = 7965
TARGET_MS = 16000
RATES = (0.249, 0.25, 0.5, 1.0, 1.5, 2.0, 4.0, 4.001)



def continuity_model(runway_ms, rate, ratio, lead_ms, reload_phase_ms, pause_ms,
                     segment_ms=TARGET_MS, cadence_ms=8000):
    """One-hour transport model; excludes actor/flow and physical presentation.

    Complete 16-second objects become visible on 8-second server ticks.
    A changed reload waits 16 seconds; an unchanged reload waits 8 seconds.
    Transfer/append takes the explicit 2.5-second assumption. A single source
    pause begins at 45 seconds. Inventory is optimistic and unconstrained by
    the daemon's flow budget, so a failure is useful; a pass is not admission.
    """
    initial = math.ceil((lead_ms + runway_ms) / segment_ms)
    known = initial
    buffered_end_ms = initial * segment_ms
    producer_rate = rate * ratio
    fetches = []
    changed = []
    previous = initial
    for tick in range(cadence_ms, 3600001, cadence_ms):
        paused = min(pause_ms, max(0, tick - 45000))
        inventory = initial + math.floor((tick - paused) * producer_rate / segment_ms)
        if inventory > previous:
            changed.append(tick)
            previous = inventory
    reload_at = reload_phase_ms
    while reload_at <= 3600000:
        server_tick = math.floor(reload_at / cadence_ms) * cadence_ms
        paused = min(pause_ms, max(0, server_tick - 45000))
        inventory = initial + math.floor((server_tick - paused) * producer_rate / segment_ms)
        changed_reload = inventory > known
        if changed_reload:
            known = inventory
            fetches.append((reload_at + 2500, known * segment_ms))
        reload_at += TARGET_MS if changed_reload else TARGET_MS / 2
    first_deficit_ms = None
    min_runway_ms = buffered_end_ms - lead_ms
    for available_at, end in fetches + [(3600000, buffered_end_ms)]:
        remaining = buffered_end_ms - lead_ms - available_at * rate
        min_runway_ms = min(min_runway_ms, remaining)
        if remaining < 0 and first_deficit_ms is None:
            first_deficit_ms = round((buffered_end_ms - lead_ms) / rate)
        buffered_end_ms = max(buffered_end_ms, end)
    gaps = [b-a for a, b in zip([0] + changed, changed)]
    return {
        "runway_requested_ms": runway_ms,
        "segment_ms": segment_ms, "server_cadence_ms": cadence_ms,
        "initial_exposed_ms": initial * segment_ms,
        "origin_lead_ms": lead_ms,
        "playback_rate": rate,
        "production_to_consumption": ratio,
        "first_reload_ms": reload_phase_ms,
        "source_pause_ms": pause_ms,
        "modeled_seconds": 3600,
        "first_buffer_deficit_ms": first_deficit_ms,
        "minimum_buffer_ms": round(min_runway_ms),
        "max_segment_bearing_update_gap_ms": max(gaps, default=3600000),
        "legal_update_spacing": bool(gaps) and all(8000 <= gap <= 24000 for gap in gaps),
        "qualifies_transport": False,
    }


def replay():
    endpoints = []
    end = 0
    for duration in DURATIONS_MS:
        end += duration
        endpoints.append(end)
    candidates = []
    for runway in (12000, 16000, 24000, 32000, 48000):
        threshold = LEAD_MS + runway
        selected = next((i + 1 for i, end in enumerate(endpoints) if end >= threshold), None)
        candidates.append({"runway_1x_ms": runway, "required_endpoint_ms": threshold,
                           "incident_first_segment_count": selected,
                           "usable_media_ms": None if selected is None else endpoints[selected - 1] - LEAD_MS})
    # A completion can just miss a cadence tick; its next snapshot then waits
    # one cadence. The client can just miss that update at a changed reload.
    # Transfer/append and scheduling are explicit experiment inputs, not
    # measured bounds. Reject a candidate here rather than calling it qualified.
    traces = []
    for raw_rate in RATES:
        rate = max(0.25, min(4.0, raw_rate))
        for producer_ratio in (0.95, 1.05, 1.2, 2.0):
            producer_rate = rate * producer_ratio
            completion_gap_ms = TARGET_MS / producer_rate
            discoverable_delay_ms = completion_gap_ms + TARGET_MS / 2 + TARGET_MS + 2500
            required_ms = rate * discoverable_delay_ms
            traces.append({"requested_rate": raw_rate, "accepted_rate": rate,
                           "production_to_consumption": producer_ratio,
                           "max_segment_completion_ms": round(completion_gap_ms),
                           "assumed_transfer_append_schedule_ms": 2500,
                           "worst_discovery_media_requirement_ms": round(required_ms),
                           "sustainable": producer_ratio >= 1,
                           "legal_update_upper_bound": completion_gap_ms + TARGET_MS / 2 <= TARGET_MS * 1.5,
                           "qualifies_transport": False})
    models = []
    for candidate in (12000, 16000, 24000, 32000, 48000):
        for raw_rate in RATES:
            rate = max(0.25, min(4.0, raw_rate))
            # Candidate floor replaces the existing 48-second floor only in
            # this experiment. The runtime reserve ceiling remains 124 seconds.
            runway = max(candidate, min(124000, math.ceil(candidate * rate)))
            for ratio in (0.95, 1.05, 1.2, 2.0):
                for lead in (0, LEAD_MS):
                    for phase in (8000, 15999):
                        for pause in (0, 2000):
                            model = continuity_model(runway, rate, ratio, lead, phase, pause)
                            model.update(candidate_1x_ms=candidate, requested_rate=raw_rate)
                            models.append(model)
    amendment_models = []
    for candidate in (12000, 16000, 24000, 32000, 48000):
        for minimum in sorted(set((12000, candidate))):
            for rate in (0.25, 0.5, 1.0, 2.0, 4.0):
                for lead in (0, 675, LEAD_MS):
                    for phase in (0, 7999, 15999):
                        for pause in (0, 2000):
                            for segment in (8000, 16000):
                                runway = max(minimum, min(124000, math.ceil(candidate * rate)))
                                model = continuity_model(runway, rate, 1.05, lead, phase, pause,
                                                         segment_ms=segment, cadence_ms=16000)
                                model.update(candidate_1x_ms=candidate, candidate_minimum_ms=minimum)
                                amendment_models.append(model)
    return {"kind": "deterministic_design_replay", "physical_client_evidence": False,
            "target_ms": TARGET_MS, "writer_gate_ms": 12000,
            "incident_origin_lead_ms": LEAD_MS, "incident_endpoints_ms": endpoints,
            "incident_observed_first_complete_ms": 5950,
            "incident_observed_sixth_complete_ms": 11940,
            "old_gate_hold_between_observed_endpoints_ms": 5990,
            "intermediate_completion_times": "not supplied; not interpolated",
            "candidate_readiness": candidates, "capacity_prefilter": traces,
            "one_hour_transport_models": models,
            "october_2_fixed_cadence_models": amendment_models,
            "model_limits": "Optimistic complete inventory; no production flow budget, scratch, actor, native initial selection, or physical client proof.",
            "decision": "No smaller policy qualified by arithmetic alone; preserve existing transport policy pending actual reload and continuity evidence."}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    text = json.dumps(replay(), indent=2) + "\n"
    if args.output:
        args.output.write_text(text)
    else:
        print(text, end="")


if __name__ == "__main__":
    main()
