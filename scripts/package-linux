#!/usr/bin/env bash
# Package a built Linux plurxd as a .deb and an .rpm with nfpm.
#
#   scripts/package-linux --arch amd64|arm64 --version X.Y.Z \
#     --binary target/release/plurxd --control-dir target/release --out DIR
#     [--desktop-binary target-desktop/release/plurx-tray]
#     [--packager all|deb|rpm] [--service-policy maintainer|external]
#
# The paired split-debug file is read from beside the binary (BINARY.dwp, which
# the release profile's packed split-debuginfo produces). The headless server
# and optional GUI have separate nFPM descriptions. This stages their complete
# controller/desktop companions and derives a guarded unit from deploy/plurxd.service.
# nfpm must be on PATH (the GitHub release workflow installs a pinned build).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
source_root="${PLURX_PKG_SOURCE_ROOT:-$root}"
arch= version= binary= out= control_dir= desktop_binary=
packager_choice=all
service_policy=maintainer
while [ $# -gt 0 ]; do
  case $1 in
    --arch) arch=${2:?}; shift ;;
    --version) version=${2:?}; shift ;;
    --binary) binary=${2:?}; shift ;;
    --out) out=${2:?}; shift ;;
    --control-dir) control_dir=${2:?}; shift ;;
    --desktop-binary) desktop_binary=${2:?}; shift ;;
    --packager) packager_choice=${2:?}; shift ;;
    --service-policy) service_policy=${2:?}; shift ;;
    *) echo "package-linux: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
case $packager_choice in all|deb|rpm) ;; *) echo "package-linux: --packager must be all, deb or rpm" >&2; exit 2 ;; esac
case $service_policy in maintainer|external) ;; *) echo "package-linux: --service-policy must be maintainer or external" >&2; exit 2 ;; esac
case $arch in amd64|arm64) ;; *) echo "package-linux: --arch must be amd64 or arm64" >&2; exit 2 ;; esac
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "package-linux: --version must be X.Y.Z" >&2; exit 2; }
[ -x "$binary" ] || { echo "package-linux: no executable at $binary" >&2; exit 1; }
[ -f "$binary.dwp" ] || { echo "package-linux: no $binary.dwp beside the binary" >&2; exit 1; }
[ -n "$out" ] || { echo "package-linux: --out is required" >&2; exit 2; }
command -v nfpm >/dev/null || { echo "package-linux: nfpm is not on PATH" >&2; exit 1; }

verify_linux_binary() {
  local file=$1 magic machine expected
  magic=$(LC_ALL=C od -An -tx1 -N6 "$file" | tr -d '[:space:]')
  machine=$(LC_ALL=C od -An -tx1 -j18 -N2 "$file" | tr -d '[:space:]')
  case $arch in amd64) expected=3e00 ;; arm64) expected=b700 ;; esac
  [ "$magic" = 7f454c460201 ] && [ "$machine" = "$expected" ] || {
    echo "package-linux: $file is not an ELF64 little-endian $arch executable" >&2; exit 1;
  }
}
[ -n "$control_dir" ] || { echo "package-linux: --control-dir is required" >&2; exit 2; }
verify_linux_binary "$binary"
for name in plurx-control plurx-install-helper plurx-update-worker plurx-service-launch plurx-recovery; do
  [ -x "$control_dir/$name" ] || { echo "package-linux: missing controller executable $name" >&2; exit 1; }
  verify_linux_binary "$control_dir/$name"
done
if [ -n "$desktop_binary" ]; then
  [ -x "$desktop_binary" ] || { echo "package-linux: missing desktop executable" >&2; exit 1; }
  verify_linux_binary "$desktop_binary"
fi

mkdir -p "$out"
out=$(cd "$out" && pwd)
stage=$(mktemp -d "$out/.plurx-package-linux.XXXXXX")
trap 'rm -rf "$stage"' EXIT
install -m 0755 "$binary" "$stage/plurxd"
install -m 0644 "$binary.dwp" "$stage/plurxd.dwp"
# The example configuration ships from the tree the binary was built from;
# PLURX_PKG_SOURCE_ROOT names it when that is not this checkout.
install -m 0644 "$source_root/plurx.example.toml" "$stage/plurx.example.toml"
python3 "$root/scripts/stage-subtitle-translation-notice.py" "$source_root" "$stage"
[ -n "$control_dir" ] || { echo "package-linux: --control-dir is required" >&2; exit 2; }
for name in plurx-control plurx-install-helper plurx-update-worker plurx-service-launch plurx-recovery; do
  [ -x "$control_dir/$name" ] || { echo "package-linux: missing controller executable $name" >&2; exit 1; }
  install -m 0755 "$control_dir/$name" "$stage/$name"
done
install -m 0644 "$root/deploy/packaging/plurx-recovery.service" "$stage/"
install -m 0644 "$root/deploy/desktop/tv.plurx.install.policy" "$stage/"
for script in preinstall postinstall preremove postremove; do
  install -m 0755 "$root/deploy/packaging/$script" "$stage/$script"
  install -m 0755 "$root/deploy/packaging/desktop-$script" "$stage/desktop-$script"
done
if [ "$service_policy" = external ]; then
  # A source installer snapshots/restores startup and running policy itself.
  # The package still registers its real dpkg/rpm cohort before returning.
  awk '{ print } /^systemctl daemon-reload >\/dev\/null 2>&1 \|\| true$/ { print "# Source installer restores the observed service policy."; print "exit 0" }' \
    "$stage/postinstall" > "$stage/postinstall.external"
  grep -q '^# Source installer restores the observed service policy.$' "$stage/postinstall.external" || {
    echo "package-linux: service policy hook anchor changed" >&2; exit 1;
  }
  mv "$stage/postinstall.external" "$stage/postinstall"
  chmod 0755 "$stage/postinstall"
fi
# The source unit stays suitable for source installs. Packages use the native
# launcher and a mandatory root guard before every activation.
grep -q '^ExecStart=/usr/local/bin/plurxd run$' "$root/deploy/plurxd.service" || {
  echo "package-linux: deploy/plurxd.service no longer has the ExecStart this script repoints" >&2
  exit 1
}
sed -e 's|^ExecStart=/usr/local/bin/plurxd run$|ExecStart=/usr/lib/plurx-control/plurx-service-launch|' \
    -e 's|^After=network-online.target$|After=network-online.target plurx-recovery.service|' \
    -e '/^Wants=network-online.target$/a\
Requires=plurx-recovery.service' \
    -e '/^Type=simple$/a\
ExecStartPre=+/usr/lib/plurx-control/plurx-recovery --guard\
RuntimeDirectory=plurx\
RuntimeDirectoryMode=0755' \
    -e 's|^ReadWritePaths=/var/lib/plurx$|ReadWritePaths=/var/lib/plurx /run/plurx /var/lib/plurx-control/shutdown-receipts|' \
  "$root/deploy/plurxd.service" > "$stage/plurxd.service"

repository=${PLURX_PKG_REPOSITORY:-https://github.com/pjunod/cinema}
owner=${repository%/*}; owner=${owner##*/}
source_commit=${PLURX_BUILD_SHA:-$(git -C "${PLURX_PKG_SOURCE_ROOT:-$root}" rev-parse HEAD)}
[[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] || { echo "package-linux: invalid source commit" >&2; exit 2; }
printf '{"schema_version":1,"repository":"pjunod/cinema","version":"%s","source_commit":"%s","architecture":"%s"}\n' "$version" "$source_commit" "$arch" > "$stage/release.json"
export PLURX_PKG_ARCH=$arch PLURX_PKG_VERSION=$version
export PLURX_PKG_HOMEPAGE=$repository
export PLURX_PKG_MAINTAINER="noirr cinema <$owner@users.noreply.github.com>"

packagers="deb rpm"
[ "$packager_choice" = all ] || packagers=$packager_choice
for packager in $packagers; do
  # nfpm resolves the config's ./ sources against its working directory.
  (cd "$stage" && nfpm package --config "$root/deploy/packaging/nfpm.yaml" \
    --packager "$packager" --target "$out/" >&2)
done
case $arch in amd64) rpm_arch=x86_64 ;; arm64) rpm_arch=aarch64 ;; esac
deb="$out/plurxd_${version}-1_${arch}.deb"
rpm="$out/plurxd-${version}-1.${rpm_arch}.rpm"
server_packages=
case $packager_choice in all|deb) server_packages="$deb" ;; esac
case $packager_choice in all) server_packages="$server_packages
$rpm" ;; rpm) server_packages="$rpm" ;; esac
while IFS= read -r package; do
  [ -f "$package" ] || { echo "package-linux: nfpm did not write $package" >&2; ls -l "$out" >&2; exit 1; }
  printf '%s\n' "$package"
done <<EOF
$server_packages
EOF

if [ -n "$desktop_binary" ]; then
  [ -x "$desktop_binary" ] || { echo "package-linux: missing desktop executable" >&2; exit 1; }
  install -m 0755 "$desktop_binary" "$stage/plurx-tray"
  for asset in tv.plurx.Server.desktop tv.plurx.Server-autostart.desktop tv.plurx.Server.svg; do
    install -m 0644 "$root/deploy/desktop/$asset" "$stage/"
  done
  for state in running starting stopped unhealthy unknown; do
    install -m 0644 "$root/deploy/desktop/icons/tv.plurx.Server-$state-symbolic.svg" "$stage/"
  done
  for packager in $packagers; do
    (cd "$stage" && nfpm package --config "$root/deploy/packaging/desktop-nfpm.yaml" \
      --packager "$packager" --target "$out/" >&2)
  done
  for packager in $packagers; do
    case $packager in
      deb) package="$out/plurx-desktop_${version}-1_${arch}.deb" ;;
      rpm) package="$out/plurx-desktop-${version}-1.${rpm_arch}.rpm" ;;
    esac
    [ -f "$package" ] || { echo "package-linux: nfpm did not write $package" >&2; exit 1; }
    printf '%s\n' "$package"
  done
fi
