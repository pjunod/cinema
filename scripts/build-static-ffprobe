#!/bin/sh
# Build the local-file probe used by the sealed-executable facts collector.
# This does not replace the general-purpose Jellyfin probe or encoder.
set -eu

version=8.1.3
source_sha256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3
source_url="https://ffmpeg.org/releases/ffmpeg-${version}.tar.xz"
binary=${1:?usage: build-static-ffprobe BINARY_PATH DOCUMENTATION_DIR}
documentation=${2:?usage: build-static-ffprobe BINARY_PATH DOCUMENTATION_DIR}
jobs=${PLURX_STATIC_PROBE_JOBS:-2}
case "$jobs" in
    1|2|3|4) ;;
    *) echo 'static probe build jobs must be between 1 and 4' >&2; exit 1 ;;
esac
case "$binary:$documentation" in
    /*:/*) ;;
    *) echo 'static probe output paths must be absolute' >&2; exit 1 ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
archive="$work/source.tar.xz"
if [ -n "${PLURX_STATIC_PROBE_ARCHIVE:-}" ]; then
    cp "$PLURX_STATIC_PROBE_ARCHIVE" "$archive"
else
    curl --proto '=https' --tlsv1.2 --fail --location --retry 2 \
        "$source_url" -o "$archive"
fi
printf '%s  %s\n' "$source_sha256" "$archive" | sha256sum -c -
mkdir "$work/source"
tar -xJf "$archive" --strip-components=1 -C "$work/source"
cd "$work/source"

# Static FFmpeg libraries alone are insufficient: the final executable must
# also have no ELF interpreter or dynamic dependencies. Network and devices
# are unnecessary for the collector's already-open, authorized source handle.
./configure \
    --disable-shared --enable-static --disable-autodetect \
    --disable-programs --enable-ffprobe --disable-doc --disable-debug \
    --disable-network --disable-devices --disable-avdevice --disable-avfilter \
    --disable-encoders --disable-muxers \
    --disable-protocols --enable-protocol=file,pipe \
    --enable-zlib --enable-bzlib --enable-lzma \
    --pkg-config-flags=--static --extra-ldexeflags=-static
make -j "$jobs" ffprobe

readelf -h ffprobe > "$work/elf-header"
readelf -l ffprobe > "$work/elf-program-headers"
if grep -Eq '[[:space:]](INTERP|DYNAMIC)[[:space:]]' "$work/elf-program-headers"; then
    echo 'static probe unexpectedly requires a dynamic executable closure' >&2
    exit 1
fi
./ffprobe -version > "$work/version"
grep -F "ffprobe version ${version}" "$work/version"
mkdir -p "$(dirname "$binary")" "$documentation"
install -m 0755 ffprobe "$binary"
cp COPYING.LGPLv2.1 COPYING.LGPLv3 LICENSE.md "$documentation/"
# Retain the exact upstream source, configuration, dependency copyright and
# binary identity with the package, so it remains inspectable/rebuildable.
cp "$archive" "$documentation/ffmpeg-${version}.tar.xz"
cp ffbuild/config.log "$documentation/config.log"
cp "$work/version" "$documentation/version.txt"
{
    printf 'source_url=%s\nsource_sha256=%s\n' "$source_url" "$source_sha256"
    sha256sum "$binary"
    cat "$work/elf-header" "$work/elf-program-headers"
} > "$documentation/build.txt"
for package in zlib1g-dev libbz2-dev liblzma-dev libc6-dev; do
    if [ -f "/usr/share/doc/$package/copyright" ]; then
        cp "/usr/share/doc/$package/copyright" "$documentation/$package.copyright"
    fi
done
