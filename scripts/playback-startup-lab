INDEX = '''<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>Startup lab</title><style>body{{font:16px system-ui;margin:24px;background:#101822;color:#dae6f2}}
a{{color:#8cc4ff}}td,th{{padding:4px 12px;text-align:left}}</style>
<h1>Startup lab — target / bootstrap arms</h1>
<p>Each link opens one page with one player per growth rate ({rates}). Keep the window visible and
in front until every player says DONE ({minutes} minutes after its first frame). Receipts go to
the evidence directory the server was started with.</p>
<table><tr><th>Arm</th><th>Target / bootstrap</th><th>Safari native</th><th>hls.js</th></tr>{rows}</table>
<p>Any other valid pair: <code>/run?target=T&amp;bootstrap=B&amp;transport=native|hlsjs&amp;rates=1.05,1,2</code>.
Apple TV: open the native page from this Mac's Safari at this server's LAN address, add
<code>&amp;device=appletv</code>, and AirPlay the video to the Apple TV; or point an AVPlayer at
<code>/direct.m3u8?arm=a&amp;rate=1.05&amp;label=&lt;unique&gt;</code>.</p>'''

PAGE = '''<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>Startup lab {arm}</title>
<style>body{{font:14px system-ui;margin:16px;background:#101822;color:#dae6f2}}
.players{{display:flex;flex-wrap:wrap;gap:12px}}.player{{width:330px}}video{{width:320px;background:#000}}
pre{{white-space:pre-wrap;font-size:12px;margin:4px 0}}</style>
<h1>Arm {arm}: target {target} s, bootstrap {bootstrap} s, {transport}</h1>
<p>Generated H.264/AAC, 2 s segments, sliding live playlist. Keep this window visible.</p>
<div class="players" id="players"></div>
<script id="cfg" type="application/json">{cfg}</script>
<script src="/playback-policy.js"></script><script src="/hls.js"></script><script>
"use strict";
const cfg=JSON.parse(document.getElementById('cfg').textContent);
const origin=performance.now(),now=()=>Math.round(performance.now()-origin);
const policy=window.PlurxPlaybackPolicy&&window.PlurxPlaybackPolicy.HLS_STARTUP;
function ahead(v){{for(let i=0;i<v.buffered.length;i++){{const s=v.buffered.start(i),e=v.buffered.end(i);
 if(v.currentTime>=s-0.05&&v.currentTime<=e)return +(e-v.currentTime).toFixed(3);}}return 0;}}
function ranges(v){{const r=[];for(let i=0;i<Math.min(v.buffered.length,4);i++)r.push([+v.buffered.start(i).toFixed(3),+v.buffered.end(i).toFixed(3)]);return r;}}
function player(rate){{
 const box=document.createElement('div');box.className='player';
 const v=document.createElement('video');v.muted=true;v.playsInline=true;v.controls=true;v.setAttribute('x-webkit-airplay','allow');
 const out=document.createElement('pre');box.append(v,out);document.getElementById('players').append(box);
 const st={{id:null,queue:[],first:null,done:false,hls:null,waiting:0,started:now(),playing:null}};
 const post=e=>fetch('/report/'+st.id,{{method:'POST',body:JSON.stringify(e),keepalive:true}}).catch(()=>{{}});
 const send=(event,data={{}})=>{{const e={{event,client_ms:now(),...data}};if(st.id)post(e);else st.queue.push(e);}};
 const finish=(kind,data={{}})=>{{if(st.done)return;st.done=true;send(kind,{{position:v.currentTime,...data}});
  setTimeout(()=>{{v.pause();if(st.hls)st.hls.destroy();v.removeAttribute('src');v.load();}},500);}};
 const frame=(t,m)=>{{if(st.first===null){{st.first=now();send('first_frame',{{position:v.currentTime,media_time:m&&m.mediaTime,source:'video_frame_callback'}});}}}};
 const watchFrame=()=>{{if(st.first===null&&v.requestVideoFrameCallback)v.requestVideoFrameCallback(frame);}};
 for(const name of ['waiting','playing','pause','seeking','seeked','stalled','ended','loadedmetadata','loadeddata','canplay'])
  v.addEventListener(name,()=>{{if(name==='waiting')st.waiting++;if(name==='loadeddata'||name==='playing')watchFrame();
   if(name==='playing'&&st.first===null&&st.playing===null)st.playing={{client_ms:now(),position:v.currentTime}};
   send(name,{{position:v.currentTime}});}});
 v.addEventListener('error',()=>{{send('video_error',{{code:v.error&&v.error.code,position:v.currentTime}});finish('fatal_error');}});
 watchFrame();
 const params=new URLSearchParams({{target:cfg.target,bootstrap:cfg.bootstrap,rate,transport:cfg.transport,
  duration:cfg.duration,device:cfg.device,arm:cfg.arm}});
 fetch('/start?'+params).then(r=>r.ok?r.json():r.text().then(t=>{{throw Error(t);}})).then(r=>{{
  st.id=r.id;st.queue.splice(0).forEach(post);
  if(cfg.transport==='hlsjs'){{
   if(!window.Hls||!Hls.isSupported()){{send('player_unsupported',{{detail:'hls.js MSE'}});finish('fatal_error');return;}}
   // Mirrors constructHls for a transcode: bufferTargets() gives fwd 60 / back 30.
   const hls=new Hls({{preferManagedMediaSource:false,maxBufferLength:60,backBufferLength:30,startPosition:-1,
    ...(policy&&policy.manifest_load_policy?{{manifestLoadPolicy:policy.manifest_load_policy}}:{{}})}});
   st.hls=hls;hls.on(Hls.Events.ERROR,(_,d)=>{{send('hls_error',{{type:d.type,details:d.details,fatal:!!d.fatal}});if(d.fatal)finish('fatal_error');}});
   hls.on(Hls.Events.MANIFEST_PARSED,()=>v.play().catch(e=>send('play_rejected',{{detail:e.name}})));
   hls.loadSource(r.playlist);hls.attachMedia(v);
  }}else{{
   if(!v.canPlayType('application/vnd.apple.mpegurl')){{send('player_unsupported',{{detail:'native HLS'}});finish('fatal_error');return;}}
   v.src=r.playlist;v.play().catch(e=>send('play_rejected',{{detail:e.name}}));
  }}
 }}).catch(e=>{{out.textContent='Could not start: '+e.message;}});
 const timer=setInterval(()=>{{
  if(st.done){{clearInterval(timer);out.textContent='DONE '+out.textContent;return;}}
  // Safari has been seen never to call requestVideoFrameCallback for native HLS.
  // Then the first `playing` stands in, once the playhead has really advanced.
  if(st.first===null&&st.playing&&v.currentTime>=st.playing.position+0.5){{st.first=st.playing.client_ms;
   send('first_frame',{{position:st.playing.position,source:'playing_fallback',client_ms:st.playing.client_ms}});}}
  send('sample',{{position:+v.currentTime.toFixed(3),paused:v.paused,ended:v.ended,seeking:v.seeking,
   ready_state:v.readyState,rate:v.playbackRate,ahead:ahead(v),ranges:ranges(v)}});
  if(st.first!==null&&now()-st.first>=cfg.duration*1000)finish('run_complete');
  else if(st.first===null&&now()-st.started>=cfg.start_timeout*1000)finish('start_timeout');
  out.textContent=JSON.stringify({{rate,run:st.id,first_frame_ms:st.first,position:+v.currentTime.toFixed(1),
   ahead:ahead(v),waiting:st.waiting,elapsed_s:st.first===null?null:Math.round((now()-st.first)/1000)}});
 }},1000);
}}
for(const rate of cfg.rates)player(rate);
</script>'''


class Lab:
    def __init__(self, media_dir, evidence_dir, setup_s, burst):
        self.media_dir, self.manifest, self.durations = load_media(media_dir)
        self.evidence = pathlib.Path(evidence_dir).resolve()
        self.evidence.mkdir(parents=True, exist_ok=True)
        self.setup_s, self.burst = setup_s, burst
        self.lab_sha = file_sha256(__file__)
        self.runs, self.clocks, self.locks = {}, {}, {}
        self.dirty = set()
        self.lock = threading.Lock()
        self.write_lock = threading.Lock()
        self.direct = {}

    def active(self):
        return sum(1 for run in self.runs.values() if not run.get('finished'))

    def create(self, params, user_agent, mode='page'):
        target, bootstrap = resolve_arm(params.get('arm'), params.get('target'), params.get('bootstrap'))
        rate = params.get('rate', '1.05')
        clock = Clock(target, bootstrap, rate, self.durations, self.setup_s, self.burst)
        transport = 'direct' if mode == 'direct' else params.get('transport', 'hlsjs')
        if transport not in ('native', 'hlsjs', 'direct'):
            raise ArmError(f'transport must be native or hlsjs, got {transport!r}')
        device = re.sub(r'[^A-Za-z0-9_.-]', '', params.get('device', '') or params.get('label', ''))[:40]
        seconds = _integral(params.get('duration', DEFAULT_RUN_SECONDS), 'duration')
        run_id = uuid.uuid4().hex
        run = {
            'schema': RUN_SCHEMA, 'id': run_id, 'mode': mode,
            'created_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
            'lab_sha256': self.lab_sha,
            'arm': arm_name(clock.target, clock.bootstrap), 'target': clock.target,
            'bootstrap': clock.bootstrap, 'rate': clock.rate, 'segment_s': clock.segment,
            'transport': transport, 'device': device if mode == 'direct' or params.get('device') else '',
            'user_agent': user_agent, 'run_seconds': seconds,
            'model': {
                'release_s': round(clock.release_s, 3), 'setup_s': self.setup_s, 'burst': self.burst,
                'publication_cadence_s': clock.target, 'steady_reserve_s': clock.reserve_s,
                'production_ceiling_s': clock.ceiling_s, 'back_window_s': clock.back_s,
                'media_segments': len(self.durations), 'media_init_sha256': self.manifest.get('init_sha256'),
            },
            'rule': {'clean_rule': CLEAN_RULE, 'deficit_margin_s': DEFICIT_MARGIN_S,
                     'progress_s': PROGRESS_S, 'freeze_s': FREEZE_S, 'forward_jump_s': FORWARD_JUMP_S,
                     'backward_jump_s': BACKWARD_JUMP_S, 'start_timeout_s': START_TIMEOUT_S},
            'first_playlist_served_ms': None, 'endlist_served_ms': None,
            'reloads': [], 'segment_requests': {'count': 0, 'refused': 0, 'log': []},
            'request_user_agents': {}, 'client': [], 'client_dropped': 0,
        }
        run['player'] = derive_player(transport, user_agent, run['device'])
        with self.lock:
            run['concurrent_runs_at_start'] = self.active() + 1
            self.runs[run_id] = run
            self.clocks[run_id] = (clock, time.monotonic())
            self.locks[run_id] = threading.Lock()
            self.dirty.add(run_id)
        return run

    def elapsed_ms(self, run_id):
        return round((time.monotonic() - self.clocks[run_id][1]) * 1000)

    def note_agent(self, run, agent):
        agents = run['request_user_agents']
        if agent in agents or len(agents) < 8:
            agents[agent] = agents.get(agent, 0) + 1

    def position(self, run):
        for event in reversed(run['client']):
            if event.get('event') == 'sample' and isinstance(event.get('position'), (int, float)):
                return float(event['position'])
        return None

    def playlist(self, run_id, agent):
        run = self.runs[run_id]
        clock, began = self.clocks[run_id]
        wait = clock.release_s - (time.monotonic() - began)
        if wait > 0:
            time.sleep(wait)
        with self.locks[run_id]:
            now_s = time.monotonic() - began
            snap = clock.snapshot(now_s, self.position(run))
            text = clock.playlist(snap, lambda name: f'/media/{run_id}/{name}')
            ms = round(now_s * 1000)
            if run['first_playlist_served_ms'] is None:
                run['first_playlist_served_ms'] = ms
            if snap['ended'] and run['endlist_served_ms'] is None:
                run['endlist_served_ms'] = ms
            previous = run['reloads'][-1] if run['reloads'] else None
            run['reloads'].append({
                'server_ms': ms, 'since_first_playlist_ms': ms - run['first_playlist_served_ms'],
                'interval_ms': ms - previous['server_ms'] if previous else None,
                'tick': snap['tick'], 'media_sequence': snap['media_sequence'],
                'segments': snap['segments'], 'end_s': snap['end_s'], 'ended': snap['ended'],
                'changed': previous is None or previous['tick'] != snap['tick'] and (
                    previous['end_s'] != snap['end_s'] or previous['media_sequence'] != snap['media_sequence']),
            })
            self.note_agent(run, agent)
            self.dirty.add(run_id)
        return text

    def media(self, run_id, name, agent):
        run = self.runs[run_id]
        index = segment_index(name)
        if name != 'init.mp4' and index is None:
            return None
        with self.locks[run_id]:
            requests = run['segment_requests']
            clock = self.clocks[run_id][0]
            if index is not None and index >= clock.count:
                requests['refused'] += 1
                self.dirty.add(run_id)
                return None
            if index is not None:
                requests['count'] += 1
                if len(requests['log']) < SEGMENT_LOG_CAP:
                    requests['log'].append([self.elapsed_ms(run_id), index])
            self.note_agent(run, agent)
            self.dirty.add(run_id)
        return (self.media_dir / name).read_bytes()

    def report(self, run_id, entry):
        run = self.runs[run_id]
        with self.locks[run_id]:
            entry['server_ms'] = self.elapsed_ms(run_id)
            if len(run['client']) >= CLIENT_EVENT_CAP:
                run['client_dropped'] += 1
            else:
                run['client'].append(entry)
            if entry.get('event') in ('run_complete', 'start_timeout', 'fatal_error'):
                run['finished'] = True
            self.dirty.add(run_id)

    def persist(self, run_id):
        run = self.runs[run_id]
        with self.locks[run_id]:
            body = dict(run)
            body['metrics'] = analyse(run)
            text = json.dumps(body, separators=(',', ':'))
        target = self.evidence / f'{run_id}.json'
        temporary = target.with_suffix('.json.tmp')
        with self.write_lock:
            temporary.write_text(text)
            temporary.replace(target)

    def flush(self):
        with self.lock:
            pending, self.dirty = self.dirty, set()
        for run_id in pending:
            self.persist(run_id)

    def flusher(self):
        while True:
            time.sleep(2)
            self.flush()


def make_handler(lab):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = 'HTTP/1.1'

        def log_message(self, *args):
            pass

        def send(self, data, kind='application/json', status=200):
            if isinstance(data, str):
                data = data.encode()
            self.send_response(status)
            self.send_header('Content-Type', kind)
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            try:
                self.wfile.write(data)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def refuse(self, message, status=400):
            self.send(json.dumps({'error': message}), status=status)

        def agent(self):
            return self.headers.get('User-Agent', '')[:300]

        def do_POST(self):
            run_id = self.path.rsplit('/', 1)[-1]
            length = int(self.headers.get('Content-Length', '0'))
            if not self.path.startswith('/report/') or run_id not in lab.runs or length > 16384:
                self.rfile.read(min(length, 16384))
                return self.refuse('unknown run or oversized report')
            try:
                entry = json.loads(self.rfile.read(length))
            except json.JSONDecodeError:
                return self.refuse('report is not JSON')
            if not isinstance(entry, dict) or not isinstance(entry.get('event'), str):
                return self.refuse('report needs an event')
            lab.report(run_id, entry)
            self.send('{}')

        def do_GET(self):
            url = urllib.parse.urlparse(self.path)
            params = {k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()}
            path = url.path
            if path == '/':
                return self.send(index_page(), 'text/html; charset=utf-8')
            if path == '/run':
                try:
                    return self.send(run_page(params), 'text/html; charset=utf-8')
                except ArmError as error:
                    return self.refuse(str(error))
            if path == '/hls.js':
                return self.send(HLS_JS.read_bytes(), 'text/javascript')
            if path == '/playback-policy.js':
                return self.send(POLICY_JS.read_bytes(), 'text/javascript')
            if path == '/start':
                try:
                    run = lab.create(params, self.agent())
                except ArmError as error:
                    return self.refuse(str(error))
                return self.send(json.dumps({'id': run['id'], 'playlist': f'/playlist/{run["id"]}.m3u8'}))
            if path == '/direct.m3u8':
                label = params.get('label', '')
                if not re.fullmatch(r'[A-Za-z0-9_.-]{1,40}', label):
                    return self.refuse('direct runs need a unique label of letters, digits, _ . -')
                with lab.lock:
                    run_id = lab.direct.get(url.query)
                if run_id is None:
                    try:
                        run_id = lab.create(params, self.agent(), mode='direct')['id']
                    except ArmError as error:
                        return self.refuse(str(error))
                    with lab.lock:
                        run_id = lab.direct.setdefault(url.query, run_id)
                return self.send(lab.playlist(run_id, self.agent()), 'application/vnd.apple.mpegurl')
            if path.startswith('/playlist/'):
                run_id = path.rsplit('/', 1)[-1].removesuffix('.m3u8')
                if run_id not in lab.runs:
                    return self.refuse('unknown run', 404)
                return self.send(lab.playlist(run_id, self.agent()), 'application/vnd.apple.mpegurl')
            if path.startswith('/media/'):
                parts = path.split('/')
                if len(parts) != 4 or parts[2] not in lab.runs:
                    return self.refuse('unknown media', 404)
                body = lab.media(parts[2], parts[3], self.agent())
                if body is None:
                    return self.refuse('not published', 404)
                return self.send(body, 'video/mp4')
            if path == '/runs':
                with lab.lock:
                    ids = list(lab.runs)
                rows = []
                for run_id in ids:
                    run = lab.runs[run_id]
                    with lab.locks[run_id]:
                        metrics = analyse(run)
                        rows.append({k: v for k, v in run.items() if k not in ('client', 'reloads', 'segment_requests')}
                                    | {'reloads': len(run['reloads']), 'metrics': metrics})
                return self.send(json.dumps(rows))
            self.refuse('not found', 404)

    return Handler


def index_page():
    rows = ''.join(
        f'<tr><td>{name}</td><td>{t} / {b}</td>'
        f'<td><a href="/run?arm={name}&amp;transport=native">native</a></td>'
        f'<td><a href="/run?arm={name}&amp;transport=hlsjs">hls.js</a></td></tr>'
        for name, (t, b) in NAMED_ARMS.items())
    return INDEX.format(rows=rows, rates=', '.join(f'{r:g}x' for r in DECISION_RATES),
                        minutes=DEFAULT_RUN_SECONDS // 60)


def run_page(params):
    target, bootstrap = resolve_arm(params.get('arm'), params.get('target'), params.get('bootstrap'))
    rates = [r for r in params.get('rates', ','.join(f'{r:g}' for r in DECISION_RATES)).split(',') if r]
    validated = [validate_arm(target, bootstrap, rate) for rate in rates]
    if not validated:
        raise ArmError('give at least one rate')
    transport = params.get('transport', 'native')
    if transport not in ('native', 'hlsjs'):
        raise ArmError('transport must be native or hlsjs')
    device = re.sub(r'[^A-Za-z0-9_.-]', '', params.get('device', ''))[:40]
    duration = _integral(params.get('duration', DEFAULT_RUN_SECONDS), 'duration')
    if not 10 <= duration <= 7200:
        raise ArmError('duration must be 10..7200 s')
    target, bootstrap = validated[0][0], validated[0][1]
    cfg = {'arm': arm_name(target, bootstrap), 'target': target, 'bootstrap': bootstrap,
           'rates': [v[2] for v in validated], 'transport': transport, 'device': device,
           'duration': duration, 'start_timeout': START_TIMEOUT_S}
    return PAGE.format(arm=cfg['arm'], target=target, bootstrap=bootstrap, transport=transport,
                       cfg=json.dumps(cfg).replace('</', '<\\/'))


def plan(args):
    durations = [float(args.segment)] * args.segments
    clock = Clock(args.target, args.bootstrap, args.rate, durations, args.setup, args.burst)
    rows = []
    for tick in range(args.ticks):
        at = clock.release_s + tick * clock.target
        position = None if args.position_lag is None else max(0.0, at - clock.release_s - args.position_lag)
        snap = clock.snapshot(at, position)
        rows.append({**snap, 'at_s': round(at, 3), 'position_s': position,
                     'lead_s': None if position is None else round(snap['end_s'] - position, 3)})
    first = Clock(args.target, args.bootstrap, args.rate, durations, args.setup, args.burst)
    text = first.playlist(first.snapshot(first.release_s), lambda name: name)
    print(json.dumps({'arm': arm_name(clock.target, clock.bootstrap), 'target': clock.target,
                      'bootstrap': clock.bootstrap, 'rate': clock.rate, 'release_s': round(clock.release_s, 3),
                      'first_playlist': text, 'snapshots': rows}, indent=1))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--generate-media', type=pathlib.Path, metavar='DIR')
    mode.add_argument('--summarize', type=pathlib.Path, metavar='EVIDENCE_DIR')
    mode.add_argument('--plan', action='store_true', help='print the snapshot schedule for one arm')
    parser.add_argument('--media-dir', type=pathlib.Path)
    parser.add_argument('--evidence-dir', type=pathlib.Path)
    parser.add_argument('--bind', default='127.0.0.1', help='0.0.0.0 to reach an Apple TV on the LAN')
    parser.add_argument('--port', type=int, default=8765)
    parser.add_argument('--setup', type=float, default=DEFAULT_SETUP_S, help='seconds before the bootstrap burst')
    parser.add_argument('--burst', type=float, default=DEFAULT_BURST, help='bootstrap production multiple')
    parser.add_argument('--duration', type=int, default=2400, help='generated media seconds')
    parser.add_argument('--segment', type=int, default=2, help='generated segment seconds')
    parser.add_argument('--output', type=pathlib.Path, help='decision file (default EVIDENCE_DIR/decision.json)')
    parser.add_argument('--min-seconds', type=int, default=DEFAULT_RUN_SECONDS)
    parser.add_argument('--arm', choices=list(NAMED_ARMS))
    parser.add_argument('--target')
    parser.add_argument('--bootstrap')
    parser.add_argument('--rate', default='1.05')
    parser.add_argument('--ticks', type=int, default=8)
    parser.add_argument('--segments', type=int, default=1200)
    parser.add_argument('--position-lag', type=float, help='plan: viewer position = time since release - lag')
    args = parser.parse_args(argv)
    if args.generate_media:
        return generate_media(args.generate_media, args.duration, args.segment)
    if args.summarize:
        result = summarize(args.summarize, args.min_seconds)
        output = args.output or args.summarize / 'decision.json'
        output.write_text(json.dumps(result, indent=1) + '\n')
        print_summary(result)
        print(f'decision receipt: {output}')
        return 0 if result['decision'] else 2
    try:
        if args.plan:
            args.target, args.bootstrap = resolve_arm(args.arm, args.target, args.bootstrap)
            return plan(args)
    except ArmError as error:
        parser.exit(2, f'invalid arm: {error}\n')
    if not args.media_dir or not args.evidence_dir:
        parser.error('serving needs --media-dir and --evidence-dir')
    lab = Lab(args.media_dir, args.evidence_dir, args.setup, args.burst)
    server = http.server.ThreadingHTTPServer((args.bind, args.port), make_handler(lab))
    server.daemon_threads = True
    threading.Thread(target=lab.flusher, daemon=True).start()
    print(f'startup lab listening on http://{args.bind}:{server.server_address[1]}/', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        lab.flush()


if __name__ == '__main__':
    sys.exit(main())
