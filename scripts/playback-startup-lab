#!/usr/bin/env python3
"""Startup lab: a generated sliding HLS presentation with a separate target and bootstrap.

A-M0 of docs/streaming/STARTUP-AND-TONE-MAP-BUILD-HANDOFF.md. The lab serves
generated H.264/AAC fMP4 (2 s closed-GOP segments) to Safari's native player
and to the shipped hls.js, as a sliding live playlist with two independent
parameters:

  target     the advertised #EXT-X-TARGETDURATION, which is also the server's
             publication cadence (a new snapshot is due every target seconds)
  bootstrap  seconds of media present when the first playlist is released

After release the produced media grows at --rate times real time. Every
snapshot publishes every completed segment up to a steady published reserve
ahead of the viewer's reported position (48 s, today's value, which the
design keeps), never less than one new segment per cycle. Removed segments
trail the reported position by 30 s. Each run writes a JSON receipt with its
reload log and the client's events; `--summarize` groups receipts by
arm x player x rate and writes the A-M0 decision.

It does not exercise the daemon's actor, flow controller, scratch or source
production. The fixture decides when the first playlist exists, so starting
earlier is true by construction and is not a criterion.

Modes:
  --generate-media DIR [--duration S] [--segment S]   make the media
  --media-dir DIR --evidence-dir DIR [--bind H] [--port N]   serve
  --summarize DIR [--output FILE] [--min-seconds S]   decide
  --plan --target T --bootstrap B --rate R            print the snapshots
"""
import argparse
import hashlib
import http.server
import json
import math
import pathlib
import re
import subprocess
import sys
import threading
import time
import urllib.parse
import uuid

REPO = pathlib.Path(__file__).resolve().parent.parent
HLS_JS = REPO / 'crates/plurxd/src/web/hls.min.js'
POLICY_JS = REPO / 'crates/plurxd/src/web/playback-policy.js'
RUN_SCHEMA = 'plurx.startup-lab.run.v2'
DECISION_SCHEMA = 'plurx.startup-lab.decision.v1'
MEDIA_MANIFEST = 'lab-media.json'

# Arms named by the handoff. Any other valid pair is accepted and named t<T>-b<B>.
NAMED_ARMS = {'control': (16, 48), 'a': (8, 24), 'b': (8, 32), 'c': (6, 18), 'd': (4, 12)}
DECISION_ARMS = ('a', 'b')
DECISION_RATES = (1.05, 1.0, 2.0)
DECISION_PLAYERS = ('safari-native', 'hlsjs')
DECISION_TEXT = {
    24000: '8 / 24 clean at every rate → B = 24 000',
    32000: '8 / 24 not clean, 8 / 32 clean at every rate → B = 32 000',
    None: 'neither clean → Part A is not built',
}

# Bounds. A target shorter than the segment cannot carry it; a bootstrap under
# two targets is below Safari's observed start rule; 124 s is the rolling
# reserve maximum, so no first snapshot can exceed it.
TARGET_MAX_S = 20
BOOTSTRAP_MAX_S = 124
RATE_MIN = 0.25
RATE_MAX = 8.0

# Server model (seconds).
STEADY_RESERVE_S = 48.0      # published lead ahead of the viewer, today's steady reserve
PRODUCTION_CEILING_S = 124.0  # produced lead ahead of the viewer, the reserve maximum
BACK_WINDOW_S = 30.0          # removed segments trail the viewer by this much
DEFAULT_SETUP_S = 3.0         # producer start cost before the bootstrap burst
DEFAULT_BURST = 8.0           # bootstrap is produced at this multiple of real time

# Receipt rule (seconds). Stated in every receipt and decision.
PROGRESS_S = 0.5
FREEZE_S = 2.0
FREEZE_ADVANCE_S = 0.1
FORWARD_JUMP_S = 1.0
BACKWARD_JUMP_S = 0.5
DEFICIT_MARGIN_S = 2.0
START_TIMEOUT_S = 120
DEFAULT_RUN_SECONDS = 1800
CLIENT_EVENT_CAP = 20000
SEGMENT_LOG_CAP = 4000
CLEAN_RULE = (
    'A run is clean when it presented a first frame and, from then until it '
    'completed, had: zero stalls (a `waiting` event after the playhead advanced '
    f'{PROGRESS_S} s past its first-frame position); zero freezes ({FREEZE_S} s '
    f'or more of wall time with less than {FREEZE_ADVANCE_S} s of playhead '
    'advance while not paused, seeking or ended); zero position jumps (between '
    'consecutive 1 s samples, position advance exceeding wall time x '
    f'playbackRate by more than {FORWARD_JUMP_S} s, or position moving back '
    f'more than {BACKWARD_JUMP_S} s); zero buffer deficits (a sample after that '
    f'progress whose forward buffer -- end of the buffered range holding the '
    f'playhead minus the playhead -- is under {DEFICIT_MARGIN_S} s while the '
    'served playlist has no ENDLIST); and no fatal player error. A run counts '
    'only when complete (its page reached the run length, timed out before a '
    'first frame, or hit a fatal error), was not paused by the browser or the '
    'operator, and did not exhaust the generated media. A cell is clean when it '
    'has at least one counted run and every counted run in it is clean.'
)


class ArmError(ValueError):
    pass


def _integral(value, name):
    try:
        number = float(value)
    except (TypeError, ValueError):
        raise ArmError(f'{name} must be a number, got {value!r}') from None
    if not math.isfinite(number) or number != int(number):
        raise ArmError(f'{name} must be a whole number of seconds, got {value!r}')
    return int(number)


def validate_arm(target, bootstrap, rate, segment=2):
    """Return (target, bootstrap, rate) or raise ArmError naming the broken rule."""
    target = _integral(target, 'target')
    bootstrap = _integral(bootstrap, 'bootstrap')
    try:
        rate = float(rate)
    except (TypeError, ValueError):
        raise ArmError(f'rate must be a number, got {rate!r}') from None
    if target < segment:
        raise ArmError(f'target {target} s is shorter than the {segment} s segment')
    if target > TARGET_MAX_S:
        raise ArmError(f'target {target} s is above the {TARGET_MAX_S} s bound')
    if bootstrap < 2 * target:
        raise ArmError(f'bootstrap {bootstrap} s is under 2 x target ({2 * target} s)')
    if bootstrap > BOOTSTRAP_MAX_S:
        raise ArmError(f'bootstrap {bootstrap} s is above the {BOOTSTRAP_MAX_S} s reserve maximum')
    if bootstrap % segment:
        raise ArmError(f'bootstrap {bootstrap} s is not a whole number of {segment} s segments')
    if not math.isfinite(rate) or not RATE_MIN <= rate <= RATE_MAX:
        raise ArmError(f'rate {rate} is outside {RATE_MIN}..{RATE_MAX}')
    return target, bootstrap, rate


def arm_name(target, bootstrap):
    for name, pair in NAMED_ARMS.items():
        if pair == (target, bootstrap):
            return name
    return f't{target}-b{bootstrap}'


def resolve_arm(arm=None, target=None, bootstrap=None):
    """An arm name, or an explicit pair. Explicit values win over the name."""
    if arm:
        if arm not in NAMED_ARMS:
            raise ArmError(f'unknown arm {arm!r}; named arms are {", ".join(NAMED_ARMS)}')
        named_target, named_bootstrap = NAMED_ARMS[arm]
        target = named_target if target in (None, '') else target
        bootstrap = named_bootstrap if bootstrap in (None, '') else bootstrap
    if target in (None, '') or bootstrap in (None, ''):
        raise ArmError('give an arm name or both target and bootstrap')
    return target, bootstrap


class Clock:
    """Deterministic publication model; every time is seconds since the run began.

    Snapshots change only on publication ticks, one target apart from release,
    so every reload inside a tick receives identical bytes.
    """

    def __init__(self, target, bootstrap, rate, durations, setup_s=DEFAULT_SETUP_S,
                 burst=DEFAULT_BURST, reserve_s=STEADY_RESERVE_S,
                 ceiling_s=PRODUCTION_CEILING_S, back_s=BACK_WINDOW_S):
        self.segment = durations[0]
        self.target, self.bootstrap, self.rate = validate_arm(target, bootstrap, rate, self.segment)
        if self.bootstrap / self.segment > len(durations):
            raise ArmError(f'the media holds {len(durations)} segments, fewer than the bootstrap')
        self.durations = durations
        self.ends = []
        total = 0.0
        for duration in durations:
            total += duration
            self.ends.append(total)
        self.release_s = setup_s + self.bootstrap / burst
        self.reserve_s = reserve_s
        self.ceiling_s = ceiling_s
        self.back_s = back_s
        self.tick = -1
        self.produced_s = 0.0
        self.count = 0
        self.first = 0

    def _count_at(self, media_s):
        return sum(1 for end in self.ends if end <= media_s + 1e-6)

    def snapshot(self, now_s, position_s=None):
        """The snapshot served at now_s, or None before release.

        position_s is the viewer's latest reported position. Unknown, the
        model assumes the viewer has played since release at 1x, an upper
        bound that can only publish more, and removes nothing.
        """
        if now_s < self.release_s:
            return None
        due = int((now_s - self.release_s) // self.target)
        while self.tick < due:
            self.tick += 1
            tick_at = self.release_s + self.tick * self.target
            viewer = position_s if position_s is not None else tick_at - self.release_s
            if self.tick == 0:
                self.produced_s = float(self.bootstrap)
                self.count = self._count_at(self.produced_s)
                continue
            self.produced_s = min(self.produced_s + self.rate * self.target,
                                  max(viewer + self.ceiling_s, self.produced_s))
            produced = self._count_at(self.produced_s)
            reserve = self._count_at(viewer + self.reserve_s)
            self.count = max(self.count, min(produced, max(reserve, self.count + 1)))
            if position_s is not None:
                behind = self._count_at(max(0.0, position_s - self.back_s))
                self.first = max(self.first, min(behind, self.count - 1))
        ended = self.count >= len(self.durations)
        return {
            'tick': self.tick,
            'media_sequence': self.first,
            'count': self.count,
            'segments': self.count - self.first,
            'end_s': round(self.ends[self.count - 1], 3),
            'ended': ended,
        }

    def playlist(self, snap, uri):
        """uri(name) returns the URI for a media file name."""
        lines = ['#EXTM3U', '#EXT-X-VERSION:7', f'#EXT-X-TARGETDURATION:{self.target}',
                 f'#EXT-X-MEDIA-SEQUENCE:{snap["media_sequence"]}',
                 '#EXT-X-START:TIME-OFFSET=0', f'#EXT-X-MAP:URI="{uri("init.mp4")}"']
        for index in range(snap['media_sequence'], snap['count']):
            lines.append(f'#EXTINF:{self.durations[index]:.6f},')
            lines.append(uri(segment_name(index)))
        if snap['ended']:
            lines.append('#EXT-X-ENDLIST')
        return '\n'.join(lines) + '\n'


def segment_name(index):
    return f'seg{index:05d}.m4s'


def segment_index(name):
    match = re.fullmatch(r'seg(\d{5})\.m4s', name)
    return int(match.group(1)) if match else None


def load_media(directory):
    directory = pathlib.Path(directory).resolve()
    manifest_path = directory / MEDIA_MANIFEST
    if not manifest_path.is_file():
        raise SystemExit(f'{manifest_path} is missing; make the media with --generate-media {directory}')
    manifest = json.loads(manifest_path.read_text())
    durations = [float(value) for value in manifest['durations']]
    missing = [name for name in ['init.mp4'] + [segment_name(i) for i in range(len(durations))]
               if not (directory / name).is_file()]
    if missing:
        raise SystemExit(f'{directory} lacks {len(missing)} media files, first {missing[0]}')
    return directory, manifest, durations


def file_sha256(path):
    return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()


# ---------------------------------------------------------------- media

def generate_media(directory, duration, segment):
    directory = pathlib.Path(directory)
    if segment < 2 or segment % 2:
        raise SystemExit('--segment must be an even number of seconds; keyframes are 2 s apart')
    directory.mkdir(parents=True, exist_ok=True)
    fps = 30
    argv = [
        'ffmpeg', '-hide_banner', '-loglevel', 'error', '-y',
        '-f', 'lavfi', '-i', f'testsrc=size=640x360:rate={fps}:duration={duration}',
        '-f', 'lavfi', '-i', f'sine=frequency=440:beep_factor=4:sample_rate=48000:duration={duration}',
        '-map', '0:v', '-map', '1:a',
        '-c:v', 'libx264', '-preset', 'veryfast', '-profile:v', 'high', '-pix_fmt', 'yuv420p',
        '-g', str(2 * fps), '-keyint_min', str(2 * fps), '-sc_threshold', '0', '-bf', '2',
        '-flags', '+cgop', '-force_key_frames', 'expr:gte(t,n_forced*2)',
        '-c:a', 'aac', '-b:a', '96k', '-ac', '2',
        '-f', 'hls', '-hls_time', str(segment), '-hls_playlist_type', 'vod',
        '-hls_segment_type', 'fmp4', '-hls_flags', 'independent_segments',
        '-hls_fmp4_init_filename', 'init.mp4',
        '-hls_segment_filename', str(directory / 'seg%05d.m4s'),
        str(directory / 'source.m3u8'),
    ]
    subprocess.run(argv, check=True)
    durations = [float(line.split(':', 1)[1].rstrip(','))
                 for line in (directory / 'source.m3u8').read_text().splitlines()
                 if line.startswith('#EXTINF:')]
    odd = [(i, d) for i, d in enumerate(durations[:-1]) if abs(d - segment) > 0.01]
    if odd:
        raise SystemExit(f'segment {odd[0][0]} is {odd[0][1]} s, not {segment} s')
    version = subprocess.run(['ffmpeg', '-version'], capture_output=True, text=True).stdout.splitlines()[0]
    manifest = {
        'segment_seconds': segment,
        'segments': len(durations),
        'durations': durations,
        'video': f'H.264 High 640x360 {fps} fps, closed GOP, keyframe every 2 s',
        'audio': 'AAC-LC 48 kHz stereo 96 kb/s',
        'ffmpeg': version,
        'argv': argv,
        'init_sha256': file_sha256(directory / 'init.mp4'),
    }
    (directory / MEDIA_MANIFEST).write_text(json.dumps(manifest, indent=2) + '\n')
    print(f'{len(durations)} segments of {segment} s in {directory}')


# ---------------------------------------------------------------- analysis

def derive_player(transport, user_agent, device=''):
    if device:
        return f'device:{device}'
    if transport == 'hlsjs':
        return 'hlsjs'
    if transport == 'direct':
        return 'direct'
    agent = user_agent or ''
    safari = 'Safari/' in agent and 'Version/' in agent and not re.search(r'Chrome|Chromium|CriOS|Edg|Firefox', agent)
    return 'safari-native' if safari else 'native-other'


def analyse(run, min_seconds=None):
    """Derive the rule's quantities from a receipt's raw records.

    The judged window runs from the first frame to the run's end event, or to
    the first browser pause if one came earlier. A failure inside the window
    always counts; a run that was paused or exhausted the media without
    failing is not counted, so neither can hide a failure nor fake a pass.
    """
    if min_seconds is None:
        min_seconds = run.get('run_seconds', DEFAULT_RUN_SECONDS)
    events = sorted((e for e in run.get('client', []) if isinstance(e.get('client_ms'), (int, float))),
                    key=lambda e: e['client_ms'])
    out = {'min_seconds': min_seconds, 'client_events': len(events)}
    if not events:
        out.update(complete=False, counted=False, clean=False, reasons=['no client telemetry'])
        return out
    offsets = [e['server_ms'] - e['client_ms'] for e in events if isinstance(e.get('server_ms'), (int, float))]
    offset = min(offsets) if offsets else None
    first = next((e for e in events if e['event'] == 'first_frame'), None)
    end = next((e for e in events if e['event'] in ('run_complete', 'start_timeout', 'fatal_error')), None)
    end_ms = end['client_ms'] if end else math.inf
    pause = next((e for e in events if e['event'] == 'pause' and first is not None
                  and first['client_ms'] < e['client_ms'] < end_ms), None)
    cut_ms = min(end_ms, pause['client_ms']) if pause else end_ms
    waiting = [e for e in events if e['event'] == 'waiting']
    out['waiting_events'] = [{'client_ms': e['client_ms'], 'position': e.get('position')} for e in waiting]
    fatal = [e for e in events if e['client_ms'] <= cut_ms and (
        e['event'] in ('video_error', 'player_unsupported') or (e['event'] == 'hls_error' and e.get('fatal')))]
    if first is None:
        out.update(first_frame=False, ttff_after_first_playlist_ms=None)
    else:
        served = run.get('first_playlist_served_ms')
        out.update(first_frame=True, ttff_source=first.get('source', 'video_frame_callback'),
                   start_position_s=first.get('position'), clock_offset_ms=offset,
                   ttff_after_first_playlist_ms=(round(first['client_ms'] + offset - served)
                                                 if offset is not None and served is not None else None))
    progress_ms = None
    if first is not None:
        base = first.get('position') or 0
        progress_ms = next((e['client_ms'] for e in events if e['client_ms'] >= first['client_ms']
                            and isinstance(e.get('position'), (int, float)) and e['position'] >= base + PROGRESS_S),
                           None)
    out['progress_ms'] = progress_ms

    def judged(ms):
        return progress_ms is not None and progress_ms < ms <= cut_ms

    stalls = [e for e in waiting if judged(e['client_ms'])]
    samples = [e for e in events if e['event'] == 'sample' and isinstance(e.get('position'), (int, float))
               and first is not None and first['client_ms'] <= e['client_ms'] <= cut_ms]
    ended_at = run.get('endlist_served_ms')
    freezes, jumps, deficits = [], [], []
    anchor, freezing, deficit_open, previous = None, False, False, None
    for s in samples:
        moving = not (s.get('paused') or s.get('ended') or s.get('seeking'))
        if previous is not None and moving and not (previous.get('paused') or previous.get('seeking')):
            wall = (s['client_ms'] - previous['client_ms']) / 1000 * (previous.get('rate') or 1)
            moved = s['position'] - previous['position']
            if moved - wall > FORWARD_JUMP_S or moved < -BACKWARD_JUMP_S:
                jumps.append({'client_ms': s['client_ms'], 'from': previous['position'],
                              'to': s['position'], 'wall_s': round(wall, 3)})
        previous = s
        if not judged(s['client_ms']):
            continue
        if not moving:
            anchor, freezing = None, False
        elif anchor is None or s['position'] - anchor['position'] > FREEZE_ADVANCE_S:
            anchor, freezing = s, False
        elif not freezing and s['client_ms'] - anchor['client_ms'] >= FREEZE_S * 1000:
            freezing = True
            freezes.append({'client_ms': anchor['client_ms'], 'position': s['position']})
        server_ms = s.get('server_ms')
        endlisted = ended_at is not None and server_ms is not None and server_ms >= ended_at
        ahead = s.get('ahead')
        if not s.get('ended') and not endlisted and isinstance(ahead, (int, float)) and ahead < DEFICIT_MARGIN_S:
            if not deficit_open:
                deficits.append({'client_ms': s['client_ms'], 'position': s['position'], 'ahead': ahead})
            deficit_open = True
        else:
            deficit_open = False
    timed_out = bool(end and end['event'] == 'start_timeout' and first is None)
    failed = bool(stalls or freezes or jumps or deficits or fatal or timed_out)
    observed = None
    if first is not None:
        last = cut_ms if cut_ms != math.inf else (samples[-1]['client_ms'] if samples else first['client_ms'])
        observed = round((last - first['client_ms']) / 1000, 3)
    long_enough = observed is not None and observed >= min_seconds - 1
    finished = end is not None and end['event'] == 'run_complete'
    exhausted = ended_at is not None and not (finished and ended_at > (end.get('server_ms') or math.inf))
    complete = failed or (long_enough and (finished or end is None) and not pause)
    counted = failed or (complete and not exhausted)
    reasons = []
    if timed_out:
        reasons.append(f'no first frame within {START_TIMEOUT_S} s')
    if fatal:
        reasons.append('fatal player error')
    for name, count in (('stall', len(stalls)), ('freeze', len(freezes)),
                        ('position jump', len(jumps)), ('buffer deficit', len(deficits))):
        if count:
            reasons.append(f'{count} {name}{"s" if count > 1 else ""}')
    if pause and not failed:
        reasons.append('paused by the browser or operator before completing; not counted')
    if exhausted and not failed:
        reasons.append('the generated media ran out before the run completed; make longer media')
    if not complete and not pause:
        reasons.append(f'incomplete: {observed or 0} of {min_seconds} s observed')
    out.update(
        stalls=len(stalls), stall_events=[{'client_ms': e['client_ms'], 'position': e.get('position')} for e in stalls],
        freezes=len(freezes), freeze_events=freezes,
        position_jumps=len(jumps), jump_events=jumps,
        buffer_deficits=len(deficits), deficit_events=deficits,
        fatal_errors=len(fatal),
        fatal_events=[{k: e.get(k) for k in ('event', 'client_ms', 'type', 'details', 'code')} for e in fatal],
        browser_pauses=1 if pause else 0, observed_seconds=observed,
        complete=complete, counted=counted, clean=counted and not failed, reasons=reasons,
    )
    return out


# ---------------------------------------------------------------- summary

def rate_key(rate):
    return round(float(rate), 3)


def summarize(directory, min_seconds=DEFAULT_RUN_SECONDS):
    directory = pathlib.Path(directory)
    receipts = []
    for path in sorted(directory.glob('*.json')):
        try:
            run = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if run.get('schema') != RUN_SCHEMA:
            continue
        receipts.append((path, run))
    cells = {}
    for path, run in receipts:
        player = derive_player(run.get('transport'), run.get('user_agent'), run.get('device', ''))
        key = (run['target'], run['bootstrap'], player, rate_key(run['rate']))
        metrics = analyse(run, min_seconds)
        entry = {
            'id': run['id'], 'file': path.name, 'sha256': file_sha256(path),
            'user_agent': run.get('user_agent'), 'created_utc': run.get('created_utc'),
            'counted': metrics['counted'], 'clean': metrics['clean'], 'reasons': metrics['reasons'],
            'ttff_after_first_playlist_ms': metrics.get('ttff_after_first_playlist_ms'),
            'ttff_source': metrics.get('ttff_source'),
            'observed_seconds': metrics.get('observed_seconds'),
            **{k: metrics.get(k) for k in ('stalls', 'freezes', 'position_jumps', 'buffer_deficits',
                                           'fatal_errors', 'browser_pauses')},
            'waiting_events': len(metrics.get('waiting_events', [])),
            'reloads': len(run.get('reloads', [])),
        }
        cells.setdefault(key, []).append(entry)
    table = []
    for (target, bootstrap, player, rate), runs in sorted(cells.items()):
        counted = [r for r in runs if r['counted']]
        status = 'missing' if not counted else ('clean' if all(r['clean'] for r in counted) else 'not clean')
        table.append({'arm': arm_name(target, bootstrap), 'target': target, 'bootstrap': bootstrap,
                      'player': player, 'rate': rate, 'status': status, 'runs': runs})
    status = {(c['target'], c['bootstrap'], c['player'], c['rate']): c['status'] for c in table}
    required, missing = [], []
    for arm in DECISION_ARMS:
        target, bootstrap = NAMED_ARMS[arm]
        for player in DECISION_PLAYERS:
            for rate in DECISION_RATES:
                label = f'{target} / {bootstrap} {player} {rate:g}x'
                required.append(label)
                if status.get((target, bootstrap, player, rate_key(rate)), 'missing') == 'missing':
                    missing.append(label)

    def arm_clean(arm):
        target, bootstrap = NAMED_ARMS[arm]
        return all(status.get((target, bootstrap, p, rate_key(r))) == 'clean'
                   for p in DECISION_PLAYERS for r in DECISION_RATES)

    acceptance_grade = min_seconds >= DEFAULT_RUN_SECONDS
    if missing:
        b_ms, decision = None, None
        refusal = ('No decision: both target-8 arms need a counted run at every rate on both '
                   'players. Missing: ' + '; '.join(missing))
    else:
        refusal = None
        b_ms = 24000 if arm_clean('a') else 32000 if arm_clean('b') else None
        decision = DECISION_TEXT[b_ms]
    # Runs shorter than the handoff's 30 minutes never name B. What they
    # would have decided is kept, labelled provisional, for smoke runs.
    provisional_decision, provisional_b_ms = decision, b_ms
    if not acceptance_grade and refusal is None:
        refusal = (f'No decision: runs judged over {min_seconds} s are not acceptance grade '
                   f'(A-M0 needs {DEFAULT_RUN_SECONDS} s). Provisional: {decision}')
    if not acceptance_grade:
        decision, b_ms = None, None
    return {
        'schema': DECISION_SCHEMA,
        'generated_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
        'evidence_dir': directory.name,
        'lab_sha256': file_sha256(__file__),
        'min_seconds': min_seconds,
        'acceptance_grade': acceptance_grade,
        'clean_rule': CLEAN_RULE,
        'required_cells': required,
        'missing_cells': missing,
        'decision': decision,
        'bootstrap_ms': b_ms,
        'provisional_decision': provisional_decision,
        'provisional_bootstrap_ms': provisional_b_ms,
        'refusal': refusal,
        'cells': table,
    }


def print_summary(result):
    print(f'{"arm":8} {"T/B":7} {"player":22} {"rate":>5}  {"status":10} runs  ttff ms')
    for cell in result['cells']:
        ttff = [r['ttff_after_first_playlist_ms'] for r in cell['runs'] if r['ttff_after_first_playlist_ms'] is not None]
        print(f'{cell["arm"]:8} {cell["target"]:>2}/{cell["bootstrap"]:<4} {cell["player"]:22} '
              f'{cell["rate"]:>5g}  {cell["status"]:10} {len(cell["runs"]):>4}  '
              f'{",".join(str(t) for t in ttff) or "-"}')
        for run in cell['runs']:
            if run['reasons']:
                print(f'    {run["file"]}: {"; ".join(run["reasons"])}')
    if not result['acceptance_grade']:
        print(f'NOT ACCEPTANCE GRADE: --min-seconds {result["min_seconds"]} is under {DEFAULT_RUN_SECONDS}')
    print(result['decision'] or result['refusal'])


