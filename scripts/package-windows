#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
target="${CARGO_TARGET_DIR:-$root/target}/x86_64-pc-windows-msvc/release"
stage="$root/target/windows-package/plurx-windows-x86_64"
archive="$root/target/windows-package/plurxd-windows-x86_64.zip"

test -f "$target/plurxd.exe" || {
  echo "missing release binary: $target/plurxd.exe" >&2
  exit 1
}
pdb_name=$(PYTHONPATH="$root" python3 -m validation.release_pdb \
  "$target/plurxd.exe" "$target/plurxd.pdb")

rm -rf "$stage"
mkdir -p "$stage"
cp "$target/plurxd.exe" "$stage/plurxd.exe"
cp "$target/plurxd.pdb" "$stage/$pdb_name"
cp "$root/plurx.example.toml" "$stage/plurx.example.toml"
cp "$root/deploy/windows/README.md" "$stage/README.md"

mkdir -p "$(dirname "$archive")"
rm -f "$archive"
# Python is already required by the PE/PDB verifier. Keep archive creation
# available on the same hosts without a second, undeclared `zip` executable.
(cd "$(dirname "$stage")" && python3 -m zipfile -c "$archive" "$(basename "$stage")")
sha256sum "$archive" > "$archive.sha256"
printf '%s\n' "$archive"
