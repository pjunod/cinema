#!/usr/bin/env python3
"""Reassemble Rust splits and compare them with a Git revision.

Usage: split-identity BASE SOURCE PIECE [PIECE ...]
       split-identity BASE --plan
       split-identity BASE --moves

PIECE files are concatenated in source order. Lines inside a
``// split: header`` / ``// split: end header`` pair are split-only module
plumbing and are omitted. Passing SOURCE as the only piece is the M0
unchanged-file self-test.

``--plan`` proves the M1 and M2/T2 subsection moves. It replaces explicit
markers in each current parent with the children named below, removes only
the module plumbing represented by those markers, and compares the complete
reconstructed parent byte-for-byte with BASE. The segment-index recipe also
checks the exact count of parent-visibility additions before removing them.
``--moves`` proves the S-14 continuation moves (M2/T3 onward) against BASE,
which is the branch's current merge base with main: the reconstruction reads
the working tree and BASE only supplies the expected parents, so after a merge
of main the same proof is run against the new merge base. Every main change
to a split parent has to be re-applied inside the child now holding its
region; an ``OK`` against the new merge base shows none was dropped or
duplicated, and the per-row counts below include the ``pub(super)`` that
main's new cross-child items needed. Each row of ``MOVES`` names a parent, a marker
and the child that marker stands for: the child's exact ``use super::*;``
header is dropped, every ``pub(super) `` it gained is removed (and counted
against the row's declared number), the result replaces the marker block,
and the reconstructed parent is passed through ``rustfmt`` on stdin (the
added visibility pushes some signatures past the line limit, so rustfmt
wrapped them; formatting the reconstruction unwraps exactly those) before a
byte-for-byte comparison with the base parent. The base parent is itself
checked to be a rustfmt fixed point so formatting cannot hide a difference.

This one-shot helper is deleted before the plan PR is promoted.
"""

from __future__ import annotations

import difflib
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def without_split_headers(path: pathlib.Path) -> list[str]:
    lines: list[str] = []
    inside_header = False
    for line_number, line in enumerate(
        path.read_text(encoding="utf-8").splitlines(keepends=True), start=1
    ):
        if line.rstrip("\r\n") == "// split: header":
            if inside_header:
                raise SystemExit(f"{path}:{line_number}: nested split header")
            inside_header = True
            continue
        if line.rstrip("\r\n") == "// split: end header":
            if not inside_header:
                raise SystemExit(f"{path}:{line_number}: unmatched split header end")
            inside_header = False
            continue
        if not inside_header:
            lines.append(line)
    if inside_header:
        raise SystemExit(f"{path}: unterminated split header")
    return lines


def chunks(manifest: str) -> str:
    manifest_path = ROOT / manifest
    result: list[str] = []
    for line_number, line in enumerate(
        manifest_path.read_text(encoding="utf-8").splitlines(), start=1
    ):
        prefix = 'include!("'
        suffix = '");'
        if not line.startswith(prefix) or not line.endswith(suffix):
            raise SystemExit(
                f"{manifest}:{line_number}: expected a plain include! manifest"
            )
        child = manifest_path.parent / line[len(prefix) : -len(suffix)]
        result.append(child.read_text(encoding="utf-8"))
    return "".join(result)


def replace_marker(parent: str, marker: str, replacement: str) -> str:
    begin = f"// split: begin {marker}\n"
    end = f"// split: end {marker}\n"
    if parent.count(begin) != 1 or parent.count(end) != 1:
        raise SystemExit(f"expected exactly one {marker!r} marker pair")
    before, marked = parent.split(begin, 1)
    _plumbing, after = marked.split(end, 1)
    return before + replacement + after


def indented_child(path: str) -> str:
    lines = read(path).splitlines(keepends=True)
    return "".join(("    " + line) if line.strip() else line for line in lines)


def plan_reconstructions() -> dict[str, str]:
    transcode_path = "crates/plurxd/src/transcode.rs"
    transcode = read(transcode_path)

    segment = read("crates/plurxd/src/transcode/rolling/segment_index.rs")
    header = "use super::*;\n\n"
    if not segment.startswith(header):
        raise SystemExit("segment-index child lost its exact structural header")
    segment = segment[len(header) :]
    visibility = "pub(super) "
    expected_visibility_additions = 40
    actual_visibility_additions = segment.count(visibility)
    if actual_visibility_additions != expected_visibility_additions:
        raise SystemExit(
            "segment-index visibility additions: "
            f"expected {expected_visibility_additions}, got {actual_visibility_additions}"
        )
    segment = segment.replace(visibility, "")
    transcode = replace_marker(transcode, "segment-index", segment)

    renewal = (
        "#[cfg(test)]\n"
        "mod pretranscode_renewal_tests {\n"
        + indented_child("crates/plurxd/src/transcode/tests/pretranscode_renewal.rs")
        + "}\n"
    )
    transcode = replace_marker(transcode, "pretranscode-renewal-tests", renewal)
    transcode_tests = chunks("crates/plurxd/src/transcode/tests.rs")
    relocated_include = 'include!("../../vodencode_manager_tests.rs");'
    if transcode_tests.count(relocated_include) != 1:
        raise SystemExit("expected the one declared vodencode test include relocation")
    transcode_tests = transcode_tests.replace(
        relocated_include, 'include!("vodencode_manager_tests.rs");'
    )
    tests = (
        "#[cfg(test)]\n"
        "pub(crate) mod tests {\n"
        + transcode_tests
        + "}\n"
    )
    transcode = replace_marker(transcode, "transcode-tests", tests)

    hls_tests = chunks("crates/plurxd/src/http/hls/tests.rs")
    hls_relocated_source = 'include_str!("../../hls.rs")'
    if hls_tests.count(hls_relocated_source) != 3:
        raise SystemExit("expected the three declared hls source include relocations")
    hls_tests = hls_tests.replace(hls_relocated_source, 'include_str!("hls.rs")')
    hls_path = "crates/plurxd/src/http/hls.rs"
    hls = replace_marker(
        read(hls_path),
        "hls-tests",
        "#[cfg(test)]\nmod tests {\n"
        + hls_tests
        + "}\n",
    )

    vod_tests = chunks("crates/plurxd/src/vod/tests.rs")
    vod_relocated_include = 'include!("../../vodencode_tests.rs");'
    if vod_tests.count(vod_relocated_include) != 1:
        raise SystemExit("expected the one declared vodencode test include relocation")
    vod_tests = vod_tests.replace(
        vod_relocated_include, 'include!("vodencode_tests.rs");'
    )
    vod_path = "crates/plurxd/src/vodserve.rs"
    vod = replace_marker(
        read(vod_path),
        "vod-tests",
        "#[cfg(test)]\nmod tests {\n"
        + vod_tests
        + "}\n",
    )
    return {transcode_path: transcode, hls_path: hls, vod_path: vod}


MOVES: list[tuple[str, str, str, int]] = [
    # (parent, marker, child relative to the parent's directory, pub(super) additions)
    ("crates/plurxd/src/transcode.rs", "flow", "transcode/rolling/flow.rs", 50),
    ("crates/plurxd/src/transcode.rs", "spawn", "transcode/producer/spawn.rs", 20),
    ("crates/plurxd/src/transcode.rs", "prepublication", "transcode/rolling/prepublication.rs", 44),
    ("crates/plurxd/src/transcode.rs", "retirement", "transcode/rolling/retirement.rs", 37),
    ("crates/plurxd/src/transcode.rs", "prepublication-executor", "transcode/producer/prepublication_executor.rs", 8),
    ("crates/plurxd/src/transcode.rs", "attempt-child", "transcode/producer/attempt_child.rs", 38),
    ("crates/plurxd/src/transcode.rs", "publication", "transcode/rolling/publication.rs", 58),
    ("crates/plurxd/src/transcode.rs", "session", "transcode/rolling/session.rs", 157),
    ("crates/plurxd/src/transcode.rs", "response", "transcode/response.rs", 31),
    ("crates/plurxd/src/transcode.rs", "hls-codecs", "transcode/hls_codecs.rs", 2),
    ("crates/plurxd/src/transcode.rs", "cluster-adoption", "transcode/cluster_adoption.rs", 43),
    ("crates/plurxd/src/transcode.rs", "session-request", "transcode/session_request.rs", 22),
    ("crates/plurxd/src/transcode.rs", "requests", "transcode/requests.rs", 12),
    ("crates/plurxd/src/transcode.rs", "pretranscode-source", "transcode/pretranscode/source.rs", 44),
    ("crates/plurxd/src/transcode.rs", "pretranscode-parts", "transcode/pretranscode/parts.rs", 46),
    ("crates/plurxd/src/transcode.rs", "rate-control", "transcode/rate_control.rs", 9),
    ("crates/plurxd/src/transcode.rs", "retention", "transcode/rolling/retention.rs", 6),
    ("crates/plurxd/src/transcode.rs", "ladder", "transcode/ladder.rs", 7),
    ("crates/plurxd/src/transcode.rs", "test-support", "transcode/test_support.rs", 3),
    ("crates/plurxd/src/http/hls.rs", "hls-session-guard", "hls/session_guard.rs", 13),
    ("crates/plurxd/src/http/hls.rs", "hls-create", "hls/create.rs", 33),
    ("crates/plurxd/src/http/hls.rs", "hls-relay", "hls/relay.rs", 2),
    ("crates/plurxd/src/http/hls.rs", "hls-release", "hls/release.rs", 7),
    ("crates/plurxd/src/http/hls.rs", "hls-control", "hls/control.rs", 45),
    ("crates/plurxd/src/http/hls.rs", "hls-preparation", "hls/preparation.rs", 47),
    ("crates/plurxd/src/http/hls.rs", "hls-status", "hls/status.rs", 3),
    ("crates/plurxd/src/http/hls.rs", "hls-response", "hls/response.rs", 35),
    ("crates/plurxd/src/http/hls.rs", "hls-playlist", "hls/playlist.rs", 5),
    ("crates/plurxd/src/http/hls.rs", "hls-subtitle-playlist", "hls/subtitle_playlist.rs", 9),
    ("crates/plurxd/src/http/hls.rs", "hls-context", "hls/context.rs", 9),
    ("crates/plurxd/src/http/hls.rs", "hls-subtitle-names", "hls/subtitle_names.rs", 4),
    ("crates/plurxd/src/http/hls.rs", "hls-playlist-text", "hls/playlist_text.rs", 8),
    ("crates/plurxd/src/http/hls.rs", "hls-segment", "hls/segment.rs", 15),
    ("crates/plurxd/src/vodserve.rs", "vod-discovery", "vod/discovery.rs", 7),
    ("crates/plurxd/src/vodserve.rs", "vod-reader", "vod/reader.rs", 29),
    ("crates/plurxd/src/vodserve.rs", "vod-marker-prewarm", "vod/marker_prewarm.rs", 68),
    ("crates/plurxd/src/vodserve.rs", "vod-session", "vod/session.rs", 115),
    ("crates/plurxd/src/vodserve.rs", "vod-shared", "vod/shared.rs", 13),
    ("crates/plurxd/src/vodserve.rs", "vod-driver", "vod/driver.rs", 6),
    ("crates/plurxd/src/vodserve.rs", "vod-marker-dispatch", "vod/marker_dispatch.rs", 4),
    ("crates/plurxd/src/vodserve.rs", "vod-generation", "vod/generation.rs", 19),
    ("crates/plurxd/src/vodserve.rs", "vod-plan", "vod/plan.rs", 15),
    ("crates/plurxd/src/vodserve.rs", "vod-init", "vod/init.rs", 7),
]

CHILD_HEADER = "use super::*;\n\n"

# A parent's own `pub(super)` names *its* parent. Moved one level down, the
# same reach must be spelled out: `http/hls.rs`'s `pub(super)` (visible in
# `http`) becomes `pub(in crate::http)` in a child, and one inside hls.rs's
# inline `pub mod plan_derivation` (visible in `hls`) becomes
# `pub(in crate::http::hls)`. Reconstruction maps each back after removing
# the added `pub(super) `; the base parents contain no `pub(in ` at all.
RESTATED: dict[str, tuple[str, ...]] = {
    "crates/plurxd/src/http/hls.rs": ("pub(in crate::http) ", "pub(in crate::http::hls) "),
}


# Paths the parent wrote relative to *its* parent, which a child one level
# down must write with one more `super::` (hls.rs's `super::stream::`
# names `http::stream`). The base parents contain no `super::super::`.
RELOCATED: dict[str, tuple[str, str]] = {
    "crates/plurxd/src/http/hls.rs": ("super::super::", "super::"),
}


def unsplit_visibility(parent: str, text: str) -> tuple[str, int]:
    added = text.count("pub(super) ")
    text = text.replace("pub(super) ", "")
    for spelling in RESTATED.get(parent, ()):
        text = text.replace(spelling, "pub(super) ")
    if parent in RELOCATED:
        text = text.replace(*RELOCATED[parent])
    return text, added

# (parent, marker, impl header line, [chunk children], pub(super) additions):
# one `impl` block cut into contiguous chunks. Each chunk child is the
# structural header, the same impl header line, its methods, and a closing
# `}`; the single blank line that separated two methods at each cut is
# structural too, so the reconstruction joins chunks with one blank line.
IMPL_SPLITS: list[tuple[str, str, str, list[str], int]] = [
    (
        "crates/plurxd/src/transcode.rs",
        "manager",
        'impl TranscodeManager {\n',
        [
            "transcode/manager/construct.rs",
            "transcode/manager/plan.rs",
            "transcode/manager/cache.rs",
            "transcode/manager/produce.rs",
            "transcode/manager/create.rs",
            "transcode/manager/describe.rs",
            "transcode/manager/start.rs",
            "transcode/manager/control.rs",
            "transcode/manager/publication.rs",
            "transcode/manager/maintenance.rs",
        ],
        78,
    ),
    (
        "crates/plurxd/src/vodserve.rs",
        "vod-serve",
        'impl VodServe {\n',
        [
            "vod/serve/construct.rs",
            "vod/serve/create.rs",
            "vod/serve/delivery.rs",
            "vod/serve/end.rs",
            "vod/serve/control.rs",
            "vod/serve/serve.rs",
        ],
        11,
    ),
]


def impl_split_reconstruction(
    parent_text: str, parent: str, marker: str, header: str, chunks: list[str], expected: int
) -> tuple[str, str]:
    bodies: list[str] = []
    added = 0
    for chunk_rel in chunks:
        chunk_path = str(pathlib.Path(parent).parent / chunk_rel)
        text = read(chunk_path)
        prefix = CHILD_HEADER + header
        if not text.startswith(prefix) or not text.endswith("\n}\n"):
            raise SystemExit(f"{chunk_path}: lost its exact impl-chunk wrapper")
        body, count = unsplit_visibility(parent, text[len(prefix) : -len("}\n")])
        added += count
        bodies.append(body)
    if added != expected:
        raise SystemExit(f"{marker}: pub(super) additions expected {expected}, got {added}")
    rebuilt = header + "\n".join(bodies) + "}\n"
    return (
        replace_marker(parent_text, marker, rebuilt),
        f"{marker}: {len(chunks)} impl chunks, {added} pub(super) additions",
    )


def rustfmt(text: str) -> str:
    return subprocess.run(
        ["rustfmt", "--edition", "2021", "--emit", "stdout"],
        check=True,
        input=text.encode("utf-8"),
        stdout=subprocess.PIPE,
    ).stdout.decode("utf-8")


def moves_reconstructions() -> tuple[dict[str, str], list[str]]:
    parents: dict[str, str] = {}
    report: list[str] = []
    for parent, marker, child_rel, expected in MOVES:
        text = parents.get(parent) or read(parent)
        child_path = str(pathlib.Path(parent).parent / child_rel)
        child = read(child_path)
        if not child.startswith(CHILD_HEADER):
            raise SystemExit(f"{child_path}: lost its exact structural header")
        child = child[len(CHILD_HEADER) :]
        child, added = unsplit_visibility(parent, child)
        if added != expected:
            raise SystemExit(
                f"{child_path}: pub(super) additions expected {expected}, got {added}"
            )
        parents[parent] = replace_marker(text, marker, child)
        report.append(
            f"{child_path}: {child.count(chr(10))} lines, {added} pub(super) additions"
        )
    for parent, marker, header, chunks, expected in IMPL_SPLITS:
        text = parents.get(parent) or read(parent)
        parents[parent], line = impl_split_reconstruction(
            text, parent, marker, header, chunks, expected
        )
        report.append(line)
    return parents, report


def baseline(base: str, source: str) -> str:
    return subprocess.run(
        ["git", "show", f"{base}:{source}"],
        check=True,
        stdout=subprocess.PIPE,
    ).stdout.decode("utf-8")


def compare(base: str, source: str, current: str, description: str) -> bool:
    original = baseline(base, source)
    if current == original:
        print(f"{source}: OK against {base} ({description})")
        return True
    diff = difflib.unified_diff(
        original.splitlines(),
        current.splitlines(),
        fromfile=f"{base}:{source}",
        tofile=description,
        n=3,
        lineterm="",
    )
    for line in diff:
        print(line)
    return False


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[2] == "--plan":
        base = sys.argv[1]
        reconstructions = plan_reconstructions()
        return (
            0
            if all(
                compare(base, source, current, "marker-expanded split tree")
                for source, current in reconstructions.items()
            )
            else 1
        )

    if len(sys.argv) == 3 and sys.argv[2] == "--moves":
        base = sys.argv[1]
        reconstructions, report = moves_reconstructions()
        ok = True
        for source, current in reconstructions.items():
            original = baseline(base, source)
            if rustfmt(original) != original:
                print(f"{source}: base is not a rustfmt fixed point")
                ok = False
                continue
            raw_same = current == original
            ok &= compare(
                base,
                source,
                rustfmt(current),
                "marker-expanded continuation split tree"
                + ("" if raw_same else " after rustfmt"),
            )
        for line in report:
            print(line)
        return 0 if ok else 1

    if len(sys.argv) < 4:
        print(
            "usage: split-identity BASE SOURCE PIECE [PIECE ...]\n"
            "       split-identity BASE --plan\n"
            "       split-identity BASE --moves",
            file=sys.stderr,
        )
        return 2

    base, source, *piece_names = sys.argv[1:]
    assembled: list[str] = []
    counts: list[tuple[str, int]] = []
    for piece_name in piece_names:
        piece = pathlib.Path(piece_name)
        lines = without_split_headers(piece)
        assembled.extend(lines)
        counts.append((piece_name, len(lines)))
    current = "".join(assembled)

    if not compare(base, source, current, " + ".join(piece_names)):
        return 1

    for piece_name, count in counts:
        print(f"{piece_name}: {count} lines")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
