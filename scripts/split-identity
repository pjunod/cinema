    ("transcode/session_request.rs", None, 0, ["pub struct StartInfo {"]),
    ("transcode/test_support.rs", None, 0, ["pub(crate) fn require_ffmpeg() {"]),
]

ATTACHED = ("///", "//", "#[")


def item_span(lines: list[str], name: str) -> tuple[int, int, bool]:
    keep_comments = name.startswith("=")
    key = name[1:] if keep_comments else name
    hits = [index for index, line in enumerate(lines) if line.rstrip("\n") == key]
    if len(hits) != 1:
        raise SystemExit(f"{key!r}: expected one line in the base parent, found {len(hits)}")
    start = end = hits[0]
    if not keep_comments:
        while (
            start > 0
            and lines[start - 1].startswith(ATTACHED)
            and not lines[start - 1].startswith("// split:")
        ):
            start -= 1
    if not key.endswith(";"):
        end += 1
        while lines[end].rstrip("\n") not in ("}", "};", ");"):
            end += 1
    return start, end + 1, keep_comments


def item_spans(base_parent: str) -> dict[str, tuple[int, int, bool]]:
    lines = base_parent.splitlines(keepends=True)
    spans: dict[str, tuple[int, int, bool]] = {}
    owner: dict[int, str] = {}
    for _child, _marker, _expected, names in ITEM_MOVES:
        for name in names:
            span = item_span(lines, name)
            for index in range(span[0], span[1]):
                if index in owner:
                    raise SystemExit(f"{name!r} overlaps {owner[index]!r}")
                owner[index] = name
            spans[name] = span
    return spans


def single_blank_lines(lines: list[str]) -> list[str]:
    result: list[str] = []
    for line in lines:
        if line == "\n" and result and result[-1] == "\n":
            continue
        result.append(line)
    return result


def parent_without_items(base_parent: str, spans: dict[str, tuple[int, int, bool]]) -> list[str]:
    lines = base_parent.splitlines(keepends=True)
    removed: set[int] = set()
    for start, end, keep_comments in spans.values():
        removed.update(range(start, end))
        # A kept comment now sits on the item below it; the blank line that
        # separated the moved item from that one goes too.
        if keep_comments and end < len(lines) and lines[end] == "\n":
            removed.add(end)
    return single_blank_lines([line for index, line in enumerate(lines) if index not in removed])


def parent_without_new_markers(current: str, markers: dict[str, str]) -> list[str]:
    text = current
    for marker, child_rel in markers.items():
        begin = f"// split: begin {marker}\n"
        end = f"// split: end {marker}\n"
        if text.count(begin) != 1 or text.count(end) != 1:
            raise SystemExit(f"expected exactly one {marker!r} marker pair")
        before, marked = text.split(begin, 1)
        plumbing, after = marked.split(end, 1)
        if f'#[path = "{child_rel}"]\n' not in plumbing:
            raise SystemExit(f"{marker!r} does not declare {child_rel}")
        text = before + after
    return single_blank_lines(text.splitlines(keepends=True))


def item_reconstructions(base: str) -> tuple[bool, list[str]]:
    base_parent = baseline(base, ITEM_PARENT)
    if 'target: "' in base_parent or "pub(super) " in base_parent:
        raise SystemExit(f"{ITEM_PARENT}: base already spells a pin or a pub(super)")
    lines = base_parent.splitlines(keepends=True)
    spans = item_spans(base_parent)
    parent_dir = pathlib.Path(ITEM_PARENT).parent
    report: list[str] = []
    ok = True
    markers: dict[str, str] = {}
    for child_rel, marker, expected, names in ITEM_MOVES:
        child_path = str(parent_dir / child_rel)
        current = read(child_path)
        if marker is None:
            base_child = baseline(base, child_path)
            if not current.startswith(base_child + "\n"):
                print(f"{child_path}: its base text is not an unchanged prefix")
                ok = False
                continue
            body = current[len(base_child) + 1 :]
        else:
            markers[marker] = child_rel
            if not current.startswith(CHILD_HEADER):
                raise SystemExit(f"{child_path}: lost its exact structural header")
            body = current[len(CHILD_HEADER) :]
        body, added = unsplit_visibility(ITEM_PARENT, body)
        body, targets = unpinned_targets(ITEM_PARENT, body)
        if added != expected:
            print(f"{child_path}: pub(super) additions expected {expected}, got {added}")
            ok = False
        moved = "\n".join("".join(lines[spans[n][0] : spans[n][1]]) for n in names)
        rebuilt = rustfmt(body)
        if rebuilt != moved:
            ok = False
            for line in difflib.unified_diff(
                moved.splitlines(),
                rebuilt.splitlines(),
                fromfile=f"{base}:{ITEM_PARENT} items",
                tofile=child_path,
                n=3,
                lineterm="",
            ):
                print(line)
        report.append(
            f"{child_path}: {len(names)} items, {moved.count(chr(10))} lines, "
            f"{added} pub(super) additions, {targets} log targets"
        )
    expected_parent = parent_without_items(base_parent, spans)
    current_parent = parent_without_new_markers(read(ITEM_PARENT), markers)
    if current_parent == expected_parent:
        moved_items = sum(len(row[3]) for row in ITEM_MOVES)
        print(
            f"{ITEM_PARENT}: OK against {base} ({moved_items} items moved into "
            f"{len(ITEM_MOVES)} children; {len(lines)} -> "
            f"{read(ITEM_PARENT).count(chr(10))} lines)"
        )
    else:
        ok = False
        for line in difflib.unified_diff(
            [line.rstrip("\n") for line in expected_parent],
            [line.rstrip("\n") for line in current_parent],
            fromfile=f"{base}:{ITEM_PARENT} without the moved items",
            tofile=f"{ITEM_PARENT} without the new markers",
            n=3,
            lineterm="",
        ):
            print(line)
    return ok, report


def baseline(base: str, source: str) -> str:
    return subprocess.run(
        ["git", "show", f"{base}:{source}"],
        check=True,
        stdout=subprocess.PIPE,
    ).stdout.decode("utf-8")


def compare(base: str, source: str, current: str, description: str) -> bool:
    original = baseline(base, source)
    if current == original:
        print(f"{source}: OK against {base} ({description})")
        return True
    diff = difflib.unified_diff(
        original.splitlines(),
        current.splitlines(),
        fromfile=f"{base}:{source}",
        tofile=description,
        n=3,
        lineterm="",
    )
    for line in diff:
        print(line)
    return False


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[2] == "--plan":
        base = sys.argv[1]
        reconstructions = plan_reconstructions()
        return (
            0
            if all(
                compare(base, source, current, "marker-expanded split tree")
                for source, current in reconstructions.items()
            )
            else 1
        )

    if len(sys.argv) == 3 and sys.argv[2] == "--moves":
        base = sys.argv[1]
        original = baseline(base, ITEM_PARENT)
        if rustfmt(original) != original:
            print(f"{ITEM_PARENT}: base is not a rustfmt fixed point")
            return 1
        ok, report = item_reconstructions(base)
        for line in report:
            print(line)
        return 0 if ok else 1

    if len(sys.argv) < 4:
        print(
            "usage: split-identity BASE SOURCE PIECE [PIECE ...]\n"
            "       split-identity BASE --plan\n"
            "       split-identity BASE --moves",
            file=sys.stderr,
        )
        return 2

    base, source, *piece_names = sys.argv[1:]
    assembled: list[str] = []
    counts: list[tuple[str, int]] = []
    for piece_name in piece_names:
        piece = pathlib.Path(piece_name)
        lines = without_split_headers(piece)
        assembled.extend(lines)
        counts.append((piece_name, len(lines)))
    current = "".join(assembled)

    if not compare(base, source, current, " + ".join(piece_names)):
        return 1

    for piece_name, count in counts:
        print(f"{piece_name}: {count} lines")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
