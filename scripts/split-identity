    (
        "transcode/media_origin.rs",
        "media-origin",
        1,
        [
            "pub(crate) async fn probe_media_origin(source_path: &std::path::Path, start_seconds: f64) -> f64 {",
            "async fn probe_media_origin_reads_the_preceding_keyframe() {",
        ],
