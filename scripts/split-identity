#!/usr/bin/env python3
"""Reassemble Rust splits and compare them with a Git revision.

Usage: split-identity BASE SOURCE PIECE [PIECE ...]
       split-identity BASE --plan
       split-identity BASE --moves

PIECE files are concatenated in source order. Lines inside a
``// split: header`` / ``// split: end header`` pair are split-only module
plumbing and are omitted. Passing SOURCE as the only piece is the M0
unchanged-file self-test.

``--plan`` proves the M1 and M2/T2 subsection moves. It replaces explicit
markers in each current parent with the children named below, removes only
the module plumbing represented by those markers, and compares the complete
reconstructed parent byte-for-byte with BASE. The segment-index recipe also
checks the exact count of parent-visibility additions before removing them.
``--moves`` proves the M3 remainder (``plan/S-14-10``) against BASE, the
branch's current merge base with main. #511's region moves (M2/T3 onward,
M3, M5) were proved by the earlier ``--moves`` recipe against their own
merge bases; that recipe is in the history of this file at ``f9c976132``
and was retired here because the parents it reconstructed are now the base.
The M3 remainder moves single items rather than regions, so a child's items
need not have been contiguous and an item may join an existing child. Each
row of ``ITEM_MOVES`` names a child, the marker it is declared under (none
when the items are appended to an existing single-region child), its exact
``pub(super)`` count and its items, each by its exact first line in BASE
with its directly attached ``///``, ``//`` and ``#[...]`` lines. The proof
has two halves. Every child is its base text unchanged (or, for a new
child, the ``use super::*;`` header) followed by text that, once its
``pub(super) `` additions are counted and removed and its tracing target
pins are removed exactly as below, is rustfmt-identical to its items cut
from BASE, joined by one blank line, in the row's order. And the current
parent, less the new marker blocks, equals BASE less every item's lines,
compared with runs of blank lines taken as one (rustfmt allows at most one
blank line, so this ignores only where a seam's blank line fell). Together
these show each moved item is byte-identical modulo visibility and target
pins and that nothing else in the parent or an existing child changed.
A child's tracing events carry an explicit ``target:`` naming the parent's
module path, so a move does not relabel its log lines (a ``#[path]``
child's default target is its own ``module_path!()``). Each was inserted
in one of three spellings, which reconstruction removes exactly: its own
line directly after a ``tracing::<level>!(`` that ends its line;
``target: "...", `` directly after the opening parenthesis; or, for a
one-line call the pin would push past the line limit, the call wrapped as
``(`` / pin / the untouched arguments / ``)``. The base parent contains no
``target: "`` and no ``pub(super) `` at all (checked), and any other
spelling is left in place to fail the comparison.

This one-shot helper is deleted before the plan PR is promoted.
"""

from __future__ import annotations

import difflib
import pathlib
import re
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def without_split_headers(path: pathlib.Path) -> list[str]:
    lines: list[str] = []
    inside_header = False
    for line_number, line in enumerate(
        path.read_text(encoding="utf-8").splitlines(keepends=True), start=1
    ):
        if line.rstrip("\r\n") == "// split: header":
            if inside_header:
                raise SystemExit(f"{path}:{line_number}: nested split header")
            inside_header = True
            continue
        if line.rstrip("\r\n") == "// split: end header":
            if not inside_header:
                raise SystemExit(f"{path}:{line_number}: unmatched split header end")
            inside_header = False
            continue
        if not inside_header:
            lines.append(line)
    if inside_header:
        raise SystemExit(f"{path}: unterminated split header")
    return lines


def chunks(manifest: str) -> str:
    manifest_path = ROOT / manifest
    result: list[str] = []
    for line_number, line in enumerate(
        manifest_path.read_text(encoding="utf-8").splitlines(), start=1
    ):
        prefix = 'include!("'
        suffix = '");'
        if not line.startswith(prefix) or not line.endswith(suffix):
            raise SystemExit(
                f"{manifest}:{line_number}: expected a plain include! manifest"
            )
        child = manifest_path.parent / line[len(prefix) : -len(suffix)]
        result.append(child.read_text(encoding="utf-8"))
    return "".join(result)


def replace_marker(parent: str, marker: str, replacement: str) -> str:
    begin = f"// split: begin {marker}\n"
    end = f"// split: end {marker}\n"
    if parent.count(begin) != 1 or parent.count(end) != 1:
        raise SystemExit(f"expected exactly one {marker!r} marker pair")
    before, marked = parent.split(begin, 1)
    _plumbing, after = marked.split(end, 1)
    return before + replacement + after


def indented_child(path: str) -> str:
    lines = read(path).splitlines(keepends=True)
    return "".join(("    " + line) if line.strip() else line for line in lines)


def plan_reconstructions() -> dict[str, str]:
    transcode_path = "crates/plurxd/src/transcode.rs"
    transcode = read(transcode_path)

    segment = read("crates/plurxd/src/transcode/rolling/segment_index.rs")
    header = "use super::*;\n\n"
    if not segment.startswith(header):
        raise SystemExit("segment-index child lost its exact structural header")
    segment = segment[len(header) :]
    visibility = "pub(super) "
    expected_visibility_additions = 40
    actual_visibility_additions = segment.count(visibility)
    if actual_visibility_additions != expected_visibility_additions:
        raise SystemExit(
            "segment-index visibility additions: "
            f"expected {expected_visibility_additions}, got {actual_visibility_additions}"
        )
    segment = segment.replace(visibility, "")
    transcode = replace_marker(transcode, "segment-index", segment)

    renewal = (
        "#[cfg(test)]\n"
        "mod pretranscode_renewal_tests {\n"
        + indented_child("crates/plurxd/src/transcode/tests/pretranscode_renewal.rs")
        + "}\n"
    )
    transcode = replace_marker(transcode, "pretranscode-renewal-tests", renewal)
    transcode_tests = chunks("crates/plurxd/src/transcode/tests.rs")
    relocated_include = 'include!("../../vodencode_manager_tests.rs");'
    if transcode_tests.count(relocated_include) != 1:
        raise SystemExit("expected the one declared vodencode test include relocation")
    transcode_tests = transcode_tests.replace(
        relocated_include, 'include!("vodencode_manager_tests.rs");'
    )
    tests = (
        "#[cfg(test)]\n"
        "pub(crate) mod tests {\n"
        + transcode_tests
        + "}\n"
    )
    transcode = replace_marker(transcode, "transcode-tests", tests)

    hls_tests = chunks("crates/plurxd/src/http/hls/tests.rs")
    hls_relocated_source = 'include_str!("../../hls.rs")'
    if hls_tests.count(hls_relocated_source) != 3:
        raise SystemExit("expected the three declared hls source include relocations")
    hls_tests = hls_tests.replace(hls_relocated_source, 'include_str!("hls.rs")')
    hls_path = "crates/plurxd/src/http/hls.rs"
    hls = replace_marker(
        read(hls_path),
        "hls-tests",
        "#[cfg(test)]\nmod tests {\n"
        + hls_tests
        + "}\n",
    )

    vod_tests = chunks("crates/plurxd/src/vod/tests.rs")
    vod_relocated_include = 'include!("../../vodencode_tests.rs");'
    if vod_tests.count(vod_relocated_include) != 1:
        raise SystemExit("expected the one declared vodencode test include relocation")
    vod_tests = vod_tests.replace(
        vod_relocated_include, 'include!("vodencode_tests.rs");'
    )
    vod_path = "crates/plurxd/src/vodserve.rs"
    vod = replace_marker(
        read(vod_path),
        "vod-tests",
        "#[cfg(test)]\nmod tests {\n"
        + vod_tests
        + "}\n",
    )
    return {transcode_path: transcode, hls_path: hls, vod_path: vod}


CHILD_HEADER = "use super::*;\n\n"

# A parent's own `pub(super)` names *its* parent. Moved one level down, the
# same reach must be spelled out: `http/hls.rs`'s `pub(super)` (visible in
# `http`) becomes `pub(in crate::http)` in a child, and one inside hls.rs's
# inline `pub mod plan_derivation` (visible in `hls`) becomes
# `pub(in crate::http::hls)`. Reconstruction maps each back after removing
# the added `pub(super) `; the base parents contain no `pub(in ` at all.
RESTATED: dict[str, tuple[str, ...]] = {
    "crates/plurxd/src/http/hls.rs": ("pub(in crate::http) ", "pub(in crate::http::hls) "),
}


# Paths the parent wrote relative to *its* parent, which a child one level
# down must write with one more `super::` (hls.rs's `super::stream::`
# names `http::stream`). The base parents contain no `super::super::`.
RELOCATED: dict[str, tuple[str, str]] = {
    "crates/plurxd/src/http/hls.rs": ("super::super::", "super::"),
}


# The module path each parent's events were labelled with before the split.
LOG_TARGETS: dict[str, str] = {
    "crates/plurxd/src/transcode.rs": "plurxd::transcode",
    "crates/plurxd/src/http/hls.rs": "plurxd::http::hls",
    "crates/plurxd/src/vodserve.rs": "plurxd::vodserve",
}


def unpinned_targets(parent: str, text: str) -> tuple[str, int]:
    call = r"(tracing::(?:trace|debug|info|warn|error)!\()"
    pin = 'target: "' + re.escape(LOG_TARGETS[parent]) + '",'
    count = 0

    # A call that fitted on one line but not with its target was wrapped:
    # the pin and the untouched argument text each on their own line, four
    # spaces in, and the closing parenthesis back at the call's indentation.
    # It is unwrapped only if the one line it came from fits the limit, so a
    # call that was already written with one argument line because it did
    # not fit keeps its shape and only loses the pin line below. One that
    # did fit and was wrapped by hand anyway would be joined here and fail
    # the comparison loudly.
    def unwrap(match: re.Match[str]) -> str:
        nonlocal count
        if len(match["inner"]) != len(match["outer"]) + 4:
            return match[0]
        source = match.string
        line_start = source.rfind("\n", 0, match.start()) + 1
        line_end = source.find("\n", match.end())
        rest = source[match.end() : len(source) if line_end < 0 else line_end]
        width = match.start() - line_start + len(match[1]) + len(match["args"]) + 1 + len(rest)
        if width > 100:
            return match[0]
        count += 1
        return match[1] + match["args"] + ")"

    text = re.sub(
        call + r"\n(?P<inner> *)" + pin + r"\n(?P=inner)(?P<args>[^\n]*)\n(?P<outer> *)\)",
        unwrap,
        text,
    )
    text, own_line = re.subn(call + r"\n *" + pin + r"(?=\n)", r"\1", text)
    text, inline = re.subn(call + pin + " ", r"\1", text)
    return text, count + own_line + inline


def unsplit_visibility(parent: str, text: str) -> tuple[str, int]:
    added = text.count("pub(super) ")
    text = text.replace("pub(super) ", "")
    for spelling in RESTATED.get(parent, ()):
        text = text.replace(spelling, "pub(super) ")
    if parent in RELOCATED:
        text = text.replace(*RELOCATED[parent])
    return text, added

def rustfmt(text: str) -> str:
    return subprocess.run(
        ["rustfmt", "--edition", "2021", "--emit", "stdout"],
        check=True,
        input=text.encode("utf-8"),
        stdout=subprocess.PIPE,
    ).stdout.decode("utf-8")


# The M3 remainder (S-14-10): the items #511 left in `transcode.rs` move one
# by one into child modules, so a child's items need not have been one
# contiguous region of the parent. Each row names a child (relative to the
# parent's directory), the parent marker a new child is declared under (None
# when the items are appended to an existing single-region child, whose base
# text must then be an exact prefix of its current text), the exact number of
# `pub(super) ` the moved text gained, and the items in the child's order.
# An item is named by its exact first code line in the base parent; the
# `///`, `//` and `#[...]` lines directly above it move with it. A name that
# starts with "=" leaves those lines in the parent (the one misplaced doc
# comment, which documents the constant below the function it sat on).
ITEM_PARENT = "crates/plurxd/src/transcode.rs"
ITEM_MOVES: list[tuple[str, str | None, int, list[str]]] = [
    (
        "transcode/errors.rs",
        "errors",
