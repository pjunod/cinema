#!/usr/bin/env python3
"""Exercise the shipped web player against a delayed HLS manifest in Chromium."""

import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import tempfile
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
WEB = ROOT / "crates" / "plurxd" / "src" / "web"

ASSET_TAG = re.compile(r'(?:<script src|<link rel="stylesheet" href)="/assets/([^"?]+)"')


def shell_assets() -> set[str]:
    """Every `/assets/` file the shell asks for, table rows and sidecars alike.

    The web app is a tree served from one ordered table
    (`docs/clients/WEB-SHELL-LAYOUT.md`); this fixture server answers whatever
    the shell names rather than a list that goes stale behind it.
    """
    return set(ASSET_TAG.findall((WEB / "index.html").read_text(encoding="utf-8")))
MANIFEST_REFUSALS = 8
TIMEOUT_MS = 38_000


def find_browser(explicit):
    if explicit:
        return explicit
    for candidate in (
        Path("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"),
        Path("/Applications/Chromium.app/Contents/MacOS/Chromium"),
        Path("/usr/bin/google-chrome"),
        Path("/usr/bin/chromium"),
    ):
        if candidate.is_file():
            return str(candidate)
    root = Path(os.environ.get("PLAYWRIGHT_BROWSERS_PATH", "/opt/pw-browsers"))
    for pattern in (
        "chromium-*/chrome-linux/chrome",
        "chromium_headless_shell-*/chrome-linux/headless_shell",
    ):
        found = sorted(root.glob(pattern)) if root.is_dir() else []
        if found:
            return str(found[-1])
    return None


def make_fixture(directory):
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        raise RuntimeError("ffmpeg is required to build the deterministic HLS fixture")
    subprocess.run(
        [
            ffmpeg, "-hide_banner", "-loglevel", "error", "-y",
            "-f", "lavfi", "-i", "color=c=black:s=320x180:r=25:d=24",
            "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000:duration=24",
            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-g", "25",
            "-c:a", "aac", "-b:a", "64k", "-shortest",
            "-f", "hls", "-hls_time", "2", "-hls_playlist_type", "vod",
            # MPEG-TS intentionally exercises hls.js's transmuxer worker.
            # fMP4 can append without the worker and made this harness claim
            # worker coverage from configuration alone.
            "-hls_segment_filename", str(directory / "seg%d.ts"),
            str(directory / "index.m3u8"),
        ],
        check=True,
    )
    digest = hashlib.sha256()
    for path in sorted(directory.iterdir()):
        digest.update(path.name.encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


class FixtureServer(ThreadingHTTPServer):
    def __init__(self, fixture):
        super().__init__(("127.0.0.1", 0), Handler)
        self.fixture = fixture
        self.manifest_requests = 0
        self.session_creates = 0
        self.client_logs = []
        self.lock = threading.Lock()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_args):
        pass

    def reply(self, status, body=b"", content_type="application/octet-stream"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        route = self.path.split("?", 1)[0]
        if route == "/":
            return self.reply(200, (WEB / "index.html").read_bytes(), "text/html; charset=utf-8")
        # Whatever the shell asks for, from wherever it lives. Hand-listing the
        # assets here meant a new one silently 404'd and the page it broke
        # looked like a playback bug.
        asset = route.removeprefix("/assets/")
        if route.startswith("/assets/") and asset in shell_assets():
            kind = "text/css" if asset.endswith(".css") else "text/javascript"
            return self.reply(200, (WEB / asset).read_bytes(), f"{kind}; charset=utf-8")
        if route == "/delayed/index.m3u8":
            with self.server.lock:
                self.server.manifest_requests += 1
                ordinal = self.server.manifest_requests
            if ordinal <= MANIFEST_REFUSALS:
                body = json.dumps({
                    "code": "startup_timeout",
                    "message": "the deterministic fixture is still starting",
                }).encode()
                return self.reply(503, body, "application/json")
            return self.reply(200, (self.server.fixture / "index.m3u8").read_bytes(), "application/vnd.apple.mpegurl")
        fixture = self.server.fixture / route.removeprefix("/delayed/")
        if route.startswith("/delayed/") and fixture.is_file():
            return self.reply(200, fixture.read_bytes())
        self.reply(404, b"not found", "text/plain")

    def do_POST(self):
        route = self.path.split("?", 1)[0]
        length = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(length)
        with self.server.lock:
            if route.startswith("/api/v1/hls/"):
                self.server.session_creates += 1
            if route == "/api/v1/client-log":
                try:
                    self.server.client_logs.append(json.loads(body))
                except json.JSONDecodeError:
                    self.server.client_logs.append({"event": "invalid"})
        self.reply(204)


def add_worker_blocking_csp(page):
    """Fulfil the shell response with worker-src disabled through CDP."""
    session = page.context.new_cdp_session(page)
    session.send("Fetch.enable", {
        "patterns": [{
            "urlPattern": "*",
            "resourceType": "Document",
            "requestStage": "Response",
        }],
    })

    def fulfil(event):
        request_id = event["requestId"]
        body = session.send("Fetch.getResponseBody", {"requestId": request_id})
        raw = body["body"]
        if not body.get("base64Encoded"):
            raw = base64.b64encode(raw.encode()).decode()
        headers = [
            header for header in event.get("responseHeaders", [])
            if header["name"].lower() != "content-security-policy"
        ]
        headers.append({"name": "Content-Security-Policy", "value": "worker-src 'none'"})
        session.send("Fetch.fulfillRequest", {
            "requestId": request_id,
            "responseCode": event.get("responseStatusCode", 200),
            "responsePhrase": event.get("responseStatusText", "OK"),
            "responseHeaders": headers,
            "body": raw,
        })

    session.on("Fetch.requestPaused", fulfil)
    return session


def run_case(browser, server, *, block_worker):
    with server.lock:
        server.manifest_requests = 0
        server.session_creates = 0
        server.client_logs = []
    page = browser.new_page()
    page.add_init_script("""
      window.__plurxWorkerStarts=0;
      const NativeWorker=window.Worker;
      window.Worker=new Proxy(NativeWorker,{construct(target,args){
        window.__plurxWorkerStarts+=1;
        return Reflect.construct(target,args);
      }});
    """)
    console = []
    page.on("console", lambda message: console.append(f"{message.type}: {message.text}"))
    cdp = add_worker_blocking_csp(page) if block_worker else None
    started_at = None
    try:
        page.goto(f"http://127.0.0.1:{server.server_port}/", wait_until="load")
        page.wait_for_function("() => typeof attachHls === 'function' && window.Hls")
        started_at = page.evaluate("() => performance.now()")
        page.evaluate("""
            () => {
              Hls.DefaultConfig.debug=true;
              const video=document.getElementById('video');
              video.muted=true;
              PLAYER={method:'transcode',source:{video_codec:'h264'},started:false,
                wantsPlayback:true,controlIntentGeneration:1,attemptId:'browser-check',
                bufSegSecs:4,marks:{},abr:{},offset:0,bookOffset:0,mediaAttachment:null};
              attachHls(video,'/delayed/index.m3u8',0.75);
            }
        """)
        page.wait_for_function(
            """() => {
              const video=document.getElementById('video');
              return PLAYER && PLAYER.hlsStartup &&
                PLAYER.hlsStartup.dispatches >= 9 && video.currentTime >= 0.5 &&
                !video.paused && video.readyState >= 2;
            }""",
            timeout=TIMEOUT_MS,
        )
        page.wait_for_function(
            """() => {
              const video=document.getElementById('video');
              if (!video.buffered.length) return false;
              return video.buffered.end(video.buffered.length-1)-video.currentTime >= 10.5;
            }""",
            timeout=TIMEOUT_MS,
        )
        local_seek_target = page.evaluate("""async () => {
          const video=document.getElementById('video');
          const target=video.currentTime+10;
          await seekTo(target);
          return target;
        }""")
        page.wait_for_function(
            """target => PLAYER && PLAYER.controlSeek && PLAYER.controlSeek.executed &&
              Math.abs(document.getElementById('video').currentTime-target) < 1""",
            arg=local_seek_target,
            timeout=TIMEOUT_MS,
        )
        page.wait_for_timeout(250)
        result = page.evaluate("""() => ({
          position:document.getElementById('video').currentTime,
          readyState:document.getElementById('video').readyState,
          dispatches:PLAYER.hlsStartup.dispatches,
          manifestState:PLAYER.hlsStartup.manifestState,
          retryState:PLAYER.hlsStartup.retry.state,
          hlsVersion:Hls.version,
          workerStarts:window.__plurxWorkerStarts,
          browser:navigator.userAgent,
          finishedAt:performance.now(),
        })""")
        result["local_seek_target"] = local_seek_target
        with server.lock:
            result["session_creates"] = server.session_creates
            result["client_logs"] = list(server.client_logs)
    finally:
        if cdp:
            cdp.send("Fetch.disable")
        page.close()
    result["first_frame_ms"] = result.pop("finishedAt") - started_at
    result["manifest_requests"] = server.manifest_requests
    result["console"] = console
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--browser", default=None)
    args = parser.parse_args()
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        print("SKIP  playwright is not installed; web HLS startup browser evidence unavailable")
        return 0

    with tempfile.TemporaryDirectory(prefix="plurx-hls-startup-") as raw:
        fixture = Path(raw)
        fixture_hash = make_fixture(fixture)
        server = FixtureServer(fixture)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            with sync_playwright() as pw:
                browser = pw.chromium.launch(
                    executable_path=find_browser(args.browser),
                    args=["--no-sandbox", "--disable-dev-shm-usage", "--autoplay-policy=no-user-gesture-required"],
                )
                worker = run_case(browser, server, block_worker=False)
                fallback = run_case(browser, server, block_worker=True)
                browser.close()
        finally:
            server.shutdown()
            server.server_close()
            thread.join(timeout=2)

    for label, result in (("started", worker), ("fallback-inline", fallback)):
        if result["manifest_requests"] < 9 or result["position"] < 0.5:
            print(f"FAIL  worker: {label} did not recover and present at the requested position")
            print(json.dumps(result, indent=2))
            return 1
        local = [event for event in result["client_logs"] if event.get("event") == "seek_local"]
        if not local or result["session_creates"] != 0:
            print(f"FAIL  seek: {label} did not keep the +10 s scrub on the attached HLS session")
            print(json.dumps(result, indent=2))
            return 1
    worker_log = "\n".join(worker["console"])
    fallback_log = "\n".join(fallback["console"])
    if worker["workerStarts"] < 1 or "fallback to inline" in worker_log:
        print("FAIL  worker-enabled run did not start the vendored hls.js worker")
        print(worker_log)
        return 1
    if fallback["workerStarts"] < 1 or "worker-src 'none'" not in fallback_log:
        print("FAIL  worker-blocked run did not exercise hls.js inline fallback")
        print(fallback_log)
        return 1
    print(f"PASS  worker: started; first_frame_ms={worker['first_frame_ms']:.0f}")
    print(f"PASS  worker: fallback-inline; first_frame_ms={fallback['first_frame_ms']:.0f}")
    print("PASS  seek: +10 s stayed local; seek_local logged; session_creates=0")
    print(f"      fixture sha256: {fixture_hash}; hls.js: {result['hlsVersion']}")
    print(f"      browser: {result['browser']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
