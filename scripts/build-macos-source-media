#!/usr/bin/env python3
"""Build the complete patched Jellyfin media package before source installation.

The private prepared tree retains every upstream codec dependency plus pinned
static MoltenVK, shaderc and libplacebo. Only verified package bytes are copied
to --output; installed media and service state are never changed here.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import platform
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
BREW_PREFIXES = [Path("/opt/homebrew"), Path("/usr/local")]
TOOLS = {"wget": "wget", "cmake": "cmake", "meson": "meson", "ninja": "ninja",
         "pkg-config": "pkgconf", "autoconf": "autoconf",
         "nasm": "nasm", "gtimeout": "coreutils",
         "gshuf": "coreutils", "makeinfo": "texinfo", "gsed": "gnu-sed", "svn": "subversion"}


def recipe(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "scripts" / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def run(argv, **kwargs):
    subprocess.run([str(value) for value in argv], check=True, **kwargs)


def source_generation_tools(prepared, env):
    """Keep generated build auxiliaries tied to official source archive bytes."""
    directory = prepared / "source-generation-tools"
    directory.mkdir()
    archives = directory / "archives"
    archives.mkdir()
    prefix = directory / "prefix"
    env["PATH"] = os.pathsep.join([str(prefix / "bin"), env["PATH"]])
    # Source-built aclocal needs Homebrew's pkg.m4 as well as caller macros.
    macro_paths = [str(path / "share/aclocal") for path in BREW_PREFIXES
                   if (path / "share/aclocal").is_dir()]
    if macro_paths:
        inherited = env.get("ACLOCAL_PATH")
        if inherited:
            macro_paths.insert(0, inherited)
        env["ACLOCAL_PATH"] = os.pathsep.join(macro_paths)
    helper = recipe("build-macos-vulkan")
    for name, version, sha256 in [
        ("automake", "1.19", "79e8b1f7a967e87ce8a9ded76bee7f793d0ce1886ab2002feb1b0510f578b75a"),
        ("libtool", "2.6.2", "24adb3aa9ae035c70faba344af57d73215eb89281045af6c7ccd307751f8b0bf"),
    ]:
        archive = archives / (name + ".tar.gz")
        helper.acquire({"role": name, "archive": archive.name, "sha256": sha256,
                        "url": f"https://ftp.gnu.org/gnu/{name}/{name}-{version}.tar.gz"}, archive)
        source = directory / f"{name}-{version}"
        helper.extract(archive, source)
        # Keep Autoconf's srcdir as "." for this in-source build. Absolute paths
        # through macOS's /var alias can make GNUmakefile link back to itself.
        run(["/bin/sh", "./configure", "--prefix=" + str(prefix)], cwd=source, env=env)
        run(["make", "-j4"], cwd=source, env=env)
        run(["make", "install"], cwd=source, env=env)


def build_search_environment():
    env = dict(os.environ)
    extra = [str(prefix / suffix) for prefix in BREW_PREFIXES
             for suffix in ["bin", "sbin", "opt/texinfo/bin"]]
    env["PATH"] = os.pathsep.join(extra + [env.get("PATH", "")])
    return env


def build_tool_environment():
    env = build_search_environment()
    missing = sorted({formula for tool, formula in TOOLS.items() if not shutil.which(tool, path=env["PATH"])})
    if missing:
        brew = shutil.which("brew", path=env["PATH"])
        if not brew:
            raise ValueError("Homebrew build tools required: " + ", ".join(missing))
        run([brew, "install", *missing], env=env)
    return env


def xcode_applications():
    """Try conventional locations, then macOS's bundle-identity index."""
    for directory in [Path("/Applications"), Path.home() / "Applications"]:
        yield from sorted(directory.glob("Xcode*.app"))
    try:
        # Bundle identity also finds renamed apps and nonstandard locations.
        indexed = subprocess.check_output(
            ["/usr/bin/mdfind", "-0", "kMDItemCFBundleIdentifier == 'com.apple.dt.Xcode*'"],
            text=True, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return
    for path in indexed.split("\0"):
        if path and Path(path).is_absolute():
            yield Path(path)


def initialize_xcode(env):
    """Complete first-launch setup in the terminal only when required."""
    ready = subprocess.run(["/usr/bin/xcodebuild", "-checkFirstLaunchStatus"], env=env,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if ready.returncode == 0:
        return
    developer = env.get("DEVELOPER_DIR")
    if not developer:
        developer = subprocess.check_output(["/usr/bin/xcode-select", "-p"], text=True).strip()
    directory = Path(developer)
    if directory.suffix == ".app":
        directory = directory / "Contents/Developer"
    executable = directory / "usr/bin/xcodebuild"
    print("native media build: completing Xcode setup; answer the administrator and license prompts below",
          file=sys.stderr, flush=True)
    # Use the absolute selected binary: sudo may remove DEVELOPER_DIR.
    run(["/usr/bin/sudo", executable, "-license"], env=env)
    run(["/usr/bin/sudo", executable, "-runFirstLaunch"], env=env)
    run(["/usr/bin/xcodebuild", "-checkFirstLaunchStatus"], env=env)


def install_xcode():
    """Inherit the terminal for Apple authentication, 2FA and administrator prompts."""
    env = build_search_environment()
    installer = shutil.which("xcodes", path=env["PATH"])
    if not installer:
        brew = recipe("build-macos-source-runtime").ensure_homebrew()
        env["PATH"] = os.pathsep.join([str(Path(brew).parent), env["PATH"]])
        run([brew, "install", "xcodesorg/made/xcodes"], env=env)
        installer = shutil.which("xcodes", path=env["PATH"])
        if not installer:
            raise ValueError("Homebrew installed xcodes but its executable cannot be found")
    print("native media build: installing full Xcode; answer any Apple sign-in or 2FA prompts below",
          file=sys.stderr, flush=True)
    # Finish setup ourselves so the license is presented interactively rather
    # than xcodes accepting it silently. Do not select Xcode system-wide.
    run([installer, "install", "--latest", "--directory", "/Applications", "--no-superuser"], env=env)


def developer_environment():
    """Find or install full Xcode without changing the system's selection."""
    env = dict(os.environ)

    def usable(candidate):
        return subprocess.run(["/usr/bin/xcodebuild", "-version"], env=candidate,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    if usable(env):
        initialize_xcode(env)
        return env
    # An explicit override is authoritative, including when it is broken.
    if env.get("DEVELOPER_DIR"):
        directory = Path(env["DEVELOPER_DIR"])
        if directory.suffix == ".app":
            directory = directory / "Contents/Developer"
        if (directory / "usr/bin/xcodebuild").is_file():
            initialize_xcode(env)
            if usable(env):
                return env
        raise ValueError("DEVELOPER_DIR does not identify a usable full Xcode; correct or unset it")

    def discovered():
        for app in xcode_applications():
            developer = app / "Contents/Developer"
            if not (developer / "usr/bin/xcodebuild").is_file():
                continue
            candidate = dict(env, DEVELOPER_DIR=str(developer))
            initialize_xcode(candidate)
            if usable(candidate):
                print(f"native media build: using Xcode at {developer}", file=sys.stderr)
                return candidate
        return None

    candidate = discovered()
    if candidate is not None:
        return candidate
    install_xcode()
    # xcodes installs a versioned app in /Applications. Search again instead of
    # assuming the filename or waiting for Spotlight to index a fresh install.
    candidate = discovered()
    if candidate is None:
        raise ValueError("Xcode installation finished but no usable developer directory was found")
    return candidate


def build_environment(prepared, developer_env=None):
    if developer_env is None:
        developer_env = developer_environment()
    # Resolve Xcode before installing Homebrew tools or compiling dependencies.
    env = build_tool_environment()
    if developer_env.get("DEVELOPER_DIR"):
        env["DEVELOPER_DIR"] = developer_env["DEVELOPER_DIR"]
    source_generation_tools(prepared, env)
    (prepared / "bin/glibtoolize").symlink_to(shutil.which("libtoolize", path=env["PATH"]))
    for alias, source in [("timeout", "gtimeout"), ("shuf", "gshuf")]:
        if not shutil.which(alias, path=env["PATH"]):
            executable = shutil.which(source, path=env["PATH"])
            if not executable:
                raise ValueError("missing build tool: " + source)
            (prepared / "bin" / alias).symlink_to(executable)
    explicit_toolchain = ""
    result = subprocess.run(["/usr/bin/xcrun", "-sdk", "macosx", "metal", "-v"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    if result.returncode:
        component = subprocess.check_output(["/usr/bin/xcodebuild", "-showComponent", "MetalToolchain", "-json"], text=True, env=env)
        facts = json.loads(component)
        if facts.get("status") != "installed":
            run(["/usr/bin/xcodebuild", "-downloadComponent", "MetalToolchain"], env=env)
            facts = json.loads(subprocess.check_output(["/usr/bin/xcodebuild", "-showComponent", "MetalToolchain", "-json"], text=True, env=env))
        identifier = facts.get("toolchainIdentifier", "")
        if not identifier or any(character not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-" for character in identifier):
            raise ValueError("Metal toolchain has no usable explicit identifier")
        run(["/usr/bin/xcrun", "--toolchain", identifier, "-sdk", "macosx", "metal", "-v"], env=env)
        explicit_toolchain = " --toolchain " + identifier
    metal = subprocess.check_output(["/usr/bin/xcrun", *explicit_toolchain.split(), "-sdk", "macosx", "--find", "metal"], text=True, env=env).strip()
    metallib = Path(metal).with_name("metallib")
    if not metallib.is_file():
        raise ValueError("Metal compiler has no matching metallib linker")
    wrapper = prepared / "bin/xcrun"
    # Xcode can find metal in the component while resolving metallib to a
    # broken default stub. Link with the sibling from the same component.
    import shlex
    wrapper.write_text('#!/bin/sh\nif [ "$1" = "-sdk" ]; then sdk="$2"; shift 2; else sdk=""; fi\ncase "$1" in\n metal) shift; exec ' + shlex.quote(metal) + ' "$@" -fmodules-cache-path="${PLURX_BUILD_ROOT:?}/metal-module-cache";;\n metallib) shift; exec ' + shlex.quote(str(metallib)) + ' "$@";;\nesac\nif [ -n "$sdk" ]; then exec /usr/bin/xcrun -sdk "$sdk" "$@"; fi\nexec /usr/bin/xcrun "$@"\n')
    wrapper.chmod(0o755)
    # These are build-only Python modules, isolated from the installed runtime.
    venv = prepared / "python-build-tools"
    run([sys.executable, "-m", "venv", venv])
    python = venv / "bin/python"
    run([python, "-m", "pip", "install", "--disable-pip-version-check", "Jinja2==3.1.6", "MarkupSafe==3.0.3"])
    site = subprocess.check_output([python, "-c", "import site; print(site.getsitepackages()[0])"], text=True).strip()
    env["PYTHONPATH"] = site
    # The first native recipe installs gettext here. Later autoreconf runs
    # need its autopoint/msgfmt, including on a host without global gettext.
    env["PATH"] = os.pathsep.join([str(prepared / "bin"), str(venv / "bin"),
                                   str(prepared / "prefix/bin"), env["PATH"]])
    return env


def finalize_package(prepared, package):
    """Retain generated source for direct Git/SVN builds before validation.

    Archive-recipe builds already retain their snapshot and actual consumption
    receipts. Direct upstream recipes have a different lineage: keep their
    observed Git/SVN source offers and add the actual compiled source, without
    inventing an archive-consumption receipt.
    """
    prepared_facts = json.loads((prepared / "prepared-source.json").read_text())
    if "dependency_source_inputs" not in prepared_facts:
        manifest_path = package / "provenance/manifest.json"
        manifest = json.loads(manifest_path.read_text())
        closure = recipe("macos-video-dependency-offers.py").retain_compiled_snapshot(
            prepared, package / "provenance", prepared / "source-generation-tools")
        manifest["compiled_source"].update({"mode": "git-svn-recipe-build", **closure})
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    recipe("build-macos-source-runtime").validate_media_package(package, platform.machine())


def build(destination, jobs, prepared_build=None, source_archive=None, dependency_source=None):
    if platform.system() != "Darwin":
        raise ValueError("native macOS build required")
    if not 1 <= jobs <= 8:
        raise ValueError("jobs must be between 1 and 8")
    if not destination.is_absolute() or destination.exists() or destination.is_symlink():
        raise ValueError("output must be an absolute new directory")
    developer_env = developer_environment() if prepared_build is None else None
    media = recipe("build-macos-video-ffmpeg")
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="plurx-native-media-") as work:
        temporary = Path(work)
        prepared = prepared_build
        if prepared is None:
            archive = temporary / "jellyfin-ffmpeg-source.tar.gz"
            media.acquire(source_archive, media.SOURCE_URL, media.SOURCE_SHA256, archive)
            prepared = temporary / "prepared"
            recipe("prepare-macos-video-ffmpeg").prepare(archive, prepared, jobs, dependency_source)
            env = build_environment(prepared, developer_env)
            run(["/bin/bash", prepared / "build.sh"], env=env)
        parser = temporary / "parser"
        run([sys.executable, ROOT / "scripts/build-macos-source-parser", "--output", parser, "--jobs", str(jobs),
             "--source-archive", prepared / "jellyfin-ffmpeg-source.tar.gz"])
        package = temporary / "package"
        # Read the public SVN working-copy inventory with a private client
        # configuration, retaining neither the user's config nor credentials.
        (prepared / "svn-config").mkdir(exist_ok=True)
        run([sys.executable, ROOT / "scripts/build-macos-video-ffmpeg", "--output", package,
             "--prepared-build", prepared, "--source-parser-package", parser])
        finalize_package(prepared, package)
        stage = Path(tempfile.mkdtemp(prefix=".native-media-", dir=destination.parent))
        try:
            shutil.copytree(package, stage, dirs_exist_ok=True)
            if destination.exists():
                raise ValueError("media output appeared while building; refusing replacement")
            stage.rename(destination)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
    return destination


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--jobs", type=int, default=4)
    parser.add_argument("--prepared-build", type=Path, help="completed warm private source build")
    parser.add_argument("--source-archive", type=Path)
    parser.add_argument("--dependency-source", type=Path)
    args = parser.parse_args()
    try:
        print(build(args.output, args.jobs, args.prepared_build, args.source_archive, args.dependency_source))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"native media build: {error}\n")


if __name__ == "__main__":
    main()
