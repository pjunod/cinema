#!/usr/bin/env python3
"""Build the plurxd image once per commit and let every other node pull it.

`make docker-up` compiles the image from the node's own checkout. Deploying
one commit to a fleet therefore compiled the same image once per node, each
taking the better part of an hour. This helper gives that path a shared,
commit-addressed copy in the fleet registry (the same LAN Forgejo registry
`make docker-image-up` pulls from):

    <registry>/noirr/plurxd:build-<40-character commit>-<arch>

`pull` runs after the hardware overlay is resolved (COMPOSE_FILE exported)
and prints one verdict on stdout:

    use <image id>   another node built this commit; it was pulled, its
                     revision label and platform match, and the local Compose
                     tag now points at it. Start it with --no-build.
    share <sha>      this node should build, then `push --expect <sha>`.
    (nothing)        build locally and push nothing.

`push --expect <sha>` runs after a local build. It tags the image Compose just
built with the shared name and pushes it, so the next node pulls instead of
compiling.

Sharing applies only when it is safe to name the image by its commit:

- the checkout is fully clean (no tracked or untracked changes) before the
  build and still at the same commit afterwards;
- both `plurxd` and `plurx-discovery` resolve through `PLURX_IMAGE`. An overlay
  that pins its own image (the Raspberry Pi runtime from `--prepare-pi`, or a
  host override's `image:`) is a different image from the shared one, so it is
  neither replaced by a pulled image nor published as one.

The `build-` tags are deliberately separate from the `sha-`/`main` tags that
`scripts/registry-push` publishes after the full post-merge validation: a
node-built image is the same commit, not a qualified one. Neither subcommand
can fail a deploy: a missing registry setting, a registry outage, a refused
push or any unexpected error is reported on stderr and the deploy carries on
with the local build.

The registry host comes from `PLURX_REGISTRY` in the environment or in
`deploy/.env` (the gitignored per-host settings file). Without it `make
docker-up` behaves exactly as it always has.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEPLOY = ROOT / "deploy"
DEPLOY_ENV = DEPLOY / ".env"
REPOSITORY = "noirr/plurxd"
REVISION_LABEL = "org.opencontainers.image.revision"
SERVICES = ("plurxd", "plurx-discovery")
PROBE_IMAGE = "fleet-image-probe.invalid/plurxd:probe"
ARCHITECTURES = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}
REGISTRY_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$")
SHA_PATTERN = re.compile(r"^[0-9a-f]{40}$")
MISSING_PATTERN = re.compile(r"manifest unknown|name unknown|not found", re.IGNORECASE)
TRANSFER_TIMEOUT = 900


class Skip(Exception):
    """Sharing does not apply; the deploy continues with a local build."""


def note(message: str) -> None:
    print(f"fleet-image: {message}", file=sys.stderr)


def run(*args: str, cwd: Path = ROOT, timeout: int = 60,
        env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True,
                          errors="replace", timeout=timeout, env=env)


def env_file_value(name: str, path: Path = DEPLOY_ENV) -> str:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return ""
    value = ""
    for line in lines:
        line = line.strip()
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, separator, raw = line.partition("=")
        if separator and key.strip() == name:
            value = raw.strip().strip("'\"")
    return value


def registry() -> str:
    host = os.environ.get("PLURX_REGISTRY", "").strip() or env_file_value("PLURX_REGISTRY")
    if not host:
        raise Skip("PLURX_REGISTRY is not set; building locally without sharing")
    if not REGISTRY_PATTERN.match(host):
        raise Skip(f"PLURX_REGISTRY {host!r} is not a host[:port]; building locally without sharing")
    return host


def clean_head() -> str:
    head = run("git", "rev-parse", "HEAD")
    if head.returncode != 0:
        raise Skip("not a git checkout; building locally without sharing")
    status = run("git", "status", "--porcelain=v1", "--untracked-files=normal")
    if status.returncode != 0 or status.stdout.strip():
        raise Skip("checkout has local changes, so the commit does not name this build; "
                   "building locally without sharing")
    sha = head.stdout.strip()
    if not SHA_PATTERN.match(sha):
        raise Skip(f"unexpected HEAD {sha!r}; building locally without sharing")
    return sha


def architecture() -> str:
    platform = os.environ.get("DOCKER_DEFAULT_PLATFORM", "")
    machine = platform.split("/", 1)[1] if platform.startswith("linux/") else os.uname().machine
    arch = ARCHITECTURES.get(machine)
    if arch is None:
        raise Skip(f"unsupported architecture {machine!r}; building locally without sharing")
    return arch


def compose_images(*services: str, image: str | None = None) -> list[str]:
    env = dict(os.environ)
    if image is not None:
        env["PLURX_IMAGE"] = image
    result = run("docker", "compose", "config", "--images", *services, cwd=DEPLOY, env=env)
    if result.returncode != 0:
        raise Skip(f"cannot resolve the Compose images: {result.stderr.strip()}")
    return result.stdout.split()


def require_standard_image() -> None:
    """Both services must take their image from PLURX_IMAGE, or this is not the shared image."""
    if compose_images(*SERVICES, image=PROBE_IMAGE) != [PROBE_IMAGE] * len(SERVICES):
        raise Skip("this host's Compose files pin their own plurxd image (Pi runtime or an "
                   "override); building locally without sharing")


def shared_ref(sha: str, arch: str) -> str:
    return f"{registry()}/{REPOSITORY}:build-{sha}-{arch}"


def inspect(ref: str, template: str) -> str:
    result = run("docker", "image", "inspect", "--format", template, ref)
    if result.returncode != 0:
        raise Skip(f"cannot inspect {ref}: {result.stderr.strip()}")
    return result.stdout.strip()


def verify(ref: str, sha: str, arch: str) -> str:
    image_id = inspect(ref, "{{.Id}}")
    revision = inspect(image_id, "{{ index .Config.Labels \"%s\" }}" % REVISION_LABEL)
    if revision != sha:
        raise Skip(f"{ref} carries revision {revision or '(none)'}, not {sha}")
    found = inspect(image_id, "{{.Os}}/{{.Architecture}}")
    if found != f"linux/{arch}":
        raise Skip(f"{ref} is {found}, not linux/{arch}")
    return image_id


def pull() -> str:
    ref = shared_ref(sha := clean_head(), arch := architecture())
    require_standard_image()
    share = f"share {sha}"
    note(f"looking for {ref}")
    result = run("docker", "pull", "--platform", f"linux/{arch}", ref, timeout=TRANSFER_TIMEOUT)
    if result.returncode != 0:
        detail = result.stderr.strip()
        if MISSING_PATTERN.search(detail):
            note("no node has shared this commit yet; building it here and sharing it")
        else:
            note(f"registry pull failed ({detail}); building locally")
        return share
    try:
        image_id = verify(ref, sha, arch)
    except Skip as skip:
        note(f"{skip}; building locally and replacing it")
        return share
    # Move the tag Compose would otherwise use, so a later plain `compose up`,
    # smoke or packaging step that names it gets this image, not the last build.
    (local,) = compose_images("plurxd")
    tagged = run("docker", "tag", image_id, local)
    if tagged.returncode != 0:
        note(f"cannot tag {local}: {tagged.stderr.strip()}")
    note(f"using shared image {ref} ({image_id}); skipping the local build")
    return f"use {image_id}"


def push(expected: str) -> None:
    if not SHA_PATTERN.match(expected):
        raise Skip(f"--expect {expected!r} is not a full commit")
    sha = clean_head()
    if sha != expected:
        raise Skip(f"checkout moved from {expected} to {sha} during the build; not sharing it")
    arch = architecture()
    ref = shared_ref(sha, arch)
    require_standard_image()
    (local,) = compose_images("plurxd")
    image_id = verify(local, sha, arch)
    tagged = run("docker", "tag", image_id, ref)
    if tagged.returncode != 0:
        raise Skip(f"cannot tag {ref}: {tagged.stderr.strip()}")
    result = run("docker", "push", ref, timeout=TRANSFER_TIMEOUT)
    if result.returncode != 0:
        raise Skip(f"push of {ref} failed ({result.stderr.strip()})")
    note(f"shared {ref}; other {arch} nodes deploying {sha[:12]} will pull it")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    parser.add_argument("action", choices=("pull", "push"))
    parser.add_argument("--expect", default="", help="push: the commit pull reported as shareable")
    args = parser.parse_args(argv)
    try:
        if args.action == "pull":
            print(pull())
        else:
            push(args.expect)
    except Skip as skip:
        note(str(skip) if args.action == "pull" else f"{skip}; other nodes will build it themselves")
    except Exception as error:  # noqa: BLE001 - sharing is an optimisation and never fails a deploy
        note(f"unexpected {type(error).__name__}: {error}; continuing with the local build")
    return 0


if __name__ == "__main__":
    sys.exit(main())
