#!/usr/bin/env bash
#
# One command per target for the things Paul's Mac controls.
#
# Server and mobile deployment both run through the private Ansible repository.
# Plurx owns this entry point and passes its checkout path to infrastructure;
# Ansible owns the playbooks, controller inventory, and device contract.
#
# Everything is opt-in and everything prints what it will do first. Nothing
# here force-pushes, rewrites history, or deploys without saying which nodes.
#
# Usage:
#   scripts/ship --check                 # the portable CI profile, locally
#   scripts/ship --push                  # push main + the working branch
#   scripts/ship --deploy                # ansible → every plurx node
#   scripts/ship --apple                 # Ansible → archive + TestFlight upload
#   scripts/ship --android               # Ansible → build + physical devices
#   scripts/ship --status                # ask every node what it is running
#   scripts/ship --all                   # check, push, deploy, apple, android
#   scripts/ship --deploy --dry-run      # print the commands, run nothing
#
# Ladder rungs for the DV investigation (docs/APPLE-NATIVE-SUBTITLES-PLAN.md
# §5.4) — ONE per deploy, then observe on the device:
#   scripts/ship --deploy --rung closed-captions
#   scripts/ship --deploy --rung forced-autoselect
#   scripts/ship --deploy --rung none        # back to the shipped shape

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="${PLURX_ANSIBLE_DIR:-$HOME/code/ansible/media}"
ANSIBLE_INVENTORY="${PLURX_ANSIBLE_INVENTORY:-$ANSIBLE_DIR/inventory.yml}"
MOBILE_VARS_FILE="${PLURX_MOBILE_VARS_FILE:-}"

DO_CHECK=0; DO_PUSH=0; DO_DEPLOY=0; DO_APPLE=0; DO_ANDROID=0; DO_STATUS=0
DRY=0; RUNG=""

say()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

run() {
  printf '    $ %s\n' "$*"
  if [ "$DRY" -eq 0 ]; then "$@"; fi
}

usage() { sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --check)   DO_CHECK=1; shift ;;
    --push)    DO_PUSH=1; shift ;;
    --deploy)  DO_DEPLOY=1; shift ;;
    --apple)   DO_APPLE=1; shift ;;
    --android) DO_ANDROID=1; shift ;;
    --status)  DO_STATUS=1; shift ;;
    --all)     DO_CHECK=1; DO_PUSH=1; DO_DEPLOY=1; DO_APPLE=1; DO_ANDROID=1; shift ;;
    --rung)    RUNG="${2:-}"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

if [ $((DO_CHECK + DO_PUSH + DO_DEPLOY + DO_APPLE + DO_ANDROID + DO_STATUS)) -eq 0 ]; then
  usage 1
fi

cd "$ROOT"
[ "$DRY" -eq 1 ] && say "DRY RUN — printing commands, running none"

# --- the gate --------------------------------------------------------------
# The same portable profile CI runs, on the pinned toolchain. It includes the
# catalog contract and web-static checks around the baseline fmt, clippy, and
# test commands. `rust-toolchain.toml` pins 1.97.1 for a reason (a floating
# "stable" fails CI on new lints with no code change), and homebrew's cargo has
# been ahead of the override on this machine before — so this asks cargo what it
# actually is and says so.
if [ "$DO_CHECK" -eq 1 ]; then
  say "gate"
  note "$(cargo --version) · $(rustc --version)"
  case "$(rustc --version)" in
    *1.97.1*) ;;
    *) note "WARNING: not the pinned 1.97.1 — CI may disagree with this run" ;;
  esac
  run scripts/validate run --profile ci --all --strict
fi

# --- push ------------------------------------------------------------------
if [ "$DO_PUSH" -eq 1 ]; then
  say "push"
  BRANCH="$(git rev-parse --abbrev-ref HEAD)"
  note "on branch $BRANCH"
  git --no-pager log --oneline origin/main..main 2>/dev/null | sed 's/^/    main ahead: /' || true
  run git push origin main
  if [ "$BRANCH" != "main" ]; then
    run git push origin "$BRANCH"
  fi
fi

# --- deploy ----------------------------------------------------------------
# The private Ansible repo lives outside this one. Its playbooks are versioned,
# while its production inventory remains local and uncommitted.
if [ "$DO_DEPLOY" -eq 1 ]; then
  say "deploy"
  [ -d "$ANSIBLE_DIR" ] || die "no ansible dir at $ANSIBLE_DIR (set PLURX_ANSIBLE_DIR)"
  [ -f "$ANSIBLE_INVENTORY" ] || die "no ansible inventory at $ANSIBLE_INVENTORY (set PLURX_ANSIBLE_INVENTORY)"
  note "playbooks: $ANSIBLE_DIR (private repo; production inventory stays local)"
  note "nodes follow origin/main, so push first or you will deploy the old tree"

  # The rung is a per-deploy environment change on the nodes. This script
  # cannot set it for you, and pretending otherwise would be worse than
  # saying so: the ansible repo is not in this tree, so whether its role
  # templates arbitrary environment into the unit is not knowable from here.
  # What IS knowable is exactly which variables the server reads, so print
  # them, and refuse to deploy a rung until the playbook is wired to carry
  # it — a rung that silently did not take would be read as "the rung
  # didn't help", which is the one wrong conclusion this ladder cannot
  # afford.
  if [ -n "$RUNG" ]; then
    case "$RUNG" in
      none)              CC=0; FA=0; LABEL="the shipped master shape" ;;
      closed-captions)   CC=1; FA=0; LABEL="CLOSED-CAPTIONS=NONE on the variant" ;;
      forced-autoselect) CC=0; FA=1; LABEL="AUTOSELECT=YES on forced renditions" ;;
      *) die "unknown rung '$RUNG' (none | closed-captions | forced-autoselect)" ;;
    esac
    note ""
    note "rung: $LABEL — ONE change this deploy"
    note "the nodes must run plurxd with exactly:"
    note "  PLURX_HLS_CLOSED_CAPTIONS_NONE=$CC"
    note "  PLURX_HLS_FORCED_AUTOSELECT=$FA"
    note "set that where the node's environment lives (systemd: Environment= in"
    note "plurxd.service, per deploy/plurxd.service; compose: the untracked"
    note "deploy/docker-compose.override.yml or deploy/.env), or add it to the ansible role once and"
    note "drive it from a group_var."
    note ""
    if [ "$DRY" -eq 0 ]; then
      printf '    wired the playbook to carry those two variables? [y/N] '
      read -r reply
      case "$reply" in
        y|Y|yes|YES) ;;
        *) die "stopping — deploy the rung only when the env change actually reaches the nodes" ;;
      esac
    fi
    note "after this deploy: play file 5615 on Bedroom, write down what happened,"
    note "and change exactly one thing before the next one."
  fi
  run ansible-playbook -i "$ANSIBLE_INVENTORY" "$ANSIBLE_DIR/deploy.yml"
fi

# --- mobile ---------------------------------------------------------------
# Both targets are local-controller work: Xcode signing and adb pairing live
# on this Mac, not on a server node. Ansible still owns the sequence and the
# inventory contract, so a missing required device or failed upload stops the
# deployment instead of leaving a partly shipped release looking successful.
if [ $((DO_APPLE + DO_ANDROID)) -gt 0 ]; then
  say "mobile"
  if [ "$DRY" -eq 0 ]; then
    command -v ansible-playbook >/dev/null || die "no ansible-playbook in PATH"
    [ -f "$ANSIBLE_DIR/mobile.yml" ] || die "no mobile playbook at $ANSIBLE_DIR/mobile.yml (set PLURX_ANSIBLE_DIR)"
    [ -f "$ANSIBLE_INVENTORY" ] || die "no ansible inventory at $ANSIBLE_INVENTORY (set PLURX_ANSIBLE_INVENTORY)"
    if [ -n "$MOBILE_VARS_FILE" ]; then
      [ -f "$MOBILE_VARS_FILE" ] || die "no mobile vars file at $MOBILE_VARS_FILE"
    fi
  fi

  MOBILE_TAGS=""
  [ "$DO_APPLE" -eq 1 ] && MOBILE_TAGS="apple"
  if [ "$DO_ANDROID" -eq 1 ]; then
    [ -n "$MOBILE_TAGS" ] && MOBILE_TAGS="$MOBILE_TAGS,"
    MOBILE_TAGS="${MOBILE_TAGS}android"
  fi

  MOBILE_ARGS=(
    ansible-playbook
    -i "$ANSIBLE_INVENTORY"
    "$ANSIBLE_DIR/mobile.yml"
    --tags "$MOBILE_TAGS"
    -e "plurx_repo=$ROOT"
  )
  if [ -n "$MOBILE_VARS_FILE" ]; then
    MOBILE_ARGS+=(-e "@$MOBILE_VARS_FILE")
  fi

  note "controller inventory: $ANSIBLE_INVENTORY"
  note "targets: $MOBILE_TAGS"
  run "${MOBILE_ARGS[@]}"
fi

# --- the status probe ------------------------------------------------------
# What is actually running out there, asked of the nodes rather than inferred
# from what we last pushed.
#
# Deploying and then believing it worked is how a node sits on an old binary
# for a week: `--deploy` reports what Ansible did, which is not the same fact
# as what the node is now serving. This asks each node directly and prints the
# answer, including for the nodes that do not answer at all.
#
# Read-only by construction — GETs against `/readyz` and `/metrics`, no
# argument that changes anything — so it is safe to run at any time, including
# against a node mid-deploy.
if [ "$DO_STATUS" -eq 1 ]; then
  say "status"

  # The inventory is Ansible's, so ask Ansible rather than parsing its YAML:
  # the schema is the private repository's to change, and a parser here would
  # break silently the first time it did. PLURX_NODES overrides for a node not
  # in the inventory yet, or when the controller is unavailable.
  if [ -n "${PLURX_NODES:-}" ]; then
    read -r -a NODES <<< "$PLURX_NODES"
    note "nodes: from PLURX_NODES"
  else
    [ -f "$ANSIBLE_INVENTORY" ] || die "no ansible inventory at $ANSIBLE_INVENTORY (set PLURX_ANSIBLE_INVENTORY, or PLURX_NODES to skip it)"
    command -v ansible-inventory >/dev/null 2>&1 \
      || die "ansible-inventory not found; set PLURX_NODES=\"host1 host2\" to probe without it"
    mapfile -t NODES < <(
      ansible-inventory -i "$ANSIBLE_INVENTORY" --list 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); h=d.get("_meta",{}).get("hostvars",{}); print("\n".join(sorted(h)))'
    )
    note "nodes: $ANSIBLE_INVENTORY"
  fi
  [ "${#NODES[@]}" -gt 0 ] || die "no nodes to probe"

  # An entry may carry its own port. Nodes do not all listen on the same one
  # once a spare is running beside a production daemon, and a probe that can
  # only ask one port is a probe that quietly omits the interesting node.
  PORT="${PLURX_PORT:-8080}"
  printf '\n    %-16s %-10s %-22s %-9s %s\n' NODE READY VERSION SERVING WAITING

  probe_failed=0
  for node in "${NODES[@]}"; do
    case "$node" in
      *:*) base="http://$node" ;;
      *)   base="http://$node:$PORT" ;;
    esac
    # Separate calls on purpose: a node can be up and unready, and the two
    # facts are reported independently rather than one masking the other.
    #
    # No `-f` on the readiness call, and that is the whole point of it.
    # `/readyz` answers 503 with the reason in the body — `maintenance`,
    # `quorum unavailable`, `store unavailable` — and `curl -f` throws the body
    # away on a non-2xx, which discards precisely the sentence worth reading.
    # A node that is down is told apart from one that is unready by curl's exit
    # status, not by whether a body arrived.
    if ready="$(curl -sS --max-time 5 "$base/readyz" 2>/dev/null | tr -d '\n')"; then
      reachable=1
    else
      reachable=0; ready=""
    fi
    metrics="$(curl -fsS --max-time 5 "$base/metrics" 2>/dev/null)" || metrics=""

    if [ "$reachable" -eq 0 ] && [ -z "$metrics" ]; then
      printf '    %-16s \033[31m%-10s\033[0m %s\n' "$node" "no answer" "(nothing listening on $PORT, or the daemon is down)"
      probe_failed=1
      continue
    fi

    version="$(printf '%s' "$metrics" | sed -n 's/^plurx_build_info{version="\([^"]*\)",build="\([^"]*\)"}.*/\1+\2/p' | head -1)"
    serving="$(printf '%s' "$metrics" | sed -n 's/^plurx_vod_gets_serving \(.*\)/\1/p' | head -1)"
    waiting="$(printf '%s' "$metrics" | sed -n 's/^plurx_vod_blocked_gets_waiting \(.*\)/\1/p' | head -1)"
    cap="$(printf '%s' "$metrics" | sed -n 's/^plurx_vod_blocked_get_cap \(.*\)/\1/p' | head -1)"

    # An older binary predates a metric rather than reporting zero for it, and
    # printing 0 would read as "idle" for a node that cannot answer the
    # question at all.
    [ -n "$version" ] || version="unknown"
    [ -n "$serving" ] || serving="n/a"
    if [ -n "$waiting" ] && [ -n "$cap" ]; then waiting="$waiting/$cap"; else waiting="n/a"; fi

    case "$ready" in
      ready) printf '    %-16s \033[32m%-10s\033[0m %-22s %-9s %s\n' "$node" ready "$version" "$serving" "$waiting" ;;
      "")    printf '    %-16s \033[31m%-10s\033[0m %-22s %-9s %s\n' "$node" "unready" "$version" "$serving" "$waiting"
             probe_failed=1 ;;
      *)     printf '    %-16s \033[33m%-10s\033[0m %-22s %-9s %s\n' "$node" "$ready" "$version" "$serving" "$waiting"
             probe_failed=1 ;;
    esac
  done

  # Distinct versions are worth naming: a partial deploy is the failure this
  # probe exists to catch, and it is invisible in a per-node list nobody adds up.
  distinct="$(
    for node in "${NODES[@]}"; do
      case "$node" in
        *:*) probe_base="http://$node" ;;
        *)   probe_base="http://$node:$PORT" ;;
      esac
      curl -fsS --max-time 5 "$probe_base/metrics" 2>/dev/null \
        | sed -n 's/^plurx_build_info{version="\([^"]*\)",build="\([^"]*\)"}.*/\1+\2/p' | head -1
    done | sort -u | grep -c . || true
  )"
  if [ "${distinct:-0}" -gt 1 ]; then
    printf '\n'
    note "WARNING: $distinct different builds are serving — this fleet is mid-deploy or a node was missed"
    probe_failed=1
  fi

  # Non-zero so a caller can gate on it, and because a probe that always
  # succeeds is one nobody reads.
  if [ "$probe_failed" -eq 1 ]; then
    printf '\n'
    note "at least one node is not ready, not answering, or not on the same build"
  fi
fi

say "done"
