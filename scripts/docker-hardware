#!/usr/bin/env python3
"""Generate a per-invocation Compose GPU overlay without editing host config."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tempfile


class HardwareError(ValueError):
    pass


def run(*args: str) -> str:
    result = subprocess.run(args, capture_output=True, text=True, timeout=20)
    if result.returncode:
        raise HardwareError(f"{' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def compose_files(environment: dict[str, str], directory: Path) -> list[str]:
    """Retain Compose's selected files, including its automatic host override."""
    configured = environment.get("COMPOSE_FILE", "")
    if configured:
        separator = environment.get("COMPOSE_PATH_SEPARATOR") or os.pathsep
        files = [Path(name) for name in configured.split(separator)]
    else:
        # Match Compose's filename preference, including alternate overrides.
        names = (
            "compose.yaml",
            "compose.yml",
            "docker-compose.yml",
            "docker-compose.yaml",
        )
        base = next(
            (directory / name for name in names if (directory / name).is_file()), None
        )
        if base is None:
            raise HardwareError("no Compose file in the deployment directory")
        files = [base]
        overrides = (
            "compose.override.yml",
            "compose.override.yaml",
            "docker-compose.override.yml",
            "docker-compose.override.yaml",
        )
        override = next(
            (directory / name for name in overrides if (directory / name).is_file()),
            None,
        )
        if override is not None:
            files.append(override)
    return [os.path.abspath(directory / path) for path in files]


def local_linux_engine() -> bool:
    if platform.system() != "Linux":
        return False
    # DOCKER_CONTEXT takes precedence over DOCKER_HOST in the Docker CLI.
    endpoint = (
        "" if os.environ.get("DOCKER_CONTEXT") else os.environ.get("DOCKER_HOST", "")
    )
    endpoint = endpoint or run(
        "docker", "context", "inspect", "--format", "{{.Endpoints.docker.Host}}"
    )
    if not endpoint.startswith("unix://"):
        return False
    return (
        "docker desktop"
        not in run("docker", "info", "--format", "{{.OperatingSystem}}").lower()
    )


def nvidia_available() -> bool:
    if not shutil.which("nvidia-smi"):
        return False
    try:
        present = bool(run("nvidia-smi", "--query-gpu=uuid", "--format=csv,noheader"))
    except (HardwareError, subprocess.TimeoutExpired):
        print(
            "docker hardware: NVIDIA driver probe failed; leaving NVIDIA selection to the override",
            file=sys.stderr,
        )
        return False
    return present


def device_source(device: dict | str) -> str:
    return (
        device.get("source", "")
        if isinstance(device, dict)
        else str(device).split(":")[0]
    )


def gpu_selection(service: dict, dri: Path) -> tuple[bool, bool]:
    """Explicit GPU choices suppress discovery, but unrelated devices do not."""
    requests = (
        service.get("deploy", {})
        .get("resources", {})
        .get("reservations", {})
        .get("devices")
        or []
    )
    nvidia = (
        bool(service.get("gpus"))
        or service.get("runtime") == "nvidia"
        or any(request.get("driver") == "nvidia" for request in requests)
    )
    selected = nvidia or any(
        "gpu" in request.get("capabilities", []) for request in requests
    )
    for device in service.get("devices") or []:
        source = device_source(device)
        target = device.get("target", "") if isinstance(device, dict) else source
        if source.startswith(("nvidia.com/gpu=", "/dev/nvidia")):
            nvidia = True
            selected = True
        if any(
            Path(name) == dri or dri in Path(name).parents for name in (source, target)
        ):
            selected = True
    return selected, nvidia


def gpu_overlay(service: dict, *, dri: Path, nvidia: bool) -> dict:
    additions: dict = {}
    devices = service.get("devices") or []
    explicit_gpu, nvidia_requested = gpu_selection(service, dri)
    selected = []
    for device in devices:
        path = Path(device_source(device))
        if path == dri or dri in path.parents:
            selected.append(path)
    if (
        not explicit_gpu
        and dri.is_dir()
        and any(node.is_char_device() for node in dri.iterdir())
    ):
        selected = [dri]
        additions["devices"] = [f"{dri}:{dri}"]
    groups = set()
    for path in selected:
        for node in path.iterdir() if path.is_dir() else [path]:
            if node.is_char_device():
                groups.add(str(node.stat().st_gid))
    groups.difference_update(str(group) for group in service.get("group_add", []))
    if groups:
        additions["group_add"] = sorted(groups, key=int)

    if nvidia and not explicit_gpu:
        additions["deploy"] = {
            "resources": {
                "reservations": {
                    "devices": [
                        {"driver": "nvidia", "count": "all", "capabilities": ["gpu"]}
                    ]
                }
            }
        }
        nvidia_requested = True
    if nvidia_requested:
        capabilities = (service.get("environment") or {}).get(
            "NVIDIA_DRIVER_CAPABILITIES"
        ) or ""
        values = {value.strip() for value in capabilities.split(",") if value.strip()}
        if "all" not in values:
            values.update(("compute", "video", "utility", "graphics"))
            additions["environment"] = {
                "NVIDIA_DRIVER_CAPABILITIES": ",".join(sorted(values))
            }
    return {"services": {"plurxd": additions}}


def resolved_compose_inputs() -> tuple[dict[str, str], dict]:
    """Use Compose itself for interpolation, including pre-2.27 clients."""
    try:
        text = run("docker", "compose", "config", "--environment")
    except HardwareError as error:
        if "unknown flag: --environment" not in str(error).lower():
            raise
        # Older Compose cannot print its interpolation environment. A throwaway
        # service makes the relevant values observable through supported JSON
        # config output instead. It is never part of the deployment overlay.
        name = "plurx-hardware-environment-probe"
        probe = {
            "services": {
                name: {
                    "image": "scratch",
                    "labels": {
                        "COMPOSE_FILE": "${COMPOSE_FILE:-}",
                        "COMPOSE_PATH_SEPARATOR": "${COMPOSE_PATH_SEPARATOR:-}",
                        "PLURX_DOCKER_GPU": "${PLURX_DOCKER_GPU:-auto}",
                    },
                }
            }
        }
        directory = Path.cwd()
        # The first probe stays in the deployment directory, retaining its .env.
        # The second uses the selected base first, retaining any project .env too.
        with tempfile.NamedTemporaryFile(
            mode="w", suffix=".json", prefix=".plurx-hardware-probe-", dir=directory
        ) as temporary:
            json.dump(probe, temporary)
            temporary.flush()
            initial = json.loads(
                run("docker", "compose", "-f", temporary.name, "config", "--format", "json")
            )
            environment = initial.get("services", {}).get(name, {}).get("labels", {})
            if not isinstance(environment, dict):
                raise HardwareError("Compose did not resolve hardware environment labels")
            files = compose_files(environment, directory)
            arguments = ["docker", "compose"]
            for filename in files:
                arguments.extend(("-f", filename))
            arguments.extend(("-f", temporary.name, "config", "--format", "json"))
            document = json.loads(run(*arguments))
            resolved = document.get("services", {}).pop(name, {}).get("labels", {})
            if not isinstance(resolved, dict) or "PLURX_DOCKER_GPU" not in resolved:
                raise HardwareError("Compose did not resolve hardware mode")
            return resolved, document
    environment = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    return environment, json.loads(run("docker", "compose", "config", "--format", "json"))


def prepare(output: Path) -> str:
    # Ask Compose for precedence, rather than implementing an .env parser.
    environment, document = resolved_compose_inputs()
    mode = environment.get("PLURX_DOCKER_GPU", "auto")
    if mode not in ("auto", "manual"):
        raise HardwareError("PLURX_DOCKER_GPU must be auto or manual")
    files = compose_files(environment, Path.cwd())
    service = document.get("services", {}).get("plurxd")
    if not isinstance(service, dict):
        raise HardwareError("resolved Compose configuration has no plurxd service")
    overlay = {"services": {"plurxd": {}}}
    if mode == "auto" and local_linux_engine():
        dri = Path("/dev/dri")
        explicit_gpu, _ = gpu_selection(service, dri)
        # Existing selections (including hook-free CDI) need no legacy probe.
        nvidia = not explicit_gpu and nvidia_available()
        if nvidia and not shutil.which("nvidia-container-runtime-hook"):
            print(
                "docker hardware: NVIDIA GPU detected but its Docker runtime hook "
                "is missing; leaving NVIDIA passthrough unset. Configure NVIDIA "
                "Container Toolkit or select a CDI device in your override. "
                "Other encoder paths remain available.",
                file=sys.stderr,
            )
            nvidia = False
        overlay = gpu_overlay(service, dri=dri, nvidia=nvidia)
        print(
            "docker hardware: "
            + json.dumps(overlay["services"]["plurxd"], sort_keys=True),
            file=sys.stderr,
        )
    else:
        print(
            "docker hardware: using existing configuration (manual mode or non-local/native-Linux engine)",
            file=sys.stderr,
        )
    output.write_text(json.dumps(overlay) + "\n", encoding="utf-8")
    files.append(os.path.abspath(output))
    if any(os.pathsep in name for name in files):
        raise HardwareError("Compose paths must not contain the path-list separator")
    return os.pathsep.join(files)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    try:
        print(prepare(args.output))
    except (HardwareError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(
            f"docker hardware preflight failed; nothing was changed: {error}",
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
