#!/usr/bin/env python3
"""Emit standalone Rust that prints the current dispatch contenders SQL."""
from __future__ import annotations

import argparse
from pathlib import Path
import re
import sys

BACKGROUND_JOBS = Path("crates/plurx-core/src/store/background_jobs.rs")
SOURCE_LEASES = Path("crates/plurx-core/src/store/source_leases.rs")
MACRO_START = "macro_rules! subtitle_managed_admission"
MACRO_END = "macro_rules! claim_maintenance_reader"
ROOT_START = "macro_rules! root_dispatch_contenders"
EXPECTED_MACROS = 13


def block(source: str, anchor: str, *, after: int = 0) -> tuple[int, int]:
    starts = [match.start() for match in re.finditer(re.escape(anchor), source)]
    if len(starts) != 1 or starts[0] < after:
        raise ValueError(f"expected one `{anchor}` anchor after offset {after}, found {len(starts)}")
    start = starts[0]
    close = re.search(r"(?m)^}[ \t]*$", source[start:])
    if close is None:
        raise ValueError(f"no standalone closing brace after `{anchor}`")
    end = start + close.end()
    if end < len(source) and source[end] != "\n":
        raise ValueError(f"closing brace for `{anchor}` is not a complete source line")
    return start, end


def extract(source: Path) -> str:
    try:
        background = (source / BACKGROUND_JOBS).read_text(encoding="utf-8")
        leases = (source / SOURCE_LEASES).read_text(encoding="utf-8")
        first, _ = block(background, MACRO_START)
        last_start, last_end = block(background, MACRO_END, after=first)
        macros = background[first:last_end]
        count = len(re.findall(r"(?m)^macro_rules!\s+[A-Za-z_][A-Za-z0-9_]*", macros))
        if count != EXPECTED_MACROS:
            raise ValueError(f"expected {EXPECTED_MACROS} shared macros in the anchored section, found {count}")
        if background.find(MACRO_END) <= first or last_start < first:
            raise ValueError("shared macro range is out of order")
        root_start, root_end = block(leases, ROOT_START)
        root_macro = leases[root_start:root_end]
        return (
            "// Generated by source-dispatch-fixture.py; do not edit.\n"
            + macros.rstrip()
            + "\n\n"
            + root_macro.rstrip()
            + '\n\nfn main() { print!("{}", root_dispatch_contenders!()); }\n'
        )
    except (OSError, UnicodeError) as error:
        raise ValueError(f"cannot read macro inputs under {source}: {error}") from error


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--repo",
        type=Path,
        help="source archive/repository root (defaults to the repo when copied under scripts/)",
    )
    args = parser.parse_args(argv)
    repo = (args.repo or Path(__file__).resolve().parent.parent).resolve()
    try:
        sys.stdout.write(extract(repo))
    except ValueError as error:
        print(f"source-dispatch-fixture: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
