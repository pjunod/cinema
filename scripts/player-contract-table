#!/usr/bin/env node
"use strict";

// Render the two player contracts as the markdown blocks
// docs/clients/PLAYER-INPUT-CONTRACT.md embeds:
//
//   tests/playback/player-input-contract.json  → contract:routing:begin/end
//   tests/playback/playback-info-fields.json   → contract:info:begin/end
//
//   scripts/player-contract-table            # print both blocks
//   scripts/player-contract-table --write    # rewrite both blocks in the doc
//   scripts/player-contract-table --embed    # rewrite the served web routing table
//
// tests/playback/player-input-contract.test.js fails when the doc and the
// fixtures disagree, so the fixtures are the only thing anyone edits by hand.

const fs = require("node:fs");
const path = require("node:path");

const ROOT = path.join(__dirname, "..");
const FIXTURE = path.join(ROOT, "tests/playback/player-input-contract.json");
const FIELDS = path.join(ROOT, "tests/playback/playback-info-fields.json");
const SURFACE_FIXTURE = path.join(ROOT, "tests/playback/playback-surface-contract.json");
const DOC = path.join(ROOT, "docs/clients/PLAYER-INPUT-CONTRACT.md");
const SURFACE_DOC = path.join(ROOT, "docs/clients/PLAYBACK-SURFACE-CONTRACT.md");
const POLICY = path.join(ROOT, "crates/plurxd/src/web/playback-policy.js");
// The generated blocks cite the fixtures with a link relative to the doc, so
// the citation stays correct when the doc moves: docs/clients/PLAYER-INPUT-CONTRACT.md
// needed "../tests/…", docs/clients/ needs "../../tests/…". Deriving it means
// a move never silently desynchronizes the doc from this generator.
const fromDoc = (target) =>
  path.relative(path.dirname(DOC), target).split(path.sep).join("/");
const FIXTURE_LINK = fromDoc(FIXTURE);
const FIELDS_LINK = fromDoc(FIELDS);
const SURFACE_FIXTURE_LINK = path
  .relative(path.dirname(SURFACE_DOC), SURFACE_FIXTURE)
  .split(path.sep)
  .join("/");
const WEB = path.join(ROOT, "crates/plurxd/src/web/index.html");
const BEGIN = "<!-- contract:routing:begin -->";
const END = "<!-- contract:routing:end -->";
const INFO_BEGIN = "<!-- contract:info:begin -->";
const INFO_END = "<!-- contract:info:end -->";
const OUTCOMES_BEGIN = "<!-- contract:outcomes:begin -->";
const OUTCOMES_END = "<!-- contract:outcomes:end -->";
const ROWS_BEGIN = "<!-- contract:rows:begin -->";
const ROWS_END = "<!-- contract:rows:end -->";
const LIVE_BEGIN = "<!-- contract:live:begin -->";
const LIVE_END = "<!-- contract:live:end -->";
const TIMINGS_BEGIN = "<!-- contract:timings:begin -->";
const TIMINGS_END = "<!-- contract:timings:end -->";
const LIVE_EMBED_BEGIN = "  // ---- generated from the `live` section of\n  // tests/playback/player-input-contract.json by scripts/player-contract-table\n  // --embed; do not edit by hand ----";
const LIVE_EMBED_END = "  // ---- end generated live table ----";
const EMBED_BEGIN = "  // ---- generated from tests/playback/player-input-contract.json by\n  // scripts/player-contract-table --embed; do not edit by hand ----";
const EMBED_END = "  // ---- end generated ----";
const SURFACE_CLASSES_BEGIN = "<!-- contract:surface-classes:begin -->";
const SURFACE_CLASSES_END = "<!-- contract:surface-classes:end -->";
const SURFACE_SOURCES_BEGIN = "<!-- contract:surface-sources:begin -->";
const SURFACE_SOURCES_END = "<!-- contract:surface-sources:end -->";
const SURFACE_EMBED_BEGIN = "  // ---- generated from the surface sections of\n  // tests/playback/playback-surface-contract.json by scripts/player-contract-table\n  // --embed; do not edit by hand ----";
const SURFACE_EMBED_END = "  // ---- end generated surface table ----";
const FIELDS_EMBED_BEGIN = "// ---- generated from tests/playback/playback-info-fields.json by\n// scripts/player-contract-table --embed; do not edit by hand ----";
const FIELDS_EMBED_END = "// ---- end playback info fields ----";

function renderBlock(contract) {
  const out = [];
  out.push(BEGIN);
  out.push("");
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](${FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  for (const surface of Object.keys(contract.routing)) {
    out.push("");
    out.push(`**Surface \`${surface}\`** — ${contract.surfaces[surface]}`);
    out.push("");
    out.push(`| state \\ input | ${contract.inputs.map((i) => `\`${i}\``).join(" | ")} |`);
    out.push(`|---|${contract.inputs.map(() => "---").join("|")}|`);
    for (const state of Object.keys(contract.states)) {
      const row = contract.routing[surface][state];
      out.push(
        `| \`${state}\` | ${contract.inputs.map((i) => `\`${row[i]}\``).join(" | ")} |`,
      );
    }
  }
  out.push("");
  out.push(END);
  return out.join("\n");
}

// The Live TV table is a sibling of the finite-player table in the same
// fixture, not a fourth surface in it: a live stream has no timeline, so a
// `live` entry under `surfaces` would have to invent `timeline`, `scrub`,
// `menu` and `info` states it can never enter. One fixture, two tables, three
// clients — which is the property that mattered.
function renderLiveBlock(contract) {
  const live = contract.live;
  const out = [LIVE_BEGIN, ""];
  out.push(
    `_Generated from the \`live\` section of [\`tests/playback/player-input-contract.json\`](${FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  for (const surface of Object.keys(live.routing)) {
    out.push("");
    out.push(`**Surface \`${surface}\`** — ${live.surfaces[surface]}`);
    out.push("");
    out.push(`| state \\ input | ${live.inputs.map((i) => `\`${i}\``).join(" | ")} |`);
    out.push(`|---|${live.inputs.map(() => "---").join("|")}|`);
    for (const state of Object.keys(live.states)) {
      const row = live.routing[surface][state];
      out.push(`| \`${state}\` | ${live.inputs.map((i) => `\`${row[i]}\``).join(" | ")} |`);
    }
  }
  out.push("");
  out.push("| Outcome | What the client does |");
  out.push("|---|---|");
  for (const [name, meaning] of Object.entries(live.outcomes)) out.push(`| \`${name}\` | ${meaning} |`);
  out.push("");
  out.push("| Timing | Value |");
  out.push("|---|---|");
  const show = (value) => (value === null ? "none" : String(value));
  for (const [name, value] of Object.entries(live.timings)) {
    if (name === "notes") continue;
    out.push(`| \`${name}\` | ${show(value)} |`);
  }
  out.push("");
  out.push(
    `**Hotkeys** (desktop, only while the live host is fullscreen or focused): ${Object.entries(live.hotkeys)
      .map(([key, action]) => `\`${key}\` ${action}`)
      .join(" · ")}.`,
  );
  out.push("");
  for (const note of live.notes || []) out.push(`- ${note}`);
  for (const [surface, note] of Object.entries(live.surface_notes || {})) out.push(`- \`${surface}\`: ${note}`);
  out.push("");
  out.push(LIVE_END);
  return out.join("\n");
}

function renderOutcomesBlock(contract) {
  const out = [OUTCOMES_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](${FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Outcome | What the client does |");
  out.push("|---|---|");
  for (const [name, meaning] of Object.entries(contract.outcomes)) {
    out.push(`| \`${name}\` | ${meaning} |`);
  }
  out.push("");
  out.push(OUTCOMES_END);
  return out.join("\n");
}

function renderRowsBlock(contract) {
  const out = [ROWS_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](${FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Row | Items in order | Surfaces | Focusable | Notes |");
  out.push("|---|---|---|---|---|");
  for (const row of contract.controls.rows) {
    const focusable = row.focusable ? row.focusable.map((i) => `\`${i}\``).join(" · ") : "all";
    const surfaces = row.surfaces ? row.surfaces.map((s) => `\`${s}\``).join(" · ") : "all";
    const conditions = row.conditional
      ? Object.entries(row.conditional).map(([item, when]) => `\`${item}\` when ${when}`).join(" · ")
      : "";
    const placement = row.surface_placement
      ? Object.entries(row.surface_placement)
          .flatMap(([item, where]) =>
            Object.entries(where).map(([surface, target]) =>
              `\`${surface}\` renders \`${item}\` at position ${target.position} of the \`${target.row}\` row`))
          .join(" · ")
      : "";
    const notes = [row.notes, conditions, placement].filter(Boolean).join(" ");
    out.push(
      `| \`${row.id}\` | ${row.items.map((i) => (i === "spacer" ? "spacer" : `\`${i}\``)).join(" · ")} | ${surfaces} | ${focusable} | ${notes} |`,
    );
  }
  out.push("");
  out.push(`**\`settings\` holds:** ${contract.controls.settings_contains.map((i) => `\`${i}\``).join(" · ")}.`);
  out.push("");
  out.push(ROWS_END);
  return out.join("\n");
}

function renderTimingsBlock(contract) {
  const out = [TIMINGS_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](${FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Name | Value |");
  out.push("|---|---|");
  const show = (value) => (value === null ? "none" : String(value));
  for (const [name, value] of Object.entries(contract.timings)) {
    if (name === "notes") continue;
    out.push(`| \`${name}\` | ${show(value)} |`);
  }
  out.push(`| \`steps.skip_seconds\` | ${show(contract.steps.skip_seconds)} |`);
  out.push(
    `| \`steps.preview_acceleration\` | ${contract.steps.preview_acceleration
      .map((step) => `${step.step_seconds} s from repeat ${step.from_repeat}`)
      .join(" · ")} |`,
  );
  out.push(`| \`steps.vertical_seek_seconds\` | ${show(contract.steps.vertical_seek_seconds)} |`);
  out.push("");
  for (const note of contract.timings.notes || []) out.push(`- ${note}`);
  out.push("");
  out.push(TIMINGS_END);
  return out.join("\n");
}

function renderInfoBlock(fields) {
  const out = [];
  out.push(INFO_BEGIN);
  out.push("");
  out.push(
    `_Generated from [\`tests/playback/playback-info-fields.json\`](${FIELDS_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  const modes = Object.keys(fields.modes);
  for (const section of fields.sections) {
    const rows = fields.fields.filter((f) => f.section === section);
    if (rows.length === 0) continue;
    out.push("");
    out.push(`**${section}**`);
    out.push("");
    out.push(`| Row | ${modes.map((m) => m).join(" | ")} | Format | Placement | Available on | Note |`);
    out.push(`|---|${modes.map(() => "---").join("|")}|---|---|---|---|`);
    for (const f of rows) {
      const cells = modes.map((m) => (f.modes.includes(m) ? "✓" : "–"));
      const placement = f.placement === "notes" ? "notes" : "grid";
      const avail = f.available_on ? f.available_on.join(" · ") : "all";
      const note = [f.always ? "always shown" : "", f.note || ""].filter(Boolean).join(" ");
      out.push(`| \`${f.label}\` | ${cells.join(" | ")} | ${f.format} | ${placement} | ${avail} | ${note} |`);
    }
  }
  out.push("");
  out.push(INFO_END);
  return out.join("\n");
}

function replaceBlock(doc, begin, end, block, label, where = DOC) {
  const start = doc.indexOf(begin);
  const stop = doc.indexOf(end);
  if (start < 0 || stop < 0 || stop < start) {
    throw new Error(`${where} has no ${begin} … ${end} block to rewrite (${label})`);
  }
  return doc.slice(0, start) + block + doc.slice(stop + end.length);
}

function renderEmbedBlock(contract) {
  return [
    EMBED_BEGIN,
    `  const INPUT_ROUTING = ${JSON.stringify(contract.routing)};`,
    `  const CONTRACT_TIMINGS = ${JSON.stringify(contract.timings)};`,
    `  const CONTRACT_STEPS = ${JSON.stringify(contract.steps)};`,
    EMBED_END,
  ].join("\n");
}

function renderLiveEmbedBlock(contract) {
  return [
    LIVE_EMBED_BEGIN,
    `  const LIVE_INPUT_ROUTING = ${JSON.stringify(contract.live.routing)};`,
    `  const LIVE_CONTRACT_TIMINGS = ${JSON.stringify(contract.live.timings)};`,
    `  const LIVE_HOTKEYS = ${JSON.stringify(contract.live.hotkeys)};`,
    LIVE_EMBED_END,
  ].join("\n");
}

function renderFieldsEmbedBlock(fields) {
  return `${FIELDS_EMBED_BEGIN}\nconst PLAYBACK_INFO_FIELDS=${JSON.stringify(fields.fields)};\n${FIELDS_EMBED_END}`;
}


// The surface contract's two tables. The doc keeps its prose table above each
// block; these are the machine-checked copies the three clients are tested
// against, so a class or a source cannot change in prose alone.
function renderSurfaceClassesBlock(surface) {
  const out = [SURFACE_CLASSES_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/playback-surface-contract.json\`](${SURFACE_FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Class | Severity | Blocking | Timer | Requires the owner to have stopped the player | Retired by | Default actions |");
  out.push("|---|---|---|---|---|---|---|");
  for (const [name, cls] of Object.entries(surface.classes)) {
    const blocking =
      cls.blocking === true ? "always" : cls.blocking === "while_not_presenting" ? "while not presenting" : "never";
    const timer = cls.timed_ms == null ? "none" : `${cls.timed_ms} ms${cls.timer_paused_while_actions ? " (paused while it has actions)" : ""}`;
    const actions = (cls.default_actions || []).map((a) => `\`${a}\``).join(" · ") || "–";
    out.push(
      `| \`${name}\` | ${cls.severity} | ${blocking} | ${timer} | ${cls.requires_player_stopped ? "yes" : "no"} | ${(cls.retired_by || []).map((r) => `\`${r}\``).join(" · ")} | ${actions} |`,
    );
  }
  out.push("");
  out.push("| Severity | Rank | Meaning |");
  out.push("|---|---|---|");
  const severityMeaning = {
    notice: "a banner beside the picture",
    progress: "the player is working on it",
    prompt: "the viewer has to answer",
    terminal: "this attempt is over",
  };
  for (const [severity, rank] of Object.entries(surface.severity_rank)) {
    out.push(`| ${severity} | ${rank} | ${severityMeaning[severity] || ""} |`);
  }
  out.push("");
  out.push(surface.precedence_note);
  out.push("");
  out.push(
    `**Surface kinds:** ${Object.entries(surface.kinds).map(([kind, meaning]) => `\`${kind}\` — ${meaning}`).join(" ")}`,
  );
  out.push("");
  out.push(
    `**The input contract's \`failed\` state** is a \`blocking\` surface whose class is ${surface.input_failed_state.classes.map((c) => `\`${c}\``).join(" or ")}. ${surface.input_failed_state.note}`,
  );
  out.push("");
  out.push("| Timing | Value |");
  out.push("|---|---|");
  for (const [name, value] of Object.entries(surface.timings)) {
    if (name === "notes") continue;
    out.push(`| \`${name}\` | ${value === null ? "none" : String(value)} |`);
  }
  out.push("");
  for (const note of surface.timings.notes || []) out.push(`- ${note}`);
  out.push("");
  out.push(SURFACE_CLASSES_END);
  return out.join("\n");
}

function renderSurfaceSourcesBlock(surface) {
  const out = [SURFACE_SOURCES_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/playback-surface-contract.json\`](${SURFACE_FIXTURE_LINK}) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("Rows are evaluated in order; the first row whose `context` matches wins.");
  out.push("");
  out.push("| # | Source | Context | Class | Requires a stopped player | Actions | Notes |");
  out.push("|---|---|---|---|---|---|---|");
  surface.sources.forEach((row, index) => {
    const notes = [];
    if (row.codes) notes.push(`codes: ${row.codes.map((c) => `\`${c}\``).join(" · ")}`);
    if (row.retryable) notes.push("retryable by the owner (M5)");
    if (row.then_when_stopped) notes.push(`re-classes to \`${row.then_when_stopped}\` when the owner stops`);
    if (row.carries) notes.push(`carries ${row.carries.map((c) => `\`${c}\``).join(" · ")}`);
    const actions = (row.actions || []).map((a) => `\`${a}\``).join(" · ") || "class default";
    out.push(
      `| ${index + 1} | \`${row.id}\` | ${row.context} | ${row.class === null ? "*(log only)*" : `\`${row.class}\``} | ${(row.requires && row.requires.player_stopped) || (row.class && surface.classes[row.class].requires_player_stopped) ? "yes" : "no"} | ${actions} | ${notes.join("; ")} |`,
    );
  });
  out.push("");
  out.push("| Fixture error | Meaning |");
  out.push("|---|---|");
  for (const [name, meaning] of Object.entries(surface.errors)) out.push(`| \`${name}\` | ${meaning} |`);
  out.push("");
  for (const note of surface.identity_notes || []) out.push(`- ${note}`);
  out.push("");
  out.push(SURFACE_SOURCES_END);
  return out.join("\n");
}

function renderSurfaceEmbedBlock(surface) {
  return [
    SURFACE_EMBED_BEGIN,
    `  const SURFACE_CLASSES = ${JSON.stringify(surface.classes)};`,
    `  const SURFACE_SOURCES = ${JSON.stringify(surface.sources)};`,
    `  const SURFACE_TIMINGS = ${JSON.stringify(surface.timings)};`,
    `  const SURFACE_SEVERITY_RANK = ${JSON.stringify(surface.severity_rank)};`,
    SURFACE_EMBED_END,
  ].join("\n");
}

function main() {
  const contract = JSON.parse(fs.readFileSync(FIXTURE, "utf8"));
  const fields = JSON.parse(fs.readFileSync(FIELDS, "utf8"));
  const surface = JSON.parse(fs.readFileSync(SURFACE_FIXTURE, "utf8"));
  const block = renderBlock(contract);
  const info = renderInfoBlock(fields);
  if (process.argv.includes("--embed")) {
    let policy = fs.readFileSync(POLICY, "utf8");
    policy = replaceBlock(policy, EMBED_BEGIN, EMBED_END, renderEmbedBlock(contract), "web routing embed");
    policy = replaceBlock(policy, LIVE_EMBED_BEGIN, LIVE_EMBED_END, renderLiveEmbedBlock(contract), "web live routing embed");
    policy = replaceBlock(policy, SURFACE_EMBED_BEGIN, SURFACE_EMBED_END, renderSurfaceEmbedBlock(surface), "web surface contract embed");
    fs.writeFileSync(POLICY, policy);
    let web = fs.readFileSync(WEB, "utf8");
    web = replaceBlock(web, FIELDS_EMBED_BEGIN, FIELDS_EMBED_END, renderFieldsEmbedBlock(fields), "web playback-info embed");
    fs.writeFileSync(WEB, web);
    process.stdout.write(`rewrote the routing table in ${path.relative(ROOT, POLICY)} and playback-info fields in ${path.relative(ROOT, WEB)}\n`);
    return;
  }
  const liveBlock = renderLiveBlock(contract);
  const outcomes = renderOutcomesBlock(contract);
  const rows = renderRowsBlock(contract);
  const timings = renderTimingsBlock(contract);
  if (process.argv.includes("--write")) {
    let doc = fs.readFileSync(DOC, "utf8");
    doc = replaceBlock(doc, BEGIN, END, block, "routing");
    doc = replaceBlock(doc, OUTCOMES_BEGIN, OUTCOMES_END, outcomes, "outcomes");
    doc = replaceBlock(doc, ROWS_BEGIN, ROWS_END, rows, "rows");
    doc = replaceBlock(doc, TIMINGS_BEGIN, TIMINGS_END, timings, "timings");
    doc = replaceBlock(doc, LIVE_BEGIN, LIVE_END, liveBlock, "live");
    doc = replaceBlock(doc, INFO_BEGIN, INFO_END, info, "info");
    fs.writeFileSync(DOC, doc);
    let surfaceDoc = fs.readFileSync(SURFACE_DOC, "utf8");
    surfaceDoc = replaceBlock(surfaceDoc, SURFACE_CLASSES_BEGIN, SURFACE_CLASSES_END, renderSurfaceClassesBlock(surface), "surface classes", SURFACE_DOC);
    surfaceDoc = replaceBlock(surfaceDoc, SURFACE_SOURCES_BEGIN, SURFACE_SOURCES_END, renderSurfaceSourcesBlock(surface), "surface sources", SURFACE_DOC);
    fs.writeFileSync(SURFACE_DOC, surfaceDoc);
    process.stdout.write(`rewrote the routing, outcome, row, timing, live and info blocks in ${path.relative(ROOT, DOC)} and the surface blocks in ${path.relative(ROOT, SURFACE_DOC)}\n`);
    return;
  }
  process.stdout.write(
    [block, outcomes, rows, timings, liveBlock, info, renderSurfaceClassesBlock(surface), renderSurfaceSourcesBlock(surface)].join("\n\n") + "\n",
  );
}

module.exports = {
  renderBlock,
  renderLiveBlock,
  renderOutcomesBlock,
  renderRowsBlock,
  renderTimingsBlock,
  renderInfoBlock,
  BEGIN,
  END,
  INFO_BEGIN,
  INFO_END,
  EMBED_BEGIN,
  EMBED_END,
  OUTCOMES_BEGIN,
  OUTCOMES_END,
  ROWS_BEGIN,
  ROWS_END,
  TIMINGS_BEGIN,
  TIMINGS_END,
  LIVE_BEGIN,
  LIVE_END,
  LIVE_EMBED_BEGIN,
  LIVE_EMBED_END,
  FIELDS_EMBED_BEGIN,
  FIELDS_EMBED_END,
  FIXTURE,
  FIELDS,
  SURFACE_FIXTURE,
  SURFACE_DOC,
  SURFACE_CLASSES_BEGIN,
  SURFACE_CLASSES_END,
  SURFACE_SOURCES_BEGIN,
  SURFACE_SOURCES_END,
  SURFACE_EMBED_BEGIN,
  SURFACE_EMBED_END,
  renderSurfaceClassesBlock,
  renderSurfaceSourcesBlock,
  renderSurfaceEmbedBlock,
  DOC,
  POLICY,
  WEB,
  renderEmbedBlock,
  renderLiveEmbedBlock,
  renderFieldsEmbedBlock,
};

if (require.main === module) main();
