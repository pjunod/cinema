#!/usr/bin/env node
"use strict";

// Render the two player contracts as the markdown blocks
// docs/PLAYER-INPUT-CONTRACT.md embeds:
//
//   tests/playback/player-input-contract.json  → contract:routing:begin/end
//   tests/playback/playback-info-fields.json   → contract:info:begin/end
//
//   scripts/player-contract-table            # print both blocks
//   scripts/player-contract-table --write    # rewrite both blocks in the doc
//   scripts/player-contract-table --embed    # rewrite the served web routing table
//
// tests/playback/player-input-contract.test.js fails when the doc and the
// fixtures disagree, so the fixtures are the only thing anyone edits by hand.

const fs = require("node:fs");
const path = require("node:path");

const ROOT = path.join(__dirname, "..");
const FIXTURE = path.join(ROOT, "tests/playback/player-input-contract.json");
const FIELDS = path.join(ROOT, "tests/playback/playback-info-fields.json");
const DOC = path.join(ROOT, "docs/PLAYER-INPUT-CONTRACT.md");
const POLICY = path.join(ROOT, "crates/plurxd/src/web/playback-policy.js");
const WEB = path.join(ROOT, "crates/plurxd/src/web/index.html");
const BEGIN = "<!-- contract:routing:begin -->";
const END = "<!-- contract:routing:end -->";
const INFO_BEGIN = "<!-- contract:info:begin -->";
const INFO_END = "<!-- contract:info:end -->";
const OUTCOMES_BEGIN = "<!-- contract:outcomes:begin -->";
const OUTCOMES_END = "<!-- contract:outcomes:end -->";
const ROWS_BEGIN = "<!-- contract:rows:begin -->";
const ROWS_END = "<!-- contract:rows:end -->";
const TIMINGS_BEGIN = "<!-- contract:timings:begin -->";
const TIMINGS_END = "<!-- contract:timings:end -->";
const EMBED_BEGIN = "  // ---- generated from tests/playback/player-input-contract.json by\n  // scripts/player-contract-table --embed; do not edit by hand ----";
const EMBED_END = "  // ---- end generated ----";
const FIELDS_EMBED_BEGIN = "// ---- generated from tests/playback/playback-info-fields.json by\n// scripts/player-contract-table --embed; do not edit by hand ----";
const FIELDS_EMBED_END = "// ---- end playback info fields ----";

function renderBlock(contract) {
  const out = [];
  out.push(BEGIN);
  out.push("");
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](../tests/playback/player-input-contract.json) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  for (const surface of Object.keys(contract.routing)) {
    out.push("");
    out.push(`**Surface \`${surface}\`** — ${contract.surfaces[surface]}`);
    out.push("");
    out.push(`| state \\ input | ${contract.inputs.map((i) => `\`${i}\``).join(" | ")} |`);
    out.push(`|---|${contract.inputs.map(() => "---").join("|")}|`);
    for (const state of Object.keys(contract.states)) {
      const row = contract.routing[surface][state];
      out.push(
        `| \`${state}\` | ${contract.inputs.map((i) => `\`${row[i]}\``).join(" | ")} |`,
      );
    }
  }
  out.push("");
  out.push(END);
  return out.join("\n");
}

function renderOutcomesBlock(contract) {
  const out = [OUTCOMES_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](../tests/playback/player-input-contract.json) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Outcome | What the client does |");
  out.push("|---|---|");
  for (const [name, meaning] of Object.entries(contract.outcomes)) {
    out.push(`| \`${name}\` | ${meaning} |`);
  }
  out.push("");
  out.push(OUTCOMES_END);
  return out.join("\n");
}

function renderRowsBlock(contract) {
  const out = [ROWS_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](../tests/playback/player-input-contract.json) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Row | Items in order | Surfaces | Focusable | Notes |");
  out.push("|---|---|---|---|---|");
  for (const row of contract.controls.rows) {
    const focusable = row.focusable ? row.focusable.map((i) => `\`${i}\``).join(" · ") : "all";
    const surfaces = row.surfaces ? row.surfaces.map((s) => `\`${s}\``).join(" · ") : "all";
    const conditions = row.conditional
      ? Object.entries(row.conditional).map(([item, when]) => `\`${item}\` when ${when}`).join(" · ")
      : "";
    const placement = row.surface_placement
      ? Object.entries(row.surface_placement)
          .flatMap(([item, where]) =>
            Object.entries(where).map(([surface, target]) =>
              `\`${surface}\` renders \`${item}\` at position ${target.position} of the \`${target.row}\` row`))
          .join(" · ")
      : "";
    const notes = [row.notes, conditions, placement].filter(Boolean).join(" ");
    out.push(
      `| \`${row.id}\` | ${row.items.map((i) => (i === "spacer" ? "spacer" : `\`${i}\``)).join(" · ")} | ${surfaces} | ${focusable} | ${notes} |`,
    );
  }
  out.push("");
  out.push(`**\`settings\` holds:** ${contract.controls.settings_contains.map((i) => `\`${i}\``).join(" · ")}.`);
  out.push("");
  out.push(ROWS_END);
  return out.join("\n");
}

function renderTimingsBlock(contract) {
  const out = [TIMINGS_BEGIN, ""];
  out.push(
    `_Generated from [\`tests/playback/player-input-contract.json\`](../tests/playback/player-input-contract.json) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  out.push("");
  out.push("| Name | Value |");
  out.push("|---|---|");
  const show = (value) => (value === null ? "none" : String(value));
  for (const [name, value] of Object.entries(contract.timings)) {
    if (name === "notes") continue;
    out.push(`| \`${name}\` | ${show(value)} |`);
  }
  out.push(`| \`steps.skip_seconds\` | ${show(contract.steps.skip_seconds)} |`);
  out.push(
    `| \`steps.preview_acceleration\` | ${contract.steps.preview_acceleration
      .map((step) => `${step.step_seconds} s from repeat ${step.from_repeat}`)
      .join(" · ")} |`,
  );
  out.push(`| \`steps.vertical_seek_seconds\` | ${show(contract.steps.vertical_seek_seconds)} |`);
  out.push("");
  for (const note of contract.timings.notes || []) out.push(`- ${note}`);
  out.push("");
  out.push(TIMINGS_END);
  return out.join("\n");
}

function renderInfoBlock(fields) {
  const out = [];
  out.push(INFO_BEGIN);
  out.push("");
  out.push(
    `_Generated from [\`tests/playback/playback-info-fields.json\`](../tests/playback/playback-info-fields.json) by \`scripts/player-contract-table\`; do not edit by hand._`,
  );
  const modes = Object.keys(fields.modes);
  for (const section of fields.sections) {
    const rows = fields.fields.filter((f) => f.section === section);
    if (rows.length === 0) continue;
    out.push("");
    out.push(`**${section}**`);
    out.push("");
    out.push(`| Row | ${modes.map((m) => m).join(" | ")} | Format | Placement | Available on | Note |`);
    out.push(`|---|${modes.map(() => "---").join("|")}|---|---|---|---|`);
    for (const f of rows) {
      const cells = modes.map((m) => (f.modes.includes(m) ? "✓" : "–"));
      const placement = f.placement === "notes" ? "notes" : "grid";
      const avail = f.available_on ? f.available_on.join(" · ") : "all";
      const note = [f.always ? "always shown" : "", f.note || ""].filter(Boolean).join(" ");
      out.push(`| \`${f.label}\` | ${cells.join(" | ")} | ${f.format} | ${placement} | ${avail} | ${note} |`);
    }
  }
  out.push("");
  out.push(INFO_END);
  return out.join("\n");
}

function replaceBlock(doc, begin, end, block, label) {
  const start = doc.indexOf(begin);
  const stop = doc.indexOf(end);
  if (start < 0 || stop < 0 || stop < start) {
    throw new Error(`${DOC} has no ${begin} … ${end} block to rewrite (${label})`);
  }
  return doc.slice(0, start) + block + doc.slice(stop + end.length);
}

function renderEmbedBlock(contract) {
  return [
    EMBED_BEGIN,
    `  const INPUT_ROUTING = ${JSON.stringify(contract.routing)};`,
    `  const CONTRACT_TIMINGS = ${JSON.stringify(contract.timings)};`,
    `  const CONTRACT_STEPS = ${JSON.stringify(contract.steps)};`,
    EMBED_END,
  ].join("\n");
}

function renderFieldsEmbedBlock(fields) {
  return `${FIELDS_EMBED_BEGIN}\nconst PLAYBACK_INFO_FIELDS=${JSON.stringify(fields.fields)};\n${FIELDS_EMBED_END}`;
}

function main() {
  const contract = JSON.parse(fs.readFileSync(FIXTURE, "utf8"));
  const fields = JSON.parse(fs.readFileSync(FIELDS, "utf8"));
  const block = renderBlock(contract);
  const info = renderInfoBlock(fields);
  if (process.argv.includes("--embed")) {
    let policy = fs.readFileSync(POLICY, "utf8");
    policy = replaceBlock(policy, EMBED_BEGIN, EMBED_END, renderEmbedBlock(contract), "web routing embed");
    fs.writeFileSync(POLICY, policy);
    let web = fs.readFileSync(WEB, "utf8");
    web = replaceBlock(web, FIELDS_EMBED_BEGIN, FIELDS_EMBED_END, renderFieldsEmbedBlock(fields), "web playback-info embed");
    fs.writeFileSync(WEB, web);
    process.stdout.write(`rewrote the routing table in ${path.relative(ROOT, POLICY)} and playback-info fields in ${path.relative(ROOT, WEB)}\n`);
    return;
  }
  const outcomes = renderOutcomesBlock(contract);
  const rows = renderRowsBlock(contract);
  const timings = renderTimingsBlock(contract);
  if (process.argv.includes("--write")) {
    let doc = fs.readFileSync(DOC, "utf8");
    doc = replaceBlock(doc, BEGIN, END, block, "routing");
    doc = replaceBlock(doc, OUTCOMES_BEGIN, OUTCOMES_END, outcomes, "outcomes");
    doc = replaceBlock(doc, ROWS_BEGIN, ROWS_END, rows, "rows");
    doc = replaceBlock(doc, TIMINGS_BEGIN, TIMINGS_END, timings, "timings");
    doc = replaceBlock(doc, INFO_BEGIN, INFO_END, info, "info");
    fs.writeFileSync(DOC, doc);
    process.stdout.write(`rewrote the routing, outcome, row, timing and info blocks in ${path.relative(ROOT, DOC)}\n`);
    return;
  }
  process.stdout.write([block, outcomes, rows, timings, info].join("\n\n") + "\n");
}

module.exports = {
  renderBlock,
  renderOutcomesBlock,
  renderRowsBlock,
  renderTimingsBlock,
  renderInfoBlock,
  BEGIN,
  END,
  INFO_BEGIN,
  INFO_END,
  EMBED_BEGIN,
  EMBED_END,
  OUTCOMES_BEGIN,
  OUTCOMES_END,
  ROWS_BEGIN,
  ROWS_END,
  TIMINGS_BEGIN,
  TIMINGS_END,
  FIELDS_EMBED_BEGIN,
  FIELDS_EMBED_END,
  FIXTURE,
  FIELDS,
  DOC,
  POLICY,
  WEB,
  renderEmbedBlock,
  renderFieldsEmbedBlock,
};

if (require.main === module) main();
