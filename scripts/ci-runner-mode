#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/ci-runner-mode [status|self-hosted|github]

Read or set the repository-wide CI_RUNNER_MODE variable. The default is
self-hosted when the variable has never been created. Set GH_REPO to target a
fork; otherwise the script targets pjunod/plurx.
EOF
}

repo="${GH_REPO:-pjunod/plurx}"
mode="${1:-status}"

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

case "$mode" in
  -h|--help)
    usage
    ;;
  status)
    value="$(
      gh variable list --repo "$repo" --json name,value \
        --jq '.[] | select(.name == "CI_RUNNER_MODE") | .value'
    )"
    if [[ -n "$value" ]]; then
      printf '%s\n' "$value"
    else
      printf '%s\n' "self-hosted (default; CI_RUNNER_MODE is unset)"
    fi
    ;;
  self-hosted|github)
    gh variable set CI_RUNNER_MODE --body "$mode" --repo "$repo"
    printf 'CI_RUNNER_MODE=%s for %s; new workflow runs will use that runner pool.\n' \
      "$mode" "$repo"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
