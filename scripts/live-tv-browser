#!/usr/bin/env python3
"""Exercise the shipped Live TV UI with real generated HLS and a fake tuner API.

Run: python3 scripts/live-tv-browser --self-host --out target/live-tv-browser
Uses ui-baseline's isolated seeded daemon. No household tuner is opened and no
production settings are changed. A failed assertion exits nonzero; screenshots
are evidence of the player, not a substitute for advancing media time.
"""
from __future__ import annotations

import json
from pathlib import Path
import re
import runpy
import subprocess
import sys
import time
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parents[1]
HARNESS = runpy.run_path(str(ROOT / "scripts/ui-baseline"), run_name="live_tv_fixture_harness")


def main(argv: list[str]) -> int:
    from playwright.sync_api import sync_playwright

    args = HARNESS["parse_args"](argv)
    if not args.self_host:
        raise SystemExit("live-tv-browser only accepts --self-host; production servers are not test fixtures")
    HARNESS["preflight"](args)
    out = Path(args.out).resolve()
    media = out / "live-hls"
    media.mkdir(parents=True, exist_ok=True)
    subprocess.run([
        args.ffmpeg, "-hide_banner", "-loglevel", "error", "-y",
        "-f", "lavfi", "-i", "testsrc2=size=320x180:rate=24",
        "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000",
        "-t", "90", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p",
        "-g", "48", "-keyint_min", "48", "-sc_threshold", "0", "-c:a", "aac",
        "-b:a", "96k", "-f", "hls", "-hls_time", "2", "-hls_list_size", "0",
        "-hls_segment_filename", str(media / "%d.ts"), str(media / "source.m3u8"),
    ], check=True, timeout=90)

    host = HARNESS["SelfHost"](args)
    try:
        host.start()
        with sync_playwright() as pw:
            browser = pw.chromium.launch(headless=True, args=[
                "--no-sandbox", "--disable-dev-shm-usage", "--mute-audio",
                "--autoplay-policy=no-user-gesture-required", "--disable-features=HardwareMediaKeyHandling",
            ])
            context = browser.new_context(viewport={"width": 1280, "height": 860})
            context.add_init_script("if (location.origin === %s) localStorage.setItem('plurx_token', %s);" %
                                    (json.dumps(host.base_url.rstrip('/')), json.dumps(host.token)))
            channels = [
                {"id": "one", "guide_number": "7.1", "guide_name": "Fixture News", "drm": False, "favorite": True, "support": "ready"},
                {"id": "two", "guide_number": "10.2", "guide_name": "Fixture Public TV", "drm": False, "favorite": False, "support": "ready"},
                {"id": "protected", "guide_number": "107.1", "guide_name": "Fixture Protected", "drm": True, "favorite": False, "support": "drm_unsupported"},
            ]
            sessions: dict[str, dict] = {}
            events: list[str] = []
            errors: list[str] = []
            forbidden: list[str] = []
            # A raised assertion inside a Playwright route handler is caught by
            # the dispatcher, leaves the route unfulfilled, and surfaces later
            # as an unrelated timeout — or not at all. Record and assert in the
            # test body, where a violation actually fails the run.
            violations: list[str] = []
            pending: list = []
            deletes: list[str] = []
            mode = {"next": "normal", "drop_delete": False}

            def active() -> list[str]:
                return [key for key, value in sessions.items() if not value["closed"]]

            def intercept(route):
                request = route.request
                path = urlsplit(request.url).path.removeprefix("/api/v1/live-tv/")
                method = request.method
                if path == "channels":
                    route.fulfill(json={"channels": channels, "freshness": "fresh", "age_seconds": 0})
                    return
                if path == "guide":
                    # The guide is a second, independent read. The page must be
                    # usable before it answers and must stay usable if it never
                    # does, so this fixture answers the honest degraded shape: a
                    # configured source with nothing cached. Every assertion in
                    # this script is about the tuner, and none of them may come
                    # to depend on a programme line existing.
                    route.fulfill(json={"source": "hdhomerun", "freshness": "unavailable",
                                        "age_seconds": 0, "window": {"start": 0, "end": 0},
                                        "matched_channels": 0, "lineup_channels": len(channels),
                                        "channels": []})
                    return
                if path == "guide/readiness":
                    route.fulfill(json={"advisory": True, "source": "hdhomerun", "guide_hours": 24,
                                        "freshness": "unavailable", "age_seconds": 0,
                                        "matched_channels": 0, "lineup_channels": len(channels),
                                        "programmes": 0, "refresh_interval_seconds": 1200,
                                        "checks": []})
                    return
                start = re.fullmatch(r"channels/(one|two)/sessions", path)
                if start and method == "POST":
                    if request.headers.get("authorization") != "Bearer " + host.token:
                        violations.append("start did not carry the account bearer: " + request.url)
                    if mode["next"] == "capacity":
                        mode["next"] = "normal"
                        route.fulfill(status=503, json={"code": "tuner_capacity", "message": "Fixture is busy"})
                        return
                    if active():
                        violations.append("a new tuner was allocated before the old capability was released")
                    capability = "fixture-" + str(len(sessions) + 1)
                    channel = next(c for c in channels if c["id"] == start[1])
                    sessions[capability] = {"opened": time.monotonic(), "closed": False, "channel": channel}
                    events.append("start:" + capability)
                    result = {"session_id": capability, "playlist_url": "https://untrusted.invalid/ignored",
                              "channel": channel, "live": True, "output": {"video": "h264", "audio": "aac"}}
                    if mode["next"] == "late":
                        mode["next"] = "normal"
                        pending.append((route, result))
                    else:
                        route.fulfill(json=result)
                    return
                resource = re.fullmatch(r"sessions/(fixture-\d+)(?:/(.*))?", path)
                assert resource, "unexpected Live TV fixture route: " + path
                if "authorization" in request.headers:
                    violations.append("account token escaped onto a capability route: " + request.url)
                capability, suffix = resource.groups()
                session = sessions[capability]
                if method == "DELETE":
                    deletes.append(capability)
                    if mode["drop_delete"]:
                        route.abort("failed")
                        return
                    if not session["closed"]:
                        session["closed"] = True
                        events.append("release:" + capability)
                    route.fulfill(status=204)
                elif session["closed"]:
                    route.fulfill(status=410, json={"code": "capability_expired"})
                elif suffix in {"keepalive", "status"} and session.get("failure"):
                    code = session["failure"]
                    route.fulfill(status=410 if code == "capability_expired" else 503, json={"code": code})
                elif suffix == "keepalive":
                    route.fulfill(status=204)
                elif suffix == "status":
                    route.fulfill(json={"state": "active", "owner_node_id": "fixture-owner", "encoder": "fixture", "output_height": 180})
                elif suffix == "index.m3u8":
                    end = min(44, 3 + int((time.monotonic() - session["opened"]) / 2))
                    first = max(0, end - 5)
                    playlist = "#EXTM3U\n#EXT-X-VERSION:3\n#EXT-X-TARGETDURATION:2\n#EXT-X-MEDIA-SEQUENCE:%d\n" % first
                    playlist += "".join("#EXTINF:2.000000,\n%d.ts\n" % i for i in range(first, end + 1))
                    route.fulfill(content_type="application/vnd.apple.mpegurl", body=playlist)
                else:
                    assert re.fullmatch(r"\d+\.ts", suffix or "")
                    route.fulfill(content_type="video/mp2t", body=(media / suffix).read_bytes())

            def observe(request):
                path = urlsplit(request.url).path
                if request.method in {"POST", "PUT", "PATCH", "DELETE"} and "/api/v1/" in path and "/live-tv/" not in path:
                    forbidden.append(request.method + " " + path)

            context.route("**/api/v1/live-tv/**", intercept)
            context.on("request", observe)
            page = context.new_page()
            page.on("pageerror", lambda error: errors.append(str(error)))

            def until(predicate, message: str, timeout: float = 10):
                deadline = time.monotonic() + timeout
                while not predicate():
                    assert time.monotonic() < deadline, message
                    # Pump Playwright events while the fake tuner services requests.
                    page.wait_for_timeout(50)

            def frames_advance():
                sample = page.locator("#live-tv-video").evaluate("""video => ({
                    time: video.currentTime,
                    frames: video.getVideoPlaybackQuality?.().totalVideoFrames ?? video.webkitDecodedFrameCount ?? 0
                })""")
                page.wait_for_function("""sample => {
                    const video = document.querySelector('#live-tv-video');
                    const frames = video.getVideoPlaybackQuality?.().totalVideoFrames ?? video.webkitDecodedFrameCount ?? 0;
                    return !video.paused && video.videoWidth > 0 && video.videoHeight > 0
                        && video.currentTime > sample.time + 1 && frames > sample.frames + 12;
                }""", arg=sample, timeout=30000)

            # The rebuilt page is a list of channel rows, not a wall of cards
            # with their own Watch buttons: the row is the click target.
            rows = page.locator("#live-tv-body button.lt-row:not([disabled])")

            def watch(index=0):
                rows.nth(index).click()
                # The picture lives in a fixed host outside `#main` now, so
                # wait for it to be shown rather than assuming the click's own
                # re-render put a video on screen.
                page.wait_for_function(
                    "!document.querySelector('#live-tv-host').hidden"
                    " && document.querySelector('#live-tv-video')")
                frames_advance()

            def stop():
                page.locator("#live-tv-host").get_by_label("Stop Live TV", exact=True).click()

            page.goto(host.base_url + "/#/live-tv")
            # A protected channel is drawn, dimmed and unclickable — never
            # hidden, and never quietly playable.
            locked = page.locator("#live-tv-body button.lt-row.locked")
            locked.first.wait_for()
            assert locked.first.is_disabled()

            # Everything past this point plays the fixture's H.264/AAC media.
            # A Chromium built without the proprietary decoders cannot, and
            # Hls.js reports it as `bufferAddCodecError` — which the page then
            # renders, correctly, as "channel format unsupported". Failing here
            # would blame the page for the browser, so say what is true instead
            # and let the runner that has the codecs prove the rest.
            playable = page.evaluate("""() => MediaSource.isTypeSupported('video/mp4; codecs="avc1.42E01E"')
                && MediaSource.isTypeSupported('audio/mp4; codecs="mp4a.40.2"')""")
            if not playable:
                print(
                    "live-tv-browser: this Chromium has no H.264/AAC decoder, so the tuner-lease "
                    "half of this acceptance is NOT EXERCISED here. The channel list, the "
                    "protected-channel refusal and the degraded-guide rendering above did run. "
                    "Run this on a browser with the proprietary codecs to prove the rest."
                )
                assert not errors, "browser page errors: " + repr(errors)
                assert not forbidden, "Live TV wrote VOD/account state: " + repr(forbidden)
                return 0

            watch()
            page.screenshot(path=str(out / "live-tv-playing.png"), full_page=True)
            page.get_by_label("Pause", exact=True).click()
            assert page.locator("#live-tv-video").evaluate("video => video.paused")
            page.locator("#live-tv-video").evaluate("video => video.play()")
            frames_advance()
            # Fullscreen takes the host, not the bare video: the overlay has to
            # be inside the fullscreen tree or there is no channel strip.
            page.locator("#live-tv-body").get_by_label("Fullscreen", exact=True).click()
            page.wait_for_function("document.fullscreenElement?.id === 'live-tv-host'")
            page.evaluate("""() => {
                const detach = detachLiveTvMedia;
                detachLiveTvMedia = () => {
                    try { return detach(); }
                    catch (error) { window.__liveTvDetachError = String(error?.stack || error); throw error; }
                };
            }""")
            stop()
            try:
                page.wait_for_function("!document.fullscreenElement && document.querySelector('#live-tv-host').hidden")
            except Exception as error:
                state = page.evaluate("""() => ({
                    fullscreen: document.fullscreenElement?.id || null,
                    webkitFullscreen: document.webkitFullscreenElement?.id || null,
                    pictureInPicture: document.pictureInPictureElement?.id || null,
                    webkitDisplayingFullscreen: document.querySelector('#live-tv-video')?.webkitDisplayingFullscreen || false,
                    webkitPresentationMode: document.querySelector('#live-tv-video')?.webkitPresentationMode || null,
                    hidden: document.querySelector('#live-tv-host')?.hidden,
                    mode: document.querySelector('#live-tv-host')?.dataset.mode || null,
                    serial: LIVE_TV.serial,
                    stopSource: stopLiveTv.toString(),
                    exitSource: exitLiveTvPresentation.toString(),
                    detachError: window.__liveTvDetachError || null,
                    message: document.querySelector('#live-tv-message')?.textContent || null,
                })""")
                raise AssertionError(
                    f"fullscreen stop did not settle: state={state!r}, "
                    f"active={active()!r}, page_errors={errors!r}"
                ) from error
            until(lambda: not active(), "fullscreen stop did not release")

            watch()
            first = active()[0]
            watch(1)
            page.wait_for_function("document.querySelector('#live-tv-host')?.dataset.mode === 'slot'")
            assert active() and active()[0] != first, "switching channels reused the old capability"

            # The behaviour this milestone exists for, and the inverse of what
            # this script asserted before it: leaving the route DOCKS the
            # picture rather than tearing it down. The lease is still held, the
            # media element still exists, and the poll that owns the tuner is
            # still running -- so the dock's own Stop is what releases it.
            docked = active()[0]
            page.evaluate("location.hash = '#/settings'")
            page.wait_for_function("location.hash.startsWith('#/settings')")
            page.wait_for_function("document.querySelector('#live-tv-host')?.dataset.mode === 'dock'")
            assert page.locator("#live-tv-video").count() == 1, "docking destroyed the media element"
            assert active() == [docked], "docking released a tuner the viewer is still watching"
            page.get_by_label("Stop from the dock", exact=True).click()
            until(lambda: not active(), "the dock's stop did not release")

            page.goto(host.base_url + "/#/live-tv")
            rows.first.wait_for()
            mode["next"] = "capacity"
            rows.nth(0).click()
            page.get_by_text("All Live TV slots are busy.", exact=False).wait_for()
            mode["next"] = "late"
            rows.nth(0).click()
            until(lambda: len(pending) == 1, "late start never reached the tuner")
            # Navigating during the start now docks rather than abandoning the
            # reply: a capability granted after the viewer left must arrive
            # somewhere it can be seen and stopped, not be held invisibly.
            page.evaluate("location.hash = '#/settings'")
            page.wait_for_function("location.hash.startsWith('#/settings')")
            late_route, late_result = pending.pop()
            late_route.fulfill(json=late_result)
            until(lambda: len(active()) == 1, "the late start was not adopted by the dock")
            page.wait_for_function("document.querySelector('#live-tv-host')?.dataset.mode === 'dock'")
            page.get_by_label("Stop from the dock", exact=True).click()
            until(lambda: not active(), "a late start adopted by the dock could not be stopped")

            page.goto(host.base_url + "/#/live-tv")
            for failure in ("owner_unavailable", "stream_failed", "capability_expired"):
                watch()
                sessions[active()[0]]["failure"] = failure
                until(lambda: not active(), "active " + failure + " did not release", timeout=25)
                page.wait_for_function("document.querySelector('#live-tv-host').hidden")

            watch()
            page.get_by_label("Pause", exact=True).click()
            until(lambda: not active(), "paused tuner was renewed instead of released", timeout=42)
            page.wait_for_function("document.querySelector('#live-tv-host').hidden")

            watch()
            # Exercise the shipped visibility handler. Headless Chromium does
            # not model an OS app switch, so this is explicitly an event test.
            page.evaluate("""() => {
                Object.defineProperty(document, 'visibilityState', {configurable: true, get: () => 'hidden'});
                document.dispatchEvent(new Event('visibilitychange'));
            }""")
            until(lambda: not active(), "visibility loss did not release")
            page.evaluate("delete document.visibilityState")

            watch()
            # The orphan has to be made through a release the browser actually
            # sends. This step used to set the flag and navigate away, waiting
            # for an unload DELETE to be lost -- and none ever arrived, so
            # nothing was dropped, every session closed cleanly, and the
            # "orphaned start blocks replacement" claim below was proven by a
            # run that had no orphan in it. Pause is a release this fixture has
            # already serviced nine times.
            orphan = active()[0]
            attempted = len(deletes)
            mode["drop_delete"] = True
            page.get_by_label("Pause", exact=True).click()
            until(
                lambda: len(deletes) > attempted,
                "the client never tried to release the orphan",
                timeout=45,
            )
            assert deletes[attempted] == orphan, deletes
            assert active() == [orphan], "a lost DELETE must not close the session"
            # Now the reload, with a capability the server still holds and the
            # client believes it has given back.
            page.goto("about:blank")
            page.goto(host.base_url + "/#/live-tv")
            assert page.evaluate("Object.keys(localStorage).some(key => key.startsWith('plurx_live_tv_pending_v1:'))")
            rows.nth(0).click()
            page.get_by_text("90 seconds", exact=False).wait_for()
            # Nothing new was allocated: the replacement document adopted the
            # outstanding capability rather than opening an eleventh tuner.
            assert active() == [orphan] and len(sessions) == 10, (active(), len(sessions))
            assert not forbidden, "Live TV wrote VOD/account state: " + repr(forbidden)
            assert not errors, "browser page errors: " + repr(errors)
            assert events == [entry for i in range(1, 10) for entry in (f"start:fixture-{i}", f"release:fixture-{i}")] + ["start:fixture-10"], events
            # The last capability intentionally has no confirmed DELETE.
            # Its backend orphan expiry belongs to backend/hardware acceptance,
            # not an invented reaper inside this browser fixture.
            assert all(deletes.count(f"fixture-{i}") == 1 for i in range(1, 10)), deletes
            # Reachable at last: the orphan's DELETE really is sent and
            # really is lost, so this counts attempts rather than describing a
            # request that was never made. The upper bound keeps the client's
            # retry from becoming a loop.
            assert 1 <= deletes.count(orphan) <= 3, deletes
            assert not violations, violations
            print("PASS decoded H.264/AAC frames advance; pause/resume, fullscreen stop, switch, navigation, typed refusal and late-start cleanup")
            print("PASS active owner loss, producer failure, capability expiry, paused timeout, visibility event and lost-unload reload quarantine")
            print("PASS no account token on capability requests; no VOD or account write from any Live TV path; ten starts, nine confirmed releases, one deliberately orphaned start blocks replacement")
            context.close()
            browser.close()
        return 0
    finally:
        host.stop()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
