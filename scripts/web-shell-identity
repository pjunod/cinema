#!/usr/bin/env python3
"""Prove the split web shell is byte-identical to the file it was cut from.

Why this exists: `crates/plurxd/src/web/index.html` used to be one 23,901-line
file holding the whole web app. `docs/clients/WEB-SHELL-SPLIT-PLAN.md` cuts it
into sixty-two files served in a fixed order, and the entire safety argument for
that PR is that the bytes did not change — not "the tests still pass", which
would only say the tests do not look at the parts that moved.

So this reassembles the tree the way the browser does, from the shell's own tag
order, and compares it to the pre-split file at a given base ref:

  * `app.css` must equal the old `<style>` block's content,
  * `core/theme.js` must equal the old `<head>` script's content,
  * concatenating the body rows in served order, after removing exactly one
    leading `"use strict";` line from each, must equal the old `<body>` script
    minus its own one `"use strict";` line — with the one deliberate relocation
    applied: the `LAYOUTS.classic.*` registration moves to wherever the row
    named by --relocated-to sits in the served order.

That relocation is the only intended difference, and it is the one thing the
plan (§3.1 rule 4) allows: those eight lines execute at load and name functions
declared in later files, so cut where the banners say, the app dies at load.

    scripts/web-shell-identity <base-ref>

This is a one-shot proof for the split PR, not a standing gate: once files start
changing on their own the comparison is meaningless by design. The standing
gates are `tests/web/asset-order.test.js` and `tests/web/asset-load.test.js`.
"""

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WEB = ROOT / "crates/plurxd/src/web"
SHELL = WEB / "index.html"
PROLOGUE = '"use strict";'
RELOCATED_TO = "layouts/register-classic.js"

# The seven pre-existing sidecars and reader.css keep their own routes and are
# NOT part of the split table (plan §2) — they are UMD modules required by path
# from tests and bundled into both native clients by path.
SIDECARS = frozenset({
    "cluster-panel.js", "playback-policy.js", "playback-control.js", "reader.js",
    "hls.min.js", "live-tv.js", "library-channels.js", "reader.css",
})

ASSET_SCRIPT = re.compile(r'^<script src="/assets/(?P<path>[^"?]+)"></script>$')
ASSET_STYLE = re.compile(r'^<link rel="stylesheet" href="/assets/(?P<path>[^"?]+)">$')


def fail(msg: str) -> int:
    print(f"web-shell-identity: FAIL — {msg}", file=sys.stderr)
    return 1


def inline_blocks(lines: list[str]) -> tuple[list[str], list[str], list[str]]:
    """The old file's three inline blocks: style content, head script, body script."""
    style = [i for i, l in enumerate(lines) if l == "<style>"]
    style_end = [i for i, l in enumerate(lines) if l == "</style>"]
    opens = [i for i, l in enumerate(lines) if l == "<script>"]
    closes = [i for i, l in enumerate(lines) if l == "</script>"]
    if len(style) != 1 or len(style_end) != 1 or len(opens) != 2 or len(closes) != 2:
        raise SystemExit(
            f"base file is not the pre-split shell: {len(style)} <style>, "
            f"{len(opens)} inline <script> blocks"
        )
    return (
        lines[style[0] + 1 : style_end[0]],
        lines[opens[0] + 1 : closes[0]],
        lines[opens[1] + 1 : closes[1]],
    )


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip().splitlines()[-4], file=sys.stderr)
        print("usage: scripts/web-shell-identity <base-ref>", file=sys.stderr)
        return 2
    base = argv[1]

    old = subprocess.run(
        ["git", "show", f"{base}:crates/plurxd/src/web/index.html"],
        cwd=ROOT, capture_output=True, text=True,
    )
    if old.returncode != 0:
        return fail(f"cannot read index.html at {base}: {old.stderr.strip()}")
    old_lines = old.stdout[:-1].split("\n")
    old_css, old_head, old_body = inline_blocks(old_lines)

    # The served order is the shell's own tag order — that is what a browser
    # obeys, and a web.rs unit test pins WEB_ASSETS to it.
    shell = SHELL.read_text(encoding="utf-8")[:-1].split("\n")
    def rows(pattern):
        hits = [m.group("path") for m in (pattern.match(l) for l in shell) if m]
        return [h for h in hits if h not in SIDECARS]

    styles = rows(ASSET_STYLE)
    scripts = rows(ASSET_SCRIPT)
    if "app.css" not in styles:
        return fail("the shell does not link /assets/app.css")
    if scripts[:1] != ["core/theme.js"]:
        return fail(f"the shell's first asset script is {scripts[:1]}, not core/theme.js")
    body_rows = scripts[1:]
    if RELOCATED_TO not in body_rows:
        return fail(f"the shell never loads {RELOCATED_TO}")

    problems = []

    css = (WEB / "app.css").read_text(encoding="utf-8")[:-1].split("\n")
    if css != old_css:
        problems.append(f"app.css differs from the old <style> block "
                        f"({len(css)} lines vs {len(old_css)})")

    head = (WEB / "core/theme.js").read_text(encoding="utf-8")[:-1].split("\n")
    if head != old_head:
        problems.append(f"core/theme.js differs from the old <head> script "
                        f"({len(head)} lines vs {len(old_head)})")
    if sum(1 for l in head if l.strip() == PROLOGUE) != 1:
        problems.append("core/theme.js does not carry exactly one \"use strict\"")

    # Lift the relocated block out of the old body, then put it back where the
    # served order now places it.
    marks = [i for i, l in enumerate(old_body) if l.startswith("LAYOUTS.classic.")]
    if not marks:
        return fail("the old body script has no LAYOUTS.classic registration to relocate")
    start = marks[0]
    end = start
    while end < len(old_body) and old_body[end] != "};":
        end += 1
    reloc = old_body[start : end + 1]

    if old_body[0] != PROLOGUE:
        return fail("the old body script does not open with \"use strict\";")
    expected = old_body[1:start] + old_body[end + 1 :]

    actual: list[str] = []
    insert_at = None
    for row in body_rows:
        if row == RELOCATED_TO:
            insert_at = len(actual)
        text = (WEB / row).read_text(encoding="utf-8")[:-1].split("\n")
        if text[0] != PROLOGUE:
            problems.append(f"{row} does not open with the \"use strict\"; prologue")
            continue
        actual += text[1:]
    expected = expected[:insert_at] + reloc + expected[insert_at:]

    if actual != expected:
        for n, (a, e) in enumerate(zip(actual, expected), 1):
            if a != e:
                problems.append(f"body mismatch at concatenated line {n}:\n"
                                f"      got  {a!r}\n      want {e!r}")
                break
        else:
            problems.append(f"body length mismatch: {len(actual)} vs {len(expected)}")

    if problems:
        for p in problems:
            print(f"web-shell-identity: FAIL — {p}", file=sys.stderr)
        return 1

    print(f"web-shell-identity: OK against {base}")
    print(f"  app.css            {len(css):6d} lines == old <style> content")
    print(f"  core/theme.js      {len(head):6d} lines == old <head> script")
    print(f"  {len(body_rows)} body rows  {len(actual):6d} lines == old <body> script "
          f"(one prologue stripped per row; {len(reloc)} relocated lines re-inserted "
          f"where {RELOCATED_TO} is served)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
