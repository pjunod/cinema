#!/bin/sh
# Generate and measure small, deterministic encoded-media controls for M0.
set -eu

baseline_root=${1:?usage: decoder-media-baseline EMPTY_OUTPUT_DIRECTORY}
if [ -e "$baseline_root" ]; then
    echo "refusing existing output path: $baseline_root" >&2
    exit 2
fi
mkdir -p "$baseline_root"

ffmpeg -hide_banner -loglevel error \
    -f lavfi -i 'testsrc2=duration=2:size=320x180:rate=24' \
    -f lavfi -i 'sine=frequency=1000:sample_rate=48000:duration=2' \
    -c:v libx264 -preset veryfast -pix_fmt yuv420p \
    -c:a aac -shortest "$baseline_root/source-h264.mp4"

ffmpeg -hide_banner -loglevel error \
    -f lavfi -i 'testsrc2=duration=2:size=320x180:rate=25' \
    -f lavfi -i 'sine=frequency=440:sample_rate=48000:duration=2' \
    -c:v mpeg4 -q:v 5 -c:a libmp3lame -shortest \
    "$baseline_root/source-mpeg4.avi"

ffmpeg -hide_banner -loglevel error \
    -f lavfi -i 'testsrc2=duration=2:size=320x180:rate=24' \
    -vf format=yuv420p10le -c:v libx265 -preset ultrafast \
    -x265-params 'hdr10=1:repeat-headers=1:pools=1:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc' \
    -color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc \
    -an "$baseline_root/source-hevc-hdr10.mkv"

for control in h264 mpeg4 hevc-hdr10; do
    mkdir "$baseline_root/output-$control"
done

for control in h264 mpeg4; do
    source_file="$baseline_root/source-$control.$([ "$control" = h264 ] && printf mp4 || printf avi)"
    ffmpeg -hide_banner -loglevel error -i "$source_file" \
        -map 0:v:0 -map '0:a:0?' \
        -vf "scale=-2:'min(1080,ih)',format=yuv420p" \
        -c:v libx264 -preset veryfast -b:v 8000k -maxrate 12000k \
        -bufsize 16000k -profile:v high \
        -force_key_frames 'expr:gte(t,n_forced*2)' \
        -c:a aac -ac 2 -b:a 160k -muxdelay 0 -muxpreload 0 \
        -f hls -hls_time 2 -hls_playlist_type event \
        -hls_flags independent_segments+temp_file -hls_segment_type mpegts \
        -hls_segment_filename "$baseline_root/output-$control/seg%05d.ts" \
        -start_number 0 "$baseline_root/output-$control/index.m3u8"
done

ffmpeg -hide_banner -loglevel error \
    -i "$baseline_root/source-hevc-hdr10.mkv" -map 0:v:0 -map '0:a:0?' \
    -vf "scale=-2:'min(1080,ih)',zscale=tin=smpte2084:min=bt2020nc:pin=bt2020:t=linear:npl=100,format=gbrpf32le,tonemap=tonemap=hable:desat=0,zscale=p=bt709:t=bt709:m=bt709:r=tv,format=yuv420p" \
    -c:v libx264 -preset veryfast -b:v 8000k -maxrate 12000k \
    -bufsize 16000k -profile:v high \
    -force_key_frames 'expr:gte(t,n_forced*2)' \
    -c:a aac -ac 2 -b:a 160k -muxdelay 0 -muxpreload 0 \
    -f hls -hls_time 2 -hls_playlist_type event \
    -hls_flags independent_segments+temp_file -hls_segment_type mpegts \
    -hls_segment_filename "$baseline_root/output-hevc-hdr10/seg%05d.ts" \
    -start_number 0 "$baseline_root/output-hevc-hdr10/index.m3u8"

for control in h264 mpeg4 hevc-hdr10; do
    source_file="$baseline_root/source-$control.$([ "$control" = h264 ] && printf mp4 || { [ "$control" = mpeg4 ] && printf avi || printf mkv; })"
    printf '%s\tsource_sha256\t' "$control"
    sha256sum "$source_file" | awk '{print $1}'
    printf '%s\tsource_probe\t' "$control"
    ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,profile,pix_fmt,width,height,color_range,color_space,color_transfer,color_primaries,r_frame_rate \
        -of compact=p=0:nk=0 "$source_file"
    printf '%s\tplaylist_sha256\t' "$control"
    sha256sum "$baseline_root/output-$control/index.m3u8" | awk '{print $1}'
    printf '%s\tsegment_sha256\t' "$control"
    sha256sum "$baseline_root/output-$control/seg00000.ts" | awk '{print $1}'
    printf '%s\tdecoded_framemd5_sha256\t' "$control"
    ffmpeg -hide_banner -loglevel error \
        -i "$baseline_root/output-$control/index.m3u8" \
        -map 0:v:0 -f framemd5 - | sha256sum | awk '{print $1}'
    printf '%s\toutput_probe\t' "$control"
    ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,profile,pix_fmt,width,height,color_range,color_space,color_transfer,color_primaries,r_frame_rate \
        -of compact=p=0:nk=0 "$baseline_root/output-$control/index.m3u8"
done
