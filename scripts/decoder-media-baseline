#!/usr/bin/env python3
"""Generate deterministic encoded controls and optionally verify M0 evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tomllib


PROBE_FIELDS = (
    "codec_name,profile,pix_fmt,width,height,color_range,color_space,"
    "color_transfer,color_primaries,r_frame_rate"
)


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        while chunk := source.read(64 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def run(args: list[str], *, capture: bool = False, combine_stderr: bool = False) -> bytes:
    completed = subprocess.run(
        args,
        check=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.STDOUT if combine_stderr else None,
    )
    return completed.stdout or b""


def video_probe(ffprobe: str, path: Path) -> str:
    return run(
        [
            ffprobe,
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            f"stream={PROBE_FIELDS}",
            "-of",
            "compact=p=0:nk=0",
            str(path),
        ],
        capture=True,
    ).decode("utf-8").strip()


def generate(output: Path, ffmpeg: str, ffprobe: str) -> list[dict[str, str]]:
    if output.exists():
        raise ValueError(f"refusing existing output path: {output}")
    output.mkdir(parents=True)

    sources = {
        "h264-sdr": output / "source-h264.mp4",
        "mpeg4-simple-avi": output / "source-mpeg4.avi",
        "hevc-main10-hdr10": output / "source-hevc-hdr10.mkv",
    }
    run(
        [
            ffmpeg,
            "-hide_banner",
            "-loglevel",
            "error",
            "-f",
            "lavfi",
            "-i",
            "testsrc2=duration=2:size=320x180:rate=24",
            "-f",
            "lavfi",
            "-i",
            "sine=frequency=1000:sample_rate=48000:duration=2",
            "-c:v",
            "libx264",
            "-preset",
            "veryfast",
            "-pix_fmt",
            "yuv420p",
            "-c:a",
            "aac",
            "-shortest",
            str(sources["h264-sdr"]),
        ]
    )
    run(
        [
            ffmpeg,
            "-hide_banner",
            "-loglevel",
            "error",
            "-f",
            "lavfi",
            "-i",
            "testsrc2=duration=2:size=320x180:rate=25",
            "-f",
            "lavfi",
            "-i",
            "sine=frequency=440:sample_rate=48000:duration=2",
            "-c:v",
            "mpeg4",
            "-q:v",
            "5",
            "-c:a",
            "libmp3lame",
            "-shortest",
            str(sources["mpeg4-simple-avi"]),
        ]
    )
    run(
        [
            ffmpeg,
            "-hide_banner",
            "-loglevel",
            "error",
            "-f",
            "lavfi",
            "-i",
            "testsrc2=duration=2:size=320x180:rate=24",
            "-vf",
            "format=yuv420p10le",
            "-c:v",
            "libx265",
            "-preset",
            "ultrafast",
            "-x265-params",
            "hdr10=1:repeat-headers=1:pools=1:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc",
            "-color_primaries",
            "bt2020",
            "-color_trc",
            "smpte2084",
            "-colorspace",
            "bt2020nc",
            "-an",
            str(sources["hevc-main10-hdr10"]),
        ]
    )

    outputs: dict[str, Path] = {}
    for control in sources:
        destination = output / f"output-{control}"
        destination.mkdir()
        outputs[control] = destination

    filters = {
        "h264-sdr": "scale=-2:'min(1080,ih)',format=yuv420p",
        "mpeg4-simple-avi": "scale=-2:'min(1080,ih)',format=yuv420p",
        "hevc-main10-hdr10": (
            "scale=-2:'min(1080,ih)',"
            "zscale=tin=smpte2084:min=bt2020nc:pin=bt2020:t=linear:npl=100,"
            "format=gbrpf32le,tonemap=tonemap=hable:desat=0,"
            "zscale=p=bt709:t=bt709:m=bt709:r=tv,format=yuv420p"
        ),
    }
    for control, source in sources.items():
        destination = outputs[control]
        run(
            [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                str(source),
                "-map",
                "0:v:0",
                "-map",
                "0:a:0?",
                "-vf",
                filters[control],
                "-c:v",
                "libx264",
                "-preset",
                "veryfast",
                "-b:v",
                "8000k",
                "-maxrate",
                "12000k",
                "-bufsize",
                "16000k",
                "-profile:v",
                "high",
                "-force_key_frames",
                "expr:gte(t,n_forced*2)",
                "-c:a",
                "aac",
                "-ac",
                "2",
                "-b:a",
                "160k",
                "-muxdelay",
                "0",
                "-muxpreload",
                "0",
                "-f",
                "hls",
                "-hls_time",
                "2",
                "-hls_playlist_type",
                "event",
                "-hls_flags",
                "independent_segments+temp_file",
                "-hls_segment_type",
                "mpegts",
                "-hls_segment_filename",
                str(destination / "seg%05d.ts"),
                "-start_number",
                "0",
                str(destination / "index.m3u8"),
            ]
        )

    results = []
    for control, source in sources.items():
        destination = outputs[control]
        playlist = destination / "index.m3u8"
        framemd5 = run(
            [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                str(playlist),
                "-map",
                "0:v:0",
                "-f",
                "framemd5",
                "-",
            ],
            capture=True,
        )
        results.append(
            {
                "id": control,
                "source_sha256": sha256_file(source),
                "source_probe": video_probe(ffprobe, source),
                "playlist_sha256": sha256_file(playlist),
                "segment_sha256": sha256_file(destination / "seg00000.ts"),
                "decoded_framemd5_sha256": sha256_bytes(framemd5),
                "output_probe": video_probe(ffprobe, playlist),
            }
        )
    return results


def observed_build(ffmpeg: str) -> dict[str, str]:
    version_output = run([ffmpeg, "-version"], capture=True, combine_stderr=True)
    first_line = version_output.decode("utf-8").splitlines()[0]
    prefix = "ffmpeg version "
    if not first_line.startswith(prefix):
        raise ValueError("cannot parse FFmpeg version output")
    return {
        "ffmpeg_version": first_line[len(prefix) :].split()[0],
        "ffmpeg_binary_sha256": sha256_file(Path(ffmpeg)),
        "ffmpeg_buildconf_sha256": sha256_bytes(
            run([ffmpeg, "-buildconf"], capture=True, combine_stderr=True)
        ),
        "generator_sha256": sha256_file(Path(__file__)),
    }


def verify(evidence_path: Path, build: dict[str, str], controls: list[dict[str, str]]) -> None:
    with evidence_path.open("rb") as document:
        evidence = tomllib.load(document)
    mismatches = []
    for field, actual in build.items():
        if evidence.get(field) != actual:
            mismatches.append(
                {"field": field, "expected": evidence.get(field), "actual": actual}
            )
    expected_controls = {control["id"]: control for control in evidence["controls"]}
    actual_controls = {control["id"]: control for control in controls}
    if set(expected_controls) != set(actual_controls):
        mismatches.append(
            {
                "field": "control_ids",
                "expected": sorted(expected_controls),
                "actual": sorted(actual_controls),
            }
        )
    for identifier in sorted(set(expected_controls) & set(actual_controls)):
        for field, actual in actual_controls[identifier].items():
            if expected_controls[identifier].get(field) != actual:
                mismatches.append(
                    {
                        "field": f"{identifier}.{field}",
                        "expected": expected_controls[identifier].get(field),
                        "actual": actual,
                    }
                )
    if mismatches:
        raise ValueError(json.dumps({"verified": False, "mismatches": mismatches}))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("output", type=Path, help="new directory for generated media")
    parser.add_argument("--verify", type=Path, metavar="EVIDENCE_TOML")
    arguments = parser.parse_args()
    ffmpeg = shutil.which("ffmpeg")
    ffprobe = shutil.which("ffprobe")
    if ffmpeg is None or ffprobe is None:
        parser.error("ffmpeg and ffprobe must be on PATH")
    try:
        controls = generate(arguments.output, ffmpeg, ffprobe)
        build = observed_build(ffmpeg)
        if arguments.verify is not None:
            verify(arguments.verify, build, controls)
    except (OSError, KeyError, subprocess.CalledProcessError, ValueError) as error:
        parser.error(str(error))
    print(
        json.dumps(
            {
                "verified": arguments.verify is not None,
                "build": build,
                "controls": controls,
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
