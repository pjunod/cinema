#!/usr/bin/env python3
"""Prove the Live TV producer against a real, endless source.

Run: python3 scripts/live-tv-endless --self-host --out target/live-tv-endless

No household tuner is opened and no production setting is changed. The device
is a fake HDHomeRun served from this machine's own private address, and its
channel is a real FFmpeg encode that never ends -- which is the point. The
constructed-window unit fixtures prove the bookkeeping; only an endless source
proves the producer survives its own playlist rolling over, keeps its scratch
bounded while it does, opens the tuner exactly once, and gives every one of
those resources back when the last reader walks away.

A failed assertion exits nonzero.
"""
from __future__ import annotations

import json
import re
import runpy
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urljoin

ROOT = Path(__file__).resolve().parents[1]
HARNESS = runpy.run_path(str(ROOT / "scripts/ui-baseline"), run_name="live_tv_endless_harness")

DEVICE_PORT = 80             # discover.json and lineup.json, as a real device serves them
TUNER_PORT = 5004            # the stream, per pinned_url in crates/plurxd/src/live_tv.rs
DEVICE_ID = "FIXTURE1"
GUIDE_NUMBER = "7.1"
LISTED_SEGMENTS = 6          # MAX_LISTED_SEGMENTS in crates/plurxd/src/live_tv.rs
IDLE_TIMEOUT = 45            # CAPABILITY_IDLE_TIMEOUT
ROLLOVERS = 10
MEDIA_SEQUENCE_TARGET = ROLLOVERS * LISTED_SEGMENTS
READY_DEADLINE = 120
ROLLOVER_DEADLINE = 600
EXPIRY_DEADLINE = IDLE_TIMEOUT + 90


def private_ipv4() -> str:
    """The address the daemon will accept: private, and not loopback."""
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.connect(("192.0.2.1", 80))  # TEST-NET-1; no packet leaves the host
        address = probe.getsockname()[0]
    finally:
        probe.close()
    first, second = (int(part) for part in address.split(".")[:2])
    private = (first == 10 or (first == 172 and 16 <= second <= 31)
               or (first == 192 and second == 168) or (first == 169 and second == 254))
    assert private, "this host address %s is not one the daemon accepts as a tuner" % address
    return address


class Tuner:
    """A fake HDHomeRun whose one channel never stops."""

    def __init__(self, address, ffmpeg, log):
        self.address = address
        self.ffmpeg = ffmpeg
        self.log = log
        self.gets = []
        self.streams = []
        self.lock = threading.Lock()
        harness = self

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, *_args):
                pass

            def _json(self, payload):
                body = json.dumps(payload).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                with harness.lock:
                    harness.gets.append(self.path)
                base = "http://%s:%d" % (harness.address, DEVICE_PORT)
                if self.path.startswith("/discover.json"):
                    self._json({
                        "FriendlyName": "Fixture HDHomeRun", "ModelNumber": "HDFX-4K",
                        "FirmwareName": "hdhomerun_fixture", "FirmwareVersion": "20260326",
                        "DeviceID": DEVICE_ID, "TunerCount": 2,
                        "BaseURL": base, "LineupURL": base + "/lineup.json",
                    })
                    return
                if self.path.startswith("/lineup.json"):
                    self._json([{"GuideNumber": GUIDE_NUMBER, "GuideName": "Endless Fixture",
                                 "URL": "%s/auto/v%s" % (base, GUIDE_NUMBER)}])
                    return
                if self.path.startswith("/auto/v%s" % GUIDE_NUMBER):
                    harness.stream(self)
                    return
                self.send_error(404)

        # The daemon reads discover.json and lineup.json from port 80 and opens
        # the stream on 5004, exactly as a real HDHomeRun serves them, so the
        # fixture has to answer on both rather than on one convenient port.
        self.servers = []
        self.threads = []
        for port in (DEVICE_PORT, TUNER_PORT):
            server = ThreadingHTTPServer(("0.0.0.0", port), Handler)
            server.daemon_threads = True
            self.servers.append(server)
            self.threads.append(threading.Thread(target=server.serve_forever, daemon=True))

    def stream(self, handler):
        """Pipe a live encode until the reader goes away. It has no end."""
        with open(self.log, "ab") as errors:
            process = subprocess.Popen([
                self.ffmpeg, "-hide_banner", "-loglevel", "error",
                "-re", "-f", "lavfi", "-i", "testsrc2=size=640x360:rate=25",
                "-re", "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000",
                "-c:v", "libx264", "-preset", "ultrafast", "-tune", "zerolatency",
                "-pix_fmt", "yuv420p", "-g", "50", "-keyint_min", "50", "-sc_threshold", "0",
                "-c:a", "aac", "-b:a", "96k", "-f", "mpegts", "pipe:1",
            ], stdout=subprocess.PIPE, stderr=errors)
        with self.lock:
            self.streams.append(process)
        handler.send_response(200)
        handler.send_header("Content-Type", "video/mp2t")
        handler.send_header("Connection", "close")
        handler.end_headers()
        try:
            while True:
                chunk = process.stdout.read(65536)
                if not chunk:
                    break
                handler.wfile.write(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            process.terminate()
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                process.kill()

    def start(self):
        for thread in self.threads:
            thread.start()

    def stop(self):
        for server in self.servers:
            server.shutdown()
        with self.lock:
            for process in self.streams:
                if process.poll() is None:
                    process.kill()

    @property
    def tuner_gets(self):
        with self.lock:
            return [path for path in self.gets if path.startswith("/auto/")]


class Client:
    def __init__(self, base_url, token):
        self.base = base_url.rstrip("/")
        self.token = token

    def api(self, path, method="GET", body=None, authenticated=True, timeout=30):
        headers = {"Content-Type": "application/json"}
        if authenticated:
            headers["Authorization"] = "Bearer " + self.token
        request = urllib.request.Request(
            self.base + "/api/v1" + path, method=method,
            data=json.dumps(body).encode() if body is not None else None, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                raw = response.read().decode()
                return json.loads(raw) if raw.strip() else {}
        except urllib.error.HTTPError as error:
            # A bare status tells you nothing about which contract was broken.
            detail = error.read().decode(errors="replace")[:400]
            raise AssertionError("%s %s -> %s %s" % (method, path, error.code, detail)) from None

    def raw(self, url, timeout=30):
        """Capability resources carry their own authority and never the bearer."""
        with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as response:
            return response.status, response.read()


def wait_ready(client, expect_enabled=True, seen=None):
    """Refresh readiness until every check the current state can satisfy passes.

    Before Live TV is enabled the enablement check is expected to fail; the
    device, configuration and graph checks are the ones that must come up.
    """
    deadline = time.monotonic() + READY_DEADLINE
    last = None
    while time.monotonic() < deadline:
        readiness = client.api("/live-tv/readiness/refresh", "POST")
        checks = readiness.get("checks", [])
        failing = [c for c in checks if not c.get("ready")]
        if readiness.get("ready"):
            return readiness
        if not expect_enabled and all("enabl" in (c.get("id", "") + c.get("message", "")).lower()
                                      for c in failing) and failing:
            return readiness
        last = readiness
        time.sleep(2)
    failing = [c for c in (last or {}).get("checks", []) if not c.get("ready")]
    raise AssertionError("readiness never came up: %s; the fixture device saw %s"
                         % (json.dumps(failing), json.dumps(seen() if seen else None)))


def playlist_facts(text):
    sequence = int(re.search(r"#EXT-X-MEDIA-SEQUENCE:(\d+)", text)[1])
    segments = [line.strip() for line in text.splitlines()
                if line.strip() and not line.startswith("#")]
    durations = [float(m) for m in re.findall(r"#EXTINF:([0-9.]+)", text)]
    return sequence, segments, (sum(durations) / len(durations) if durations else 0.0)


def scratch_dirs(root):
    return [p for p in root.rglob("*") if p.is_dir() and "live" in p.name.lower()]


def scratch_bytes(root):
    if not root or not root.exists():
        return 0
    return sum(p.stat().st_size for d in scratch_dirs(root) for p in d.rglob("*") if p.is_file())


def main(argv):
    args = HARNESS["parse_args"](argv)
    if not args.self_host:
        raise SystemExit("live-tv-endless only accepts --self-host; production servers are not test fixtures")
    HARNESS["preflight"](args)
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)

    address = private_ipv4()
    tuner = Tuner(address, args.ffmpeg, out / "ffmpeg.log")
    tuner.start()
    # Prove the fixture device answers before blaming the daemon for not
    # reaching it: a readiness failure otherwise reads the same either way.
    for attempt in range(20):
        try:
            with urllib.request.urlopen(
                    "http://%s:%d/discover.json" % (address, DEVICE_PORT), timeout=2) as probe:
                assert json.loads(probe.read().decode())["DeviceID"] == DEVICE_ID
            break
        except Exception:
            if attempt == 19:
                raise AssertionError("the fixture HDHomeRun never answered on %s:%d"
                                     % (address, DEVICE_PORT))
            time.sleep(0.5)
    host = HARNESS["SelfHost"](args)
    host.start()
    client = Client(host.base_url, host.token)
    data_root = Path(host.data_dir) if getattr(host, "data_dir", None) else None
    evidence = {"device_address": address}

    try:
        settings = client.api("/settings")
        node = client.api("/server")["node_id"]
        saved = client.api("/settings", "PUT", {
            "live_tv_config_generation": settings["live_tv_config_generation"],
            "live_tv_device_ipv4": address, "live_tv_owner_node_id": node,
            "live_tv_max_sessions": 2, "live_tv_output_height": 720,
        })
        evidence["configured_generation"] = saved["live_tv_config_generation"]
        # The server rechecks readiness when it is asked to enable, so ask for
        # it first — this is the order the Developer screen walks an operator
        # through, and enabling a device nobody has probed is not a test of
        # anything. Enabling is generation-fenced, so a conflict is refetched
        # rather than forced.
        wait_ready(client, expect_enabled=False, seen=lambda: list(tuner.gets))
        for attempt in range(5):
            generation = client.api("/settings")["live_tv_config_generation"]
            try:
                client.api("/settings", "PUT", {
                    "live_tv_config_generation": generation, "live_tv_enabled": True})
                break
            except AssertionError as conflict:
                if "409" not in str(conflict) or attempt == 4:
                    raise
                time.sleep(1)
        evidence["enabled_generation"] = client.api("/settings")["live_tv_config_generation"]
        wait_ready(client, seen=lambda: list(tuner.gets))

        lineup = client.api("/live-tv/channels")
        channel = next(c for c in lineup["channels"] if c["guide_number"] == GUIDE_NUMBER)
        started = client.api("/live-tv/channels/%s/sessions" % channel["id"], "POST")
        capability = started["session_id"]
        evidence["capability_opened"] = True

        playlist_url = "%s/api/v1/live-tv/sessions/%s/index.m3u8" % (host.base_url, capability)
        first_sequence = None
        sequence = 0
        widest_window = 0
        widest_scratch = 0
        fetched = set()
        deadline = time.monotonic() + ROLLOVER_DEADLINE
        segment_seconds = 0.0
        rolled = False
        while time.monotonic() < deadline:
            status, body = client.raw(playlist_url)
            assert status == 200, "playlist answered %s" % status
            sequence, segments, segment_seconds = playlist_facts(body.decode())
            if first_sequence is None:
                first_sequence = sequence
            widest_window = max(widest_window, len(segments))
            assert len(segments) <= LISTED_SEGMENTS, (
                "the live window grew to %d segments; the producer must publish at most %d"
                % (len(segments), LISTED_SEGMENTS))
            for name in segments[-2:]:
                if name in fetched:
                    continue
                code, chunk = client.raw(urljoin(playlist_url, name))
                assert code == 200 and chunk, "segment %s answered %s with %d bytes" % (name, code, len(chunk))
                fetched.add(name)
            widest_scratch = max(widest_scratch, scratch_bytes(data_root))
            if sequence - first_sequence >= MEDIA_SEQUENCE_TARGET:
                rolled = True
                break
            time.sleep(max(0.5, (segment_seconds / 2) or 1.0))
        assert rolled, ("only %d segments rolled past in %ds; needed %d"
                        % (sequence - (first_sequence or 0), ROLLOVER_DEADLINE, MEDIA_SEQUENCE_TARGET))

        evidence.update({
            "first_media_sequence": first_sequence,
            "last_media_sequence": sequence,
            "segments_rolled": sequence - first_sequence,
            "window_rollovers": (sequence - first_sequence) / LISTED_SEGMENTS,
            "widest_published_window": widest_window,
            "segment_seconds": round(segment_seconds, 3),
            "distinct_segments_read": len(fetched),
            "peak_scratch_bytes": widest_scratch,
        })

        opens = tuner.tuner_gets
        assert len(opens) == 1, "the tuner was opened %d times: %s" % (len(opens), opens)
        evidence["tuner_opens"] = len(opens)
        (out / "endless.json").write_text(json.dumps(evidence, indent=2) + "\n")

        # Walk away without a DELETE and then actually stay away: polling the
        # playlist to watch for expiry is itself a read, and a capability being
        # read is not idle. Wait out the budget in silence, then ask once.
        started_waiting = time.monotonic()
        time.sleep(IDLE_TIMEOUT + 20)
        expired = False
        while time.monotonic() - started_waiting < EXPIRY_DEADLINE:
            try:
                client.raw(playlist_url, timeout=10)
            except urllib.error.HTTPError as error:
                if error.code in (404, 410):
                    expired = True
                    break
                raise
            # One probe already renewed nothing that was gone; give the sweeper
            # a further quiet interval rather than polling it awake.
            time.sleep(IDLE_TIMEOUT + 10)
        assert expired, ("the orphaned capability was still served %ds after its last read"
                         % round(time.monotonic() - started_waiting))
        evidence["orphan_expired_after_seconds"] = round(time.monotonic() - started_waiting, 1)

        time.sleep(5)
        alive = [p for p in tuner.streams if p.poll() is None]
        assert not alive, "%d encoder processes outlived the expired capability" % len(alive)
        leftover = scratch_bytes(data_root)
        assert leftover == 0, "%d bytes of live scratch survived expiry" % leftover
        evidence["scratch_bytes_after_expiry"] = leftover

        (out / "endless.json").write_text(json.dumps(evidence, indent=2) + "\n")
        print("PASS %d real window rollovers (%d segments, %d read); window never exceeded %d; "
              "one tuner GET; orphan expired in %.0fs and released every resource"
              % (evidence["window_rollovers"], evidence["segments_rolled"],
                 evidence["distinct_segments_read"], widest_window,
                 evidence["orphan_expired_after_seconds"]))
        return 0
    finally:
        tuner.stop()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
