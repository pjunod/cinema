#!/usr/bin/env python3
"""Generate original CC0 4K/24 P5 envelope controls from the retained analytic source.

No hardware decode, package installation or qualification occurs here. The
small source's RPU is dimension-independent and generated by the committed
fixture helper; coding and presentation timing are generated afresh.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import struct
import subprocess

FRAMES = 24
WIDTH, HEIGHT, FPS = 3840, 2160, 24


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def run(argv, maximum=2 * 1024 * 1024):
    output = subprocess.run(argv, capture_output=True, timeout=180, check=True)
    if len(output.stdout) > maximum or len(output.stderr) > 2 * 1024 * 1024:
        raise ValueError("fixture command exceeded bounded output")
    return output.stdout


def helper_at(path):
    loader = importlib.machinery.SourceFileLoader("linux_p5_analytic_source", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def upscale(raw):
    """Integer nearest-neighbour expansion preserves every analytic code value."""
    output = bytearray()
    offset = 0
    for width, height in [(320, 180), (160, 90), (160, 90)]:
        for y in range(height):
            row = raw[offset + y * width * 2:offset + (y + 1) * width * 2]
            expanded = b"".join(row[x:x + 2] * 12 for x in range(0, len(row), 2))
            output.extend(expanded * 12)
        offset += width * height * 2
    if offset != len(raw) or len(output) != WIDTH * HEIGHT * 3:
        raise ValueError("analytic planar expansion size mismatch")
    return output


def extract_rpus(data, packets):
    rpus = []
    for packet in packets:
        start, size = int(packet["pos"]), int(packet["size"])
        sample = data[start:start + size]
        offset = 0
        found = []
        while offset < len(sample):
            length = struct.unpack_from(">I", sample, offset)[0]
            offset += 4
            nal = sample[offset:offset + length]
            if len(nal) != length or length < 2:
                raise ValueError("invalid retained sample NAL")
            if (nal[0] >> 1) & 63 == 62:
                found.append(nal)
            offset += length
        if len(found) != 1:
            raise ValueError("each retained coded AU must have exactly one fresh RPU")
        rpus.append(found[0])
    if len(rpus) != FRAMES:
        raise ValueError("retained fresh AU count mismatch")
    return rpus


def declare_uhd24_level(data):
    # Dolby Online Delivery Kit table: level06 covers 3840x2160@24.
    # https://ott.dolby.com/OnDelKits/Dolby_Vision_Online_Delivery_Kit/v1/Documentation/Specs/Visio_Profiles/help_files/topics/c_dovi_levels.html
    marker = b"dvcC" + bytes((1, 0, 10, 13))
    if data.count(marker) != 1:
        raise ValueError("unexpected generated Dolby configuration record")
    offset = data.index(marker) + 7
    result = bytearray(data)
    result[offset] = (6 << 3) | 5  # P5 level06; current BL+RPU, no EL.
    return bytes(result)


def generate(ffmpeg, ffprobe, output):
    repo = Path(__file__).resolve().parent.parent
    helper_path = repo / "scripts/generate-macos-extension-fixtures"
    fresh = repo / "crates/plurxd/fixtures/macos-processing/strict_p5_fresh.mp4"
    authority = json.loads((fresh.parent / "strict-p5.json").read_text())
    expected = next(case["sha256"] for case in authority["cases"] if case["id"] == "fresh")
    if sha(fresh) != expected:
        raise ValueError("retained CC0 fresh source checksum mismatch")
    if (not output.is_absolute() or output.exists() or output.resolve().is_relative_to(repo)
            or any(output.resolve().is_relative_to(Path(root)) for root in
                   ["/Applications", "/Library", "/System", "/usr", "/opt"])):
        raise ValueError("output must be a new absolute directory outside the checkout")
    helper = helper_at(helper_path)
    packets = json.loads(run([str(ffprobe), "-v", "error", "-threads", "2", "-show_packets", "-of", "json", str(fresh)]))["packets"]
    rpus = extract_rpus(fresh.read_bytes(), packets)
    output.mkdir(parents=True)
    raw = output / "pattern.yuv"
    with raw.open("wb") as stream:
        for frame in range(FRAMES):
            stream.write(upscale(helper.frame_bytes("p5", frame)))
    base = output / "base.mp4"
    coding = "crf=8:vbv-maxrate=20000:vbv-bufsize=20000:level-idc=5.1:no-sao=1:no-deblock=1"
    argv = [str(ffmpeg), "-nostdin", "-v", "error", "-threads", "2", "-f", "rawvideo",
            "-pix_fmt", "yuv420p10le", "-s", f"{WIDTH}x{HEIGHT}", "-r", str(FPS),
            "-color_range", "pc", "-color_trc", "smpte2084", "-color_primaries", "bt2020",
            "-colorspace", "ipt-c2", "-i", str(raw), "-vf", "setsar=1", "-frames:v", str(FRAMES),
            "-c:v", "libx265", "-x265-params",
            f"{coding}:repeat-headers=1:aud=1:keyint=12:bframes=2:pools=1:frame-threads=1:colorprim=9:transfer=16:colormatrix=15:range=full",
            "-tag:v", "hvc1", "-f", "mp4", str(base)]
    run(argv)
    base_packets = json.loads(run([str(ffprobe), "-v", "error", "-threads", "2", "-show_packets", "-of", "json", str(base)]))["packets"]
    if len(base_packets) != FRAMES:
        raise ValueError("new 4K source AU count mismatch")
    cases = []
    for name, damaged in [("fresh", None), ("missing_midstream", 12)]:
        selected = list(rpus)
        if damaged is not None:
            selected[damaged] = None
        path = output / f"p5_4k24_{name}.mp4"
        path.write_bytes(declare_uhd24_level(helper.inject_mp4_rpu(base.read_bytes(), selected)))
        cases.append({"id": name, "path": path.name, "sha256": sha(path),
                      "byte_length": path.stat().st_size,
                      "affected_decode_sample": damaged,
                      "negative_max_frames": 10 if damaged is not None else None})
    observed = json.loads(run([str(ffprobe), "-v", "error", "-threads", "2", "-show_frames", "-show_streams", "-of", "json", str(output / cases[0]["path"])]))
    # Use the original verifier with only the explicitly declared new shape/rate.
    helper.WIDTH, helper.HEIGHT, helper.FPS = WIDTH, HEIGHT, FPS
    helper.validate_observed(observed, "p5")
    dovi = [record for record in observed["streams"][0].get("side_data_list", [])
            if record.get("side_data_type") == "DOVI configuration record"]
    if len(dovi) != 1 or dovi[0].get("dv_level") != 6:
        raise ValueError("new 4K24 source must declare Dolby level06")
    (output / "observed.json").write_text(json.dumps(observed, indent=2) + "\n")
    (output / "LICENSE.txt").write_text(helper.LICENSE)
    manifest = {"schema_version": 1, "generator_recipe_version": 1, "license": "CC0-1.0",
                "source_shape": [WIDTH, HEIGHT], "frame_count": FRAMES, "frame_rate": [FPS, 1],
                "source_sample_aspect_ratio": "1:1", "dolby_vision_level": 6, "cases": cases,
                "source_recipe": "integer12x-original-analytic-IPT-P5-with-fresh-current-AU-RPU",
                "source_authority_sha256": expected, "analytic_helper_sha256": sha(helper_path),
                "generator_sha256": sha(Path(__file__)),
                "tools": {"ffmpeg_sha256": sha(ffmpeg), "ffprobe_sha256": sha(ffprobe)},
                "coding": coding, "qualification": "generated-source-only"}
    (output / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    return manifest


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ffmpeg", type=Path, required=True)
    parser.add_argument("--ffprobe", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if any(not path.is_absolute() or not path.is_file() for path in [args.ffmpeg, args.ffprobe]):
        parser.error("tools must be explicit absolute files")
    print(json.dumps(generate(args.ffmpeg, args.ffprobe, args.output), sort_keys=True))
