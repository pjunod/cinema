#!/usr/bin/env bash
# Run one bounded libFuzzer campaign and record what it did.
#
#   scripts/fuzz-campaign <target> [seconds]                  # run, then summarise
#   scripts/fuzz-campaign --summarize <target> <log> <status>  # summarise an existing log
#
# The four parser targets live in their own cargo-fuzz package, fuzz/parsers/,
# so a run is `cargo fuzz run --fuzz-dir fuzz/parsers <target>` over the seed
# corpus in fuzz/parsers/corpus/<target>/. `inspect_sup` stays in fuzz/ and is
# run by its own workflow step; `--summarize` reads that step's log, and its
# status is the step's recorded outcome (0 clean, non-zero a finding).
#
# A campaign's budget is time, not coverage, so the summary is what makes a
# target that has stopped finding new edges visible: it prints the number of
# executed inputs, the corpus size before and after (libFuzzer writes every
# input that reached new coverage back into the first corpus directory), and
# the outcome. With $GITHUB_STEP_SUMMARY set, each invocation appends its own
# header and one-row Markdown table: every job (and every step) has a summary
# file of its own, so there is nothing to share a header with. The run's
# summary page shows all five campaigns, each under its job's heading.
#
# The exit status is the fuzzer's: a crash, a timeout, a leak or an
# out-of-memory finding is non-zero and its artefact is under
# fuzz/parsers/artifacts/<target>/. The workflow keeps that status behind
# `continue-on-error` so the log and artefact upload always run, then fails the
# job from the recorded outcome. No `-e`: the fuzzer's failure must still
# reach the summary, and `PIPESTATUS[0]` carries it past `tee`.
set -uo pipefail

TOOLCHAIN="${PLURX_FUZZ_TOOLCHAIN:-nightly-2026-08-01}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FUZZ_DIR="fuzz/parsers"

# The PGS target keeps its corpus and artefacts in fuzz/; the parser targets
# keep theirs in fuzz/parsers/.
fuzz_dir_for() {
  if [[ "$1" == "inspect_sup" ]]; then
    echo "fuzz"
  else
    echo "$FUZZ_DIR"
  fi
}

summarize() {
  local target="$1" log="$2" status="$3" before="$4"
  local dir corpus after executions size outcome
  dir="$(fuzz_dir_for "$target")"
  corpus="$ROOT/$dir/corpus/$target"
  after="$(find "$corpus" -type f 2>/dev/null | wc -l | tr -d ' ')"
  size="$(du -sk "$corpus" 2>/dev/null | cut -f1)"
  # `-print_final_stats=1` prints `stat::number_of_executed_units: N` whether
  # the budget ran out or a finding stopped the run. Without it, `Done N runs`
  # is libFuzzer's line for a budget that ran out, and a campaign that stopped
  # on a finding has only its last `#N` status line.
  executions="$(grep -Eo 'stat::number_of_executed_units: *[0-9]+' "$log" 2>/dev/null \
    | tail -1 | grep -Eo '[0-9]+$')"
  if [[ -z "$executions" ]]; then
    executions="$(grep -Eo 'Done [0-9]+ runs' "$log" 2>/dev/null | tail -1 | grep -Eo '[0-9]+')"
  fi
  if [[ -z "$executions" ]]; then
    executions="$(grep -Eo '^#[0-9]+' "$log" 2>/dev/null | tail -1 | tr -d '#')"
  fi
  executions="${executions:-0}"
  if [[ "$status" == "0" ]]; then
    outcome="budget spent, no finding"
  else
    outcome="finding (exit $status); see $dir/artifacts/$target"
  fi
  local row="| \`$target\` | $executions | $before → $after files (${size:-?} KiB) | $outcome |"
  echo "fuzz-campaign: $row"
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    {
      echo "| Target | Executions | Corpus before → after | Outcome |"
      echo "|---|---|---|---|"
      echo "$row"
    } >> "$GITHUB_STEP_SUMMARY"
  fi
}

if [[ "${1:-}" == "--summarize" ]]; then
  [[ $# -eq 4 ]] || { echo "usage: $0 --summarize <target> <log> <status>" >&2; exit 2; }
  summarize "$2" "$3" "$4" "?"
  exit 0
fi

TARGET="${1:-}"
SECONDS_BUDGET="${2:-900}"
[[ -n "$TARGET" ]] || { echo "usage: $0 <target> [seconds]" >&2; exit 2; }
CORPUS="$ROOT/$FUZZ_DIR/corpus/$TARGET"
[[ -d "$CORPUS" ]] || { echo "no seed corpus at $FUZZ_DIR/corpus/$TARGET" >&2; exit 2; }

mkdir -p "$ROOT/target/validation"
LOG="$ROOT/target/validation/fuzz-$TARGET.log"
BEFORE="$(find "$CORPUS" -type f | wc -l | tr -d ' ')"

cd "$ROOT"
cargo "+$TOOLCHAIN" fuzz run --fuzz-dir fuzz/parsers "$TARGET" "fuzz/parsers/corpus/$TARGET" \
  -- -max_total_time="$SECONDS_BUDGET" -print_final_stats=1 2>&1 | tee "$LOG"
STATUS="${PIPESTATUS[0]}"

summarize "$TARGET" "$LOG" "$STATUS" "$BEFORE"
exit "$STATUS"
