#!/usr/bin/env python3
"""Build the capability-bound source parser companion without installing it.

The output package has bin/plurx-source-parser.wasm and provenance/manifest.json.
The native macOS FFmpeg package assembler copies both into its normal package.
Offline inputs are checksum-verified exactly like downloaded inputs. Compilation
uses the full pinned Jellyfin patch series; it never uses an ambient FFmpeg tree.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tarfile
import tempfile

SDK_VERSION = "34.0"
SDK_HASHES = {
    ("arm64", "macos"): "9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9",
    ("x86_64", "macos"): "87d27fa8adc68dee59bfbf2e22a6d34ef717c34d6bf1d8af2a56fc929d9ce0eb",
    ("arm64", "linux"): "f7e243dff54d60bcc576e94d6166b69f410f2500ae4a9ceef34315be10e77971",
    ("x86_64", "linux"): "b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4",
}
ABI_ID = "plurx-source-wasi-p1-v1-wasmtime-49.0.2"
WASI_LIBC_COMMIT = "2e6fb9d8ee0cdf9e431fbcabe8af3115de000a13"
WASI_LIBC_SHA256 = "f25ccd526235f7b351f9b49451b75fdd8e23250b9ad8fc9f8f2a19f517a4892f"
LLVM_COMMIT = "895aa2c896ada719451be2e3673c83da8ddf1141"


def runtime_provenance(provenance, archive=None):
    recipe = package_recipe()
    runtime = provenance / "runtime"
    runtime.mkdir()
    url = f"https://codeload.github.com/WebAssembly/wasi-libc/tar.gz/{WASI_LIBC_COMMIT}"
    recipe.acquire(archive, url, WASI_LIBC_SHA256, runtime / "wasi-libc-source.tar.gz")
    notices = Path(__file__).with_name("macos-source-parser-licenses")
    for item in notices.iterdir():
        if not item.is_file() or item.is_symlink():
            raise ValueError("unsafe compiler runtime license notice")
        shutil.copyfile(item, runtime / item.name)
    facts = {"wasi_libc_commit": WASI_LIBC_COMMIT, "wasi_libc_source_url": url,
             "wasi_libc_source_sha256": WASI_LIBC_SHA256, "llvm_commit": LLVM_COMMIT,
             "llvm_source_url": f"https://github.com/llvm/llvm-project/tree/{LLVM_COMMIT}",
             "license_sha256": {item.name: recipe.digest(item) for item in notices.iterdir()}}
    (runtime / "manifest.json").write_text(json.dumps(facts, indent=2, sort_keys=True) + "\n")
    return facts


def package_recipe():
    path = Path(__file__).with_name("build-macos-video-ffmpeg")
    loader = importlib.machinery.SourceFileLoader("source_parser_package", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def extract(archive, output):
    output.mkdir()
    with tarfile.open(archive) as tar:
        for member in tar:
            original = Path(member.name)
            if original.is_absolute() or ".." in original.parts:
                raise ValueError("unsafe archive path")
            relative = Path(*original.parts[1:])
            if not relative.parts:
                continue
            target = output / relative
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
            elif member.isfile():
                target.parent.mkdir(parents=True, exist_ok=True)
                with tar.extractfile(member) as source, target.open("wb") as dest:
                    shutil.copyfileobj(source, dest)
                target.chmod(member.mode & 0o777)
            elif member.issym():
                linked = Path(member.linkname)
                if linked.is_absolute() or not (target.parent / linked).resolve().is_relative_to(output.resolve()):
                    raise ValueError("unsafe archive symlink")
                target.parent.mkdir(parents=True, exist_ok=True)
                target.symlink_to(linked)
            else:
                raise ValueError("unsupported archive member")


def build(args):
    recipe = package_recipe()
    output = args.output
    if not output.is_absolute() or output.exists():
        raise ValueError("output must be an absolute new package directory")
    if any(output.is_relative_to(Path(p)) for p in ["/Applications", "/Library", "/System", "/usr", "/opt"]):
        raise ValueError("output must not be an installed/global directory")
    arch = {"aarch64": "arm64", "arm64": "arm64", "x86_64": "x86_64"}.get(platform.machine())
    system = {"Darwin": "macos", "Linux": "linux"}.get(platform.system())
    sdk_hash = SDK_HASHES.get((arch, system))
    if not sdk_hash:
        raise ValueError("no pinned SDK for this build host")
    output.mkdir(parents=True)
    provenance = output / "provenance"
    provenance.mkdir()
    runtime = runtime_provenance(provenance, args.wasi_libc_archive)
    with tempfile.TemporaryDirectory(prefix="source-parser-build-") as temporary:
        work = Path(temporary)
        archive = provenance / "jellyfin-ffmpeg-source.tar.gz"
        recipe.acquire(args.source_archive, recipe.SOURCE_URL, recipe.SOURCE_SHA256, archive)
        sdk_archive = work / "wasi-sdk.tar.gz"
        sdk_url = f"https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-{SDK_VERSION}-{arch}-{system}.tar.gz"
        recipe.acquire(args.sdk_archive, sdk_url, sdk_hash, sdk_archive)
        source = work / "source"
        sdk = work / "sdk"
        extract(sdk_archive, sdk)
        sdk_archive.unlink()
        extract(archive, source)
        patch_hashes = {}
        for line in (source / "debian/patches/series").read_text().splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            name = line.split()[0]
            patch = source / "debian/patches" / name
            if not patch.resolve().is_relative_to((source / "debian/patches").resolve()):
                raise ValueError("unsafe source patch path")
            patch_hashes[name] = recipe.digest(patch)
            subprocess.run(["patch", "-p1", "--batch", "--forward", "-i", str(patch)], cwd=source,
                           check=True, stdout=subprocess.DEVNULL, timeout=60)
        env = {"PATH": f"{sdk / 'bin'}:/usr/bin:/bin", "LC_ALL": "C", "SOURCE_DATE_EPOCH": "0"}
        configure = ["./configure", "--cc=clang", "--cxx=clang++", "--ar=llvm-ar", "--nm=llvm-nm",
                     "--ranlib=llvm-ranlib", "--strip=llvm-strip", "--arch=wasm32", "--target-os=none",
                     "--enable-cross-compile", "--disable-pthreads", "--disable-w32threads", "--disable-os2threads",
                     "--disable-inline-asm", "--disable-x86asm", "--enable-simd128", "--disable-autodetect",
                     "--disable-debug", "--disable-doc", "--disable-ffmpeg", "--disable-ffplay", "--disable-encoders",
                     "--disable-muxers", "--disable-network", "--disable-protocols", "--enable-protocol=file",
                     "--enable-gpl", "--enable-version3", "--disable-filters",
                     "--enable-filter=movie,trim,idet,showinfo,scale,format,aresample,anull,null,buffer,buffersink,abuffer,abuffersink",
                     "--extra-cflags=-msimd128 -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_MMAN",
                     "--extra-libs=-lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-mman",
                     "--extra-ldflags=-Wl,-z,stack-size=1048576"]
        with (provenance / "build.log").open("w") as log:
            subprocess.run(configure, cwd=source, env=env, check=True, stdout=log, stderr=log, timeout=180)
            if "#define HAVE_SIMD128 1" not in (source / "config.h").read_text():
                raise ValueError("pinned parser compiler did not enable required standard SIMD128")
            subprocess.run(["make", "-j", str(args.jobs), "ffprobe"], cwd=source, env=env,
                           check=True, stdout=log, stderr=log, timeout=600)
        module = source / "ffprobe"
        if module.stat().st_size > 32 * 1024 * 1024 or module.read_bytes()[:8] != b"\0asm\x01\0\0\0":
            raise ValueError("parser build did not produce a bounded WebAssembly image")
        binary = output / "bin/plurx-source-parser.wasm"
        binary.parent.mkdir()
        shutil.copyfile(module, binary)
        binary.chmod(0o644)
        for name in ["COPYING.GPLv3", "COPYING.LGPLv2.1", "COPYING.LGPLv3", "LICENSE.md", "config.h", "config_components.h"]:
            shutil.copyfile(source / name, provenance / name)
        shutil.copyfile(source / "ffbuild/config.mak", provenance / "config.mak")
        # Runtime/source provenance must not retain private build paths. Resolved
        # source is available through the exact retained archive + patch series.
        log = provenance / "build.log"
        log.write_text(log.read_text().replace(str(work), "/source-parser-build"))
        facts = {"schema_version": 1, "source_commit": recipe.COMMIT, "source_sha256": recipe.SOURCE_SHA256,
                 "source_url": recipe.SOURCE_URL, "source_patch_sha256": patch_hashes,
                 "sdk_version": SDK_VERSION, "sdk_archive_sha256": sdk_hash, "sdk_url": sdk_url,
                 "runtime_source": runtime,
                 "parser_abi": ABI_ID, "module_sha256": recipe.digest(binary), "module_bytes": binary.stat().st_size,
                 "configure": configure, "license": "GPL-3.0-or-later", "runtime_capabilities": ["held-source-read", "bounded-result"],
                 "qualification": "build-only; runtime and behavioral evidence recorded separately"}
        (provenance / "manifest.json").write_text(json.dumps(facts, indent=2, sort_keys=True) + "\n")
    return facts


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--source-archive", type=Path)
    parser.add_argument("--sdk-archive", type=Path)
    parser.add_argument("--wasi-libc-archive", type=Path)
    parser.add_argument("--jobs", type=int, default=2)
    args = parser.parse_args()
    if not 1 <= args.jobs <= 4:
        parser.error("jobs must be between 1 and 4")
    print(json.dumps(build(args), sort_keys=True))


if __name__ == "__main__":
    main()
