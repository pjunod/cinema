#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 --branch BRANCH [--alias BRANCH] [--receipt FILE] --filename NAME --label LABEL --message MESSAGE --fill HEX --json-color COLOR --label-width PX --message-width PX" >&2
  exit 2
}

branch=
alias_branch=
filename=
label=
message=
fill=
json_color=
label_width=
message_width=
receipt=

while (($#)); do
  case "$1" in
    --branch) branch=${2-}; shift 2 ;;
    --alias) alias_branch=${2-}; shift 2 ;;
    --receipt) receipt=${2-}; test -n "$receipt" || usage; shift 2 ;;
    --filename) filename=${2-}; shift 2 ;;
    --label) label=${2-}; shift 2 ;;
    --message) message=${2-}; shift 2 ;;
    --fill) fill=${2-}; shift 2 ;;
    --json-color) json_color=${2-}; shift 2 ;;
    --label-width) label_width=${2-}; shift 2 ;;
    --message-width) message_width=${2-}; shift 2 ;;
    *) usage ;;
  esac
done

for required in branch filename label message fill json_color label_width message_width; do
  test -n "${!required}" || usage
done

git check-ref-format "refs/heads/$branch" >/dev/null
if [[ -n "$alias_branch" ]]; then
  git check-ref-format "refs/heads/$alias_branch" >/dev/null
fi
[[ "$filename" =~ ^[A-Za-z0-9._-]+$ ]] || usage
[[ "$fill" =~ ^#[0-9A-Fa-f]{3,8}$ ]] || usage
[[ "$label_width" =~ ^[0-9]+$ ]] || usage
[[ "$message_width" =~ ^[0-9]+$ ]] || usage
[[ "$label" != *$'\n'* && "$message" != *$'\n'* ]] || usage

xml_escape() {
  sed \
    -e 's/&/\&amp;/g' \
    -e 's/</\&lt;/g' \
    -e 's/>/\&gt;/g' \
    -e 's/"/\&quot;/g' \
    -e "s/'/\&apos;/g"
}

label_xml=$(printf '%s' "$label" | xml_escape)
message_xml=$(printf '%s' "$message" | xml_escape)
total_width=$((label_width + message_width))
label_center=$(awk "BEGIN { print $label_width / 2 }")
message_center=$(awk "BEGIN { print $label_width + ($message_width / 2) }")
remote=$(git remote get-url origin)
badge_dir=$(mktemp -d)
trap 'rm -rf "$badge_dir"' EXIT

cat > "$badge_dir/$filename.svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="$total_width" height="20" role="img" aria-label="$label_xml: $message_xml">
  <title>$label_xml: $message_xml</title>
  <linearGradient id="s" x2="0" y2="100%"><stop offset="0" stop-color="#bbb" stop-opacity=".1"/><stop offset="1" stop-opacity=".1"/></linearGradient>
  <clipPath id="r"><rect width="$total_width" height="20" rx="3" fill="#fff"/></clipPath>
  <g clip-path="url(#r)"><rect width="$label_width" height="20" fill="#555"/><rect x="$label_width" width="$message_width" height="20" fill="$fill"/><rect width="$total_width" height="20" fill="url(#s)"/></g>
  <g fill="#fff" text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="11"><text x="$label_center" y="15" fill="#010101" fill-opacity=".3">$label_xml</text><text x="$label_center" y="14">$label_xml</text><text x="$message_center" y="15" fill="#010101" fill-opacity=".3">$message_xml</text><text x="$message_center" y="14">$message_xml</text></g>
</svg>
SVG
python3 - "$label" "$message" "$json_color" > "$badge_dir/$filename.json" <<'PY'
import json
import sys

json.dump(
    {
        "schemaVersion": 1,
        "label": sys.argv[1],
        "message": sys.argv[2],
        "color": sys.argv[3],
    },
    sys.stdout,
    separators=(",", ":"),
)
sys.stdout.write("\n")
PY

badge_files=("$filename.svg" "$filename.json")
if [[ -n "$receipt" ]]; then
  python3 - "$receipt" > "$badge_dir/$filename-receipt.json" <<'PY_RECEIPT'
from datetime import datetime, timezone
import json
import os
import re
import stat
import sys

MAX_BYTES = 64 * 1024


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def reject_constant(value):
    raise ValueError("nonfinite JSON number")


def identity(receipt, name, length):
    value = receipt[name]
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-fA-F]{%d}" % length, value):
        raise ValueError("invalid " + name)
    return value.lower()


try:
    descriptor = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "rb") as handle:
        before = os.fstat(handle.fileno())
        if not stat.S_ISREG(before.st_mode) or not 0 < before.st_size <= MAX_BYTES:
            raise ValueError("receipt must be a bounded regular JSON file")
        raw = handle.read(MAX_BYTES + 1)
        after = os.fstat(handle.fileno())
    fields = ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns")
    if len(raw) > MAX_BYTES or any(getattr(before, field) != getattr(after, field) for field in fields):
        raise ValueError("receipt changed while reading")
    receipt = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object,
                         parse_constant=reject_constant)
    if not isinstance(receipt, dict) or receipt.get("status") != "passed":
        raise ValueError("receipt must record passed coverage")
    lines = receipt["line_coverage"]
    count, covered = lines["count"], lines["covered"]
    if type(count) is not int or type(covered) is not int or count <= 0 or not 0 <= covered <= count:
        raise ValueError("invalid integer line coverage counters")
    sanitized = {
        "schema": 1,
        "status": "passed",
        "source_commit": identity(receipt, "source_commit", 40),
        "source_sha256": identity(receipt, "source_sha256", 64),
        "report_sha256": identity(receipt, "report_sha256", 64),
        "line_coverage": {"count": count, "covered": covered, "percent": 100 * covered / count},
    }
    if "measured_at_utc" in receipt:
        value = receipt["measured_at_utc"]
        if not isinstance(value, str) or len(value) > 64:
            raise ValueError("invalid measurement timestamp")
        measured = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if measured.utcoffset() is None:
            raise ValueError("measurement timestamp must include its timezone")
        sanitized["measured_at_utc"] = measured.astimezone(timezone.utc).isoformat()
    if "source_epoch" in receipt:
        epoch = receipt["source_epoch"]
        if type(epoch) is not int or not 0 <= epoch < 2**63:
            raise ValueError("invalid source epoch")
        sanitized["source_epoch"] = epoch
except (OSError, ValueError, TypeError, KeyError, OverflowError, RecursionError) as error:
    raise SystemExit("invalid coverage receipt: " + str(error))

json.dump(sanitized, sys.stdout, separators=(",", ":"))
sys.stdout.write("\n")
PY_RECEIPT
  badge_files+=("$filename-receipt.json")
fi

git -C "$badge_dir" init -q
git -C "$badge_dir" config user.name "forgejo-actions[bot]"
git -C "$badge_dir" config user.email "forgejo-actions@noirr.local"
git -C "$badge_dir" add "${badge_files[@]}"
git -C "$badge_dir" commit -q -m "$label badge: $message"

refs=("HEAD:refs/heads/$branch")
if [[ -n "$alias_branch" ]]; then
  refs+=("HEAD:refs/heads/$alias_branch")
fi

if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  auth=$(printf 'x-access-token:%s' "$GITHUB_TOKEN" | base64 | tr -d '\n')
  git -C "$badge_dir" -c http.extraheader="AUTHORIZATION: basic $auth" \
    push --force "$remote" "${refs[@]}"
else
  git -C "$badge_dir" push --force "$remote" "${refs[@]}"
fi
