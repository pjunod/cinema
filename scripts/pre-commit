#!/bin/sh
# plurx pre-commit hook — lint and syntax checks only.
# Install with `make hooks`. Bypass a single commit with `git commit --no-verify`.
#
# Focused tests and the functionality-point validator remain explicit developer
# and CI steps; keeping them out of this hook makes ordinary commits cheap.
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "pre-commit: running lint and syntax checks…"
make precommit-check
