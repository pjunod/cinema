#!/usr/bin/env python3
"""Fold per-pull-request fragment folders back into the pages they render.

Files that every pull request used to edit at one insertion point conflicted
on every pair of open pull requests. Each now has a folder a pull request adds
its own file to, and this folds the folder into the page:

    status.d/*.md               ->  STATUS.md              (rendered in full every time)
    tests/client-fixes.d/*.toml ->  tests/client-fixes.toml (moved in past the bound,
                                                             and all of them at a release)

A pull request edits only the folder. Two places run this:

* **after merge** -- `.github/workflows/fold.yml` runs `scripts/fold --write`
  on every push to `main` and lands the result as a `chore(fold):` pull
  request of its own. Merges into `main` happen one at a time, so this never
  races an open pull request.
* **at release** -- `scripts/release-cut` runs it too, so a release commit
  carries pages that match their folders.

    scripts/fold            # print what would change; exit 1 if anything would
    scripts/fold --write    # rewrite the pages
    scripts/fold --list     # what is folded, and from where
    scripts/fold --publish  # (the fold workflow) write, then land it as a pull request
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import urllib.request
from dataclasses import dataclass
from pathlib import Path
import re
import sys
from typing import Callable

ROOT = Path(__file__).resolve().parents[1]

# -- STATUS.md ----------------------------------------------------------------------

STATUS_DIR = "status.d"
STATUS_PAGE = "STATUS.md"
STATUS_INDEX = "status.d/INDEX.md"
STATUS_NAME_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-[a-z0-9][a-z0-9-]*\.md$")
STATUS_HEADER = """\
# Status — what the agent is working on and where it stands

<!-- Generated by scripts/fold from status.d/; do not edit. Add or update your
effort's own status.d/<YYYY-MM-DD>-<slug>.md instead (status.d/README.md). -->

**Updated:** {updated} · Newest effort first; each entry links to its current ledger.
"""


class FoldError(ValueError):
    """A fragment folder holds something it cannot fold."""


@dataclass(frozen=True)
class StatusEntry:
    path: Path
    date: str
    text: str

    @property
    def is_section(self) -> bool:
        return self.text.startswith("## ")


def status_entries(root: Path) -> list[StatusEntry]:
    """Every effort's entry, newest first by the date in its file name."""

    entries = []
    folder = root / STATUS_DIR
    for path in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        if path.name in {"README.md", "INDEX.md"}:
            continue
        named = STATUS_NAME_RE.match(path.name)
        if named is None:
            raise FoldError(f"{path.relative_to(root)}: name it status.d/<YYYY-MM-DD>-<slug>.md")
        text = path.read_text(encoding="utf-8").strip()
        if not (text.startswith("- ") or text.startswith("## ")):
            raise FoldError(
                f"{path.relative_to(root)}: an entry is one `- **date · title:** …` bullet "
                "or one `## date · title` section"
            )
        entries.append(StatusEntry(path, named.group("date"), text))
    entries.sort(key=lambda entry: (entry.date, entry.path.name), reverse=True)
    return entries


def render_status(root: Path) -> str:
    entries = status_entries(root)
    updated = entries[0].date if entries else "never"
    bullets = [entry.text for entry in entries if not entry.is_section]
    sections = [entry.text for entry in entries if entry.is_section]
    parts = [STATUS_HEADER.format(updated=updated).rstrip("\n")]
    if bullets:
        parts.append("\n".join(bullets))
    parts.extend(sections)
    index = root / STATUS_INDEX
    if index.exists():
        parts.append(index.read_text(encoding="utf-8").strip())
    return "\n\n".join(parts) + "\n"


def render_status_fold(root: Path, everything: bool) -> tuple[str, list[str]]:
    return render_status(root), []


def status_guard(before: str, after: str) -> str | None:
    return None if before == after else f"{STATUS_PAGE} changed; it is generated from {STATUS_DIR}/"


# -- tests/client-fixes.toml ----------------------------------------------------------

CLIENT_FIXES = "tests/client-fixes.toml"
CLIENT_FIXES_DIR = "tests/client-fixes.d"
# Past this many files the folder is folded into the ledger after merge. Small
# enough that the folder stays a short list, large enough that most merges add
# a row without a fold pull request following them.
CLIENT_FIXES_BOUND = 20
_FIXES_ROW_RE = re.compile(r"(?m)^\[\[fixes\]\]\s*$")


def render_client_fixes(root: Path, everything: bool) -> tuple[str, list[str]]:
    """The ledger with the folder's rows moved in at its top, and the files that empties."""

    ledger = root / CLIENT_FIXES
    text = ledger.read_text(encoding="utf-8") if ledger.exists() else ""
    folder = root / CLIENT_FIXES_DIR
    fragments = sorted(folder.glob("*.toml")) if folder.is_dir() else []
    if not fragments or (not everything and len(fragments) <= CLIENT_FIXES_BOUND):
        return text, []
    header = re.search(r"(?m)^enforce_after\s*=.*\n", text) or re.search(r"(?m)^version\s*=.*\n", text)
    if header is None:
        raise FoldError(f"{CLIENT_FIXES} has no version/enforce_after header to fold under")
    rows = []
    for fragment in fragments:
        body = fragment.read_text(encoding="utf-8").strip()
        if not _FIXES_ROW_RE.search(body):
            raise FoldError(f"{fragment.relative_to(root)} holds no [[fixes]] row")
        rows.append(body)
    cut = header.end()
    folded = text[:cut] + "\n" + "\n\n".join(rows) + "\n" + text[cut:]
    return folded, [str(fragment.relative_to(root)) for fragment in fragments]


def client_fixes_guard(before: str, after: str) -> str | None:
    added = len(_FIXES_ROW_RE.findall(after)) - len(_FIXES_ROW_RE.findall(before))
    if added > 0:
        return (f"{CLIENT_FIXES} gained {added} [[fixes]] row{'s' if added > 1 else ''}; "
                f"add new rows as a file of their own in {CLIENT_FIXES_DIR}/")
    return None


# -- the folds ------------------------------------------------------------------------


@dataclass(frozen=True)
class Fold:
    name: str
    source: str
    page: str
    # (root, fold everything) -> (the page's new text, fragment files it absorbed)
    render: Callable[[Path, bool], tuple[str, list[str]]]
    # (page at the merge base, page now) -> why a pull request may not make that edit
    guard: Callable[[str, str], str | None]


FOLDS = (
    Fold("status", f"{STATUS_DIR}/", STATUS_PAGE, render_status_fold, status_guard),
    Fold("client-fixes", f"{CLIENT_FIXES_DIR}/", CLIENT_FIXES, render_client_fixes, client_fixes_guard),
)


def changes(root: Path, everything: bool = False) -> tuple[dict[str, str], list[str]]:
    """({page: new contents}, [fragment files to delete]) for every fold with work to do."""

    pages, removed = {}, []
    for fold in FOLDS:
        rendered, absorbed = fold.render(root, everything)
        page = root / fold.page
        if not page.exists() or page.read_text(encoding="utf-8") != rendered:
            pages[fold.page] = rendered
        removed.extend(absorbed)
    return pages, removed


# -- publishing the fold (the after-merge workflow) --------------------------------

FOLD_BRANCH = "fold/main"
FOLD_TITLE = "chore(fold): fold fragment folders into their pages"
FOLD_BODY = (
    "Generated by `.github/workflows/fold.yml` after a merge into `main`: "
    "`scripts/fold --write` rewrote the pages folded from their fragment folders "
    "(`scripts/fold --list`). Nothing here is written by hand; the next fold "
    "replaces this branch.\n\nChangelog: none — generated pages"
)


def _api(base: str, token: str, method: str, path: str, payload: dict | None = None):
    request = urllib.request.Request(
        f"{base}/api/v1{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        method=method,
        headers={"Authorization": f"token {token}", "Content-Type": "application/json",
                 "Accept": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        body = response.read()
    return json.loads(body) if body else None


def publish(root: Path, paths: list[str]) -> int:
    """Commit the folded pages on `fold/main` and land them through a pull request.

    The pull request goes through the same paperwork and fast lane as any
    other and merges itself when its checks pass. The token must belong to an
    account whose pushes start workflows (a bot user, not the job's own
    token), or the pull request would never be checked and never merge.
    """

    token = os.environ.get("FOLD_BOT_TOKEN", "")
    server = os.environ.get("GITHUB_SERVER_URL", "").rstrip("/")
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    if not token:
        print("::notice::fold: FOLD_BOT_TOKEN is not set, so the folded pages were not "
              "published; run `scripts/fold --write` and land them by hand (status.d/README.md)")
        return 0
    if not server or not repo:
        print("fold: --publish needs GITHUB_SERVER_URL and GITHUB_REPOSITORY", file=sys.stderr)
        return 2

    def git(*args: str) -> None:
        subprocess.run(["git", *args], cwd=root, check=True)

    git("add", "-A", "--", *paths)
    git("-c", "user.name=plurx fold", "-c", "user.email=fold@noreply.invalid",
        "commit", "-q", "-m", FOLD_TITLE, "-m", FOLD_BODY)
    header = f"http.extraHeader=Authorization: token {token}"
    # The token reaches git through its environment, never its arguments.
    env = {**os.environ, "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "http.extraHeader",
           "GIT_CONFIG_VALUE_0": header.split("=", 1)[1]}
    subprocess.run(["git", "push", "--force", f"{server}/{repo}.git", f"HEAD:refs/heads/{FOLD_BRANCH}"],
                   cwd=root, check=True, env=env)
    owner, name = repo.split("/", 1)
    open_pulls = _api(server, token, "GET", f"/repos/{owner}/{name}/pulls?state=open&limit=50") or []
    pull = next((item for item in open_pulls
                 if (item.get("head") or {}).get("ref") == FOLD_BRANCH), None)
    if pull is None:
        pull = _api(server, token, "POST", f"/repos/{owner}/{name}/pulls",
                    {"base": "main", "head": FOLD_BRANCH, "title": FOLD_TITLE, "body": FOLD_BODY})
    number = pull["number"]
    # Forgejo drops the merge template's body on an API merge, so the message
    # (and with it the Changelog field) is passed explicitly.
    _api(server, token, "POST", f"/repos/{owner}/{name}/pulls/{number}/merge",
         {"Do": "merge", "merge_when_checks_succeed": True,
          "MergeTitleField": f"Merge pull request '{FOLD_TITLE}' (#{number}) from {FOLD_BRANCH} into main",
          "MergeMessageField": FOLD_BODY})
    print(f"fold: pull request #{number} carries {', '.join(paths)} and merges when its checks pass")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--write", action="store_true", help="rewrite the folded pages")
    parser.add_argument("--list", action="store_true", help="say what is folded from where")
    parser.add_argument("--all", action="store_true",
                        help="fold every fragment folder completely, whatever its bound (release cuts)")
    parser.add_argument("--publish", action="store_true",
                        help="write, commit on fold/main and land it as a pull request (the fold workflow)")
    args = parser.parse_args(argv)
    if args.list:
        for fold in FOLDS:
            print(f"{fold.name:10} {fold.source:24} -> {fold.page}")
        return 0
    try:
        pending, removed = changes(args.root, everything=args.all)
    except FoldError as error:
        print(f"fold: {error}", file=sys.stderr)
        return 2
    writing = args.write or args.publish
    for page, contents in pending.items():
        if writing:
            (args.root / page).write_text(contents, encoding="utf-8")
            print(f"fold: wrote {page}")
        else:
            print(f"fold: {page} differs from its fold")
    for path in removed:
        if writing:
            (args.root / path).unlink()
            print(f"fold: folded and removed {path}")
        else:
            print(f"fold: {path} would be folded in")
    if args.publish and (pending or removed):
        return publish(args.root, [*pending, *removed])
    return 0 if writing or not (pending or removed) else 1


if __name__ == "__main__":
    raise SystemExit(main())
