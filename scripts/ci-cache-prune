#!/usr/bin/env bash
set -euo pipefail

die() {
  echo "ci-cache-prune: $*" >&2
  exit 1
}

[ "$#" -eq 2 ] || die "usage: ci-cache-prune <cache-root> <budget-gb>"
requested_root=$1
budget_gb=$2
[[ "$budget_gb" =~ ^[1-9][0-9]*$ ]] || die "budget must be whole gigabytes"
test -n "${RUNNER_TOOL_CACHE:-}" || die "RUNNER_TOOL_CACHE is required"

canonical_directory() {
  [ -d "$1" ] || return 1
  (cd -P -- "$1" 2>/dev/null && pwd -P)
}

tool_cache=$(canonical_directory "$RUNNER_TOOL_CACHE") \
  || die "cannot resolve RUNNER_TOOL_CACHE"
cache_root=$(canonical_directory "$requested_root") \
  || die "cache root does not exist: $requested_root"
prefix="$tool_cache/plurx-ci/cargo/"
case "$cache_root" in
  "$prefix"*) relative=${cache_root#"$prefix"} ;;
  *) die "refusing unsafe cache root: $requested_root" ;;
esac
IFS=/ read -r runner_name toolchain extra <<< "$relative"
test -n "$runner_name" && test -z "$extra" \
  || die "refusing unsafe cache root: $requested_root"
[[ "$runner_name" =~ ^[A-Za-z0-9_.-]+$ ]] \
  || die "refusing unsafe runner cache: $runner_name"
[[ "$toolchain" =~ ^rust-[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || die "refusing unsafe toolchain cache: $toolchain"
runner_root=$(dirname -- "$cache_root")

read_usage() {
  du -sk "$runner_root" | awk '{ print $1 }'
}

read_disk() {
  df -Pk "$runner_root" | awk 'NR == 2 { print $2, $4 }'
}

read -r filesystem_kb available_kb < <(read_disk)
usage_kb=$(read_usage)
budget_kb=$((budget_gb * 1024 * 1024))
percent_floor_kb=$(((filesystem_kb + 4) / 5))
absolute_floor_kb=$((100 * 1024 * 1024))
floor_kb=$absolute_floor_kb
if [ "$percent_floor_kb" -gt "$floor_kb" ]; then
  floor_kb=$percent_floor_kb
fi

healthy() {
  [ "$usage_kb" -le "$budget_kb" ] && [ "$available_kb" -ge "$floor_kb" ]
}

refresh() {
  usage_kb=$(read_usage)
  read -r _ available_kb < <(read_disk)
}

modified_time() {
  stat -c '%Y' "$1" 2>/dev/null || stat -f '%m' "$1"
}

remove_toolchain() {
  local candidate canonical candidate_name
  candidate=$1
  canonical=$(canonical_directory "$candidate") \
    || die "cannot resolve prune candidate: $candidate"
  case "$canonical" in
    "$runner_root"/*) ;;
    *) die "refusing unsafe toolchain directory: $candidate" ;;
  esac
  [ "$(dirname -- "$canonical")" = "$runner_root" ] \
    || die "refusing nested toolchain directory: $candidate"
  candidate_name=$(basename -- "$canonical")
  [[ "$candidate_name" =~ ^rust-[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || die "refusing unrecognized toolchain directory: $candidate"
  [ "$canonical" != "$cache_root" ] \
    || die "refusing to remove the active toolchain root"
  rm -rf -- "$canonical"
}

remove_cache_directory() {
  local candidate canonical relative_candidate component fourth rest third
  candidate=$1
  canonical=$(canonical_directory "$candidate") \
    || die "cannot resolve prune candidate: $candidate"
  case "$canonical" in
    "$runner_root"/*) relative_candidate=${canonical#"$runner_root"/} ;;
    *) die "refusing unsafe cache directory: $candidate" ;;
  esac
  IFS=/ read -r toolchain component third fourth rest <<< "$relative_candidate"
  [[ "$toolchain" =~ ^rust-[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || die "refusing unrecognized cache directory: $candidate"
  if [ "$third" = target ] && [ -z "$fourth" ] && [ -z "$rest" ]; then
    [[ "$component" =~ ^[A-Za-z0-9_.-]+$ ]] \
      || die "refusing unsafe lane cache: $candidate"
  elif [ "$component" = cargo-home ] && [ -z "$rest" ]; then
    case "$third/$fourth" in
      registry/cache|registry/index|registry/src|git/checkouts|git/db) ;;
      *) die "refusing unrecognized Cargo cache: $candidate" ;;
    esac
  else
    die "refusing unrecognized cache directory: $candidate"
  fi
  rm -rf -- "$canonical"
}

before_kb=$usage_kb
reason=within-budget
if ! healthy; then
  reason=pressure

  while IFS= read -r stale_root; do
    [ -n "$stale_root" ] || continue
    remove_toolchain "$stale_root"
    refresh
    healthy && break
  done < <(
    while IFS= read -r -d '' stale_root; do
      printf '%s %s\n' "$(modified_time "$stale_root")" "$stale_root"
    done < <(
      find "$runner_root" -mindepth 1 -maxdepth 1 -type d -name 'rust-*' \
        ! -path "$cache_root" -print0
    ) |
      sort -n | cut -d' ' -f2-
  )

  if ! healthy; then
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      remove_cache_directory "$candidate"
      refresh
      healthy && break
    done < <(
      while IFS= read -r -d '' target_dir; do
        marker="$(dirname -- "$target_dir")/.last-used"
        if [ -f "$marker" ]; then
          modified=$(modified_time "$marker")
        else
          modified=0
        fi
        printf '%s %s\n' "$modified" "$target_dir"
      done < <(
        find "$runner_root" -mindepth 3 -maxdepth 3 -type d -name target \
          -print0
      ) |
        sort -n | cut -d' ' -f2-
    )
  fi

  if ! healthy; then
    for candidate in \
      "$cache_root/cargo-home/registry/cache" \
      "$cache_root/cargo-home/registry/src" \
      "$cache_root/cargo-home/git/checkouts" \
      "$cache_root/cargo-home/git/db" \
      "$cache_root/cargo-home/registry/index"; do
      [ -d "$candidate" ] || continue
      remove_cache_directory "$candidate"
      refresh
      healthy && break
    done
  fi
fi

refresh
after_kb=$usage_kb
{
  echo "### Cargo cache"
  echo
  echo "- root: \`$runner_root\`"
  echo "- active toolchain: \`$toolchain\`"
  echo "- budget: ${budget_gb} GiB"
  echo "- filesystem floor: $((floor_kb / 1024 / 1024)) GiB"
  echo "- before: $((before_kb / 1024)) MiB"
  echo "- after: $((after_kb / 1024)) MiB"
  echo "- prune decision: \`$reason\`"
} >> "${GITHUB_STEP_SUMMARY:-/dev/null}"

healthy || die "cache remains over budget or filesystem remains below reserve"
