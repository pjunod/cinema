#!/usr/bin/env python3
"""Inspect CI failures and retry a failed Forgejo Actions job.

Workflow runs and their current jobs supply job IDs for the Forgejo 17 retry
API. Logs are read over SSH from `<task id>.log.zst` on the forge host,
keeping job IDs (retry targets) distinct from task IDs (log files).

    scripts/ci-failures                 # the checkout's HEAD commit
    scripts/ci-failures 045d92f04       # any commit (prefix ok)
    scripts/ci-failures --pr 1145       # a pull request's head
    scripts/ci-failures --task 20565    # one job by task id, failed or not
    scripts/ci-failures --pr 1145 --wait 900   # wait quietly, then report
    scripts/ci-failures --retry-job 70312 --dry-run  # preview one failed job
    scripts/ci-failures --retry-job 70312      # retry it and its dependent jobs

Configuration comes from the git-ignored `scripts/ci-failures.fleet.json`,
shaped like the committed `scripts/ci-failures.fleet.example.json`, and the
API token from $FORGEJO_TOKEN or the file named by `token_file`.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "scripts" / "ci-failures.fleet.json"
# Case-sensitive on purpose: "error" inside a branch name or a path is not a failure.
SIGNAL = re.compile(
    r"(\berror(\[E\d+\])?:|\b\w*Error:|\bERROR\b|\bFAILED\b|\bFAIL\b|panicked at|Traceback|"
    r"^not ok\b|\bfatal:|[Aa]ssertion.*failed|test result: FAILED|::error|exit status [1-9]|"
    r"exit code [1-9])"
)


def load_config() -> dict:
    if not CONFIG.is_file():
        sys.exit(f"ci-failures: create {CONFIG.relative_to(ROOT)} from the .example.json beside it")
    config = json.loads(CONFIG.read_text(encoding="utf-8"))
    token = os.environ.get("FORGEJO_TOKEN")
    if not token and config.get("token_file"):
        token = Path(os.path.expanduser(config["token_file"])).read_text(encoding="utf-8").strip()
    if not token:
        sys.exit("ci-failures: set $FORGEJO_TOKEN or token_file in the config")
    config["token"] = token
    return config


def api(config: dict, path: str, method: str = "GET") -> object:
    request = urllib.request.Request(
        f"{config['forge_url'].rstrip('/')}/api/v1/repos/{config['repo']}/{path}",
        headers={"Authorization": f"token {config['token']}"},
        method=method,
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        if method == "POST":
            if response.status != 204:
                raise RuntimeError(f"expected HTTP 204, received HTTP {response.status}")
            return None
        return json.load(response)


def jobs_for(config: dict, sha: str, pages: int) -> list[dict]:
    """Read current job attempts, rather than historical task failures."""
    found: list[dict] = []
    for page in range(1, pages + 1):
        runs = api(config, f"actions/runs?limit=50&page={page}").get("workflow_runs") or []
        for run in runs:
            if run.get("commit_sha", "").startswith(sha):
                found.extend(api(config, f"actions/runs/{run['id']}/jobs") or [])
        if len(runs) < 50:
            break
    return found


def retry_job(config: dict, job_id: int, dry_run: bool) -> int:
    """Only retry the explicitly selected job if it is still failed."""
    try:
        job = api(config, f"actions/jobs/{job_id}")
        if job.get("status") != "failure":
            print(
                f"ci-failures: refusing to retry job {job_id}: "
                f"status is {job.get('status', 'unknown')}, not failure",
                file=sys.stderr,
            )
            return 1
        target = f"failed job {job_id} ({job['name']}); dependent jobs also rerun"
        if dry_run:
            print(f"Would retry {target}")
            return 0
        api(config, f"actions/jobs/{job_id}/rerun", method="POST")
        print(f"Retry requested for {target}")
        return 0
    except urllib.error.HTTPError as error:
        # Do not echo server bodies: authentication errors can contain credentials.
        error.close()
        print(f"ci-failures: retry job {job_id}: HTTP {error.code}", file=sys.stderr)
        if error.code == 404:
            print("Check the workflow job ID and Forgejo version (17.0+ required).", file=sys.stderr)
    except (urllib.error.URLError, TimeoutError, RuntimeError) as error:
        print(
            f"ci-failures: retry job {job_id}: {type(error).__name__}; "
            "check its status before retrying again",
            file=sys.stderr,
        )
    return 1


def read_log(config: dict, task_id: int) -> str:
    target = f"{config['ssh_user']}@{config['log_host']}"
    remote = (
        f"f=$(sudo -n find {config['log_root']} -name '{task_id}.log.zst' -print -quit); "
        'test -n "$f" && sudo -n zstd -dc "$f"'
    )
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new"]
    if config.get("known_hosts"):
        cmd += ["-o", f"UserKnownHostsFile={os.path.expanduser(config['known_hosts'])}"]
    if config.get("ssh_key"):
        cmd += ["-i", os.path.expanduser(config["ssh_key"]), "-o", "IdentitiesOnly=yes"]
    proc = subprocess.run([*cmd, target, remote], capture_output=True, text=True, errors="replace")
    if proc.returncode != 0 and not proc.stdout:
        return f"(no log for task {task_id}: still running, or {proc.stderr.strip()[:200]})"
    return proc.stdout


def summarize(text: str, tail_n: int, max_rows: int) -> str:
    lines = [re.sub(r"^\S+Z\s", "", line) for line in text.splitlines()]
    hits = [i for i, line in enumerate(lines) if SIGNAL.search(line)]
    keep: list[int] = []
    for i in hits:
        keep += [j for j in range(max(0, i - 2), min(len(lines), i + 4)) if j not in keep]
    tail_from = max(0, len(lines) - tail_n)
    out, previous = [], None
    for j in [j for j in keep if j < tail_from][:max_rows]:
        if previous is not None and j != previous + 1:
            out.append("   …")
        out.append(f"{j + 1:>7}: {lines[j][:300]}")
        previous = j
    out.append(f"── last {len(lines) - tail_from} of {len(lines)} lines ──")
    out += [line[:300] for line in lines[tail_from:]]
    return "\n".join(out)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("commit", nargs="?", help="commit sha or prefix (default HEAD)")
    selector = parser.add_mutually_exclusive_group()
    selector.add_argument("--pr", type=int, help="pull request number")
    selector.add_argument("--task", type=int, help="read logs by task ID (not a retry target)")
    selector.add_argument(
        "--retry-job", type=int, metavar="JOB_ID",
        help="retry one failed job and its dependents (Forgejo 17+)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="preview --retry-job without sending a retry request",
    )
    parser.add_argument("--tail", type=int, default=25)
    parser.add_argument("--max", type=int, default=80, help="most failure-context lines per job")
    parser.add_argument("--pages", type=int, default=6, help="workflow-run pages of 50 to scan")
    parser.add_argument("--all", action="store_true", help="list every job, not only failures")
    parser.add_argument(
        "--wait",
        type=int,
        default=0,
        metavar="SECONDS",
        help="poll quietly until no job is running or waiting (at most SECONDS), then report",
    )
    args = parser.parse_args()
    if args.commit and any(value is not None for value in (args.pr, args.task, args.retry_job)):
        parser.error("commit cannot be combined with --pr, --task or --retry-job")
    if args.dry_run and args.retry_job is None:
        parser.error("--dry-run requires --retry-job")
    if args.retry_job is not None and (args.retry_job <= 0 or args.wait or args.all):
        parser.error("--retry-job needs a positive job ID and cannot use --wait or --all")
    config = load_config()

    if args.retry_job is not None:
        return retry_job(config, args.retry_job, args.dry_run)
    if args.task:
        print(summarize(read_log(config, args.task), args.tail, args.max))
        return 0
    if args.pr:
        sha = api(config, f"pulls/{args.pr}")["head"]["sha"]
    else:
        sha = subprocess.run(
            ["git", "rev-parse", args.commit or "HEAD"], cwd=ROOT, capture_output=True, text=True
        ).stdout.strip() or (args.commit or "")
    tasks = jobs_for(config, sha, args.pages)
    deadline = time.monotonic() + args.wait
    while args.wait and time.monotonic() < deadline and (
        not tasks or any(t.get("status") in ("running", "waiting", "blocked") for t in tasks)
    ):
        time.sleep(min(30, max(1, deadline - time.monotonic())))
        tasks = jobs_for(config, sha, args.pages)
    pending = [t for t in tasks if t.get("status") in ("running", "waiting", "blocked")]
    if args.wait and (pending or not tasks):
        print(f"still running after {args.wait}s: {len(pending)} job(s) not finished")
    if not tasks:
        print(f"no CI jobs found for {sha[:12]} in the newest {args.pages * 50} tasks")
        return 0
    failed = [t for t in tasks if t.get("status") == "failure"]
    counts: dict[str, int] = {}
    for task in tasks:
        counts[task.get("status", "?")] = counts.get(task.get("status", "?"), 0) + 1
    print(f"{sha[:12]}: " + ", ".join(f"{n} {status}" for status, n in sorted(counts.items())))
    for task in tasks if args.all else failed:
        print(
            f"{task['status']:>9}  job {task['id']:<6} task {task.get('task_id', 0):<6} "
            f"{task['name']}  (run {task['run_id']})"
        )
    for task in failed:
        print(f"\n══ {task['name']} — job {task['id']} ══")
        if task.get('task_id'):
            print(summarize(read_log(config, task['task_id']), args.tail, args.max))
        else:
            print('(no task log for this job)')
    if failed:
        return 1
    # A wait that ran out is not a pass: `--wait N && merge` must not merge.
    return 2 if args.wait and pending else 0


if __name__ == "__main__":
    raise SystemExit(main())
