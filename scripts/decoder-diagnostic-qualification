#!/usr/bin/env python3
"""Replay sanitized FFmpeg diagnostics against the decoder-health M0 contract."""

from __future__ import annotations

import argparse
from collections import deque
from dataclasses import asdict, dataclass
import hashlib
import json
from pathlib import Path
import re
import tomllib


VIDEO_DECODE_ERROR_WINDOW_MS = 2_000
VIDEO_DECODE_ERROR_LIMIT = 5
DIAGNOSTIC_DRAIN_BUDGET_MS = 2_000
MAX_DIAGNOSTIC_LINE_BYTES = 16 * 1024
MAX_FIXTURE_PREFIX_BYTES = 32
MAX_FIXTURE_RECORD_BYTES = (
    MAX_FIXTURE_PREFIX_BYTES + 1 + MAX_DIAGNOSTIC_LINE_BYTES + 1
)
MAX_RETAINED_COUNTER = (1 << 64) - 1

CONTRACTS_PATH = (
    Path(__file__).resolve().parents[1]
    / "tests/playback/decoder-health/diagnostic-contracts.toml"
)
FLEET_PATH = (
    Path(__file__).resolve().parents[1]
    / "tests/playback/decoder-health/fleet-ffmpeg-2026-09-05.toml"
)
ACTION_STDERR_MODE = "repeat+level+error"
SHA256 = re.compile(r"[0-9a-f]{64}")
ADDRESS = r"(?:0x[0-9a-fA-F]+|<address>)"
PRIMARY_VIDEO_ERROR = re.compile(
    rf"^\[vist#(?P<input>\d+):(?P<stream>\d+)/(?P<codec>[^\]@]+?)"
    rf"(?: @ (?P<stream_address>{ADDRESS}))?\]\s+"
    rf"\[dec:(?P<decoder>[^\]@]+?)"
    rf"(?: @ (?P<decoder_address>{ADDRESS}))?\]\s+"
    r"(?P<severity>\[error\]\s+)?Error submitting packet to decoder:"
    r"(?P<detail>.*)$"
)
SUBORDINATE_NO_FRAME = re.compile(
    rf"^\[[^\]@]+(?: @ {ADDRESS})?\]\s+(?:\[error\]\s+)?No frame decoded\?"
)
LEGACY_REPEAT = re.compile(
    r"^\s*(?:\[(?:error|warning|fatal|info|verbose|debug|trace)\]\s+)?"
    r"Last message repeated (?P<count>[0-9]{1,20}) times$"
)
LEGACY_REPEAT_PREFIX = re.compile(
    r"^\s*(?:\[[a-z]+\]\s+)?Last message repeated "
)


class QualificationError(ValueError):
    """A CLI input cannot be interpreted without inventing evidence."""


def saturating_count(value: int, increment: int = 1) -> int:
    """Keep every published diagnostic count inside an unsigned 64-bit bound."""

    return min(MAX_RETAINED_COUNTER, value + increment)


@dataclass(frozen=True)
class DiagnosticContract:
    id: str
    host: str
    ffmpeg_version: str
    binary_sha256: str
    buildconf_sha256: str
    stderr_mode: str
    input_codec: str
    decoder: str
    require_context_addresses: bool
    error_detail: str
    fixture: str
    fixture_sha256: str
    scope: str


@dataclass(frozen=True)
class Qualification:
    fixture: str
    diagnostic_contract_id: str | None
    selected_input: int
    selected_stream: int
    primary_video_error_records: int
    severity_qualified_primary_records: int
    contract_qualified_primary_records: int
    subordinate_records: int
    selected_primary_repeat_summaries: int
    selected_primary_repeated_messages: int
    unrelated_repeat_summaries: int
    ambiguous_repeat_summaries: int
    observation_complete: bool
    oversized_lines: int
    invalid_utf8_lines: int
    malformed_lines: int
    first_primary_at_ms: int | None
    triggering_window_started_at_ms: int | None
    fault_at_ms: int | None
    detection_latency_ms: int | None
    automatic_action_qualified: bool


def parse_selected_stream(value: str) -> tuple[int, int]:
    match = re.fullmatch(r"(\d+):(\d+)", value)
    if match is None:
        raise QualificationError("selected stream must use INPUT:STREAM")
    return int(match.group(1)), int(match.group(2))


def action_contract(contract_id: str | None) -> DiagnosticContract | None:
    if contract_id is None:
        return None
    try:
        with CONTRACTS_PATH.open("rb") as document:
            contract_document = tomllib.load(document)
        with FLEET_PATH.open("rb") as document:
            fleet = tomllib.load(document)
    except (OSError, KeyError, tomllib.TOMLDecodeError) as error:
        raise QualificationError(f"cannot load diagnostic evidence: {error}") from error
    if contract_document.get("version") != 1:
        raise QualificationError("unsupported diagnostic contract document version")
    contracts = contract_document.get("contracts")
    if not isinstance(contracts, list):
        raise QualificationError("diagnostic contract list is missing")
    if not all(isinstance(contract, dict) for contract in contracts):
        raise QualificationError("diagnostic contract entries must be tables")
    matches = [contract for contract in contracts if contract.get("id") == contract_id]
    if len(matches) != 1:
        raise QualificationError(f"unknown diagnostic contract: {contract_id}")
    raw = matches[0]
    fields = set(DiagnosticContract.__dataclass_fields__)
    if set(raw) != fields:
        raise QualificationError(
            f"diagnostic contract {contract_id} must define exactly: "
            + ", ".join(sorted(fields))
        )
    try:
        contract = DiagnosticContract(**raw)
    except TypeError as error:
        raise QualificationError(
            f"invalid diagnostic contract {contract_id}: {error}"
        ) from error
    text_fields = (
        contract.id,
        contract.host,
        contract.ffmpeg_version,
        contract.stderr_mode,
        contract.input_codec,
        contract.decoder,
        contract.error_detail,
        contract.fixture,
        contract.scope,
    )
    if not all(isinstance(value, str) and value for value in text_fields):
        raise QualificationError(f"diagnostic contract {contract_id} has empty fields")
    if type(contract.require_context_addresses) is not bool:
        raise QualificationError(
            f"diagnostic contract {contract_id} has a non-boolean address rule"
        )
    if contract.stderr_mode != ACTION_STDERR_MODE:
        raise QualificationError(
            f"diagnostic contract {contract_id} has unsupported stderr mode"
        )
    for label, value in (
        ("binary", contract.binary_sha256),
        ("build configuration", contract.buildconf_sha256),
        ("fixture", contract.fixture_sha256),
    ):
        if not isinstance(value, str) or SHA256.fullmatch(value) is None:
            raise QualificationError(
                f"diagnostic contract {contract_id} has invalid {label} hash"
            )
    nodes = [node for node in fleet.get("nodes", []) if node.get("name") == contract.host]
    if len(nodes) != 1:
        raise QualificationError(
            f"diagnostic contract {contract_id} host is absent from fleet evidence"
        )
    node = nodes[0]
    if (
        node.get("host_ffmpeg") != contract.ffmpeg_version
        or node.get("host_binary_sha256") != contract.binary_sha256
        or node.get("host_buildconf_sha256") != contract.buildconf_sha256
    ):
        raise QualificationError(
            f"diagnostic contract {contract_id} does not match fleet build evidence"
        )
    return contract


def matches_action_contract(
    match: re.Match[str],
    contract: DiagnosticContract | None,
) -> bool:
    if contract is None:
        return False
    return (
        match.group("severity") is not None
        and match.group("codec").strip() == contract.input_codec
        and match.group("decoder").strip() == contract.decoder
        and match.group("detail").strip() == contract.error_detail
        and (
            not contract.require_context_addresses
            or (
                match.group("stream_address") is not None
                and match.group("decoder_address") is not None
            )
        )
    )


def bounded_fixture_lines(fixture, digest):
    """Yield bounded lines, draining each oversized tail before continuing."""

    number = 0
    while True:
        raw = fixture.readline(MAX_FIXTURE_RECORD_BYTES + 1)
        digest.update(raw)
        if not raw:
            break
        number += 1
        retained = raw[:MAX_FIXTURE_RECORD_BYTES]
        oversized = len(raw) > MAX_FIXTURE_RECORD_BYTES
        if not raw.endswith(b"\n") and len(raw) == MAX_FIXTURE_RECORD_BYTES + 1:
            oversized = True
            while raw and not raw.endswith(b"\n"):
                raw = fixture.readline(MAX_FIXTURE_RECORD_BYTES + 1)
                digest.update(raw)
        yield number, retained, oversized


def qualify(
    path: Path,
    selected: tuple[int, int] = (0, 0),
    contract_id: str | None = None,
) -> Qualification:
    contract = action_contract(contract_id)
    window: deque[tuple[int, bool]] = deque(maxlen=VIDEO_DECODE_ERROR_LIMIT)
    primary = 0
    severity_qualified = 0
    contract_qualified = 0
    subordinate = 0
    selected_repeat_summaries = 0
    selected_repeated_messages = 0
    unrelated_repeat_summaries = 0
    ambiguous_repeat_summaries = 0
    oversized_lines = 0
    invalid_utf8_lines = 0
    malformed_lines = 0
    valid_records = 0
    prior_ms = -1
    prior_class: str | None = None
    first_primary: int | None = None
    triggering_window_start: int | None = None
    triggering_window_contract_qualified = False
    fault_at: int | None = None

    digest = hashlib.sha256()
    with path.open("rb") as fixture:
        for _, raw, oversized in bounded_fixture_lines(fixture, digest):
            if oversized:
                oversized_lines = saturating_count(oversized_lines)
                prior_class = None
                continue
            raw = raw.rstrip(b"\r\n")
            if not raw or raw.startswith(b"#"):
                continue
            observed, separator, message_bytes = raw.partition(b"\t")
            if (
                not separator
                or len(observed) > MAX_FIXTURE_PREFIX_BYTES
                or not observed.isascii()
                or not observed.isdigit()
            ):
                malformed_lines = saturating_count(malformed_lines)
                prior_class = None
                continue
            if len(message_bytes) > MAX_DIAGNOSTIC_LINE_BYTES:
                oversized_lines = saturating_count(oversized_lines)
                prior_class = None
                continue
            try:
                message = message_bytes.decode("utf-8")
            except UnicodeDecodeError:
                invalid_utf8_lines = saturating_count(invalid_utf8_lines)
                prior_class = None
                continue
            observed_ms = int(observed)
            if observed_ms < prior_ms:
                malformed_lines = saturating_count(malformed_lines)
                prior_class = None
                continue
            prior_ms = observed_ms
            valid_records = saturating_count(valid_records)

            repeat = LEGACY_REPEAT.fullmatch(message)
            if repeat is not None:
                repeated = int(repeat.group("count"))
                if prior_class == "selected_primary":
                    selected_repeat_summaries = saturating_count(
                        selected_repeat_summaries
                    )
                    selected_repeated_messages = saturating_count(
                        selected_repeated_messages, repeated
                    )
                elif prior_class in (None, "repeat_summary"):
                    ambiguous_repeat_summaries = saturating_count(
                        ambiguous_repeat_summaries
                    )
                else:
                    unrelated_repeat_summaries = saturating_count(
                        unrelated_repeat_summaries
                    )
                prior_class = "repeat_summary"
                continue
            if LEGACY_REPEAT_PREFIX.match(message):
                malformed_lines = saturating_count(malformed_lines)
                prior_class = None
                continue
            if SUBORDINATE_NO_FRAME.match(message):
                subordinate = saturating_count(subordinate)
                prior_class = "subordinate"
                continue
            match = PRIMARY_VIDEO_ERROR.match(message)
            if match is None:
                prior_class = "other"
                continue
            stream = (int(match.group("input")), int(match.group("stream")))
            if stream != selected:
                prior_class = "other_stream_primary"
                continue

            primary = saturating_count(primary)
            prior_class = "selected_primary"
            if match.group("severity") is not None:
                severity_qualified = saturating_count(severity_qualified)
            contract_match = matches_action_contract(match, contract)
            if contract_match:
                contract_qualified = saturating_count(contract_qualified)
            if first_primary is None:
                first_primary = observed_ms
            lower_bound = observed_ms - VIDEO_DECODE_ERROR_WINDOW_MS
            while window and window[0][0] <= lower_bound:
                window.popleft()
            window.append((observed_ms, contract_match))
            if fault_at is None and len(window) >= VIDEO_DECODE_ERROR_LIMIT:
                triggering_window_start = window[0][0]
                triggering_window_contract_qualified = all(
                    qualified for _, qualified in window
                )
                fault_at = observed_ms

    contract_evidence_qualified = bool(
        contract
        and path.name == contract.fixture
        and digest.hexdigest() == contract.fixture_sha256
    )
    if not contract_evidence_qualified:
        contract_qualified = 0
        triggering_window_contract_qualified = False

    latency = None
    if fault_at is not None and triggering_window_start is not None:
        latency = fault_at - triggering_window_start
    observation_complete = (
        valid_records > 0
        and oversized_lines == 0
        and invalid_utf8_lines == 0
        and malformed_lines == 0
    )
    return Qualification(
        fixture=path.name,
        diagnostic_contract_id=contract_id,
        selected_input=selected[0],
        selected_stream=selected[1],
        primary_video_error_records=primary,
        severity_qualified_primary_records=severity_qualified,
        contract_qualified_primary_records=contract_qualified,
        subordinate_records=subordinate,
        selected_primary_repeat_summaries=selected_repeat_summaries,
        selected_primary_repeated_messages=selected_repeated_messages,
        unrelated_repeat_summaries=unrelated_repeat_summaries,
        ambiguous_repeat_summaries=ambiguous_repeat_summaries,
        observation_complete=observation_complete,
        oversized_lines=oversized_lines,
        invalid_utf8_lines=invalid_utf8_lines,
        malformed_lines=malformed_lines,
        first_primary_at_ms=first_primary,
        triggering_window_started_at_ms=triggering_window_start,
        fault_at_ms=fault_at,
        detection_latency_ms=latency,
        automatic_action_qualified=(
            fault_at is not None
            and triggering_window_contract_qualified
            and selected_repeat_summaries == 0
            and unrelated_repeat_summaries == 0
            and ambiguous_repeat_summaries == 0
            and observation_complete
        ),
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("fixture", type=Path)
    parser.add_argument("--selected-stream", default="0:0", metavar="INPUT:STREAM")
    parser.add_argument("--diagnostic-contract", metavar="CONTRACT_ID")
    arguments = parser.parse_args()
    try:
        result = qualify(
            arguments.fixture,
            parse_selected_stream(arguments.selected_stream),
            arguments.diagnostic_contract,
        )
    except (OSError, QualificationError) as error:
        parser.error(str(error))
    print(json.dumps(asdict(result), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
