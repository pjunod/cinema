#!/usr/bin/env python3
"""Offline generation of original CC0 PGS and interlace Mac smoke extensions.

Requires explicit Jellyfin programs and initial corpus. Never called by daemon.
"""
import argparse
import hashlib
import importlib.machinery
import json
from pathlib import Path
import struct
import subprocess


def run(argv):
    result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=30, check=False)
    if result.returncode:
        raise ValueError(result.stderr[-4096:].decode(errors="replace"))
    return result.stdout


def pgs_cue():
    def segment(seconds, kind, data):
        return b"PG" + struct.pack(">IIBH", round(seconds * 90000), 0, kind, len(data)) + data
    composition = struct.pack(">HHBHBBBB", 320, 180, 0x10, 1, 0x80, 0, 0, 1)
    composition += struct.pack(">HBBHH", 1, 0, 0, 220, 140)
    window = bytes([1, 0]) + struct.pack(">HHHH", 220, 140, 80, 30)
    # BT.601 PGS palette red, half alpha. Main video remains BT.709 SDR after
    # processing; the incumbent subtitle decoder/compositor owns conversion.
    palette = bytes([0, 0, 1, 81, 240, 90, 128])
    rle = (bytes([1]) * 80 + b"\0\0") * 30
    obj = struct.pack(">HBB", 1, 0, 0xc0) + (len(rle) + 4).to_bytes(3, "big")
    obj += struct.pack(">HH", 80, 30) + rle
    clear = struct.pack(">HHBHBBBB", 320, 180, 0x10, 2, 0, 0, 0, 0)
    return b"".join([segment(.25, 0x16, composition), segment(.25, 0x17, window),
                     segment(.25, 0x14, palette), segment(.25, 0x15, obj),
                     segment(.25, 0x80, b""), segment(.75, 0x16, clear),
                     segment(.75, 0x80, b"")])


ASS = """[Script Info]
ScriptType: v4.00+
PlayResX: 160
PlayResY: 90
[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Default,Arial,14,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,0,2,0,0,2,1
[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 0,0:00:00.25,0:00:00.75,Default,,0,0,0,,{\\an2\\pos(80,86)\\fad(100,100)}burn
"""


def validate_hlg_square_pixels(probe):
    if (probe["streams"][0].get("sample_aspect_ratio") != "1:1"
            or any(frame.get("sample_aspect_ratio") != "1:1" for frame in probe["frames"])):
        raise ValueError("HLG square pixels must be encoded and retained on decoded frames")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ffmpeg", required=True)
    parser.add_argument("--ffprobe", required=True)
    parser.add_argument("--initial", type=Path, required=True)
    parser.add_argument("--hlg-helper", type=Path, default=Path(__file__).with_name("generate-macos-extension-fixtures"), help="analytic HLG helper source")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not Path(args.ffmpeg).is_absolute() or not Path(args.ffprobe).is_absolute():
        parser.error("explicit absolute programs required")
    args.output.mkdir(parents=True, exist_ok=False)
    initial = json.loads((args.initial / "manifest.json").read_text())
    hlg_helper = importlib.machinery.SourceFileLoader(
        "mac_smoke_hlg", str(args.hlg_helper)).load_module()
    records = []
    prefix = [args.ffmpeg, "-hide_banner", "-loglevel", "error", "-nostdin", "-y"]
    for name, data in [("burn.ass", ASS.encode()), ("cue.sup", pgs_cue())]:
        (args.output / name).write_bytes(data)
    for family, source_name in [("sdr", "sdr8"), ("sdr10", "sdr10"), ("hdr10", "hdr10")]:
        filename = f"pgs-{family}.mkv"
        argv = prefix + ["-i", str(args.initial / f"{source_name}.mp4"), "-itsoffset", "0.25", "-i", str(args.output / "cue.sup"),
                         "-map", "0:v", "-map", "1:s", "-c", "copy", filename]
        run(argv[:-1] + [str(args.output / filename)])
        records.append({"id": f"pgs_{family}", "path": filename, "source_class": "hdr10" if family == "hdr10" else "sdr",
                        "operation": "bitmap_burn", "generation_argv": argv,
                        "output_expectation": initial["fixtures"][2 if family == "hdr10" else (1 if family == "sdr10" else 0)]["output_expectations"][-1]})
    raw = args.output / "hlg.yuv"
    raw.write_bytes(b"".join(hlg_helper.frame_bytes("hlg", frame) for frame in range(12)))
    filename = "hlg.mp4"
    argv = prefix + ["-f", "rawvideo", "-pix_fmt", "yuv420p10le", "-s", "320x180", "-r", "12", "-i", str(raw),
                     "-frames:v", "12", "-vf", "setsar=1", "-c:v", "libx265", "-x265-params",
                     "lossless=1:repeat-headers=1:aud=1:keyint=12:bframes=0:pools=1:frame-threads=1:colorprim=9:transfer=18:colormatrix=9:range=limited",
                     "-color_trc", "arib-std-b67", "-color_primaries", "bt2020", "-colorspace", "bt2020nc", "-color_range", "tv",
                     "-tag:v", "hvc1", "-movflags", "+faststart", filename]
    run(argv[:-1] + [str(args.output / filename)])
    expectation = json.loads(json.dumps(initial["fixtures"][2]["output_expectations"][-1]))
    expectation["graph_id"] = "vt_tonemap_hlg_metal"
    records.append({"id": "hlg", "path": filename, "source_class": "hlg", "operation": "plain", "generation_argv": argv,
                    "output_expectation": expectation,
                    "reference": {"display_peak_nits": 1000, "system_gamma": 1.2,
                                  "gray_source_codes": [hlg_helper.codes((n,n,n), "hlg") for n in (0,1,10,100,203,400,700,1000)],
                                  "reference_white_nits": 203,
                                  "reference_white_signal": hlg_helper.hlg_oetf((203 / 1000) ** (1 / 1.2))}})
    raw.unlink()
    for record in records:
        data = (args.output / record["path"]).read_bytes()
        record.update(sha256=hashlib.sha256(data).hexdigest(), byte_length=len(data))
        probe = json.loads(run([args.ffprobe, "-v", "error", "-select_streams", "v:0", "-show_streams", "-show_frames", "-of", "json", str(args.output / record["path"])]))
        if len(probe["frames"]) != 12:
            raise ValueError("fixture must decode 12 frames")
        if record["id"] == "hlg":
            validate_hlg_square_pixels(probe)
        record["input_observed"] = {key: probe["streams"][0].get(key) for key in
                                    ["codec_name", "profile", "pix_fmt", "avg_frame_rate", "field_order", "color_range", "color_space", "color_transfer", "color_primaries", "sample_aspect_ratio"]}
        record["generation_argv"] = [part.replace(args.ffmpeg, "$FFMPEG").replace(str(args.initial), "$INITIAL").replace(str(args.output), "$OUTPUT") for part in record["generation_argv"]]
    manifest = {"schema_version": 1, "generator_recipe_version": 1,
                "provenance": "Original analytic CC0 media; no external fonts, images, footage or private content embedded",
                "fixtures": records,
                "auxiliary": [{"path": name, "sha256": hashlib.sha256((args.output / name).read_bytes()).hexdigest(), "byte_length": (args.output / name).stat().st_size} for name in ["burn.ass", "cue.sup"]]}
    (args.output / "extensions.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")


if __name__ == "__main__":
    main()
