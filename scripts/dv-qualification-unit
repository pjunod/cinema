#!/usr/bin/env python3
"""Task-only exact-source native qualification; remove before the final PR."""
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import time
import tarfile
import subprocess
import sys
import uuid

IMAGE = "rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97"
IMAGE_ID = "sha256:897e260d0a1a5a5146433bdb73f62bd84f5f47e846d3485e5f70f63912b5917d"
OWNER = "codex-dv-gpu-qualification"
AGGREGATE = "/plurx.slice/plurx-heavy.slice"
LIMITS = {"memory.max": "21474836480", "memory.swap.max": "0", "cpu.max": "400000 100000", "cpuset.cpus.effective": "0-3", "pids.max": "4096"}
FILTERS = [
    "intel_and_nvidia_windows_use_the_actual_production_encoder_without_amd_flags",
    "intel_and_nvidia_qualification_resolve_the_same_saved_completed_encoder",
    "a_skipped_upgrade_explains_only_its_own_generation_until_release_or_replacement",
    "public_skip_report_requires_current_generation_and_bounded_owner_text",
    "skipped_processing_owner_reason_survives_relay_only_for_its_generation",
    "the_window_encode_is_the_routes_recipe",
    "a_busy_reduced_recipe_remains_pending_then_executes_its_exact_output",
    "a_foreign_backend_recipe_request_stays_pending_without_measurement",
    "qualification_source_reader_graph_is_busy_at_eight_threads_and_admitted_at_nine",
    "a_failed_trial_leaves_the_predecessors_route_and_actor_untouched",
    "a_qualification_inside_its_title_job_is_not_preempted_by_itself_and_stores_its_verdict",
    "brokered_cache_parts_keep_reader_recovery_but_raw_fallbacks_remain_fenced",
    "only_an_exact_pending_token_can_arm_a_continuation",
    "a_new_exact_receipt_can_resume_but_rejected_foreign_or_stale_receipts_cannot",
    "duplicate_control_events_claim_one_check_and_keep_the_truthful_reason",
    "release_changed_selection_and_expiry_cannot_revive_an_old_waiter",
    "a_qualified_retry_keeps_auto_original_and_manual_as_the_user_actually_selected",
    "refreshed_auto_candidate_identity_is_not_a_new_user_quality_choice",
    "a_late_qualification_resumes_once_with_fresh_authority_and_keeps_its_reason",
    "a_viewer_change_cancels_a_pending_receipt_check_before_it_can_resume",
    "a_resumed_quality_mode_uses_its_fresh_auto_policy_and_accepted_owner_epoch",
    "an_ordinary_fallback_reports_the_reason_without_private_qualification_data",
    "live_completion_waits_for_read_original_clones_and_explicit_raw_retirement",
    "tracked_raw_probe_retirement_survives_timeout_and_abandoned_collector",
    "reader_recovery_refuses_unarmed_unmediated_foreign_kernel_and_replaced_inode",
    "finish_during_blocked_enrolled_read_leaves_settlement_to_the_ledger",
]
CAPS = ["--memory", "20g", "--memory-swap", "20g", "--cpus", "4", "--cpuset-cpus", "0-3", "--pids-limit", "4096", "--cgroup-parent", "plurx-heavy.slice", "--cgroupns", "host", "--mount", "type=bind,src=/sys/fs/cgroup" + AGGREGATE + ",dst=/aggregate,readonly"]


def call(argv, **kwargs):
    return subprocess.run(argv, check=True, **kwargs)


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def bounds():
    hierarchy, controllers, relative = Path("/proc/self/cgroup").read_text().strip().split(":", 2)
    assert hierarchy == "0" and not controllers and relative.startswith("/")
    assert ".." not in Path(relative).parts and "." not in relative.split("/")
    assert relative.startswith(AGGREGATE + "/"), "container escaped the shared heavy aggregate"
    root = Path("/sys/fs/cgroup") / relative.lstrip("/")
    actual = {key: (root / key).read_text().strip() for key in LIMITS}
    assert actual == LIMITS, actual
    aggregate = Path("/aggregate")
    assert aggregate.samefile(Path("/sys/fs/cgroup" + AGGREGATE))
    assert any(row.split()[4] == "/aggregate" and "ro" in row.split()[5].split(",") for row in Path("/proc/self/mountinfo").read_text().splitlines())
    assert {key: (aggregate / key).read_text().strip() for key in LIMITS} == LIMITS
    stat = aggregate.stat()
    return {"membership": relative, "limits": actual, "aggregate": {"path": AGGREGATE, "device": stat.st_dev, "inode": stat.st_ino, "limits": LIMITS}}


def logged(argv, out, name):
    with (out / (name + ".log")).open("wb") as log:
        result = subprocess.run(argv, stdout=log, stderr=subprocess.STDOUT)
    return {"command": argv, "exit_code": result.returncode}


def child():
    out = Path("/out")
    receipt = json.loads((out / "source.json").read_text())
    receipt.update(status="failed", cgroup=bounds(), commands=[])
    assert receipt["cgroup"]["aggregate"] == receipt["outer_cgroup"]["aggregate"], "parent and compiler must share the same physical aggregate"
    try:
        assert not Path("/src/.git").exists(), "source archive must exclude repository credentials"
        compiler = subprocess.check_output(["rustc", "--version"], text=True).strip()
        assert compiler.startswith("rustc 1.97.1 "), compiler
        receipt["compiler"] = compiler
        receipt["build_environment"] = {key: os.environ.get(key) for key in ("CARGO_BUILD_JOBS", "CARGO_INCREMENTAL", "CARGO_PROFILE_DEV_DEBUG", "CARGO_PROFILE_TEST_DEBUG", "RUSTUP_TOOLCHAIN", "RUST_TEST_THREADS", "PLURX_BUILD_SHA")}
        receipt["unit_ffmpeg"] = subprocess.check_output(["ffmpeg", "-version"], text=True).splitlines()[0]
        assert receipt["unit_ffmpeg"].startswith("ffmpeg version 5.1"), receipt["unit_ffmpeg"]
        command = ["cargo", "test", "--locked", "-j1", "-p", "plurxd", "--bin", "plurxd", "--no-run", "--message-format=json-render-diagnostics"]
        built = logged(command, out, "compile")
        receipt["commands"].append(built)
        assert built["exit_code"] == 0, "full unmodified daemon test code generation failed"
        executables = set()
        for line in (out / "compile.log").read_text(errors="replace").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("reason") == "compiler-artifact" and row.get("target", {}).get("name") == "plurxd" and row.get("profile", {}).get("test") and row.get("executable"):
                executables.add(row["executable"])
        assert len(executables) == 1, executables
        executable = Path(executables.pop())
        with executable.open("rb") as stream:
            assert stream.read(4) == b"\x7fELF", "native test artifact must be ELF"
        shutil.copy2(executable, out / "plurxd-tests")
        receipt["binary_sha256"] = sha(out / "plurxd-tests")
        for index, name in enumerate(FILTERS):
            listed = subprocess.check_output([str(executable), name, "--list"], text=True)
            assert sum(line.endswith(": test") for line in listed.splitlines()) == 1, listed
            result = logged([str(executable), name, "--test-threads=1", "--nocapture"], out, f"test-{index:02d}")
            text = (out / f"test-{index:02d}.log").read_text(errors="replace")
            result["passed"] = result["exit_code"] == 0 and bool(re.search(r"test result: ok\. 1 passed; 0 failed;", text))
            receipt["commands"].append(result)
        assert all(row.get("passed", True) for row in receipt["commands"]), "one or more focused units failed"
        receipt["status"] = "passed"
    finally:
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")


def evidence_dir():
    return Path(os.environ["RUNNER_TEMP"]) / "dv-gpu-qualification"


def save_state(state):
    path = evidence_dir() / "volumes.json"
    temporary = path.with_suffix(".new")
    temporary.write_text(json.dumps(state))
    temporary.replace(path)


def state_for_cleanup():
    path = evidence_dir() / "volumes.json"
    if not path.exists():
        return None
    state = json.loads(path.read_text())
    assert re.fullmatch(r"[0-9a-f]{40}", state["source_git"])
    assert re.fullmatch(r"[0-9]+", state["run"])
    assert re.fullmatch("dv-qual-" + state["run"] + "-" + state["source_git"][:12] + r"-[0-9a-f]{8}", state["container"])
    if state.get("cid"):
        assert re.fullmatch(r"[0-9a-f]{64}", state["cid"])
    return state


def stop_owned(state):
    prefix = state["container"]
    filters = ["--filter", "label=owner=" + OWNER, "--filter", "label=task-run=" + prefix]
    ids = subprocess.check_output(["docker", "ps", "-aq", *filters], text=True).split()
    stopped = []
    for cid in ids:
        inspected = subprocess.run(["docker", "inspect", cid], capture_output=True, text=True)
        if inspected.returncode != 0:
            assert not subprocess.check_output(["docker", "ps", "-aq", "--filter", "id=" + cid], text=True).strip(), "owned container inspection failed while it still exists"
            continue
        row = json.loads(inspected.stdout)[0]
        labels = row["Config"]["Labels"]
        assert labels.get("owner") == OWNER and labels.get("task-run") == prefix and labels.get("source-git") == state["source_git"]
        assert row["Name"].lstrip("/") in {prefix, prefix + "-archive", prefix + "-metadata", prefix + "-export"}
        if row["Name"] == "/" + prefix and state.get("cid"):
            assert cid == state["cid"] or row["Id"] == state["cid"]
        if row["State"]["Running"]:
            try:
                subprocess.run(["docker", "stop", "--time", "15", cid], check=False, timeout=25, stdout=subprocess.DEVNULL)
            except subprocess.TimeoutExpired:
                call(["docker", "kill", cid], timeout=15, stdout=subprocess.DEVNULL)
        subprocess.run(["docker", "rm", "--force", cid], timeout=20, stdout=subprocess.DEVNULL, check=False)
        stopped.append(row["Id"])
    assert not subprocess.check_output(["docker", "ps", "-aq", *filters], text=True).strip(), "owned child disappearance is unconfirmed"
    (evidence_dir() / "cleanup.json").write_text(json.dumps({"compiler": prefix, "cid": state.get("cid"), "stopped": stopped, "gone": True}, indent=2))


def docker_base(state, operation="run"):
    names = state["volumes"]
    labels = ["--label", "owner=" + OWNER, "--label", "task-run=" + state["container"], "--label", "source-git=" + state["source_git"]]
    return ["docker", operation, *(["--rm"] if operation == "run" else []), *labels, *CAPS,
            "--mount", f"type=volume,src={names['source']},dst=/src", "--mount", f"type=volume,src={names['out']},dst=/out"]


def collect():
    state = state_for_cleanup()
    if state is None:
        return
    stop_owned(state)  # Stop/validate before reading any mutable output logs.
    found = subprocess.run(["docker", "volume", "inspect", state["volumes"]["out"]], capture_output=True)
    if found.returncode != 0:
        return
    assert json.loads(found.stdout)[0]["Labels"].get("owner") == OWNER
    with (evidence_dir() / "qualification.tar").open("wb") as stream:
        call([*docker_base(state), "--name", state["container"] + "-export", "--entrypoint", "tar", IMAGE, "-C", "/out", "-cf", "-", "."], stdout=stream, timeout=180)


# PID1 supervises before apt starts. EOF/ten seconds without parent heartbeat
# retires the owned work group; namespace exit kills any remaining descendants.
SUPERVISOR = r"""set -eu
exec 3<&0
setsid sh -c "$1" </dev/null 3<&- &
work=$!
(
  while IFS= read -r -t 10 heartbeat <&3; do :; done
  kill -TERM -- "-$work" 2>/dev/null || true
  sleep 2
  kill -KILL -- "-$work" 2>/dev/null || true
) &
watch=$!
trap 'kill -TERM -- "-$work" 2>/dev/null || true; sleep 2; kill -KILL -- "-$work" 2>/dev/null || true; kill "$watch" 2>/dev/null || true; wait "$work" 2>/dev/null || true; exit 143' TERM INT
set +e
wait "$work"
result=$?
kill "$watch" 2>/dev/null
wait "$watch" 2>/dev/null
exit "$result"
"""


def parent():
    evidence = evidence_dir()
    evidence.mkdir(parents=True, exist_ok=True)
    call(["git", "diff", "--quiet", "HEAD", "--"])
    revision = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    assert re.fullmatch(r"[0-9a-f]{40}", revision)
    run = os.environ.get("GITHUB_RUN_ID", os.environ.get("FORGEJO_RUN_ID", ""))
    assert re.fullmatch(r"[0-9]+", run), "runner run identity unavailable"
    prefix = f"dv-qual-{run}-{revision[:12]}-{uuid.uuid4().hex[:8]}"
    names = {"source": prefix + "-source", "out": prefix + "-out", "cargo": OWNER + "-cargo", "target": OWNER + "-target"}
    state = {"volumes": names, "container": prefix, "source_git": revision, "run": run, "cid": None}
    save_state(state)  # Name/ownership recovery precedes every possible launch.
    archive = evidence / "source.tar"
    with archive.open("wb") as stream:
        call(["git", "archive", "--format=tar", "HEAD"], stdout=stream)
    source = {"source_git": revision, "source_archive_sha256": sha(archive), "outer_cgroup": bounds(), "image": IMAGE, "image_id": IMAGE_ID,
              "parent_heartbeat": {"interval_seconds": 2, "lease_seconds": 10, "kill_grace_seconds": 2}}
    call(["docker", "pull", "--platform", "linux/amd64", IMAGE])
    source["resolved_image_id"] = subprocess.check_output(["docker", "image", "inspect", "--format", "{{.Id}}", IMAGE], text=True).strip()
    assert source["resolved_image_id"] == IMAGE_ID
    for volume in names.values():
        call(["docker", "volume", "create", "--label", "owner=" + OWNER, volume], stdout=subprocess.DEVNULL)
        assert subprocess.check_output(["docker", "volume", "inspect", "--format", '{{index .Labels "owner"}}', volume], text=True).strip() == OWNER
    try:
        base = docker_base(state)
        with archive.open("rb") as stream:
            call([*base, "--name", prefix + "-archive", "-i", "--entrypoint", "sh", IMAGE, "-c", "cat > /out/source.tar && tar -xf /out/source.tar -C /src && find /src/crates /src/vendor -type f -exec touch {} +"], stdin=stream, timeout=180)
        call([*base, "--name", prefix + "-metadata", "-i", "--entrypoint", "sh", IMAGE, "-c", "cat > /out/source.json"], input=json.dumps(source).encode(), timeout=30)
        guard = 'set -eu; IFS=: read -r h c p < /proc/self/cgroup; test "$h" = 0; test -z "$c"; case "$p" in /plurx.slice/plurx-heavy.slice/*) ;; *) exit 1 ;; esac; case "/$p/" in */../*|*/./*) exit 1 ;; esac; '
        guard += 'test "$(stat -c %d:%i /aggregate)" = "$(stat -c %d:%i /sys/fs/cgroup/plurx.slice/plurx-heavy.slice)"; '
        guard += "; ".join("test \"$(cat /sys/fs/cgroup\"$p\"/" + key + ")\" = " + repr(value) + "; test \"$(cat /aggregate/" + key + ")\" = " + repr(value) for key, value in LIMITS.items()) + "; "
        bootstrap = guard + "apt-get -o Acquire::Retries=3 update > /out/bootstrap.log 2>&1 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends python3 ffmpeg pkg-config libssl-dev clang cmake lld >> /out/bootstrap.log 2>&1 && python3 scripts/dv-qualification-unit child"
        env = ["CARGO_HOME=/cargo", "CARGO_TARGET_DIR=/target", "CARGO_BUILD_JOBS=1", "CARGO_INCREMENTAL=0", "CARGO_PROFILE_DEV_DEBUG=0", "CARGO_PROFILE_TEST_DEBUG=0", "RUSTUP_TOOLCHAIN=1.97.1", "RUST_TEST_THREADS=1", "PLURX_BUILD_SHA=" + revision]
        args = [*docker_base(state, "create"), "--name", prefix, "--cidfile", str(evidence / "compiler.cid"), "-i", "-a", "STDIN", "-a", "STDOUT", "-a", "STDERR", "--workdir", "/src",
                "--mount", f"type=volume,src={names['cargo']},dst=/cargo", "--mount", f"type=volume,src={names['target']},dst=/target"]
        for value in env:
            args += ["--env", value]
        state["cid"] = subprocess.check_output([*args, "--entrypoint", "bash", IMAGE, "-c", SUPERVISOR, "dv-qualification", bootstrap], text=True).strip()
        save_state(state)  # Immutable CID is persisted before docker start.
        config = json.loads(subprocess.check_output(["docker", "inspect", state["cid"]], text=True))[0]
        assert config["Config"]["StdinOnce"], "parent disconnect must close child stdin"
        with (evidence / "container.log").open("wb") as log:
            client = subprocess.Popen(["docker", "start", "--attach", "--interactive", state["cid"]], stdin=subprocess.PIPE, stdout=log, stderr=subprocess.STDOUT)
            try:
                while client.poll() is None:
                    try:
                        client.stdin.write(b"alive\n")
                        client.stdin.flush()
                    except BrokenPipeError:
                        break
                    time.sleep(2)
                result = client.wait(timeout=30)
            finally:
                try:
                    client.stdin.close()
                except BrokenPipeError:
                    pass
                if client.poll() is None:
                    client.terminate()
                    client.wait(timeout=10)
    finally:
        collect()
    with tarfile.open(evidence / "qualification.tar") as packed:
        retained = json.load(packed.extractfile("./receipt.json"))
    assert result == 0 and retained["status"] == "passed" and retained["source_git"] == revision, "qualification failed; retained logs are in qualification.tar"


def cleanup():
    state = state_for_cleanup()
    if state is None:
        return
    source = state["volumes"]["source"]
    assert source == state["container"] + "-source"
    found = subprocess.run(["docker", "volume", "inspect", "--format", '{{index .Labels "owner"}}', source], capture_output=True, text=True)
    if found.returncode == 0:
        assert found.stdout.strip() == OWNER
        call(["docker", "volume", "rm", source])


if __name__ == "__main__":
    def terminate(signum, _frame):
        raise SystemExit(128 + signum)
    if sys.argv[1] == "parent":
        signal.signal(signal.SIGTERM, terminate)
        signal.signal(signal.SIGINT, terminate)
    {"parent": parent, "child": child, "collect": collect, "cleanup-source": cleanup}[sys.argv[1]]()
