#!/usr/bin/env python3
"""Explicit real-release smoke and cache-freshness evidence; never a CI prerequisite."""
import json
from pathlib import Path
import xml.etree.ElementTree as ET
import runpy
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
API = runpy.run_path(str(ROOT / 'scripts/ripwire'))


def identities(output):
    # This diagnostic deliberately reads the release's observed XML; it is
    # not used by the adapter or exposed as an upstream compatibility API.
    tree = ET.fromstring(output)
    rows = []
    def visit(row, parent_path=''):
        path = row.get('p', parent_path)
        # Map symbols inherit their <f> path; find candidates carry their own.
        # Call edges have names too, but are not definition identities.
        if row.get('p') or (row.tag == 's' and path):
            rows.append((path, *(row.get(key, '') for key in ('n', 'l', 'id'))))
        for child in row:
            visit(child, path)
    visit(tree)
    return sorted(rows)


def main():
    if len(sys.argv) != 1:
        sys.exit('usage: scripts/ripwire-smoke')
    lock = API['read_lock'](ROOT)
    key = API['host_platform']()
    state = ROOT / 'target/ripwire'
    report = {'source_commit': API['git'](ROOT, 'rev-parse', 'HEAD'),
              'source_dirty': bool(API['git'](ROOT, 'status', '--porcelain')),
              'adapter_sha256': API['digest'](ROOT / 'scripts/ripwire'),
              'smoke_sha256': API['digest'](Path(__file__)),
              'tool_version': lock['version'], 'commands': [], 'freshness': []}
    with API['tool_lock'](state):
        binary, meta = API['installed'](ROOT, lock, key, check_cli=True)
        report['binary_sha256'] = meta['binary_sha256']
        evidence = state / 'evidence' / ('smoke-' + time.strftime('%Y%m%d-%H%M%S'))
        evidence.mkdir(parents=True)
        with tempfile.TemporaryDirectory(prefix='smoke-', dir=state) as scratch:
            root = Path(scratch)
            shutil.copytree(ROOT / 'tests/fixtures/ripwire', root, dirs_exist_ok=True)
            (root / '.gitignore').write_text('ignored/\ntarget/\n')
            (root / 'ignored').mkdir()
            (root / 'ignored/skip.py').write_text('def ignored_sentinel(): pass\n')
            for folder in ('docs/archive', 'tmp', 'docs/current'):
                (root / folder).mkdir(parents=True, exist_ok=True)
                (root / folder / 'guide.md').write_text('# Playback guide\nFixture playback decisions.\n')
            def git(*args):
                return API['git'](root, *args)
            git('init', '-q')
            git('config', 'user.name', 'Ripwire fixture')
            git('config', 'user.email', 'fixture@example.invalid')
            git('add', '.')
            git('commit', '-qm', 'fixture baseline')
            baseline = git('rev-parse', 'HEAD')
            def run(mode, selector=None, cold=False, profile='default'):
                values = [mode, '--profile', profile]
                if selector:
                    values += ['--base', selector] if mode == 'pr-context' else [selector]
                if cold:
                    values.append('--cold')
                args = API['arguments'](values)
                rec = {'dirty': bool(git('status', '--porcelain')), 'mode': mode}
                flags = API['query_args'](root, args, lock, key, rec)
                started = time.monotonic()
                code, out, err = API['bounded']([str(binary), *flags], root, 60)
                name = f'{len(report["commands"]):03}-{mode}'
                (evidence / (name + '.stdout')).write_bytes(out)
                (evidence / (name + '.stderr')).write_bytes(err)
                report['commands'].append(dict(mode=mode, selector=selector, cold=cold,
                                               profile=profile, exit=code, bytes=len(out),
                                               elapsed_ms=round((time.monotonic()-started)*1000),
                                               capture=name, **{k:v for k,v in rec.items() if k != 'mode'}))
                (evidence / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
                if code:
                    raise RuntimeError(f'{mode} failed with {code}; see {evidence}')
                return out
            for mode, selector in [('map', None), ('find', 'accept frame'),
                                   ('outline', 'lib/engine.rs:accept_frame'),
                                   ('body', 'lib/engine.rs:accept_frame'),
                                   ('callers', 'lib/engine.rs:accept_frame'),
                                   ('impact', 'lib/engine.rs:accept_frame'),
                                   ('pr-context', baseline), ('coverage', None)]:
                run(mode, selector)
            run('coverage', profile='history')
            for symbol in ('player.js:requestPlay', 'player.html:requestEmbeddedPlay',
                           'Player.kt:requestAndroidPlay', 'Player.swift:requestApplePlay',
                           'validate.py:validate_frame', 'accept_frame'):
                # Unsupported selectors may be refused. Record those observations.
                try:
                    run('callers', symbol)
                except RuntimeError:
                    pass
            def compare(label):
                for mode, selector in (('find', 'accept frame'), ('map', None)):
                    warm = run(mode, selector)
                    cold = run(mode, selector, cold=True)
                    a, b = identities(warm), identities(cold)
                    report['freshness'].append(dict(operation=label, mode=mode,
                                                    same_identities=a == b,
                                                    warm_identities=len(a), cold_identities=len(b)))
                    (evidence / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
                    if not a or a != b:
                        raise RuntimeError(f'freshness disagreement after {label} ({mode})')
                    if mode == 'map':
                        names = {(row[0], row[1]) for row in a if row[1]}
                        expected = {
                            'initial': ('lib/engine.rs', 'accept_frame'),
                            'edit': ('lib/engine.rs', 'accept_frame_edited'),
                            'rename': ('lib/renamed.rs', 'accept_frame_edited'),
                            'branch-change': ('lib/engine.rs', 'accept_frame'),
                            'corrupt-cache': ('lib/engine.rs', 'accept_frame'),
                        }.get(label)
                        if expected and expected not in names:
                            raise RuntimeError(f'expected mutated/restored symbol missing after {label}')
                        if label == 'edit' and ('lib/engine.rs', 'accept_frame') in names:
                            raise RuntimeError('old symbol survived edit')
                        if label == 'rename' and any(p == 'lib/engine.rs' for p, _ in names):
                            raise RuntimeError('old path survived rename')
                        if label == 'delete' and any(p in ('lib/engine.rs', 'lib/renamed.rs') for p, _ in names):
                            raise RuntimeError('deleted source symbols survived')

            compare('initial')
            source = root / 'lib/engine.rs'
            source.write_text(source.read_text().replace('accept_frame', 'accept_frame_edited'))
            compare('edit')
            source.rename(root / 'lib/renamed.rs')
            compare('rename')
            (root / 'lib/renamed.rs').unlink()
            compare('delete')
            git('checkout', '-qb', 'mutated')
            git('add', '.')
            git('commit', '-qm', 'fixture mutation')
            git('checkout', '-q', '--detach', baseline)
            compare('branch-change')
            for path in (root / 'target/ripwire/cache').rglob('*.ripwirecache'):
                path.write_bytes(b'corrupt-cache')
            compare('corrupt-cache')
        (evidence / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
        print(json.dumps({'evidence': str(evidence), 'freshness': report['freshness']}))


if __name__ == '__main__':
    try:
        main()
    except API['Refusal'] as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(exc.code)
