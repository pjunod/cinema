#!/usr/bin/env python3
"""Build a complete, deduplicated lockfile inventory for a RustSec scan."""

from __future__ import annotations

import argparse
import re
import tomllib
from pathlib import Path


VENDORED = (
    ("hiqlite", "0.14.0"),
    ("hiqlite-wal", "0.14.0"),
    ("s3-simple", "0.8.0"),
    ("rust_decimal", "1.42.1"),
)
PACKAGE_HEADER = re.compile(r"(?m)^\[\[package\]\]\n")
NON_PACKAGE_TABLE = re.compile(r"(?m)^\[(?!\[package\]\])")


def package_block(text: str, name: str, version: str) -> str:
    pattern = re.compile(
        rf'(?ms)^\[\[package\]\]\nname = "{re.escape(name)}"\n'
        rf'version = "{re.escape(version)}"\n.*?(?=^\[\[package\]\]|\Z)'
    )
    matches = pattern.findall(text)
    if len(matches) != 1:
        raise ValueError(f"expected one {name} {version} package block, found {len(matches)}")
    return matches[0]


def registry_fields(block: str, name: str, version: str) -> tuple[str, str]:
    source = re.search(r'^source = "([^"]+)"$', block, re.MULTILINE)
    checksum = re.search(r'^checksum = "([^"]+)"$', block, re.MULTILINE)
    if source is None or checksum is None:
        raise ValueError(f"registry evidence for {name} {version} has no source/checksum")
    return source.group(1), checksum.group(1)


def synthesize(root_lock: str, registry_lock: str) -> str:
    result = root_lock
    for name, version in VENDORED:
        upstream = package_block(registry_lock, name, version)
        source, checksum = registry_fields(upstream, name, version)
        patched = package_block(result, name, version)
        if re.search(r'^source = ', patched, re.MULTILINE):
            raise ValueError(f"patched {name} {version} unexpectedly already has a source")
        replacement = patched.replace(
            f'version = "{version}"\n',
            f'version = "{version}"\nsource = "{source}"\nchecksum = "{checksum}"\n',
            1,
        )
        result = result.replace(patched, replacement, 1)
    return result


def package_inventory(lock: str) -> tuple[str, list[str], str, list[tuple[str, str, str]]]:
    parsed = tomllib.loads(lock)
    packages = parsed.get("package", [])
    headers = list(PACKAGE_HEADER.finditer(lock))
    if len(headers) != len(packages):
        raise ValueError(
            f"lockfile declared {len(packages)} packages but exposed {len(headers)} blocks"
        )
    if not headers:
        raise ValueError("lockfile has no package inventory")

    suffix_match = NON_PACKAGE_TABLE.search(lock, headers[-1].end())
    package_end = suffix_match.start() if suffix_match else len(lock)
    blocks = [
        lock[header.start() : headers[index + 1].start() if index + 1 < len(headers) else package_end]
        for index, header in enumerate(headers)
    ]
    identities = [
        (
            str(package["name"]),
            str(package["version"]),
            str(package.get("source", "")),
        )
        for package in packages
    ]
    if len(set(identities)) != len(identities):
        raise ValueError("lockfile contains duplicate package identities")
    return lock[: headers[0].start()], blocks, lock[package_end:], identities


def merge_package_inventories(primary: str, additions: list[str]) -> str:
    preamble, blocks, suffix, identities = package_inventory(primary)
    known = set(identities)
    merged = list(blocks)
    primary_version = tomllib.loads(primary).get("version")

    for addition in additions:
        if tomllib.loads(addition).get("version") != primary_version:
            raise ValueError("lockfile versions do not match")
        _, extra_blocks, _, extra_identities = package_inventory(addition)
        for block, identity in zip(extra_blocks, extra_identities, strict=True):
            if identity in known:
                continue
            known.add(identity)
            merged.append(block)

    return preamble + "".join(merged).rstrip() + "\n" + suffix.lstrip("\n")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path("Cargo.lock"))
    parser.add_argument(
        "--registry-evidence",
        type=Path,
        default=Path("spikes/hiqlite-m0/Cargo.lock"),
    )
    parser.add_argument(
        "--additional-lock",
        action="append",
        default=[],
        type=Path,
        help="merge another lockfile's packages into the audit inventory",
    )
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    output = synthesize(
        args.root.read_text(encoding="utf-8"),
        args.registry_evidence.read_text(encoding="utf-8"),
    )
    output = merge_package_inventories(
        output,
        [path.read_text(encoding="utf-8") for path in args.additional_lock],
    )
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(output, encoding="utf-8")


if __name__ == "__main__":
    main()
