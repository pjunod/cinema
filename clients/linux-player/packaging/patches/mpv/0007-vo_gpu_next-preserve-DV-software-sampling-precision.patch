+#ifndef MPV_DV_UPLOAD_H
+#define MPV_DV_UPLOAD_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <libplacebo/utils/upload.h>
+#include "ta/ta.h"
+
+// Only native-endian planar low-aligned 10-bit samples in UNORM16 storage.
+// plane_data_from_imgfmt has already rejected non-native endian formats.
+// UINT/manual filtering, P010, hardware imports and other layouts keep their
+// original path. Require the actual selected format to support linear sampling.
+static inline bool plurx_dv_shift10_supported(pl_gpu gpu, bool precise_sw10, int planes,
+                                          struct pl_bit_encoding bits,
+                                          const struct pl_plane_data data[4])
+{
+    if (!precise_sw10 || planes != 3 || bits.sample_depth != 16 ||
+        bits.color_depth != 10 || bits.bit_shift != 0)
+        return false;
+    for (int p = 0; p < planes; p++) {
+        const struct pl_plane_data *d = &data[p];
+        if (d->type != PL_FMT_UNORM || d->swapped || d->pixel_stride != 2 ||
+            d->component_size[0] != 16 || d->component_pad[0] ||
+            d->component_map[0] != p)
+            return false;
+        for (int c = 1; c < 4; c++) {
+            if (d->component_size[c] || d->component_pad[c])
+                return false;
+        }
+        int mapping[4];
+        pl_fmt fmt = pl_plane_find_fmt(gpu, mapping, d);
+        if (!fmt || fmt->type != PL_FMT_UNORM || fmt->num_components != 1 ||
+            fmt->component_depth[0] != 16 || !(fmt->caps & PL_FMT_CAP_LINEAR))
+            return false;
+    }
+    return true;
+}
+
+static inline bool plurx_dv_shift10_size(int width, int height, ptrdiff_t stride,
+                                     size_t *row_bytes, size_t *bytes)
+{
+    if (width <= 0 || height <= 0 || stride == PTRDIFF_MIN ||
+        (size_t)width > SIZE_MAX / sizeof(uint16_t))
+        return false;
+    size_t row = (size_t)width * sizeof(uint16_t);
+    size_t pitch = stride < 0 ? (size_t)-stride : (size_t)stride;
+    if (pitch < row || row > PTRDIFF_MAX ||
+        (size_t)height > SIZE_MAX / row ||
+        (size_t)(height - 1) > ((size_t)PTRDIFF_MAX - row) / pitch)
+        return false;
+    *row_bytes = row;
+    *bytes = row * (size_t)height;
+    return true;
+}
+
+// Pack physical rows in ascending address order; retain the original flipped
+// flag so negative-stride images keep exactly the same sampled coordinates.
+// memcpy handles unaligned decoder storage without aliasing/alignment UB.
+static inline bool plurx_dv_shift10_pack(uint8_t *dst, size_t capacity,
+                                     const uint8_t *src, ptrdiff_t stride,
+                                     int width, int height)
+{
+    size_t row, bytes;
+    if (!src || !dst || !plurx_dv_shift10_size(width, height, stride, &row, &bytes) ||
+        capacity < bytes)
+        return false;
+    if (stride < 0) {
+        src += (height - 1) * stride;
+        stride = -stride;
+    }
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            uint16_t code;
+            memcpy(&code, src + (size_t)y * stride + (size_t)x * 2, 2);
+            if (code > 1023)
+                return false;
+            code <<= 6;
+            memcpy(dst + (size_t)y * row + (size_t)x * 2, &code, 2);
+        }
+    }
+    return true;
+}
+
+static inline bool plurx_dv_upload_shift10(pl_gpu gpu, struct pl_plane *plane,
+                                       pl_tex *tex, struct pl_plane_data data,
+                                       const uint8_t *src, ptrdiff_t stride)
+{
+    size_t row, bytes;
+    if (!plurx_dv_shift10_size(data.width, data.height, stride, &row, &bytes))
+        return false;
+    uint8_t *stage = ta_alloc_size(NULL, bytes);
+    if (!stage)
+        return false;
+    if (!plurx_dv_shift10_pack(stage, bytes, src, stride, data.width, data.height)) {
+        ta_free(stage);
+        return false;
+    }
+    data.pixels = stage;
+    data.row_stride = row;
+    data.buf = NULL;
+    data.buf_offset = 0;
+    data.callback = NULL;
+    data.priv = NULL;
+    plane->flipped = stride < 0;
+    // LP387 gpu.h guarantees callback-null host pointers are consumed/copied
+    // before return; the GPU transfer can continue from an internal PBO.
+    // Never attach this owned staging to the decoder's DR buffer or MPI.
+    // A callback is unsafe to free again on false: LP's PBO copy may call it
+    // immediately, then fail a subsequent GPU upload (gpu/utils.c).
+    bool ok = pl_upload_plane(gpu, plane, tex, &data);
+    ta_free(stage);
+    return ok;
+}
+#endif
