+        pl_shader_sample_direct(sh, pl_sample_src(.tex = out));
+        if (t->gain != 1) {
+            // Absolute mapping: the frame is in the panel's nits; bring it
+            // to libplacebo's scale, which the compositor scales back.
+            struct pl_color_space pq = pl_color_space_hdr10;
+            char body[64];
