+/*
+ * Closed-form Dolby Vision display management for plurx Player.
+ *
+ * A Profile 5 or 8 frame is reconstructed to BT.2020/PQ by libplacebo (the
+ * RPU's reshaping and colour conversion only, no tone mapping), then mapped
+ * for the display with plurx's closed-form CM v4.0 / CM v2.9 equations
+ * (plurx/dv_dm.h, copied from plurx's tools/dv_processing when the package
+ * is built). The mapped frame carries the target's own colour volume, so the
+ * final render has nothing left to map and the compositor only finishes the
+ * named gamut to the panel's real primaries.
+ *
+ * The target is the compositor's preferred description: its luminance range
+ * and the largest named gamut (BT.2020, P3-D65 or BT.709) that fits inside
+ * the panel's primaries, within half a step of the precision those primaries
+ * were reported in (EDID 10-bit or DisplayID 12-bit).
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <libplacebo/renderer.h>
+
+struct mp_image;
+struct plurx_dv;
+struct plurx_dv_source;
+
+struct plurx_dv_target {
+    int prim;                        // enum dm_prim
+    double min_nits, peak_nits;      // the display the equations map for
+    // Scale from the mapping's nits to libplacebo's reference-white scale
+    // (203 / the compositor's reference luminance) when mapping for the
+    // panel's absolute luminance; 1 when mapping on libplacebo's scale.
+    double gain;
+    struct pl_raw_primaries named;   // the named gamut's RGBW (D65)
+    const char *primaries_source;    // "edid-10bit", "displayid-12bit" or "unstated"
+    double tolerance;                // containment tolerance, xy distance
+};
+
+struct plurx_dv_report {
+    int algo;                        // 4 or 29
+    const char *trim;                // "l8-interpolated", "l2-exact", "l2-interpolated", "l1-only"
+};
+
+// Name of a target's named gamut, as the "plurx mapper:" line prints it.
+const char *plurx_dv_gamut_name(int prim);
+
+// The display's preferred colour space (mpv's target_csp) to a target, or
+// false with *why when the display is not in PQ/BT.2020 HDR mode or reports
+// no usable luminance or primaries.
+bool plurx_dv_select_target(const struct pl_color_space *display,
+                            struct plurx_dv_target *out, const char **why);
+
+// Map for the panel's absolute luminance instead of libplacebo's reference-
+// white scale: ref is the compositor's reference luminance in nits.
+void plurx_dv_target_absolute(struct plurx_dv_target *t, double ref);
+
+// The colour space of a mapped frame, and of the swapchain hint for it.
+struct pl_color_space plurx_dv_output_color(const struct plurx_dv_target *t);
+
+// True if mpv decoded this frame as Dolby Vision with an RPU it reconstructs
+// (Profile 5, 8, or 7 with its enhancement layer paired by mpv).
+bool plurx_dv_declared(const struct mp_image *mpi);
+
+struct plurx_dv *plurx_dv_create(pl_gpu gpu, pl_log log);
+void plurx_dv_destroy(struct plurx_dv **dv);
+
+// Parse the frame's RPU once. Never NULL except on allocation failure; a
+// refused source reports why with plurx_dv_source_refusal().
+struct plurx_dv_source *plurx_dv_source_create(const struct mp_image *mpi);
+void plurx_dv_source_free(struct plurx_dv_source **s);
+const char *plurx_dv_source_refusal(const struct plurx_dv_source *s);
+
+// Map one decoded frame for the target. The mapped texture is kept by the
+// source and reused while the target and trim switches stay the same. On
+// success *view is the mapped frame with geometry (crop, rotation,
+// overlays) copied from `decoded`, and *signature changes whenever its
+// pixels do.
+bool plurx_dv_map(struct plurx_dv *dv, struct plurx_dv_source *s,
+                  const struct pl_frame *decoded, int width, int height,
+                  const struct plurx_dv_target *t, bool cm4_trims, bool cm29_trims,
+                  struct pl_frame *view, uint64_t *signature,
+                  struct plurx_dv_report *report, const char **why);
