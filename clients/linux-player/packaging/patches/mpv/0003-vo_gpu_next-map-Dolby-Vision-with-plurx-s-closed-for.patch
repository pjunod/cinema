+        sig = mix64(sig, (uint64_t)llrint(t->min_nits * 1e6));
+        sig = mix64(sig, (uint64_t)llrint(t->peak_nits * 1e6));
+        sig = mix64(sig, (uint64_t)llrint(t->gain * 1e9));
+        s->signature = mix64(sig, (cm4_trims ? 1u : 0u) | (cm29_trims ? 2u : 0u));
+    }
+    *view = (struct pl_frame) {
+        .num_planes = 1,
+        .planes = {{.texture = s->mapped, .components = 3, .component_mapping = {0, 1, 2}}},
+        .repr = {.sys = PL_COLOR_SYSTEM_RGB, .levels = PL_COLOR_LEVELS_FULL,
+                 .alpha = PL_ALPHA_NONE},
+        .color = plurx_dv_output_color(t),
+        .crop = decoded->crop,
+        .rotation = decoded->rotation,
+        .overlays = decoded->overlays,
+        .num_overlays = decoded->num_overlays,
+        .user_data = decoded->user_data,
+    };
+    if (!view->crop.x1 && !view->crop.y1)
+        view->crop = (pl_rect2df){0, 0, width, height};
+    *signature = s->signature;
+    *report = s->report;
+    return true;
+}
