+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libavutil/frame.h>
+// libdovi C API header pinned by the package (plurx tools use the same one);
+// the library itself is the distribution's libdovi.
+#include "plurx/rpu_parser.h"
+#include <libplacebo/filters.h>
+#include <stdio.h>
+#include <libplacebo/shaders/colorspace.h>
+#include <libplacebo/shaders/custom.h>
+#include <libplacebo/shaders/sampling.h>
+
+// plurx's closed-form display management: the same header the plurx server
+// renders with, copied in by the package build.
+#include "plurx/dv_dm.h"
+
+#include "plurx_dv.h"
+#include "video/mp_image.h"
+
+// ------------------------------------------------------------------ target
+
+// Exact named primaries (x, y) and D65.
+static const double named_xy[3][3][2] = {
+    [DM_BT2020] = {{.708, .292}, {.170, .797}, {.131, .046}},
+    [DM_P3D65]  = {{.680, .320}, {.265, .690}, {.150, .060}},
+    [DM_BT709]  = {{.640, .330}, {.300, .600}, {.150, .060}},
+};
+static const double d65_xy[2] = {.3127, .3290};
+// Mutter's D65 white in XYZ, the frame the compositor compares gamuts in
+// (from D65 xy this adaptation is nearly the identity).
+static const double common_white[3] = {.95047, 1.0, 1.08883};
+static const double bradford[3][3] = {
+    { .8951,  .2664, -.1614},
+    {-.7502, 1.7135,  .0367},
+    { .0389, -.0685, 1.0296},
+};
+
+const char *plurx_dv_gamut_name(int prim)
+{
+    switch (prim) {
+    case DM_BT2020: return "BT.2020";
+    case DM_P3D65: return "P3-D65";
+    case DM_BT709: return "BT.709";
+    }
+    return "unknown";
+}
+
+static void mv3(const double m[3][3], const double v[3], double o[3])
+{
+    for (int i = 0; i < 3; i++)
+        o[i] = m[i][0] * v[0] + m[i][1] * v[1] + m[i][2] * v[2];
+}
+
+static bool inv3(const double m[3][3], double o[3][3])
+{
+    double c00 = m[1][1] * m[2][2] - m[1][2] * m[2][1];
+    double c01 = m[1][2] * m[2][0] - m[1][0] * m[2][2];
+    double c02 = m[1][0] * m[2][1] - m[1][1] * m[2][0];
+    double det = m[0][0] * c00 + m[0][1] * c01 + m[0][2] * c02;
+    if (!isfinite(det) || det == 0)
+        return false;
+    o[0][0] = c00 / det;
+    o[0][1] = (m[0][2] * m[2][1] - m[0][1] * m[2][2]) / det;
+    o[0][2] = (m[0][1] * m[1][2] - m[0][2] * m[1][1]) / det;
+    o[1][0] = c01 / det;
+    o[1][1] = (m[0][0] * m[2][2] - m[0][2] * m[2][0]) / det;
+    o[1][2] = (m[0][2] * m[1][0] - m[0][0] * m[1][2]) / det;
+    o[2][0] = c02 / det;
+    o[2][1] = (m[0][1] * m[2][0] - m[0][0] * m[2][1]) / det;
+    o[2][2] = (m[0][0] * m[1][1] - m[0][1] * m[1][0]) / det;
+    return true;
+}
+
+// Bradford adaptation of chromaticities from D65 (xy) to the common frame,
+// normalized by X+Y+Z.
+struct cat {
+    double back[3][3], gain[3];
+};
+
+static bool cat_init(struct cat *c)
+{
+    double src[3] = {d65_xy[0] / d65_xy[1], 1, (1 - d65_xy[0] - d65_xy[1]) / d65_xy[1]};
+    double ls[3], ld[3];
+    if (!inv3(bradford, c->back))
+        return false;
+    mv3(bradford, src, ls);
+    mv3(bradford, common_white, ld);
+    for (int i = 0; i < 3; i++)
+        c->gain[i] = ld[i] / ls[i];
+    return true;
+}
+
+static bool adapt(const struct cat *c, double x, double y, double out[2])
+{
+    double xyz[3] = {x, y, 1 - x - y}, l[3], r[3];
+    mv3(bradford, xyz, l);
+    for (int i = 0; i < 3; i++)
+        l[i] *= c->gain[i];
+    mv3(c->back, l, r);
+    double s = r[0] + r[1] + r[2];
+    if (!isfinite(s) || s == 0)
+        return false;
+    out[0] = r[0] / s;
+    out[1] = r[1] / s;
+    return isfinite(out[0]) && isfinite(out[1]);
+}
+
+// The protocol carries primaries as xy * 1e6, not the panel's own storage.
+// The six primary coordinates (not the white, which a compositor may
+// replace with D65) all within one unit of a multiple of 1/4096 are
+// DisplayID 12-bit; otherwise they are taken as EDID's 10-bit, the coarsest
+// a display reports. A named vertex counts as inside when it is at most one
+// step outside the panel triangle: rounding x and y each by half a step can
+// move a vertex by up to sqrt(2)/2 of a step, and an encoder may truncate.
+static void primaries_source(const int32_t wire[8], struct plurx_dv_target *out)
+{
+    double n = 4096;
+    bool displayid = true;
+    for (int i = 0; i < 6 && displayid; i++) {
+        double code = nearbyint(wire[i] * n / 1e6);
+        displayid = fabs(wire[i] - code * 1e6 / n) < 1.0;
+    }
+    if (!displayid)
+        n = 1024;
+    out->primaries_source = displayid ? "displayid-12bit" : "edid-10bit";
+    out->tolerance = 1.0 / n;
+}
+
+// Largest perpendicular xy distance of p outside any edge of triangle t
+// (negative: inside by that margin).
+static double outside_distance(const double t[3][2], const double p[2])
+{
+    double worst = -INFINITY;
+    for (int i = 0; i < 3; i++) {
+        const double *a = t[i], *b = t[(i + 1) % 3], *c = t[(i + 2) % 3];
+        double ex = b[0] - a[0], ey = b[1] - a[1], len = hypot(ex, ey);
+        double side_c = ex * (c[1] - a[1]) - ey * (c[0] - a[0]);
+        double side_p = (ex * (p[1] - a[1]) - ey * (p[0] - a[0])) / len;
+        worst = fmax(worst, side_c > 0 ? -side_p : side_p);
+    }
+    return worst;
+}
+
+static bool refuse(const char **why, const char *reason)
+{
+    *why = reason;
+    return false;
+}
+
+bool plurx_dv_select_target(const struct pl_color_space *display,
+                            struct plurx_dv_target *out, const char **why)
+{
+    *why = NULL;
+    *out = (struct plurx_dv_target){0};
+    if (display->transfer != PL_COLOR_TRC_PQ || display->primaries != PL_COLOR_PRIM_BT_2020)
+        return refuse(why, "the display is not in HDR (BT.2020/PQ) mode");
+    double peak = display->hdr.max_luma, black = display->hdr.min_luma;
+    if (!(peak > 0) || !(peak <= 10000) || !(black >= 0) || !(black < peak))
+        return refuse(why, "the display reports no usable luminance range");
+    const struct pl_raw_primaries *p = &display->hdr.prim;
+    if (!pl_primaries_valid(p))
+        return refuse(why, "the display reports no panel primaries");
+
+    const struct pl_cie_xy *v[4] = {&p->red, &p->green, &p->blue, &p->white};
+    int32_t wire[8];
+    double tri[3][2];
+    struct cat cat;
+    if (!cat_init(&cat))
+        return refuse(why, "internal: chromatic adaptation");
+    for (int i = 0; i < 4; i++) {
+        wire[2 * i] = lrint(v[i]->x * 1e6);
+        wire[2 * i + 1] = lrint(v[i]->y * 1e6);
+        if (i < 3 && !adapt(&cat, wire[2 * i] / 1e6, wire[2 * i + 1] / 1e6, tri[i]))
+            return refuse(why, "the display reports invalid panel primaries");
+    }
+    double area = (tri[1][0] - tri[0][0]) * (tri[2][1] - tri[0][1]) -
+                  (tri[2][0] - tri[0][0]) * (tri[1][1] - tri[0][1]);
+    if (!(fabs(area) > 1e-9))
+        return refuse(why, "the display reports degenerate panel primaries");
+
+    primaries_source(wire, out);
+    out->prim = DM_BT709; // the smallest, used when none fits
+    for (int c = DM_BT2020; c <= DM_BT709; c++) {
+        double worst = -INFINITY;
+        for (int i = 0; i < 3; i++) {
+            double q[2];
+            if (!adapt(&cat, named_xy[c][i][0], named_xy[c][i][1], q))
+                return refuse(why, "internal: named primaries");
+            worst = fmax(worst, outside_distance(tri, q));
+        }
+        if (worst <= out->tolerance) {
+            out->prim = c;
+            break;
+        }
+    }
+    static const enum pl_color_primaries pl_named[] = {
+        [DM_BT2020] = PL_COLOR_PRIM_BT_2020,
+        [DM_P3D65] = PL_COLOR_PRIM_DISPLAY_P3,
+        [DM_BT709] = PL_COLOR_PRIM_BT_709,
+    };
+    out->named = *pl_raw_primaries_get(pl_named[out->prim]);
+    out->min_nits = black;
+    out->peak_nits = peak;
+    out->gain = 1;
+    return true;
+}
+
+void plurx_dv_target_absolute(struct plurx_dv_target *t, double ref)
+{
+    // mpv rescales the compositor's luminances so its reference white sits
+    // at 203 nits; undo that for the mapping, and scale the result back.
+    if (!(ref > 0) || ref == PL_COLOR_SDR_WHITE)
+        return;
+    // (mpv keeps the minimum display-referred; only the peak is rescaled)
+    t->gain = PL_COLOR_SDR_WHITE / ref;
+    t->peak_nits /= t->gain;
+}
+
+struct pl_color_space plurx_dv_output_color(const struct plurx_dv_target *t)
+{
+    return (struct pl_color_space) {
+        .primaries = PL_COLOR_PRIM_BT_2020,
+        .transfer = PL_COLOR_TRC_PQ,
+        .hdr = {
+            .prim = t->named,
+            .min_luma = t->min_nits,
+            .max_luma = t->peak_nits * t->gain,
+            // The mapped frame never exceeds the target: maximum content and
+            // frame-average light levels are the target peak (the protocol
+            // refuses a zero maxFALL).
+            .max_cll = t->peak_nits * t->gain,
+            .max_fall = t->peak_nits * t->gain,
+        },
+    };
+}
+
+// ------------------------------------------------------------------ frames
+
+struct plurx_dv {
+    pl_gpu gpu;
+    pl_log log;
+    pl_renderer recon;   // reconstruction only, never the presentation renderer
+    pl_tex native;       // BT.2020/PQ RGBA32F reconstruction, reused per frame
+    pl_dispatch copy;    // keeps each frame's mapped result
+};
+
+struct plurx_dv_source {
+    pl_gpu gpu;
+    const char *refusal;
+    DoviRpuOpaque *rpu;
+    const DoviVdrDmData *dm;
+    double mastering_peak;
+    pl_tex mapped;
+    bool mapped_valid;
+    struct plurx_dv_target mapped_target;
+    bool mapped_cm4, mapped_cm29;
+    struct plurx_dv_report report;
+    uint64_t signature;
+};
+
+static const struct mp_ff_side_data *side_data(const struct mp_image *mpi, int type)
+{
+    for (int i = 0; i < mpi->num_ff_side_data; i++) {
+        if (mpi->ff_side_data[i].type == type && mpi->ff_side_data[i].buf)
+            return &mpi->ff_side_data[i];
+    }
+    return NULL;
+}
+
+bool plurx_dv_declared(const struct mp_image *mpi)
+{
+    return mpi && mpi->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION &&
+           mpi->params.repr.dovi && side_data(mpi, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+}
+
+struct plurx_dv *plurx_dv_create(pl_gpu gpu, pl_log log)
+{
+    struct plurx_dv *dv = calloc(1, sizeof(*dv));
+    if (!dv)
+        return NULL;
+    dv->gpu = gpu;
+    dv->log = log;
+    // Every format the mapping needs, checked once: the reconstruction and
+    // the mapped frame (16-bit UNORM; PQ is in [0, 1]), and dv_dm.h's
+    // float intermediates, which it samples with linear filtering.
+    bool formats =
+        pl_find_fmt(gpu, PL_FMT_UNORM, 4, 16, 16, PL_FMT_CAP_RENDERABLE |
+                    PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_LINEAR) &&
+        pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32, PL_FMT_CAP_RENDERABLE |
+                    PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_LINEAR);
+    dv->recon = pl_renderer_create(log, gpu);
+    dv->copy = pl_dispatch_create(log, gpu);
+    if (!formats || !dv->recon || !dv->copy)
+        plurx_dv_destroy(&dv);
+    return dv;
+}
+
+void plurx_dv_destroy(struct plurx_dv **value)
+{
+    struct plurx_dv *dv = *value;
+    if (!dv)
+        return;
+    dv_dm_destroy(dv->gpu);
+    pl_tex_destroy(dv->gpu, &dv->native);
+    pl_dispatch_destroy(&dv->copy);
+    pl_renderer_destroy(&dv->recon);
+    free(dv);
+    *value = NULL;
+}
+
+struct plurx_dv_source *plurx_dv_source_create(const struct mp_image *mpi)
+{
+    struct plurx_dv_source *s = calloc(1, sizeof(*s));
+    if (!s)
+        return NULL;
+    const struct mp_ff_side_data *raw = side_data(mpi, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+    if (!raw || !raw->buf->size || raw->buf->size > 65536) {
+        s->refusal = "the frame has no raw Dolby Vision RPU";
+        return s;
+    }
+    // libdovi parses the whole NAL unit; FFmpeg exports it without the
+    // two-byte UNSPEC62 NAL header.
+    size_t size = raw->buf->size + 2;
+    uint8_t *nal = malloc(size);
+    if (!nal) {
+        s->refusal = "out of memory";
+        return s;
+    }
+    nal[0] = 0x7c;
+    nal[1] = 0x01;
+    memcpy(nal + 2, raw->buf->data, raw->buf->size);
+    s->rpu = dovi_parse_unspec62_nalu(nal, size);
+    free(nal);
+    if (!s->rpu || dovi_rpu_get_error(s->rpu)) {
+        s->refusal = "the Dolby Vision RPU does not parse";
+        return s;
+    }
+    s->dm = dovi_rpu_get_vdr_dm_data(s->rpu);
+    if (!s->dm || !s->dm->dm_data.level1) {
+        s->refusal = "the Dolby Vision RPU has no L1 metadata";
+        return s;
+    }
+    const DoviExtMetadataBlockLevel6 *l6 = s->dm->dm_data.level6;
+    s->mastering_peak = l6 && l6->max_display_mastering_luminance
+                      ? l6->max_display_mastering_luminance : 4000;
+    return s;
+}
+
+void plurx_dv_source_free(struct plurx_dv_source **value)
+{
+    struct plurx_dv_source *s = *value;
+    if (!s)
+        return;
+    if (s->gpu)
+        pl_tex_destroy(s->gpu, &s->mapped);
+    if (s->dm)
+        dovi_rpu_free_vdr_dm_data(s->dm);
+    if (s->rpu)
+        dovi_rpu_free(s->rpu);
+    free(s);
+    *value = NULL;
+}
+
+const char *plurx_dv_source_refusal(const struct plurx_dv_source *s)
+{
+    return s ? s->refusal : "out of memory";
+}
+
+// The RPU's reconstruction to BT.2020/PQ, exactly as the plurx server
+// renders its master: libplacebo applies the reshaping and colour
+// conversion, and identical 0.005-10000 nit source and destination volumes
+// with clipping make its colour mapping an identity.
+static bool reconstruct(struct plurx_dv *dv, const struct pl_frame *decoded,
+                        int w, int h, const char **why)
+{
+    // 16-bit UNORM: the reconstruction is clipped to PQ [0, 1], and 1.5e-5
+    // is far below the mapping's own precision.
+    pl_fmt fmt = pl_find_fmt(dv->gpu, PL_FMT_UNORM, 4, 16, 16,
+                             PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+    if (!fmt)
+        return refuse(why, "the GPU has no renderable RGBA16 format");
+    if (!pl_tex_recreate(dv->gpu, &dv->native, pl_tex_params(.w = w, .h = h,
+                         .format = fmt, .renderable = true, .sampleable = true)))
+        return refuse(why, "reconstruction texture allocation failed");
+
+    struct pl_frame image = *decoded;
+    image.crop = (pl_rect2df){0, 0, w, h};
+    image.rotation = PL_ROTATION_0;
+    image.overlays = NULL;
+    image.num_overlays = 0;
+    image.icc = NULL;
+    image.profile = (struct pl_icc_profile){0};
+    image.lut = NULL;
+    image.film_grain = (struct pl_film_grain_data){0};
+    image.color.hdr.max_luma = 10000;
+    image.color.hdr.min_luma = 0.005;
+    struct pl_frame target = {
+        .num_planes = 1,
+        .planes = {{.texture = dv->native, .components = 3, .component_mapping = {0, 1, 2}}},
+        // No .bits on a float target: libplacebo 7.360 would scale the output
+        // as if it were 32-bit integer samples.
+        .repr = {.sys = PL_COLOR_SYSTEM_RGB, .levels = PL_COLOR_LEVELS_FULL},
+        .color = pl_color_space_hdr10,
+        .crop = {0, 0, w, h},
+    };
+    target.color.hdr.max_luma = 10000;
+    target.color.hdr.min_luma = 0.005;
+
+    struct pl_color_map_params cmap = pl_color_map_default_params;
+    cmap.tone_mapping_function = &pl_tone_map_clip;
+    cmap.gamut_mapping = &pl_gamut_map_clip;
+    cmap.metadata = PL_HDR_METADATA_NONE;
+    struct pl_render_params params = pl_render_fast_params;
+    params.color_map_params = &cmap;
+    params.plane_upscaler = &pl_filter_bilinear;
+    params.plane_downscaler = &pl_filter_bilinear;
+    params.dither_params = NULL;
+    params.peak_detect_params = NULL;
+    params.color_adjustment = NULL;
+    params.sigmoid_params = NULL;
+    params.skip_caching_single_frame = true;
+
+    pl_renderer_reset_errors(dv->recon, NULL);
+    if (!pl_render_image(dv->recon, &image, &target, &params))
+        return refuse(why, "Dolby Vision reconstruction failed");
+    return true;
+}
+
+static uint64_t mix64(uint64_t h, uint64_t v)
+{
+    return h ^ (v + UINT64_C(0x9e3779b97f4a7c15) + (h << 6) + (h >> 2));
+}
+
+bool plurx_dv_map(struct plurx_dv *dv, struct plurx_dv_source *s,
+                  const struct pl_frame *decoded, int width, int height,
+                  const struct plurx_dv_target *t, bool cm4_trims, bool cm29_trims,
+                  struct pl_frame *view, uint64_t *signature,
+                  struct plurx_dv_report *report, const char **why)
+{
+    *why = NULL;
+    if (s->refusal)
+        return refuse(why, s->refusal);
+    if (width <= 0 || height <= 0)
+        return refuse(why, "invalid frame size");
+    bool same = s->mapped_valid && s->mapped_cm4 == cm4_trims && s->mapped_cm29 == cm29_trims &&
+                s->mapped_target.prim == t->prim && s->mapped_target.min_nits == t->min_nits &&
+                s->mapped_target.peak_nits == t->peak_nits && s->mapped_target.gain == t->gain;
+    if (!same) {
+        s->mapped_valid = false;
+        dv_dm_frame *f = malloc(sizeof(*f));
+        if (!f)
+            return refuse(why, "out of memory");
+        const char *bad = dv_dm_prepare(s->dm, t->peak_nits, t->min_nits, (enum dm_prim)t->prim,
+                                        s->mastering_peak, cm4_trims, cm29_trims, f);
+        if (bad) {
+            free(f);
+            return refuse(why, "the Dolby Vision metadata cannot be mapped for this display");
+        }
+        pl_tex out = NULL;
+        if (reconstruct(dv, decoded, width, height, why))
+            out = dv_dm_render(dv->log, dv->gpu, dv->native, f);
+        s->report = (struct plurx_dv_report){.algo = f->algo, .trim = f->trim};
+        free(f);
+        if (!out)
+            return refuse(why, *why ? *why : "the closed-form mapping failed on the GPU");
+        // Keep this frame's result: dv_dm_render reuses its output texture.
+        // The mapped PQ is in [0, 1]; 16-bit UNORM keeps it to 1.5e-5, half
+        // the memory of the float output (half float would lose up to 5e-4).
+        pl_fmt fmt = pl_find_fmt(dv->gpu, PL_FMT_UNORM, 4, 16, 16,
+                                 PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_LINEAR);
+        if (!fmt)
+            fmt = out->params.format;
+        s->gpu = dv->gpu;
+        if (!pl_tex_recreate(dv->gpu, &s->mapped, pl_tex_params(.w = width, .h = height,
+                             .format = fmt, .sampleable = true, .renderable = true)))
+            return refuse(why, "mapped texture allocation failed");
