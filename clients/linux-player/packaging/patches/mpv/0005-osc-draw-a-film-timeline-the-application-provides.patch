From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: plurx contributors <noreply@plurx.invalid>
Date: Mon, 26 Oct 2026 12:00:00 +0000
Subject: [PATCH 5/5] osc: draw a film timeline the application provides

An application that plays part of a longer film, such as a live
presentation that starts part way in and grows, can set
user-data/osc/film to {origin = <s>, duration = <s>}. The seekbar, its
tooltip and seekable ranges, and both time codes then show the whole film
instead of the stream mpv holds, and a seek outside what the stream holds
is handed to the application as the script message
"osc-film-seek <seconds>" instead of being sent to mpv, which could only
clamp it. Unset, the OSC behaves exactly as before.
---
 player/lua/osc.lua | 91 ++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 80 insertions(+), 11 deletions(-)

diff --git a/player/lua/osc.lua b/player/lua/osc.lua
index 80604ca52..918d03cd7 100644
--- a/player/lua/osc.lua
+++ b/player/lua/osc.lua
@@ -366,6 +366,52 @@ local state = {
     osc_tracklist_warned = false,
 }
 
+-- A film timeline the embedding application sets in user-data/osc/film as
+-- {origin = <s>, duration = <s>} when the stream mpv plays covers only part
+-- of a longer film: a live presentation that starts at `origin` and grows.
+-- The seekbar and the time display then show the whole film, and a seek
+-- outside what the stream holds is handed to the application as the script
+-- message "osc-film-seek <s>" instead of being sent to mpv.
+local function film()
+    local f = state.film
+    if type(f) == "table" and type(f.origin) == "number"
+            and type(f.duration) == "number" and f.duration > 0 then
+        return f
+    end
+    return nil
+end
+
+local function osc_duration()
+    local f = film()
+    return f and f.duration or state.duration
+end
+
+local function film_position()
+    local f = film()
+    local t = mp.get_property_number("playback-time")
+    if not f or not t then
+        return nil
+    end
+    return f.origin + t
+end
+
+-- Seek to `pos` percent of the timeline the OSC shows.
+local function seek_percent(pos, flags)
+    local f = film()
+    if not f then
+        mp.commandv("seek", pos, flags)
+        return
+    end
+    local target = f.duration * pos / 100
+    local held = mp.get_property_number("duration")
+    local local_target = target - f.origin
+    if held and local_target >= 0 and local_target <= held then
+        mp.commandv("seek", local_target, "absolute+exact")
+    else
+        mp.commandv("script-message", "osc-film-seek", tostring(target))
+    end
+end
+
