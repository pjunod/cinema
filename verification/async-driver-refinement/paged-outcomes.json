  "monitors": {
    "BothSelectedCompletion": {
      "goal": "DoneJobs(sql)=Nodes",
      "initial": "seen_goal=goal(Init)",
      "next": "seen_goal_next=seen_goal OR goal(next)",
      "violating_suffix": "seen_goal=false"
    },
    "ConditionalAttemptCleanup": {
      "P": "w[n].stage=driver AND w[n].started AND w[n].job=j AND w[n].attempt=a",
      "Q": "w[n].stage=driver AND w[n].dropped AND w[n].job=j AND w[n].attempt=a",
      "identity": "every fixed worker n, selected job j and attempt a, exactly original AttemptCleanup quantification",
      "initial": "pending=P(Init) AND NOT Q(Init); capacity_ok=WithinEpisodeCapacity(Init)",
      "next": "pending_next=(pending OR P(next)) AND NOT Q(next); capacity_ok_next=capacity_ok AND WithinEpisodeCapacity(next)",
      "violating_suffix": "pending=true permanently for some matching job/attempt AND capacity_ok=true throughout prefix and suffix",
      "reject": "GF pending alone is insufficient"
    }
  },
  "fairness": {
    "enabledness": "full original graph ENABLED <A>_vars including outgoing component edges",
    "occurrence": "original nonstuttering <A>_vars pair membership; original state-selfloop has none",
    "weak": "GF(NOT EnA) OR GF(OccA)",
    "strong": "FG(NOT EnA) OR GF(OccA)",
    "stutter": "original implicit stutter permitted, including original deadlocks; no sticky last action",
    "mutation_families": "exactly original source configs, independently checked"
  },
  "scc_certificate": {
    "membership": "total disjoint maximal partition for every relevant full (context,property,obligation) view; the same node may occur in different fixed-obligation views",
    "connectivity": "actual-edge forward and reverse rooted arborescences",
    "maximality": "strictly increasing condensation rank for every cross-component edge",
    "witness": "actual original-Init prefix and fair recurrent walk/cycle or valid implicit-stutter witness; independently replay monitor and fairness obligations",
    "indivisible": "component exceeding admitted bound fails incomplete",
    "obligation": "null for seen_goal_false; exact fixed (node,job,claim_id) for pending_true/capacity_ok_pending_true, regenerated for every relevant obligation",
    "induced_graph": "all globally reachable monitor nodes matching that fixed pending triple (and capacity_ok where required), or seen_goal=false completion nodes; every original monitor edge with both endpoints in the set",
    "full_graph_dependencies": "original outgoing edges leaving the view/component still determine enabledness/fairness; no boundary sink"
  },
  "required_comparison_fixture_semantics": [
    "action enabled only by an outgoing component edge",
    "reachable genuine deadlock with original implicit stutter",
    "original state-selfloop carrying action label but no <A>_vars occurrence",
    "completion goal already seen in prefix",
    "cleanup pending across component boundary",
    "capacity becomes false in prefix"
  ],
  "execution_or_acceptance_credit": false
