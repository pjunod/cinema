{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paged-catalog-transport.schema.json",
  "title": "Lossless schema6 catalog transport adjunct",
  "oneOf": [
    {
      "$ref": "#/$defs/CatalogBackup"
    },
    {
      "$ref": "#/$defs/CatalogChunkIndex"
    }
  ],
  "$defs": {
    "CatalogBackup": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "catalog_backup"
        },
        "source": {
          "$ref": "paged-proof.schema.json#/$defs/SourceIdentity"
        },
        "session_id": {
          "$ref": "paged-proof.schema.json#/$defs/Uuid"
        },
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "checkpoint_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "previous_checkpoint_sha256": {
          "anyOf": [
            {
              "$ref": "paged-proof.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_plan_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "initial_image_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "catalog_commit": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "catalog_logical_digest": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "semantic_manifest_root": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "snapshot_boundary": {
          "const": "post_checkpoint_pre_upload"
        },
        "format": {
          "const": "sqlite3"
        },
        "backup_method": {
          "const": "sqlite_backup_api_v1"
        },
        "catalog_bytes": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "catalog_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "chunk_bytes_limit": {
          "const": 268435456
        },
        "chunk_count": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "artifact_part_count": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "index_root": {
          "$ref": "#/$defs/IndexRef"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source",
        "session_id",
        "unit_ordinal",
        "checkpoint_sha256",
        "previous_checkpoint_sha256",
        "resource_plan_sha256",
        "initial_image_sha256",
        "catalog_commit",
        "catalog_logical_digest",
        "semantic_manifest_root",
        "snapshot_boundary",
        "format",
        "backup_method",
        "catalog_bytes",
        "catalog_sha256",
        "chunk_bytes_limit",
        "chunk_count",
        "artifact_part_count",
        "index_root"
      ],
      "additionalProperties": false
    },
    "CatalogChunkIndex": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "catalog_chunk_index"
        },
        "source": {
          "$ref": "paged-proof.schema.json#/$defs/SourceIdentity"
        },
        "session_id": {
          "$ref": "paged-proof.schema.json#/$defs/Uuid"
        },
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "checkpoint_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "level": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "first_chunk": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "chunk_count": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "offset": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "bytes": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source",
        "session_id",
        "unit_ordinal",
        "checkpoint_sha256",
        "level",
        "first_chunk",
        "chunk_count",
        "offset",
        "bytes",
        "entries"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "$ref": "#/$defs/ChunkDescriptor"
                }
              }
            }
          },
          "else": {
            "properties": {
              "entries": {
                "items": {
                  "$ref": "#/$defs/IndexRef"
                }
              }
            }
          }
        }
      ]
    },
    "ChunkDescriptor": {
      "type": "object",
      "properties": {
        "ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "offset": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "member_path": {
          "$ref": "paged-proof.schema.json#/$defs/RelativePath"
        },
        "part_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        }
      },
      "required": [
        "ordinal",
        "offset",
        "bytes",
        "sha256",
        "member_path",
        "part_ordinal"
      ],
      "additionalProperties": false
    },
    "IndexRef": {
      "type": "object",
      "properties": {
        "member_path": {
          "$ref": "paged-proof.schema.json#/$defs/RelativePath"
        },
        "sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "part_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "level": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "first_chunk": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "chunk_count": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "offset": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "bytes": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        }
      },
      "required": [
        "member_path",
        "sha256",
        "part_ordinal",
        "level",
        "first_chunk",
        "chunk_count",
        "offset",
        "bytes"
      ],
      "additionalProperties": false
    }
  }
}
