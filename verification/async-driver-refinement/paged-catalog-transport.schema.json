{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paged-catalog-transport.schema.json",
  "title": "Bounded authenticated snapshot and publication transport",
  "oneOf": [
    {
      "$ref": "#/$defs/CatalogBackup"
    },
    {
      "$ref": "#/$defs/VerifierBackup"
    },
    {
      "$ref": "#/$defs/SnapshotManifestNode"
    },
    {
      "$ref": "#/$defs/EvidenceManifestNode"
    },
    {
      "$ref": "#/$defs/TransferManifestNode"
    },
    {
      "$ref": "#/$defs/PublicationIntent"
    },
    {
      "$ref": "#/$defs/PendingPublication"
    },
    {
      "$ref": "#/$defs/TransferBatchReceipt"
    },
    {
      "$ref": "#/$defs/ActivationResult"
    },
    {
      "$ref": "#/$defs/ConformanceResult"
    },
    {
      "$ref": "#/$defs/ValidationReceipt"
    }
  ],
  "$defs": {
    "ContentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "snapshot_chunk",
            "snapshot_manifest_node",
            "catalog_backup",
            "verifier_backup",
            "evidence_manifest_node",
            "transfer_manifest_node",
            "publication_intent",
            "transfer_batch_receipt",
            "publication_activation",
            "planned_execution_result",
            "validation_receipt"
          ]
        },
        "sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "bytes": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        }
      },
      "required": [
        "kind",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "Origin": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "pr": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "event_base": {
          "$ref": "paged-proof.schema.json#/$defs/Commit"
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "event_name": {
          "const": "workflow_dispatch"
        },
        "mode": {
          "enum": [
            "unit",
            "complete"
          ]
        },
        "operation": {
          "enum": [
            "execute",
            "publish"
          ]
        },
        "run": {
          "type": "integer",
          "minimum": 1
        },
        "job": {
          "type": "integer",
          "minimum": 1
        },
        "task": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "const": 1
        },
        "dispatch_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        }
      },
      "required": [
        "repository",
        "pr",
        "event_base",
        "workflow_id",
        "event_name",
        "mode",
        "operation",
        "run",
        "job",
        "task",
        "attempt",
        "dispatch_ordinal"
      ],
      "additionalProperties": false
    },
    "MemberRef": {
      "type": "object",
      "properties": {
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "member_path": {
          "$ref": "#/$defs/SafePath"
        },
        "bytes": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "unit_ordinal",
        "member_path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "CatalogBackup": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "paged-proof.schema.json#/$defs/SourceIdentity"
        },
        "session_id": {
          "$ref": "paged-proof.schema.json#/$defs/Uuid"
        },
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "resource_plan_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "initial_image_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "schema_version": {
          "const": 2
        },
        "execution_origin": {
          "$ref": "#/$defs/Origin"
        },
        "checkpoint_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "previous_checkpoint_sha256": {
          "anyOf": [
            {
              "$ref": "paged-proof.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "predecessor_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_commit": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "catalog_logical_digest": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "semantic_manifest_root": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "format": {
          "const": "sqlite3"
        },
        "backup_method": {
          "const": "sqlite_backup_api_v1"
        },
        "chunk_bytes_limit": {
          "const": 1048576
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_root": {
          "$ref": "#/$defs/ContentRef"
        },
        "kind": {
          "const": "catalog_backup"
        },
        "snapshot_boundary": {
          "const": "post_checkpoint_pre_upload"
        },
        "catalog_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "catalog_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "source",
        "session_id",
        "unit_ordinal",
        "resource_plan_sha256",
        "initial_image_sha256",
        "schema_version",
        "execution_origin",
        "checkpoint_sha256",
        "previous_checkpoint_sha256",
        "predecessor_root",
        "catalog_commit",
        "catalog_logical_digest",
        "semantic_manifest_root",
        "format",
        "backup_method",
        "chunk_bytes_limit",
        "chunk_count",
        "manifest_root",
        "kind",
        "snapshot_boundary",
        "catalog_bytes",
        "catalog_sha256"
      ],
      "additionalProperties": false
    },
    "VerifierBackup": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "paged-proof.schema.json#/$defs/SourceIdentity"
        },
        "session_id": {
          "$ref": "paged-proof.schema.json#/$defs/Uuid"
        },
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "resource_plan_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "initial_image_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "schema_version": {
          "const": 2
        },
        "execution_origin": {
          "$ref": "#/$defs/Origin"
        },
        "checkpoint_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "previous_checkpoint_sha256": {
          "anyOf": [
            {
              "$ref": "paged-proof.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "predecessor_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_commit": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "catalog_logical_digest": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "semantic_manifest_root": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "format": {
          "const": "sqlite3"
        },
        "backup_method": {
          "const": "sqlite_backup_api_v1"
        },
        "chunk_bytes_limit": {
          "const": 1048576
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_root": {
          "$ref": "#/$defs/ContentRef"
        },
        "kind": {
          "const": "verifier_backup"
        },
        "snapshot_boundary": {
          "const": "post_verifier_commit_pre_upload"
        },
        "work_db_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "work_db_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "verifier_schema_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "verifier_algorithm_version": {
          "const": 1
        },
        "verifier_commit": {
          "$ref": "paged-proof.schema.json#/$defs/Id"
        },
        "verifier_logical_digest": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "previous_verifier_progress_sha256": {
          "anyOf": [
            {
              "$ref": "paged-proof.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "source",
        "session_id",
        "unit_ordinal",
        "resource_plan_sha256",
        "initial_image_sha256",
        "schema_version",
        "execution_origin",
        "checkpoint_sha256",
        "previous_checkpoint_sha256",
        "predecessor_root",
        "catalog_commit",
        "catalog_logical_digest",
        "semantic_manifest_root",
        "format",
        "backup_method",
        "chunk_bytes_limit",
        "chunk_count",
        "manifest_root",
        "kind",
        "snapshot_boundary",
        "work_db_bytes",
        "work_db_sha256",
        "verifier_schema_sha256",
        "verifier_algorithm_version",
        "verifier_commit",
        "verifier_logical_digest",
        "previous_verifier_progress_sha256",
        "progress_sha256"
      ],
      "additionalProperties": false
    },
    "SnapshotManifestNode": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "snapshot_manifest_node"
        },
        "scope_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "level": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "first_chunk": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ordinal": {
                    "$ref": "paged-proof.schema.json#/$defs/Nat"
                  },
                  "offset": {
                    "$ref": "paged-proof.schema.json#/$defs/Nat"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content": {
                    "$ref": "#/$defs/ContentRef"
                  }
                },
                "required": [
                  "ordinal",
                  "offset",
                  "bytes",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "first_chunk": {
                    "$ref": "paged-proof.schema.json#/$defs/Nat"
                  },
                  "chunk_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "offset": {
                    "$ref": "paged-proof.schema.json#/$defs/Nat"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "child": {
                    "$ref": "#/$defs/ContentRef"
                  }
                },
                "required": [
                  "first_chunk",
                  "chunk_count",
                  "offset",
                  "bytes",
                  "child"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scope_sha256",
        "level",
        "first_chunk",
        "chunk_count",
        "offset",
        "bytes",
        "entries"
      ],
      "additionalProperties": false
    },
    "EvidenceManifestNode": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "evidence_manifest_node"
        },
        "scope_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "level": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "first_key": {
          "type": "string",
          "minLength": 1
        },
        "last_key": {
          "type": "string",
          "minLength": 1
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "member": {
                    "$ref": "#/$defs/MemberRef"
                  },
                  "chunks": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ContentRef"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "member",
                  "chunks"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "first_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "last_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "item_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "child": {
                    "$ref": "#/$defs/ContentRef"
                  }
                },
                "required": [
                  "first_key",
                  "last_key",
                  "item_count",
                  "child"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scope_sha256",
        "level",
        "first_key",
        "last_key",
        "item_count",
        "entries"
      ],
      "additionalProperties": false
    },
    "TransferManifestNode": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "transfer_manifest_node"
        },
        "scope_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "level": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "first_key": {
          "type": "string",
          "minLength": 1
        },
        "last_key": {
          "type": "string",
          "minLength": 1
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "content": {
                    "$ref": "#/$defs/ContentRef"
                  },
                  "part_ordinal": {
                    "$ref": "paged-proof.schema.json#/$defs/Nat"
                  },
                  "member_path": {
                    "$ref": "#/$defs/SafePath"
                  }
                },
                "required": [
                  "content",
                  "part_ordinal",
                  "member_path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "first_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "last_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "item_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "child": {
                    "$ref": "#/$defs/ContentRef"
                  }
                },
                "required": [
                  "first_key",
                  "last_key",
                  "item_count",
                  "child"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scope_sha256",
        "level",
        "first_key",
        "last_key",
        "item_count",
        "entries"
      ],
      "additionalProperties": false
    },
    "PublicationIntent": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "paged-proof.schema.json#/$defs/SourceIdentity"
        },
        "session_id": {
          "$ref": "paged-proof.schema.json#/$defs/Uuid"
        },
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "resource_plan_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "initial_image_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "publication_intent"
        },
        "execution_origin": {
          "$ref": "#/$defs/Origin"
        },
        "previous_checkpoint": {
          "anyOf": [
            {
              "$ref": "paged-proof.schema.json#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_checkpoint": {
          "$ref": "paged-proof.schema.json#/$defs/Ref"
        },
        "catalog_root": {
          "$ref": "#/$defs/ContentRef"
        },
        "verifier_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_result": {
          "$ref": "#/$defs/ContentRef"
        },
        "evidence_root": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "required": [
        "source",
        "session_id",
        "unit_ordinal",
        "resource_plan_sha256",
        "initial_image_sha256",
        "schema_version",
        "kind",
        "execution_origin",
        "previous_checkpoint",
        "candidate_checkpoint",
        "catalog_root",
        "verifier_root",
        "execution_result",
        "evidence_root"
      ],
      "additionalProperties": false
    },
    "PendingPublication": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "pending_publication"
        },
        "intent": {
          "$ref": "#/$defs/ContentRef"
        },
        "previous_batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "coverage_count": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "next_batch_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "intent",
        "previous_batch",
        "coverage_sha256",
        "coverage_count",
        "next_batch_ordinal"
      ],
      "additionalProperties": false
    },
    "TransferBatchReceipt": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "paged-proof.schema.json#/$defs/SourceIdentity"
        },
        "session_id": {
          "$ref": "paged-proof.schema.json#/$defs/Uuid"
        },
        "unit_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "resource_plan_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "initial_image_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "transfer_batch_receipt"
        },
        "intent_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "execution_origin": {
          "$ref": "#/$defs/Origin"
        },
        "publication_origin": {
          "$ref": "#/$defs/Origin"
        },
        "batch_ordinal": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "purpose": {
          "enum": [
            "transfer",
            "activate"
          ]
        },
        "previous_batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "transfer_manifest": {
          "$ref": "#/$defs/ContentRef"
        },
        "coverage_before_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "coverage_after_sha256": {
          "$ref": "paged-proof.schema.json#/$defs/Sha256"
        },
        "coverage_count": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "artifact_receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": 6
              },
              "kind": {
                "const": "ArtifactReceipt"
              },
              "record": {
                "$ref": "paged-proof.schema.json#/$defs/ArtifactReceipt"
              }
            },
            "required": [
              "schema_version",
              "kind",
              "record"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "retained_artifact_bytes": {
          "$ref": "paged-proof.schema.json#/$defs/Nat"
        },
        "acceptance": {
          "const": false
        },
        "proof_checkpoint_advanced": {
          "const": false
        }
      },
      "required": [
        "source",
        "session_id",
        "unit_ordinal",
        "resource_plan_sha256",
        "initial_image_sha256",
        "schema_version",
        "kind",
        "intent_sha256",
        "execution_origin",
        "publication_origin",
        "batch_ordinal",
        "purpose",
        "previous_batch",
        "transfer_manifest",
        "coverage_before_sha256",
        "coverage_after_sha256",
        "coverage_count",
