{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plurx.tv/schemas/cluster-topology-v1.json",
  "title": "plurx three-versus-four-voter topology evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_scope",
    "build_sha",
    "workload",
    "workload_sha256",
    "topology_order",
    "started_at_unix_ms",
    "finished_at_unix_ms",
    "runs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_scope": { "enum": ["semantic_ci", "named_runner"] },
    "build_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workload": { "$ref": "#/$defs/workload" },
    "workload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "topology_order": {
      "oneOf": [
        { "const": [3, 4] },
        { "const": [4, 3] }
      ]
    },
    "started_at_unix_ms": { "type": "integer", "minimum": 0 },
    "finished_at_unix_ms": { "type": "integer", "minimum": 0 },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "operations",
        "concurrency",
        "value_bytes",
        "latency_unit",
        "index_unit"
      ],
      "properties": {
        "id": { "const": "settings-put-v1" },
        "operation": { "const": "quorum_acknowledged_put_setting" },
        "operations": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "value_bytes": { "type": "integer", "minimum": 1 },
        "latency_unit": { "const": "microseconds" },
        "index_unit": { "const": "raft_entries" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voter_count",
        "quorum",
        "leader",
        "request_target",
        "workload_sha256",
        "started_at_unix_ms",
        "finished_at_unix_ms",
        "errors",
        "applied_index_before",
        "applied_index_after",
        "physical_commit_entries",
        "commit_latency_p50_us",
        "commit_latency_p95_us",
        "commit_latency_p99_us",
        "raw_commit_latency_us",
        "applied_indexes",
        "max_apply_lag_entries",
        "controller_host",
        "load_generator_host",
        "resources"
      ],
      "properties": {
        "voter_count": { "enum": [3, 4] },
        "quorum": { "type": "integer", "minimum": 2, "maximum": 3 },
        "leader": { "type": "integer", "minimum": 1 },
        "request_target": { "const": "leader" },
        "workload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "started_at_unix_ms": { "type": "integer", "minimum": 0 },
        "finished_at_unix_ms": { "type": "integer", "minimum": 0 },
        "errors": { "const": 0 },
        "applied_index_before": { "type": "integer", "minimum": 0 },
        "applied_index_after": { "type": "integer", "minimum": 0 },
        "physical_commit_entries": { "type": "integer", "minimum": 1 },
        "commit_latency_p50_us": { "type": "number", "minimum": 0 },
        "commit_latency_p95_us": { "type": "number", "minimum": 0 },
        "commit_latency_p99_us": { "type": "number", "minimum": 0 },
        "raw_commit_latency_us": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "applied_indexes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/applied_index" }
        },
        "max_apply_lag_entries": { "type": "integer", "minimum": 0 },
        "controller_host": { "type": "string", "minLength": 1 },
        "load_generator_host": { "type": "string", "minLength": 1 },
        "resources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "applied_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "applied_index"],
      "properties": {
        "node_id": { "type": "integer", "minimum": 1 },
        "applied_index": { "type": "integer", "minimum": 0 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "hardware",
        "storage_device",
        "network_path",
        "cpu_seconds",
        "wall_seconds",
        "max_rss_bytes",
        "storage_read_bytes",
        "storage_write_bytes",
        "network_receive_bytes",
        "network_transmit_bytes"
      ],
      "properties": {
        "node_id": { "type": "integer", "minimum": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "storage_device": { "type": "string", "minLength": 1 },
        "network_path": { "type": "string", "minLength": 1 },
        "cpu_seconds": { "$ref": "#/$defs/nullable_number" },
        "wall_seconds": { "$ref": "#/$defs/nullable_number" },
        "max_rss_bytes": { "$ref": "#/$defs/nullable_integer" },
        "storage_read_bytes": { "$ref": "#/$defs/nullable_integer" },
        "storage_write_bytes": { "$ref": "#/$defs/nullable_integer" },
        "network_receive_bytes": { "$ref": "#/$defs/nullable_integer" },
        "network_transmit_bytes": { "$ref": "#/$defs/nullable_integer" }
      }
    },
    "nullable_number": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "nullable_integer": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  }
}
